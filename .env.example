# Copy this file to .env (which git ignores) and fill it in; config.sh reads it for the scripts.
# Anything left out takes the default in config.sh. A box IP given to a script as its first
# argument wins over BOX_IP.

# The box's Debian user (hybrid/install.sh makes it with your user name on this computer)
BOX_USER="<USER>"

# The box on the cable, and over WiFi (reserve both in the router's DHCP settings)
BOX_IP="<BOX_IP>"
BOX_WIFI_IP="<BOX_WIFI_IP>"

# The ssh key hybrid/install.sh makes and installs on the box
SSH_KEY=~/.ssh/id_ed25519_ozone
