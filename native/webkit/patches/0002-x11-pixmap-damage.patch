 AcceleratedBackingStore::AcceleratedBackingStore(WebPageProxy& webPage)
     : m_webPage(webPage)
     , m_fenceMonitor([this] {
-        if (m_webPage)
-            gtk_widget_queue_draw(m_webPage->viewWidget());
+        queueDraw();
     })
     , m_legacyMainFrameProcess(webPage.legacyMainFrameProcess())
 {
@@ -338,7 +338,10 @@
         }
         cairo_rectangle(cr, clipRect.x(), clipRect.y(), clipRect.width(), clipRect.height());
         cairo_set_source_surface(cr, surface, 0, 0);
-        cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+        // An opaque page needs no blending: X then writes the frame without reading what is under it
+        const auto& background = m_webPage->backgroundColor();
+        bool opaque = surfaceIsTopDown() && (!background || background->isOpaque());
+        cairo_set_operator(cr, opaque ? CAIRO_OPERATOR_SOURCE : CAIRO_OPERATOR_OVER);
         cairo_fill(cr);
         cairo_restore(cr);
     }
@@ -833,6 +836,29 @@
     m_fenceMonitor.addFileDescriptor(WTFMove(renderingFenceFD));
 }
 
+void AcceleratedBackingStore::queueDraw()
+{
+    RefPtr webPage = m_webPage.get();
+    if (!webPage)
+        return;
+
+    auto* widget = webPage->viewWidget();
+#if PLATFORM(X11) && !USE(GTK4)
+    // A frame in an X pixmap is top down, so its damage (what changed since the frame on screen)
+    // is in the view's coordinates: only that is drawn again, X composites nothing else
+    if (m_pendingBuffer && m_pendingBuffer->surfaceIsTopDown() && m_committedBuffer && m_committedBuffer->surfaceIsTopDown()
+        && !m_pendingDamageRects.isEmpty()) {
+        float scale = webPage->deviceScaleFactor();
+        for (const auto& rect : m_pendingDamageRects) {
+            auto area = enclosingIntRect(FloatRect(rect.x() / scale, rect.y() / scale, rect.width() / scale, rect.height() / scale));
+            gtk_widget_queue_draw_area(widget, area.x(), area.y(), area.width(), area.height());
+        }
+        return;
+    }
+#endif
+    gtk_widget_queue_draw(widget);
+}
