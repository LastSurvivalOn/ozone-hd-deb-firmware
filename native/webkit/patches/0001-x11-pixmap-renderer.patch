+#if PLATFORM(GTK) && PLATFORM(X11) && !USE(GTK4)
+// The pixmaps are made on a connection of our own: the EGL display is surfaceless, and the
+// driver finds a pixmap by its XID on its own connection
+static _XDisplay* x11PixmapDisplay()
+{
+    static _XDisplay* display = XOpenDisplay(nullptr);
+    return display;
+}
+
+static bool x11PixmapRendererEnabled()
+{
+    static bool enabled = [] {
+        const char* value = getenv("WEBKIT_X11_PIXMAP_RENDERER");
+        return value && strcmp(value, "0") && x11PixmapDisplay();
+    }();
+    return enabled;
+}
+
+std::unique_ptr<AcceleratedSurface::RenderTarget> AcceleratedSurface::RenderTargetX11Pixmap::create(uint64_t surfaceID, const IntSize& size)
+{
+    auto* display = x11PixmapDisplay();
+    // depth 32: RGBA, which X composites with alpha
+    unsigned long pixmap = XCreatePixmap(display, XDefaultRootWindow(display), size.width(), size.height(), 32);
+    XSync(display, 0);
+    Vector<EGLAttrib> attributes = { EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE };
+    auto image = PlatformDisplay::sharedDisplay().createEGLImage(EGL_NO_CONTEXT, EGL_NATIVE_PIXMAP_KHR, reinterpret_cast<EGLClientBuffer>(pixmap), attributes);
+    if (!image) {
+        WTFLogAlways("Failed to create an EGL image for an X pixmap of size %dx%d", size.width(), size.height());
+        XFreePixmap(display, pixmap);
+        XFlush(display);
+        return nullptr;
+    }
+    return makeUnique<RenderTargetX11Pixmap>(surfaceID, size, pixmap, image);
+}
+
+AcceleratedSurface::RenderTargetX11Pixmap::RenderTargetX11Pixmap(uint64_t surfaceID, const IntSize& size, unsigned long pixmap, EGLImage image)
+    : RenderTargetShareableBuffer(surfaceID, size)
+    , m_pixmap(pixmap)
+    , m_image(image)
+{
+    // a texture, not a renderbuffer: the Mali-450 left renderbuffers on an EGLImage 0x0
+    glGenTextures(1, &m_texture);
+    glBindTexture(GL_TEXTURE_2D, m_texture);
+    glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, m_image);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_texture, 0);
+
+    WebProcess::singleton().parentProcessConnection()->send(Messages::AcceleratedBackingStore::DidCreateX11PixmapBuffer(m_id, size, m_pixmap), surfaceID);
+}
+
+AcceleratedSurface::RenderTargetX11Pixmap::~RenderTargetX11Pixmap()
+{
+    if (m_texture)
+        glDeleteTextures(1, &m_texture);
+    if (m_image)
+        PlatformDisplay::sharedDisplay().destroyEGLImage(m_image);
+    // the UI process holds its own reference (a Picture) while it shows it
+    XFreePixmap(x11PixmapDisplay(), m_pixmap);
+    XFlush(x11PixmapDisplay());
+}
+
+void AcceleratedSurface::RenderTargetX11Pixmap::didRenderFrame(Vector<IntRect, 1>&& damageRects)
+{
+    // all of the frame in the pixmap before X reads it
+    glFinish();
+    RenderTargetShareableBuffer::didRenderFrame(WTFMove(damageRects));
+}
