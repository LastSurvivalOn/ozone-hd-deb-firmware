+#if PLATFORM(X11) && !USE(GTK4)
+RefPtr<AcceleratedBackingStore::Buffer> AcceleratedBackingStore::BufferX11Pixmap::create(WebPageProxy& webPage, uint64_t id, uint64_t surfaceID, const IntSize& size, uint64_t pixmap)
+{
+    auto* display = gdk_display_get_default();
+    if (!GDK_IS_X11_DISPLAY(display))
+        return nullptr;
+    auto* visual = gdk_screen_get_rgba_visual(gdk_display_get_default_screen(display));
+    if (!visual)
+        return nullptr;
+
+    RefPtr<cairo_surface_t> surface = adoptRef(cairo_xlib_surface_create(GDK_DISPLAY_XDISPLAY(display), pixmap, GDK_VISUAL_XVISUAL(visual), size.width(), size.height()));
+    if (cairo_surface_status(surface.get()) != CAIRO_STATUS_SUCCESS)
+        return nullptr;
+    cairo_surface_set_device_scale(surface.get(), webPage.deviceScaleFactor(), webPage.deviceScaleFactor());
+
+    // Using the pixmap once makes cairo create its Picture, which keeps the pixmap alive in X
+    // after the web process frees its XID (when it drops the buffer)
+    gdk_x11_display_error_trap_push(display);
+    RefPtr<cairo_surface_t> probe = adoptRef(cairo_surface_create_similar(surface.get(), CAIRO_CONTENT_COLOR_ALPHA, 1, 1));
+    RefPtr<cairo_t> cr = adoptRef(cairo_create(probe.get()));
+    cairo_set_source_surface(cr.get(), surface.get(), 0, 0);
+    cairo_paint(cr.get());
+    cairo_surface_flush(probe.get());
+    bool failed = gdk_x11_display_error_trap_pop(display);
+    if (failed)
+        return nullptr;
+
+    return adoptRef(*new BufferX11Pixmap(webPage, id, surfaceID, size, WTFMove(surface)));
+}
+
+AcceleratedBackingStore::BufferX11Pixmap::BufferX11Pixmap(WebPageProxy& webPage, uint64_t id, uint64_t surfaceID, const IntSize& size, RefPtr<cairo_surface_t>&& surface)
+    : Buffer(webPage, id, surfaceID, size, RendererBufferFormat::Usage::Rendering)
+    , m_surface(WTFMove(surface))
+{
+}
+
+RendererBufferDescription AcceleratedBackingStore::BufferX11Pixmap::description() const
+{
+#if USE(LIBDRM)
+    return { RendererBufferDescription::Type::SharedMemory, m_usage, DRM_FORMAT_ARGB8888, 0 };
+#else
+    return { };
+#endif
+}
+
+void AcceleratedBackingStore::BufferX11Pixmap::release()
+{
+    // the web process renders the next frame into it: X must be done reading it
+    XSync(cairo_xlib_surface_get_display(m_surface.get()), False);
+    didRelease();
+}
+
+void AcceleratedBackingStore::didCreateX11PixmapBuffer(uint64_t id, const IntSize& size, uint64_t pixmap)
+{
+    RefPtr webPage = m_webPage.get();
+    if (!webPage)
+        return;
+
+    if (auto buffer = BufferX11Pixmap::create(*webPage, id, m_surfaceID, size, pixmap))
+        m_buffers.add(id, WTFMove(buffer));
+}
