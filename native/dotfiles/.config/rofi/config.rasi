configuration {
    modi: "drun,run";
    show-icons: false;
    drun-display-format: "{name}";
    display-drun: "  Apps";
    display-run: "  Command";
    font: "JetBrains Mono Bold 11";
}

* {
    base:     #1e1e2e;
    mantle:   #181825;
    surface0: #313244;
    text:     #cdd6f4;
    subtext:  #a6adc8;
    mauve:    #cba6f7;

    background-color: transparent;
    text-color: @text;
}

/* Placed from the top: centred, rofi starts the window at the middle of this screen (fbdev, no
   RandR) and the list runs off the bottom */
window {
    location: north;
    anchor: north;
    y-offset: 70px;
    width: 640px;
    background-color: @base;
    border: 3px;
    border-color: @mauve;
    padding: 18px;
}

mainbox { spacing: 12px; }

inputbar {
    background-color: @surface0;
    padding: 10px 14px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt { text-color: @mauve; }
entry { placeholder: "search…"; placeholder-color: @subtext; }

listview { lines: 10; spacing: 4px; fixed-height: false; }

element { padding: 8px 14px; }
/* every state, or rofi's built-in theme shows through (light rows) */
element normal.normal, element alternate.normal, element normal.active, element alternate.active,
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @text; }
element selected.normal, element selected.active, element selected.urgent {
    background-color: @mauve; text-color: @base; }
element-text { background-color: transparent; text-color: inherit; }
scrollbar { handle-color: @mauve; handle-width: 4px; background-color: @surface0; }
