# Apps
super + Return
    ozone-terminal
super + d
    rofi -show drun
super + y
    yt
super + w
    ozone-web-show
super + t
    ozone-tv
super + e
    ozone-files
super + shift + e
    ozone-power
super + Escape
    pkill -USR1 -x sxhkd
# a screenshot into Pictures/Screenshots
Print
    ozone-screenshot

# Windows
super + q
    bspc node -c
super + f
    bspc node -t ~fullscreen
super + s
    bspc node -t ~floating
super + m
    bspc desktop -l next
super + {h,j,k,l}
    bspc node -f {west,south,north,east}
super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

# Workspaces
super + {_,shift + }{1-5}
    bspc {desktop -f,node -d} '^{1-5}'
super + Tab
    bspc desktop -f last

# Volume
XF86Audio{Raise,Lower}Volume
    ozone-volume {up,down}
XF86AudioMute
    ozone-volume mute

# The IR remote (its keys: /etc/ozone/remote.conf; ozone-remote handles mouse, text, exit and
# Power). Arrows, OK, digits, page+/- and the playback keys reach the apps as they are; these
# start things.
# A keyboard's power key, or the remote's without ozone-remote. On release: sleep grabs the
# keyboards, and X would never see the key go up
@XF86PowerOff
    sudo -n ozone-standby
# home: the open windows, then the apps
XF86HomePage
    rofi -show combi -modi combi -combi-modi window,drun -display-combi "  Home"
# usb: the drives and network folders
XF86Launch7
    ozone-media menu
# The buttons of programs open them only from the empty desktop: with a window open they are that
# program's (~ passes them on to it: the TV window's, YouTube's), and open nothing over it.
# browse
~XF86WWW
    ozone-launch ozone-web-show
# red
~XF86Launch1
    ozone-launch yt
# epg, dvb, TV/radio
~XF86Launch{6,8,9}
    ozone-launch ozone-tv
