#!/bin/sh
# Catppuccin Mocha

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d 1 2 3 4 5

bspc config border_width         3
bspc config window_gap           14
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focus_follows_pointer true
bspc config pointer_modifier     mod4

bspc config normal_border_color  "#313244"
bspc config active_border_color  "#45475a"
bspc config focused_border_color "#cba6f7"
bspc config presel_feedback_color "#89b4fa"

bspc rule -a mpv state=fullscreen
bspc rule -a Rofi state=floating

feh --no-fehbg --bg-fill ~/.local/share/wallpapers/ozone.png
~/.config/polybar/launch.sh
# the browser waits hidden, so the panel button opens it at once (~60 MB)
ozone-web --background &
