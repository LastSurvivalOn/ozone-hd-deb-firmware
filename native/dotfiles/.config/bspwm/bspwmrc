#!/bin/sh
# Catppuccin Mocha

# X gives its XTEST keyboard (xdotool, the on-screen keyboard) the old xfree86 key codes; the
# real keyboard has evdev ones. Whichever typed last lends the core keyboard its keymap, and sxhkd
# grabbing keys under the wrong one leaves the media keys dead. Both get the same keymap here.
setxkbmap -rules evdev -model pc105 -layout us,ua -option -option grp:alt_shift_toggle
pgrep -x sxhkd > /dev/null || sxhkd &
# the IR remote: mouse mode, on-screen keyboard, exit and Power
pgrep -x ozone-remote > /dev/null || ozone-remote &
# the photo slideshow after some minutes without a key (Files: Screensaver)
pgrep -f "^/usr/bin/python3 /usr/local/bin/ozone-screensave[r]" > /dev/null || ozone-screensaver &
# TV timers: starts the TV for recordings and reminders set in its guide
pgrep -f "^/usr/bin/python3 /usr/local/bin/ozone-tv timer[s]" > /dev/null || ozone-tv timers &
# DLNA: phones and computers can send videos, music and photos to the box (unless turned off in
# the Network menu; it checks that itself, and that it isn't running already)
ozone-dlna renderer &
# Bluetooth: pairing codes on the screen, the sound to headphones while they are connected
pgrep -f "^/usr/bin/python3 /usr/local/bin/ozone-bluetooth agen[t]" > /dev/null || ozone-bluetooth agent &

bspc monitor -d 1 2 3 4 5

bspc config border_width         3
bspc config window_gap           14
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focus_follows_pointer true
bspc config pointer_modifier     mod4

bspc config normal_border_color  "#313244"
bspc config active_border_color  "#45475a"
bspc config focused_border_color "#cba6f7"
bspc config presel_feedback_color "#89b4fa"

bspc rule -a mpv state=fullscreen
# the photo viewer asks for full screen, but bspwm mapped it floating, in a small square
bspc rule -a Ozone-photos state=fullscreen
bspc rule -a Rofi state=floating

feh --no-fehbg --bg-fill ~/.local/share/wallpapers/ozone.png
~/.config/polybar/launch.sh
# the panel over fullscreen windows: pointer at the top edge, or info on the remote
pgrep -x ozone-panel > /dev/null || ozone-panel &
