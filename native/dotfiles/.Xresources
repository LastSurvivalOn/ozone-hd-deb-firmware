! Catppuccin Mocha
Xft.dpi: 96
Xft.antialias: true
Xft.hinting: true
Xft.hintstyle: hintslight
Xft.rgba: none

*.foreground:  #cdd6f4
*.background:  #1e1e2e
*.cursorColor: #f5e0dc
*.color0:  #45475a
*.color8:  #585b70
*.color1:  #f38ba8
*.color9:  #f38ba8
*.color2:  #a6e3a1
*.color10: #a6e3a1
*.color3:  #f9e2af
*.color11: #f9e2af
*.color4:  #89b4fa
*.color12: #89b4fa
*.color5:  #f5c2e7
*.color13: #f5c2e7
*.color6:  #94e2d5
*.color14: #94e2d5
*.color7:  #bac2de
*.color15: #a6adc8

URxvt.font: xft:JetBrains Mono:size=11, xft:Noto Color Emoji:size=11
URxvt.boldFont: xft:JetBrains Mono:style=Bold:size=11
URxvt.internalBorder: 16
URxvt.lineSpace: 2
URxvt.scrollBar: false
URxvt.saveLines: 5000
URxvt.cursorBlink: true
URxvt.iso14755: false
URxvt.urgentOnBell: true
