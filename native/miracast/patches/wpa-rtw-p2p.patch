+/*
+ * Some vendor drivers (Realtek's 8189ES, for one) report the start of a remain-on-channel but
+ * never its end, neither when it expires nor when it is cancelled, and P2P then waits for it for
+ * ever after its first listen. The end is made up here: when the time asked for is over, or at
+ * once after a cancel. A real end event that does come later finds nothing pending and is dropped.
+ */
+static void nl80211_remain_on_channel_over(void *eloop_ctx, void *timeout_ctx)
+{
+	struct wpa_driver_nl80211_data *drv = eloop_ctx;
+	union wpa_event_data data;
+
+	if (!drv->pending_remain_on_chan)
+		return;
+	wpa_printf(MSG_DEBUG, "nl80211: Remain-on-channel over (no event from the driver)");
+	drv->pending_remain_on_chan = 0;
+	os_memset(&data, 0, sizeof(data));
+	data.remain_on_channel.freq = drv->remain_on_chan_freq;
+	data.remain_on_channel.duration = drv->remain_on_chan_duration;
+	wpa_supplicant_event(drv->ctx, EVENT_CANCEL_REMAIN_ON_CHANNEL, &data);
+}
