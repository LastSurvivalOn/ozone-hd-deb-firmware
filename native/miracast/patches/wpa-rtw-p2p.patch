+#ifndef ANDROID_P2P
+/*
+ * Realtek's vendor drivers (8189ES) answer probe requests in the P2P listen state themselves and
+ * never pass them up, and as a group owner they build their beacons, probe responses and
+ * association responses with only the WPS and P2P IEs given by the Android private command
+ * SET_AP_WPS_P2P_IE (type 1, 2 and 4): without them no phone finds this device, nor joins its
+ * group. The command's IE length is the buffer's length past "SET_AP_WPS_P2P_IE N ".
+ */
+static int nl80211_rtw_p2p_ie(struct i802_bss *bss, int type, const struct wpabuf *ie)
+{
+	static const char cmd[] = "SET_AP_WPS_P2P_IE";
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct {
+		char *buf;
+		int used_len;
+		int total_len;
+	} priv_cmd;
+	struct ifreq ifr;
+	size_t head = sizeof(cmd) + 2, len = ie ? wpabuf_len(ie) : 0;
+	char *buf = os_zalloc(head + len + 1);
+	int ret;
+
+	if (!buf)
+		return -1;
+	os_snprintf(buf, head + 1, "%s %d ", cmd, type);
+	if (len)
+		os_memcpy(buf + head, wpabuf_head(ie), len);
+	os_memset(&ifr, 0, sizeof(ifr));
+	os_strlcpy(ifr.ifr_name, bss->ifname, IFNAMSIZ);
+	priv_cmd.buf = buf;
+	priv_cmd.used_len = head + len;
+	priv_cmd.total_len = head + len;
+	ifr.ifr_data = (void *) &priv_cmd;
+	ret = ioctl(drv->global->ioctl_sock, SIOCDEVPRIVATE + 1, &ifr);
+	wpa_printf(MSG_DEBUG, "nl80211: %s %d with %zu bytes: %d", cmd, type, len, ret);
+	os_free(buf);
+	return ret;
+}
+
+
+static int nl80211_rtw_set_p2p_ie(void *priv, const struct wpabuf *beacon,
+				  const struct wpabuf *proberesp,
+				  const struct wpabuf *assocresp)
+{
+	struct i802_bss *bss = priv;
+
+	if (is_ap_interface(bss->drv->nlmode)) {
+		nl80211_rtw_p2p_ie(bss, 1, beacon);
+		nl80211_rtw_p2p_ie(bss, 4, assocresp);
+	}
+	nl80211_rtw_p2p_ie(bss, 2, proberesp);
+	return 0;
+}
+#endif /* !ANDROID_P2P */
