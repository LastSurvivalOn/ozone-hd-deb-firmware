--- a/drivers/gpu/arm/ump/osk/ump_map_errcode.c	1970-01-01 03:00:00.000000000 +0300
+++ b/drivers/gpu/arm/ump/osk/ump_map_errcode.c	2026-10-21 20:46:58.183390159 +0300
@@ -0,0 +1,27 @@
+/* map_errcode() lives in mali_kernel_linux.c, which a modular ump.ko can't link against */
+#include <linux/errno.h>
+#include "mali_osk.h"
+
+int map_errcode(_mali_osk_errcode_t err)
+{
+	switch (err) {
+	case _MALI_OSK_ERR_OK:
+		return 0;
+	case _MALI_OSK_ERR_FAULT:
+		return -EFAULT;
+	case _MALI_OSK_ERR_INVALID_FUNC:
+		return -ENOTTY;
+	case _MALI_OSK_ERR_INVALID_ARGS:
+		return -EINVAL;
+	case _MALI_OSK_ERR_NOMEM:
+		return -ENOMEM;
+	case _MALI_OSK_ERR_TIMEOUT:
+		return -ETIMEDOUT;
+	case _MALI_OSK_ERR_RESTARTSYSCALL:
+		return -ERESTARTSYS;
+	case _MALI_OSK_ERR_ITEM_NOT_FOUND:
+		return -ENOENT;
+	default:
+		return -EFAULT;
+	}
+}
