#!/usr/bin/python3
"""ozone-files: videos, music and photos on the box, USB drives, SD cards and network folders,
for the remote.

  ozone-files [FOLDER]     the window: places on the left, a folder's files on the right
  ozone-files --screensaver   the photo slideshow (or a clock) until a key or the mouse moves;
                              started by ozone-screensaver when nothing has been done for a while

Videos play in amplay (the hardware decoder; mpv for what it can't decode), from where they were
left, with the audio track and subtitles chosen last time; a .srt next to a video is shown too.
Music plays here, in the background of the window (mpv without video, ao=sdl: see CLAUDE.md), the
whole folder from the track chosen. Photos open full-screen: one at a time, or a slideshow.

Kept in ~/.local/share/ozone-files: state.json (where each video was left, its tracks; the last
folder). The screensaver's settings: ~/.config/ozone/screensaver.json (the settings here).
"""
import ctypes
import json
import os
import signal
import random
import re
import shutil
import socket
import subprocess
import sys
import threading
import time

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GdkPixbuf', '2.0')
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Pango  # noqa: E402

HOME = os.path.expanduser('~')
DATA = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.join(HOME, '.local/share'), 'ozone-files')
STATE = os.path.join(DATA, 'state.json')
SAVER_CONF = os.path.join(HOME, '.config/ozone/screensaver.json')
RUNTIME = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
MPV_SOCK = os.path.join(RUNTIME, 'ozone-files-mpv-%d.sock' % os.getuid())
MEDIA = '/media'
NAND = '/mnt/nand/linux'

VIDEO = {'mkv', 'mp4', 'm4v', 'avi', 'mov', 'ts', 'm2ts', 'mts', 'webm', 'mpg', 'mpeg', 'vob', 'flv', 'wmv',
         '3gp', 'ogv', 'divx', 'xvid'}
AUDIO = {'mp3', 'flac', 'ogg', 'oga', 'opus', 'm4a', 'aac', 'wav', 'wma', 'ape', 'aiff', 'aif', 'mka', 'ac3', 'dts'}
IMAGE = {'jpg', 'jpeg', 'png', 'gif', 'bmp', 'tif', 'tiff'}
SUBS = {'srt', 'ass', 'ssa', 'vtt'}
# FontAwesome 4
ICONS = {'folder': '', 'video': '', 'audio': '', 'image': '', 'file': '',
         'up': '', 'usb': '', 'net': '', 'home': '', 'drive': '', 'tv': '',
         'download': ''}
SAVER_DEFAULTS = {'enabled': True, 'minutes': 10, 'folder': os.path.join(HOME, 'Pictures'), 'seconds': 8}
RESUME_MIN = 30   # s: videos stopped before this, or this close to the end, start from the beginning

