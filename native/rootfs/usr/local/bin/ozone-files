def kind(path):
    if os.path.isdir(path):
        return 'folder'
    ext = path.rsplit('.', 1)[-1].lower() if '.' in os.path.basename(path) else ''
    return 'video' if ext in VIDEO else 'audio' if ext in AUDIO else 'image' if ext in IMAGE else \
        'subs' if ext in SUBS else 'file'


def natural(name):
    return [int(t) if t.isdigit() else t.casefold() for t in re.split(r'(\d+)', name)]


def human_size(n):
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if n < 1024 or unit == 'TB':
            return ('%d %s' if unit == 'B' else '%.1f %s') % (n, unit)
        n /= 1024


def clock(t):
    t = int(t or 0)
    return '%d:%02d:%02d' % (t // 3600, t // 60 % 60, t % 60) if t >= 3600 else '%d:%02d' % (t // 60, t % 60)


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + '.tmp', 'w') as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(path + '.tmp', path)


def saver_settings():
    s = dict(SAVER_DEFAULTS)
    s.update(load_json(SAVER_CONF, {}))
    return s


def places():
    """(label, path, icon): the home folders that exist, TV recordings, the drives and network folders,
    the media servers"""
    out = []
    for label, sub, icon in (('Videos', 'Videos', 'video'), ('Music', 'Music', 'audio'),
                             ('Photos', 'Pictures', 'image'), ('Downloads', 'Downloads', 'download')):
        path = os.path.join(HOME, sub)
        if os.path.isdir(path):
            out.append((label, path, icon))
    for rec in [os.path.join(NAND, 'Recordings')]:
        if os.path.isdir(rec):
            out.append(('TV recordings', rec, 'tv'))
    try:
        with open('/proc/mounts') as f:
            mounts = [line.split() for line in f]
    except OSError:
        mounts = []
    for dev, mnt, fs, *_ in mounts:
        mnt = mnt.replace('\\040', ' ')
        if mnt.startswith(MEDIA + '/'):
            net = fs in ('cifs', 'fuse.rclone') or dev.startswith('//')
            out.append((os.path.basename(mnt), mnt, 'net' if net else 'usb'))
    out.append(('Media servers', DLNA, 'dlna'))
    out.append(('Home', HOME, 'home'))
    return out


def prepare_label(text='', cls=None, **kw):
    kw.setdefault('xalign', 0)
    w = Gtk.Label(label=text, **kw)
    for c in (cls or '').split():
        w.get_style_context().add_class(c)
    return w


# ---- music: mpv without video, through its JSON IPC ---------------------------------------------

def die_with_parent():
    """In the child: the music stops with the window, even when it is killed. SIGKILL: on SIGTERM
    this mpv hangs on a lock while quitting (SDL's audio thread)"""
    ctypes.CDLL('libc.so.6').prctl(1, signal.SIGKILL)   # PR_SET_PDEATHSIG


class Music:
    """One mpv for the window's music; None when nothing plays"""

    def __init__(self):
        self.p = None
        self.files = []

    def play(self, files, start):
        self.stop()
        try:
            os.unlink(MPV_SOCK)
        except OSError:
            pass
        self.files = files
        # ao=sdl, never alsa (see mpv.conf); the real mpv: no GPU needed for sound
        self.p = subprocess.Popen(['/usr/bin/mpv', '--no-video', '--no-terminal', '--ao=sdl', '--idle=no',
                                   '--input-ipc-server=' + MPV_SOCK, '--playlist-start=%d' % start, '--'] + files,
                                  stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                  preexec_fn=die_with_parent)

    def running(self):
        return self.p is not None and self.p.poll() is None

    def stop(self):
        if self.p and self.p.poll() is None:
            self.cmd('quit')
            try:
                self.p.wait(2)
            except subprocess.TimeoutExpired:
                self.p.kill()
        self.p = None

    def cmd(self, *args):
        """One command, its reply's data (or None)"""
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(0.5)
            s.connect(MPV_SOCK)
            s.sendall(json.dumps({'command': list(args), 'request_id': 1}).encode() + b'\n')
            buf = b''
            while True:
                chunk = s.recv(4096)
                if not chunk:
                    break
                buf += chunk
                for line in buf.split(b'\n'):
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    if msg.get('request_id') == 1:
                        s.close()
                        return msg.get('data')
            s.close()
        except (OSError, ValueError):
            pass
        return None

    def status(self):
        """(title, artist, position, duration, paused, index)"""
        title = self.cmd('get_property', 'media-title')
        artist = self.cmd('get_property', 'metadata/by-key/Artist') or self.cmd('get_property', 'metadata/by-key/ARTIST')
        return (title, artist, self.cmd('get_property', 'time-pos'), self.cmd('get_property', 'duration'),
                self.cmd('get_property', 'pause'), self.cmd('get_property', 'playlist-pos'))


# ---- the photo viewer and the screensaver ----------------------------------------------------------

class Viewer:
    """Photos full-screen: one, or a slideshow; also the screensaver (any input ends it)"""

    def __init__(self, files, index, slideshow=False, screensaver=False, on_close=None):
        self.files, self.index = files, index
        self.screensaver, self.on_close = screensaver, on_close
        self.interval = saver_settings()['seconds']
        self.rotation = {}
        self.timer = None
        self.loading = None
        self.cache = {}
        self.win = Gtk.Window(title='Photos')
        self.win.get_style_context().add_class('viewer')
        self.win.fullscreen()
        self.win.connect('key-press-event', self.on_key)
        self.win.connect('destroy', self.closed)
        overlay = Gtk.Overlay()
        self.image = Gtk.Image()
        overlay.add(self.image)
        self.caption = prepare_label('', 'caption', halign=Gtk.Align.CENTER, valign=Gtk.Align.END,
                                     margin_bottom=24, ellipsize=Pango.EllipsizeMode.MIDDLE)
        self.caption.set_no_show_all(True)
        overlay.add_overlay(self.caption)
        if screensaver:
            # every key and the mouse are its own as soon as it is up, whatever has the focus
            self.win.connect('map-event', self.grab)
            self.win.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_PRESS_MASK)
            self.win.connect('motion-notify-event', self.on_motion)
            self.win.connect('button-press-event', lambda w, e: self.win.destroy())
            self.moved = None
            if not files:   # no photos: a clock that moves about the screen (no burn-in)
                self.clock = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, halign=Gtk.Align.START,
                                     valign=Gtk.Align.START)
                self.time_label = prepare_label('', 'clock')
                self.date_label = prepare_label('', 'date')
                self.clock.pack_start(self.time_label, False, False, 0)
                self.clock.pack_start(self.date_label, False, False, 0)
                overlay.add_overlay(self.clock)
                GLib.timeout_add_seconds(1, self.tick_clock)
                GLib.idle_add(self.tick_clock)
        self.win.add(overlay)
        self.pixbuf = None
        self.win.show_all()
        Gdk.Window.set_cursor(self.win.get_window(), Gdk.Cursor.new_from_name(Gdk.Display.get_default(), 'none'))
        if files:
            self.show(index)
            if slideshow or screensaver:
                self.start_slideshow(announce=not screensaver)

    def grab(self, w, ev):
        seat = Gdk.Display.get_default().get_default_seat()
        seat.grab(self.win.get_window(), Gdk.SeatCapabilities.ALL, True, None, None, None, None)
        return False

    def tick_clock(self):
        self.time_label.set_text(time.strftime('%H:%M'))
        self.date_label.set_text(time.strftime('%A, %d %B'))
        if int(time.time()) % 30 == 0 or not self.clock.get_margin_start():
            w, h = self.win.get_size()
            self.clock.set_margin_start(random.randint(40, max(41, w - 520)))
            self.clock.set_margin_top(random.randint(40, max(41, h - 220)))
        return True

    def on_motion(self, w, ev):
        # the first motion event comes from the window appearing under the pointer
        if self.moved is None:
            self.moved = (ev.x_root, ev.y_root)
        elif abs(ev.x_root - self.moved[0]) + abs(ev.y_root - self.moved[1]) > 8:
            self.win.destroy()

    def closed(self, w):
        if self.timer:
            GLib.source_remove(self.timer)
        if self.on_close:
            self.on_close()

    def load(self, i):
        """The photo at i, fitted to the screen (decoders scale JPEG while reading: fast)"""
        path = self.files[i]
        if path in self.cache:
            return self.cache[path]
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 1280, 720, True)
            pb = pb.apply_embedded_orientation() or pb
        except GLib.Error:
            pb = None
        if len(self.cache) > 4:
            self.cache.pop(next(iter(self.cache)))
        self.cache[path] = pb
        return pb

    def show(self, i):
        self.index = i % len(self.files)
        path = self.files[self.index]

        def work(index):
            pb = self.load(index)
            nxt = (index + 1) % len(self.files)
            GLib.idle_add(self.shown, index, pb)
            self.load(nxt)   # ready for the next one
        threading.Thread(target=work, args=(self.index,), daemon=True).start()
        if not self.screensaver:
            self.caption.set_text('%d / %d   %s' % (self.index + 1, len(self.files), os.path.basename(path)))

    def shown(self, index, pb):
        if index != self.index:
            return False
        rot = self.rotation.get(self.files[index], 0)
        if pb and rot:
            pb = pb.rotate_simple(rot)
        if pb:   # to the screen, keeping its shape (a rotated photo is the other way round)
            w, h = self.win.get_size()
            scale = min(w / pb.get_width(), h / pb.get_height())
            if abs(scale - 1) > 0.01:
                pb = pb.scale_simple(max(1, int(pb.get_width() * scale)), max(1, int(pb.get_height() * scale)),
                                     GdkPixbuf.InterpType.BILINEAR)
        self.pixbuf = pb
        self.image.set_from_pixbuf(pb)
        return False

    def start_slideshow(self, announce=True):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
            self.flash('Slideshow stopped')
            return
        self.timer = GLib.timeout_add_seconds(self.interval, self.next_slide)
        if announce:
            self.flash('Slideshow: a photo every %d s   (OK stops it)' % self.interval)

    def next_slide(self):
        if self.screensaver and len(self.files) > 1:
            self.show(random.randrange(len(self.files)))
        else:
            self.show(self.index + 1)
        return True

    def flash(self, text):
        self.caption.set_text(text)
        self.caption.show()
        GLib.timeout_add_seconds(3, self.caption_back)

    def caption_back(self):
        if self.screensaver:
            self.caption.hide()
        else:
            self.caption.set_text('%d / %d   %s' % (self.index + 1, len(self.files),
                                                     os.path.basename(self.files[self.index])))
        return False

    def on_key(self, w, ev):
        if self.screensaver:   # any key: back to what was there
            self.win.destroy()
            return True
        k = Gdk.keyval_name(ev.keyval) or ''
        if k in ('Escape', 'BackSpace', 'q'):
            self.win.destroy()
        elif k in ('Right', 'Page_Down', 'space', 'AudioNext'):
            self.show(self.index + 1)
        elif k in ('Left', 'Page_Up', 'AudioPrev', 'AudioRewind'):
            self.show(self.index - 1)
        elif k in ('Return', 'KP_Enter', 'AudioPlay', 'AudioPause'):
            self.start_slideshow()
        elif k in ('Up', 'Down'):
            path = self.files[self.index]
            self.rotation[path] = (self.rotation.get(path, 0) + (90 if k == 'Up' else 270)) % 360
            self.shown(self.index, self.load(self.index))
        elif k in ('i', 'Tools', 'Menu', 'F2'):
            if self.caption.get_visible():
                self.caption.hide()
            else:
                pb = self.pixbuf
                path = self.files[self.index]
                st = os.stat(path)
                self.caption.set_text('%s   %s   %s   %s' % (os.path.basename(path), human_size(st.st_size),
                                                          time.strftime('%d.%m.%Y %H:%M', time.localtime(st.st_mtime)),
                                                          '%dx%d shown' % (pb.get_width(), pb.get_height()) if pb else ''))
                self.caption.show()
        return True


def photos_in(folder, limit=2000):
    """The photos under folder, a few levels down (for the screensaver)"""
    out = []
    for root, dirs, files in os.walk(folder):
        dirs[:] = [d for d in dirs if not d.startswith('.')]
        if root[len(folder):].count(os.sep) > 4:
            dirs[:] = []
        out += [os.path.join(root, f) for f in files if kind(f) == 'image']
        if len(out) >= limit:
            break
    return out


def screensaver():
    s = saver_settings()
    files = photos_in(s['folder']) if os.path.isdir(s['folder']) else []
    random.shuffle(files)
    Viewer(files, 0, screensaver=True, on_close=Gtk.main_quit)
    Gtk.main()
    return 0


# ---- copying, and what a file is ---------------------------------------------------------------------

def subtitle_files(video):
    """FILM.srt, FILM.ukr.srt... next to FILM.mkv"""
    folder, name = os.path.split(video)
    base = os.path.splitext(name)[0] + '.'
    try:
        return [os.path.join(folder, n) for n in sorted(os.listdir(folder))
                if n.startswith(base) and kind(n) == 'subs']
    except OSError:
        return []


def free_name(folder, name, is_dir=False):
    """name in folder, or "name (2).ext" ("name (2)" for a folder) if it is taken"""
    path = os.path.join(folder, name)
    base, ext = (name, '') if is_dir else os.path.splitext(name)
    n = 2
    while os.path.lexists(path):
        path = os.path.join(folder, '%s (%d)%s' % (base, n, ext))
        n += 1
    return path


class Copier:
    """Copies (or moves) paths into dest in a thread; progress(text) and done(self) in GTK's"""

    CHUNK = 1 << 20

    def __init__(self, paths, dest, move, progress, done):
        self.paths, self.dest, self.move = paths, dest, move
        self.progress_cb, self.done_cb = progress, done
        self.stop = threading.Event()
        self.cancelled = False
        self.error = None
        self.done = 0
        self.last = None
        self.copied = self.total = 0
        self.shown = 0
        threading.Thread(target=self.run, daemon=True).start()

    def cancel(self):
        self.stop.set()

    def tell(self, text):
        GLib.idle_add(self.progress_cb, text)

    def size(self, p):
        if os.path.isdir(p) and not os.path.islink(p):
            return sum(os.path.getsize(os.path.join(r, f)) for r, _d, fs in os.walk(p) for f in fs
                       if not os.path.islink(os.path.join(r, f)))
        return os.path.getsize(p) if not os.path.islink(p) else 0

    def run(self):
        try:
            self.tell('Counting…')
            # a move on the same drive is a rename: nothing to copy
            same = [p for p in self.paths if self.move and os.stat(p).st_dev == os.stat(self.dest).st_dev]
            self.total = sum(self.size(p) for p in self.paths if p not in same)
            for n, p in enumerate(self.paths, 1):
                if self.stop.is_set():
                    break
                target = free_name(self.dest, os.path.basename(p), os.path.isdir(p))
                self.current = '%d/%d %s' % (n, len(self.paths), os.path.basename(p))
                if p in same:
                    os.rename(p, target)
                elif os.path.isdir(p) and not os.path.islink(p):
                    self.copy_tree(p, target)
                    if self.move and not self.stop.is_set():
                        shutil.rmtree(p)
                else:
                    self.copy_file(p, target)
                    if self.move and not self.stop.is_set():
                        os.unlink(p)
                if self.stop.is_set():
                    break
                self.done += 1
                if kind(target) != 'subs':   # what the list can show
                    self.last = target
        except OSError as e:
            self.error = 'Paste stopped: %s%s' % (e.strerror or e, ': %s' % os.path.basename(e.filename) if e.filename else '')
        self.cancelled = self.stop.is_set()
        GLib.idle_add(self.progress_cb, '')
        GLib.idle_add(self.done_cb, self)

    def copy_tree(self, src, dst):
        os.mkdir(dst)
        for name in sorted(os.listdir(src)):
            if self.stop.is_set():
                return
            s, d = os.path.join(src, name), os.path.join(dst, name)
            if os.path.islink(s):
                continue
            if os.path.isdir(s):
                self.copy_tree(s, d)
            else:
                self.copy_file(s, d)

    def copy_file(self, src, dst):
        """In chunks, telling the progress; a file stopped halfway goes"""
        try:
            with open(src, 'rb') as fi, open(dst, 'wb') as fo:
                while True:
                    if self.stop.is_set():
                        raise InterruptedError
                    chunk = fi.read(self.CHUNK)
                    if not chunk:
                        break
                    fo.write(chunk)
                    self.copied += len(chunk)
                    now = time.monotonic()
                    if now - self.shown > 0.4:
                        self.shown = now
                        pct = self.copied * 100 // self.total if self.total else 100
                        self.tell('%s %s: %d %%  (%s of %s)   exit: stop' % (
                            'Moving' if self.move else 'Copying', self.current, pct, human_size(self.copied),
                            human_size(self.total)))
                fo.flush()
                os.fsync(fo.fileno())
        except InterruptedError:
            os.unlink(dst)
            return
        except OSError:
            try:
                os.unlink(dst)
            except OSError:
                pass
            raise
        try:   # times and modes: FAT, exFAT and network folders may refuse them
            shutil.copystat(src, dst)
        except OSError:
            pass


def exif(path):
    """The EXIF tags of a JPEG (or TIFF) worth showing: [(name, value)]"""
    names = {0x010f: 'Camera make', 0x0110: 'Camera model', 0x0112: 'Orientation', 0x0131: 'Software',
             0x0132: 'Changed', 0x9003: 'Taken', 0x829a: 'Exposure', 0x829d: 'F-number', 0x8827: 'ISO',
             0x920a: 'Focal length', 0x9209: 'Flash', 0xa434: 'Lens', 0xa002: 'Width (camera)',
             0xa003: 'Height (camera)'}
    try:
        with open(path, 'rb') as f:
            data = f.read(256 * 1024)
    except OSError:
        return []
    if data[:2] == b'\xff\xd8':   # JPEG: the APP1 segment with "Exif"
        i = 2
        tiff = None
        while i + 4 < len(data) and data[i] == 0xff:
            marker, n = data[i + 1], int.from_bytes(data[i + 2:i + 4], 'big')
            if marker == 0xe1 and data[i + 4:i + 10] == b'Exif\0\0':
                tiff = data[i + 10:i + 2 + n]
                break
            if marker == 0xda:
                break
            i += 2 + n
        if tiff is None:
            return []
    elif data[:4] in (b'II*\0', b'MM\0*'):
        tiff = data
    else:
        return []
    order = 'little' if tiff[:2] == b'II' else 'big'

    def u(off, n):
        return int.from_bytes(tiff[off:off + n], order)
    sizes = {1: 1, 2: 1, 3: 2, 4: 4, 5: 8, 7: 1, 9: 4, 10: 8}
    out, gps = {}, {}

    def value(typ, count, off):
        size = sizes.get(typ, 1) * count
        at = off + 8 if size <= 4 else u(off + 8, 4)
        if typ == 2:
            return tiff[at:at + count].split(b'\0')[0].decode('latin-1', 'replace').strip()
        if typ in (3, 4):
            vals = [u(at + k * sizes[typ], sizes[typ]) for k in range(min(count, 4))]
            return vals[0] if count == 1 else vals
        if typ in (5, 10):
            vals = []
            for k in range(min(count, 3)):
                num, den = u(at + 8 * k, 4), u(at + 8 * k + 4, 4)
                if typ == 10:
                    num = num - (1 << 32) if num >= 1 << 31 else num
                vals.append((num, den))
            return vals[0] if count == 1 else vals
        return None

    def ifd(off, into, depth=0):
        if off <= 0 or off + 2 > len(tiff) or depth > 2:
            return
        for k in range(u(off, 2)):
            e = off + 2 + 12 * k
            if e + 12 > len(tiff):
                return
            tag, typ, count = u(e, 2), u(e + 2, 2), u(e + 4, 4)
            if tag in (0x8769, 0x8825):   # the Exif and GPS sub-IFDs
                ifd(u(e + 8, 4), into if tag == 0x8769 else gps, depth + 1)
            else:
                try:
                    into[tag] = value(typ, count, e)
                except (IndexError, ZeroDivisionError):
                    pass
    try:
        ifd(u(4, 4), out)
    except IndexError:
        return []

    def ratio(r):
        return r[0] / r[1] if isinstance(r, tuple) and r[1] else None
    rows = []
    for tag, name in names.items():
        v = out.get(tag)
        if v is None or v == '':
            continue
        if tag == 0x829a and isinstance(v, tuple) and v[1]:
            v = '1/%d s' % round(v[1] / v[0]) if v[0] and v[0] < v[1] else '%.1f s' % ratio(v)
        elif tag == 0x829d and ratio(v):
            v = 'f/%.1f' % ratio(v)
        elif tag == 0x920a and ratio(v):
            v = '%.0f mm' % ratio(v)
        elif tag == 0x9209 and isinstance(v, int):
            v = 'fired' if v & 1 else 'did not fire'
        elif tag in (0x9003, 0x0132) and isinstance(v, str) and re.match(r'\d{4}:\d\d:\d\d \d', v):
            v = '%s.%s.%s %s' % (v[8:10], v[5:7], v[0:4], v[11:])
        elif tag == 0x0112:
            v = {1: 'normal', 3: 'upside down', 6: 'turned right', 8: 'turned left'}.get(v, v)
        rows.append((name, v))
    if 2 in gps and 4 in gps:
        try:
            def deg(v):
                return sum(ratio(x) / 60 ** i for i, x in enumerate(v))
            lat = deg(gps[2]) * (-1 if gps.get(1) == 'S' else 1)
            lon = deg(gps[4]) * (-1 if gps.get(3) == 'W' else 1)
            rows.append(('Place', '%.5f, %.5f' % (lat, lon)))
        except (TypeError, ZeroDivisionError):
            pass
    return rows


def describe(path, k, resume=None):
    """What a file or folder is, as text for the info dialog"""
    lines = []

    def add(name, value):
        if value not in (None, '', 'N/A'):
            lines.append('%-16s %s' % (name, value))
    try:
        st = os.lstat(path)
    except OSError as e:
        return 'Can\'t read it: %s' % e.strerror
    add('Name', os.path.basename(path))
    add('Folder', os.path.dirname(path))
    if k == 'folder':
        count = size = 0
        for r, _d, fs in os.walk(path):
            for f in fs:
                count += 1
                try:
                    size += os.lstat(os.path.join(r, f)).st_size
                except OSError:
                    pass
            if count > 50000:
                break
        add('Holds', '%d files, %s' % (count, human_size(size)))
    else:
        add('Size', '%s (%d bytes)' % (human_size(st.st_size), st.st_size))
    add('Changed', time.strftime('%d.%m.%Y %H:%M:%S', time.localtime(st.st_mtime)))
    add('Opened', time.strftime('%d.%m.%Y %H:%M:%S', time.localtime(st.st_atime)))
    import stat as stat_
    import pwd
    try:
        owner = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        owner = str(st.st_uid)
    add('Permissions', '%s, %s' % (stat_.filemode(st.st_mode), owner))
    try:
        vfs = os.statvfs(path if k == 'folder' else os.path.dirname(path))
        add('Free on drive', human_size(vfs.f_bavail * vfs.f_frsize))
    except OSError:
        pass
    if k in ('video', 'audio'):
        try:   # ffprobe's JSON, from amplay (the box has no ffprobe)
            r = subprocess.run(['amplay', '--probe', path], capture_output=True, text=True, timeout=20,
                               errors='replace')
            info = json.loads(r.stdout or '{}')
        except (OSError, ValueError, subprocess.TimeoutExpired):
            info = {}
        fmt = info.get('format', {})
        lines.append('')
        add('Format', fmt.get('format_long_name'))
        try:
            if float(fmt.get('duration') or 0) > 0:
                add('Length', clock(float(fmt['duration'])))
            add('Bit rate', '%.2f Mbit/s' % (int(fmt['bit_rate']) / 1e6) if int(fmt.get('bit_rate') or 0) > 0 else None)
        except ValueError:
            pass
        tags = {kk.lower(): v for kk, v in (fmt.get('tags') or {}).items()}
        for t in ('title', 'artist', 'album_artist', 'album', 'track', 'disc', 'date', 'genre', 'composer',
                  'comment', 'encoder', 'creation_time'):
            add(t.replace('_', ' ').capitalize(), tags.get(t))
        for s_ in info.get('streams', []):
            lines.append('')
            t = s_.get('codec_type', '')
            st_tags = s_.get('tags') or {}
            head = '%s %d' % (t.capitalize(), s_.get('index', 0))
            desc = s_.get('codec_long_name') or s_.get('codec_name')
            if s_.get('profile'):
                desc += ', ' + s_['profile']
            add(head, desc)
            if t == 'video':
                fr = s_.get('avg_frame_rate') or s_.get('r_frame_rate') or '0/1'
                try:
                    num, den = (int(x) for x in fr.split('/'))
                    fps = num / den if den else 0
                except ValueError:
                    fps = 0
                add('  picture', '%sx%s%s%s' % (s_.get('width'), s_.get('height'), ', %.3g fps' % fps if fps else '',
                                                 ', %s' % s_['pix_fmt'] if s_.get('pix_fmt') else ''))
                if s_.get('display_aspect_ratio'):
                    add('  shape', s_['display_aspect_ratio'])
            elif t == 'audio':
                add('  sound', '%s Hz, %s' % (s_.get('sample_rate'), s_.get('channel_layout') or
                                             '%s channels' % s_.get('channels')))
            if s_.get('bit_rate'):
                add('  bit rate', '%d kbit/s' % (int(s_['bit_rate']) // 1000))
            add('  language', st_tags.get('language'))
            add('  title', st_tags.get('title'))
        chapters = info.get('chapters', [])
        if chapters:
            lines.append('')
            add('Chapters', len(chapters))
            for c in chapters[:30]:
                add('  ' + clock(float(c.get('start_time', 0))), (c.get('tags') or {}).get('title', ''))
        if resume and resume.get('position', 0) > RESUME_MIN:
            lines.append('')
            add('Stopped at', '%s of %s' % (clock(resume['position']), clock(resume.get('duration'))))
    elif k == 'image':
        lines.append('')
        try:
            fmt, w, h = GdkPixbuf.Pixbuf.get_file_info(path)
            if fmt:
                add('Format', fmt.get_description())
                add('Picture', '%dx%d (%.1f megapixels)' % (w, h, w * h / 1e6))
        except (GLib.Error, TypeError):
            pass
        for name, v in exif(path):
            add(name, v if not isinstance(v, list) else ' '.join(str(x) for x in v))
    return '\n'.join(lines)


# ---- the window -----------------------------------------------------------------------------------

class Window:
    def __init__(self, folder):
        self.state = load_json(STATE, {'resume': {}, 'last': None})
        self.state.setdefault('resume', {})
        self.music = Music()
        self.viewer = None
        self.busy = False
        self.typed = ''
        self.marked = set()       # paths marked (green) for copy, cut, delete
        self.clip = None          # (paths, 'copy' or 'cut') to paste
        self.copier = None        # a paste running
        self.win = Gtk.Window(title='Files')
        self.win.set_default_size(1280, 720)
        self.win.connect('destroy', self.quit)
        self.win.connect('key-press-event', self.on_key)
        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        header = Gtk.Box(spacing=12)
        header.get_style_context().add_class('header')
        header.pack_start(prepare_label('', 'logo'), False, False, 0)
        header.pack_start(prepare_label('Files', 'heading'), False, False, 0)
        self.path_label = prepare_label('', 'path', ellipsize=Pango.EllipsizeMode.START)
        header.pack_start(self.path_label, True, True, 0)
        self.status = prepare_label('', 'status', ellipsize=Pango.EllipsizeMode.MIDDLE, max_width_chars=60)
        header.pack_start(self.status, False, False, 0)
        settings = Gtk.Button(label='Screensaver')
        settings.connect('clicked', lambda w: GLib.idle_add(lambda: self.saver_dialog() and False))
        header.pack_start(settings, False, False, 0)
        close = Gtk.Button(label='', tooltip_text='Close')
        close.get_style_context().add_class('close')
        close.connect('clicked', lambda w: self.win.destroy())
        header.pack_start(close, False, False, 0)
        top.pack_start(header, False, False, 0)

        body = Gtk.Box()
        left = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        left.set_size_request(300, -1)
        left.get_style_context().add_class('places')
        self.places = Gtk.ListBox()
        self.places.connect('row-activated', lambda lb, row: self.open_folder(row.path, focus=True))
        self.places.connect('row-selected', lambda lb, row: row and not self.marking_place and self.open_folder(row.path))
        self.marking_place = False   # the place shown as the current one, not chosen
        left.add(self.places)
        body.pack_start(left, False, False, 0)
        self.scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.list = Gtk.ListBox(activate_on_single_click=False)
        self.list.connect('row-activated', lambda lb, row: self.activate(row))
        self.list.connect('button-press-event', self.on_click)
        self.scroll.add(self.list)
        body.pack_start(self.scroll, True, True, 0)
        top.pack_start(body, True, True, 0)

        # the music playing, with its buttons (the remote reaches them with the arrows)
        self.bar = Gtk.Box(spacing=12)
        self.bar.get_style_context().add_class('playing')
        self.bar.set_no_show_all(True)
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.track = prepare_label('', 'track', ellipsize=Pango.EllipsizeMode.END)
        self.track_detail = prepare_label('', 'detail', ellipsize=Pango.EllipsizeMode.END)
        self.progress = Gtk.ProgressBar()
        for w in (self.track, self.track_detail, self.progress):
            info.pack_start(w, False, False, 0)
        self.bar.pack_start(info, True, True, 0)
        self.buttons = []
        for icon, tip, action in (('', 'Previous', lambda: self.music.cmd('playlist-prev')),
                                  ('', 'Back 10 s', lambda: self.music.cmd('seek', -10)),
                                  ('', 'Pause', lambda: self.music.cmd('cycle', 'pause')),
                                  ('', 'Forward 10 s', lambda: self.music.cmd('seek', 10)),
                                  ('', 'Next', lambda: self.music.cmd('playlist-next')),
                                  ('', 'Stop', self.stop_music)):
            b = Gtk.Button(label=icon, tooltip_text=tip)
            b.get_style_context().add_class('ctl')
            b.connect('clicked', lambda w, a=action: (a(), self.update_music()))
            self.bar.pack_start(b, False, False, 0)
            self.buttons.append(b)
        for w in [info] + self.buttons:
            w.show_all()
        top.pack_start(self.bar, False, False, 0)
        self.hint = prepare_label('OK open   blue: menu   green: mark   red: copy   yellow: paste   info: about it   '
                                  'pause: music   exit: up, close', 'hint', margin_start=16, margin_bottom=6)
        top.pack_start(self.hint, False, False, 0)
        self.win.add(top)
        self.fill_places()
        self.win.show_all()
        self.folder = None
        start = folder or self.state.get('last')
        # the cursor in the list from the start (or on the place, when the folder is empty)
        self.open_folder(start if start and os.path.isdir(start) else (places()[0][1]), focus=True)
        GLib.timeout_add_seconds(1, self.update_music)
        GLib.timeout_add_seconds(5, self.refresh_places)

    # places and folders

    def fill_places(self):
        for r in self.places.get_children():
            r.destroy()
        self.place_list = places()
        for label, path, icon in self.place_list:
            row = Gtk.ListBoxRow()
            row.path = path
            box = Gtk.Box(spacing=10)
            box.pack_start(prepare_label(ICONS.get(icon, ICONS['folder']), 'icon'), False, False, 0)
            box.pack_start(prepare_label(label, 'place', ellipsize=Pango.EllipsizeMode.END), True, True, 0)
            row.add(box)
            self.places.add(row)
        self.places.show_all()

    def refresh_places(self):
        """A drive plugged in or out"""
        if [p[1] for p in places()] != [p[1] for p in self.place_list]:
            self.fill_places()
            if self.folder and self.folder != DLNA and not os.path.isdir(self.folder):
                self.open_folder(HOME)
            else:
                self.mark_place(self.folder)
        return True

    def open_folder(self, path, focus=False, select=None):
        if path == self.folder and not focus and select is None:
            return
        if path != self.folder:
            self.marked.clear()   # marks are of one folder
        self.folder = path
        self.state['last'] = path
        self.path_label.set_text('Media servers (DLNA)' if path == DLNA else path)
        for r in self.list.get_children():
            r.destroy()
        self.rows = []
        try:
            names = [n for n in os.listdir(path) if not n.startswith('.')] if path != DLNA else []
        except OSError as e:
            names = []
            self.empty('Can\'t open this folder: %s' % e.strerror)
        entries = []
        for n in names:
            full = os.path.join(path, n)
            k = kind(full)
            if k == 'subs':
                continue
            entries.append((k != 'folder', natural(n), n, full, k))
        entries.sort()
        parent = os.path.dirname(path.rstrip('/'))
        if path not in [p[1] for p in places()] and parent and parent != path:
            self.add_row(parent, 'up', '..', 'up a folder')
        if path == DLNA:
            self.add_row(DLNA, 'dlna', 'Browse the media servers on the network…',
                         'DLNA: a NAS, Jellyfin, Plex, minidlna, a computer sharing its media')
        for _f, _s, n, full, k in entries:
            self.add_row(full, k, n, None)
        if not entries and names is not None and not self.rows:
            self.empty('Nothing here')
        self.list.show_all()
        for r in self.rows:
            if r.path in self.marked:
                r.check.show()
        self.mark_place(path)
        index = next((i for i, r in enumerate(self.rows) if r.path == select), 0)
        if self.rows:
            self.list.select_row(self.rows[index])
            if focus:
                self.rows[index].grab_focus()
        elif focus and self.places.get_selected_row():   # nothing here: the cursor on the place
            self.places.get_selected_row().grab_focus()
        self.scroll.get_vadjustment().set_value(0)

    def mark_place(self, path):
        """The place the folder is in, highlighted on the left (the deepest one that holds it)"""
        best = None
        for row in self.places.get_children():
            p = getattr(row, 'path', None)
            if p and (path == p or path.startswith(p.rstrip('/') + '/')) and (best is None or len(p) > len(best.path)):
                best = row
        if best is not None and best is not self.places.get_selected_row():
            self.marking_place = True
            self.places.select_row(best)
            self.marking_place = False

    def empty(self, text):
        row = Gtk.ListBoxRow(selectable=False, activatable=False)
        row.add(prepare_label(text, 'empty', wrap=True))
        self.list.add(row)

    def add_row(self, path, k, name, detail):
        row = Gtk.ListBoxRow()
        row.path, row.kind = path, k
        box = Gtk.Box(spacing=12)
        icon = prepare_label(ICONS.get(k, ICONS['file']), 'icon ' + k)
        box.pack_start(icon, False, False, 0)
        row.check = prepare_label('\uf00c', 'mark', no_show_all=True)
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        info.pack_start(prepare_label(name, 'name', ellipsize=Pango.EllipsizeMode.MIDDLE), False, False, 0)
        if detail is None and k != 'folder':
            try:
                st = os.stat(path)
                detail = '%s · %s' % (human_size(st.st_size), time.strftime('%d.%m.%Y', time.localtime(st.st_mtime)))
            except OSError:
                detail = ''
        if detail:
            info.pack_start(prepare_label(detail, 'detail'), False, False, 0)
        r = self.state['resume'].get(path)
        if k == 'video' and r and r.get('position', 0) > RESUME_MIN:
            info.pack_start(prepare_label('Stopped at %s of %s' % (clock(r['position']), clock(r.get('duration'))),
                                          'resume'), False, False, 0)
        box.pack_start(info, True, True, 0)
        box.pack_start(row.check, False, False, 0)
        row.add(box)
        self.list.add(row)
        self.rows.append(row)
        if path in self.marked:
            self.show_mark(row, True)

    def files_of(self, k):
        return [r.path for r in self.rows if r.kind == k]

    # opening

    def activate(self, row, from_start=False):
        if row.kind in ('folder', 'up'):
            self.open_folder(row.path, focus=True, select=self.folder if row.kind == 'up' else None)
        elif row.kind == 'video':
            self.play_video(row.path, from_start)
        elif row.kind == 'audio':
            files = self.files_of('audio')
            self.music.play(files, files.index(row.path))
            self.bar.show()
            GLib.timeout_add(600, self.update_music)
        elif row.kind == 'image':
            self.view_photos(row.path)
        elif row.kind == 'dlna':
            subprocess.Popen(['ozone-dlna', 'browse'])
        else:
            self.flash('Not a video, music or photo')

    def view_photos(self, path, slideshow=False):
        files = self.files_of('image')
        self.viewer = Viewer(files, files.index(path), slideshow=slideshow, on_close=self.viewer_closed)

    def viewer_closed(self):
        self.viewer = None
        self.win.present()

    def play_video(self, path, from_start=False):
        if self.busy:
            return
        self.busy = True
        r = self.state['resume'].get(path, {})
        args = ['amplay', '--report', '--title', os.path.splitext(os.path.basename(path))[0]]
        pos = r.get('position', 0)
        if not from_start and RESUME_MIN < pos < (r.get('duration') or 0) - RESUME_MIN:
            args += ['--start', '%.1f' % pos]
        if 'aid' in r:
            args += ['--aid', str(r['aid'])]
        if 'sid' in r:
            args += ['--sid', str(r['sid'])]
        args += ['--repeat', str(r.get('repeat', self.state.get('repeat', 0)))]
        if self.music.running():
            self.music.cmd('set_property', 'pause', True)
        self.win.hide()

        def run():
            p = subprocess.run(args + [path], capture_output=True, text=True)
            report = dict(line.split(' ', 1) for line in p.stdout.splitlines() if ' ' in line)
            if p.returncode == 3:   # no hardware decoder for it: mpv, in software
                subprocess.call(['amplay', '--reset'])
                subprocess.call(['mpv', '--fs', path])
            else:
                subprocess.call(['amplay', '--reset'])
            GLib.idle_add(self.video_done, path, report)
        threading.Thread(target=run, daemon=True).start()

    def video_done(self, path, report):
        self.busy = False
        self.win.show()
        self.win.present()
        try:
            pos, dur = float(report.get('position', 0)), float(report.get('duration', 0))
            ended, repeat = report.get('ended') == '1', int(report.get('repeat', 0))
            entry = {'position': 0 if ended else pos, 'duration': dur, 'aid': int(report.get('aid', 0)),
                     'sid': int(report.get('sid', -1)), 'repeat': repeat, 'at': time.time()}
            self.state['resume'][path] = entry
            self.state['repeat'] = repeat
            # old entries go: the 500 most recent are kept
            if len(self.state['resume']) > 500:
                for k in sorted(self.state['resume'], key=lambda k: self.state['resume'][k].get('at', 0))[:100]:
                    del self.state['resume'][k]
            save_json(STATE, self.state)
        except (ValueError, KeyError):
            ended, repeat = False, 0
        self.open_folder(self.folder, focus=True, select=path)
        if ended and repeat == 2:   # repeat all: the next video of the folder, round
            videos = self.files_of('video')
            if path in videos:
                nxt = videos[(videos.index(path) + 1) % len(videos)]
                self.state['resume'].pop(nxt, None)
                GLib.timeout_add(500, lambda: self.play_video(nxt, True) and False)
        return False

    # music

    def update_music(self):
        if not self.music.running():
            if self.bar.get_visible() and self.music.p is not None:
                self.music.p = None
                self.bar.hide()
            return True
        title, artist, pos, dur, paused, index = self.music.status()
        if title is None:
            return True
        n = len(self.music.files)
        self.track.set_text(('⏸  ' if paused else '') + str(title))
        self.track_detail.set_text('%s%s%s / %s   ·   %s of %d' % (artist or '', '   ·   ' if artist else '', clock(pos),
                                                                    clock(dur), (index or 0) + 1, n))
        self.progress.set_fraction(min(1, (pos or 0) / dur) if dur else 0)
        self.buttons[2].set_label('' if paused else '')
        return True

    def stop_music(self):
        self.music.stop()
        self.bar.hide()

    # menus and dialogs

    def flash(self, text):
        self.path_label.set_text(text)
        GLib.timeout_add_seconds(3, lambda: self.path_label.set_text('Media servers (DLNA)' if self.folder == DLNA else self.folder or '') and False)

    def on_click(self, w, ev):
        if ev.button == 3:
            row = self.list.get_row_at_y(int(ev.y))
            if row and hasattr(row, 'kind'):
                self.list.select_row(row)
                self.menu(row)
            return True
        return False

    def menu(self, row=None):
        """The file's menu (blue), or the folder's when nothing is chosen"""
        items = []
        kind_ = getattr(row, 'kind', None)
        if kind_ == 'video':
            items += [('Play', lambda: self.activate(row)), ('Play from the start', lambda: self.activate(row, True))]
        elif kind_ == 'audio':
            items += [('Play from here (the whole folder)', lambda: self.activate(row))]
        elif kind_ == 'image':
            items += [('View', lambda: self.activate(row)), ('Slideshow from here', lambda: self.view_photos(row.path, True)),
                      ('Use this folder for the screensaver', lambda: self.saver_folder(os.path.dirname(row.path)))]
        elif kind_ == 'folder':
            items += [('Open', lambda: self.activate(row)),
                      ('Use for the screensaver\'s photos', lambda: self.saver_folder(row.path))]
        if items:
            items.append(None)
        if kind_ and kind_ != 'up':
            n = len(self.chosen(row))
            what = '%d marked' % n if self.marked else 'it'
            items += [('Info  (info)', lambda: self.info(row)),
                      ('Mark  (green)' if row.path not in self.marked else 'Unmark  (green)', lambda: self.toggle_mark(row)),
                      ('Copy %s  (red)' % what, lambda: self.copy(row, 'copy')),
                      ('Cut %s, to move' % what, lambda: self.copy(row, 'cut')),
                      ('Rename…', lambda: self.rename(row))]
        if self.clip:
            items.append(('Paste %d here  (yellow)' % len(self.clip[0]), self.paste))
        items.append(('New folder…', self.new_folder))
        if self.marked:
            items += [('Mark none', self.unmark_all)]
        else:
            items += [('Mark all', self.mark_all)]
        if kind_ and kind_ != 'up':
            items += [None, ('Delete %s…' % ('%d marked' % len(self.marked) if self.marked else 'it'),
                             lambda: self.delete(row))]
        items += [None, ('Screensaver…', self.saver_dialog)]
        m = Gtk.Menu()
        for item in items:
            if item is None:
                m.append(Gtk.SeparatorMenuItem())
                continue
            mi = Gtk.MenuItem(label=item[0])
            # the action once the menu is gone: a dialog run from its handler would get no clicks
            mi.connect('activate', lambda w, a=item[1]: GLib.idle_add(lambda: a() and False))
            m.append(mi)
        m.show_all()
        self._menu = m
        m.attach_to_widget(self.win)
        if row is not None:
            m.popup_at_widget(row, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)
        else:
            m.popup_at_widget(self.scroll, Gdk.Gravity.NORTH_WEST, Gdk.Gravity.NORTH_WEST, None)
        m.select_first(False)

    # marks, copy and paste, rename, new folder

    def chosen(self, row, with_subs=False):
        """What an operation is about: the marked files, else the one chosen; with_subs, a video's
        subtitle files too (the list doesn't show them)"""
        if self.marked:
            paths = [r.path for r in self.rows if r.path in self.marked]
        else:
            paths = [row.path] if row is not None and getattr(row, 'kind', 'up') not in ('up', 'dlna') else []
        if with_subs:
            for p in list(paths):
                if kind(p) == 'video':
                    paths += [s_ for s_ in subtitle_files(p) if s_ not in paths]
        return paths

    def current(self):
        row = self.list.get_selected_row()
        return row if row is not None and hasattr(row, 'kind') else None

    def show_mark(self, row, on):
        row.check.set_visible(on)
        (row.get_style_context().add_class if on else row.get_style_context().remove_class)('marked')

    def toggle_mark(self, row, step=False):
        if row is None or row.kind in ('up', 'dlna'):
            return
        on = row.path not in self.marked
        (self.marked.add if on else self.marked.discard)(row.path)
        self.show_mark(row, on)
        self.say('%d marked' % len(self.marked) if self.marked else 'None marked')
        if step:   # on to the next, as with the remote's green over a list
            i = self.rows.index(row)
            if i + 1 < len(self.rows):
                self.list.select_row(self.rows[i + 1])
                self.rows[i + 1].grab_focus()

    def mark_all(self):
        for r in self.rows:
            if r.kind != 'up':
                self.marked.add(r.path)
                self.show_mark(r, True)
        self.say('%d marked' % len(self.marked))

    def unmark_all(self):
        for r in self.rows:
            self.show_mark(r, False)
        self.marked.clear()
        self.say('None marked')

    def copy(self, row, mode):
        paths = self.chosen(row, with_subs=True)
        if not paths:
            return
        self.clip = (paths, mode)
        n = len([p for p in paths if kind(p) != 'subs'])
        self.unmark_all()
        self.say('%s %d: open another folder and paste (yellow)' % ('Copied' if mode == 'copy' else 'Cut', n))

    def paste(self):
        if not self.clip:
            self.say('Nothing to paste: copy (red) first')
            return
        if self.copier:
            self.say('Still pasting the last ones')
            return
        paths, mode = self.clip
        dest = self.folder
        if dest == DLNA:
            self.say('Paste into a folder of the box')
            return
        for p in paths:
            if os.path.isdir(p) and (dest == p or dest.startswith(p.rstrip('/') + '/')):
                self.say('A folder can\'t go into itself')
                return
        if mode == 'cut':
            self.clip = None   # moved: the originals are gone
        self.copier = Copier(paths, dest, mode == 'cut', self.paste_progress, self.paste_done)

    def paste_progress(self, text):
        self.status.set_text(text)
        return False

    def paste_done(self, copier):
        self.copier = None
        if copier.error:
            self.say(copier.error, 8)
        elif copier.cancelled:
            self.say('Stopped: %d of %d done' % (copier.done, len(copier.paths)), 6)
        else:
            n = sum(1 for p in copier.paths[:copier.done] if kind(p) != 'subs')   # not the subtitles that went along
            self.say('%s %d' % ('Moved' if copier.move else 'Pasted', n))
        if self.folder == copier.dest or any(os.path.dirname(p) == self.folder for p in copier.paths):
            # the list again, the cursor where it was (it may have moved on since): on what was
            # pasted only if it was still on ".."
            row = self.current()
            keep = row.path if row is not None and row.kind != 'up' and os.path.exists(row.path) else None
            self.open_folder(self.folder, focus=True, select=keep or copier.last)
        return False

    def ask(self, title, prompt, text=''):
        """A name from the viewer (the remote's text key brings the on-screen keyboard), or None"""
        d = Gtk.Dialog(title=title, transient_for=self.win, modal=True)
        d.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'OK', Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        box = d.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        box.add(prepare_label(prompt))
        e = Gtk.Entry(text=text, activates_default=True, width_chars=50)
        box.add(e)
        box.add(prepare_label('text on the remote: the on-screen keyboard   OK: done   exit: cancel', 'hint'))
        d.show_all()
        # the name without its extension chosen, so typing replaces just that
        base, ext = os.path.splitext(text)
        e.select_region(0, len(base) if ext and len(ext) <= 6 else -1)
        r = d.run()
        value = e.get_text().strip()
        d.destroy()
        return value if r == Gtk.ResponseType.OK and value else None

    def bad_name(self, name):
        return name in ('.', '..') or '/' in name or '\0' in name

    def new_folder(self):
        if self.folder == DLNA:
            return
        name = self.ask('New folder', 'The new folder\'s name, in %s:' % self.folder, 'New folder')
        if not name:
            return
        if self.bad_name(name):
            self.say('A name can\'t have "/" in it')
            return
        path = os.path.join(self.folder, name)
        try:
            os.mkdir(path)
        except OSError as e:
            self.say('No folder made: %s' % e.strerror)
            return
        self.open_folder(self.folder, focus=True, select=path)

    def rename(self, row):
        if row is None or row.kind in ('up', 'dlna'):
            return
        old = row.path
        name = self.ask('Rename', 'The new name of %s:' % os.path.basename(old), os.path.basename(old))
        if not name or name == os.path.basename(old):
            return
        if self.bad_name(name):
            self.say('A name can\'t have "/" in it')
            return
        new = os.path.join(os.path.dirname(old), name)
        if os.path.exists(new):
            self.say('There is a "%s" already' % name)
            return
        try:
            os.rename(old, new)
        except OSError as e:
            self.say('Not renamed: %s' % e.strerror)
            return
        if row.kind == 'video':   # its subtitles and a TV recording's description go along
            ob, nb = os.path.splitext(old)[0], os.path.splitext(new)[0]
            for side in subtitle_files(old) + [p_ for p_ in [ob + '.json'] if os.path.exists(p_)]:
                try:
                    os.rename(side, nb + side[len(ob):])
                except OSError:
                    pass
        if old in self.state['resume']:
            self.state['resume'][new] = self.state['resume'].pop(old)
            save_json(STATE, self.state)
        self.marked.discard(old)
        self.open_folder(self.folder, focus=True, select=new)

    def say(self, text, seconds=4):
        self.status.set_text(text)
        if getattr(self, 'say_timer', None):
            GLib.source_remove(self.say_timer)
        self.say_timer = GLib.timeout_add_seconds(seconds, self.say_done)

    def say_done(self):
        self.say_timer = None
        if not self.copier:
            self.status.set_text('')
        return False

    # info

    def info(self, row):
        if row is None or row.kind in ('up', 'dlna'):
            return
        path = row.path
        self.say('Reading %s…' % os.path.basename(path))

        def work():
            text = describe(path, row.kind, self.state['resume'].get(path))
            GLib.idle_add(self.show_info, os.path.basename(path), text)
        threading.Thread(target=work, daemon=True).start()

    def show_info(self, name, text):
        self.status.set_text('')
        d = Gtk.Dialog(title=name, transient_for=self.win, modal=True)
        d.add_buttons('Close', Gtk.ResponseType.CLOSE)
        d.set_default_size(900, 600)
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        lb = prepare_label(text, 'infotext', wrap=True, selectable=False, yalign=0, margin=16)
        sw.add(lb)
        d.get_content_area().pack_start(sw, True, True, 0)

        def keys(w, ev):   # the arrows and page+ / page- scroll
            k = Gdk.keyval_name(ev.keyval) or ''
            adj = sw.get_vadjustment()
            step = {'Up': -40, 'Down': 40, 'Page_Up': -adj.get_page_size(), 'Page_Down': adj.get_page_size()}.get(k)
            if step is None:
                return False
            adj.set_value(adj.get_value() + step)
            return True
        d.connect('key-press-event', keys)
        d.show_all()
        d.run()
        d.destroy()
        return False

    def confirm(self, text):
        d = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.OK_CANCEL, text=text)
        r = d.run()
        d.destroy()
        return r == Gtk.ResponseType.OK

    def delete(self, row):
        paths = self.chosen(row)
        subs = self.chosen(row, with_subs=True)[len(paths):]
        if not paths:
            return
        if len(paths) == 1:
            name = os.path.basename(paths[0])
            what = 'the folder "%s" and everything in it' % name if os.path.isdir(paths[0]) else '"%s"' % name
        else:
            what = 'these %d (folders with everything in them)' % len(paths)
        if not self.confirm('Delete %s?' % what):
            return
        errors = []
        for p in paths:
            try:
                if os.path.isdir(p) and not os.path.islink(p):
                    shutil.rmtree(p)
                else:
                    os.unlink(p)
                    if kind(p) == 'video' and os.path.exists(os.path.splitext(p)[0] + '.json'):
                        os.unlink(os.path.splitext(p)[0] + '.json')   # a TV recording's description
                self.state['resume'].pop(p, None)
            except OSError as e:
                errors.append('%s: %s' % (os.path.basename(p), e.strerror))
        for p in subs:   # the video's subtitles go with it
            try:
                os.unlink(p)
            except OSError:
                pass
        save_json(STATE, self.state)
        self.marked.clear()
        if errors:
            self.say('Not deleted: ' + '; '.join(errors), 8)
        self.open_folder(self.folder, focus=True)

    def saver_folder(self, path):
        s = saver_settings()
        s['folder'] = path
        save_json(SAVER_CONF, s)
        self.flash('Screensaver photos: %s' % path)

    def saver_dialog(self):
        s = saver_settings()
        d = Gtk.Dialog(title='Screensaver', transient_for=self.win, modal=True)
        d.add_buttons('Try it', 1, 'Close', Gtk.ResponseType.CLOSE)
        g = Gtk.Grid(column_spacing=16, row_spacing=10, border_width=16)
        d.get_content_area().add(g)
        on = Gtk.Switch(active=s['enabled'], halign=Gtk.Align.START)
        minutes = Gtk.SpinButton.new_with_range(1, 120, 1)
        minutes.set_value(s['minutes'])
        seconds = Gtk.SpinButton.new_with_range(2, 120, 1)
        seconds.set_value(s['seconds'])
        folder = Gtk.Entry(text=s['folder'], hexpand=True)
        rows = (('On', on), ('After this many minutes without a key', minutes), ('Each photo for (s)', seconds),
                ('Photos from', folder))
        for n, (text, w) in enumerate(rows):
            g.attach(prepare_label(text), 0, n, 1, 1)
            g.attach(w, 1, n, 1, 1)
        g.attach(prepare_label('Not while a video, music or a game plays. Without photos in the folder it is a '
                               'clock. The blue key on a folder or a photo chooses the folder too.', 'hint',
                               wrap=True, max_width_chars=60), 0, len(rows), 2, 1)
        d.show_all()
        while True:
            r = d.run()
            s.update(enabled=on.get_active(), minutes=minutes.get_value_as_int(), seconds=seconds.get_value_as_int(),
                     folder=folder.get_text().strip() or SAVER_DEFAULTS['folder'])
            save_json(SAVER_CONF, s)
            if r != 1:
                break
            d.hide()
            subprocess.Popen([sys.argv[0], '--screensaver'])
            break
        d.destroy()

    # keys

    def on_key(self, w, ev):
        """The remote has everything: the arrows, OK, exit, page+ / page-, and the colored keys"""
        k = Gdk.keyval_name(ev.keyval) or ''
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        shift = ev.state & Gdk.ModifierType.SHIFT_MASK
        focus = self.win.get_focus()
        in_list = focus is not None and focus.get_parent() is self.list
        in_places = focus is not None and focus.get_parent() is self.places
        in_bar = focus in self.buttons
        row = focus if in_list and hasattr(focus, 'kind') else self.current()
        if k in ('AudioPlay', 'AudioPause', 'space') and self.music.running() and not in_bar:
            self.music.cmd('cycle', 'pause')
            self.update_music()
            return True
        if k == 'AudioStop' and self.music.running():
            self.stop_music()
            return True
        if k == 'AudioRewind' and self.music.running():
            self.music.cmd('seek', -10)
            return True
        if k in ('Menu', 'F10', 'Launch4'):   # blue
            self.menu(row if in_list or not in_places else None)
            return True
        if k in ('Launch2', 'Insert'):   # green
            self.toggle_mark(row, step=True)
            return True
        if k == 'Launch1' or (ctrl and k in ('c', 'C')):   # red
            self.copy(row, 'copy')
            return True
        if ctrl and k in ('x', 'X'):
            self.copy(row, 'cut')
            return True
        if k == 'Launch3' or (ctrl and k in ('v', 'V')):   # yellow
            self.paste()
            return True
        if k in ('Tools', 'i') or (k == 'Return' and ev.state & Gdk.ModifierType.MOD1_MASK):   # info
            self.info(row)
            return True
        if k == 'F2':
            self.rename(row)
            return True
        if k == 'Delete':
            self.delete(row)
            return True
        if ctrl and shift and k in ('n', 'N'):
            self.new_folder()
            return True
        if ctrl and k in ('a', 'A'):
            self.mark_all()
            return True
        if k == 'Right' and in_places:
            row = self.list.get_selected_row() or (self.rows[0] if self.rows else None)
            if row:
                row.grab_focus()
            return True
        if k == 'Left' and not in_places:   # from the files, or from wherever the focus was
            self.mark_place(self.folder)
            row = self.places.get_selected_row() or (self.places.get_children() or [None])[0]
            if row is not None:
                row.grab_focus()
            return True
        # the music's buttons: down from the end of the list, up or exit back into it
        if k == 'Down' and in_list and self.bar.get_visible() and self.rows and focus is self.rows[-1]:
            self.buttons[2].grab_focus()
            return True
        if k in ('Up', 'Escape', 'BackSpace') and in_bar:
            target = self.list.get_selected_row() or (self.rows[-1] if self.rows else self.places)
            target.grab_focus()
            return True
        if k in ('Escape', 'BackSpace'):   # exit: stop pasting, unmark, up a folder, the places, close
            if self.copier:
                if self.confirm('Stop pasting?'):
                    self.copier.cancel()
                return True
            if self.marked:
                self.unmark_all()
                return True
            parent = os.path.dirname(self.folder.rstrip('/'))
            if in_list and self.folder not in [p[1] for p in self.place_list] and parent:
                self.open_folder(parent, focus=True, select=self.folder)
            elif in_list:
                self.mark_place(self.folder)
                (self.places.get_selected_row() or self.places).grab_focus()
            else:
                self.win.destroy()
            return True
        return False

    def quit(self, w):
        if self.copier:
            self.copier.cancel()
        self.music.stop()
        save_json(STATE, self.state)
        Gtk.main_quit()


def main(argv):
    GLib.set_prgname('ozone-files')
    # GTK's CSS parser loses the first number of the first stylesheet to a stale errno (see yt)
    try:
        Gtk.CssProvider().load_from_data(b'* { padding: 0px; }')
    except GLib.Error:
        pass
    css = Gtk.CssProvider()
    css.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    if argv[1:2] == ['--screensaver']:
        return screensaver()
    if argv[1:] and not os.path.isdir(argv[1]):
        sys.exit(__doc__)
    Window(argv[1] if argv[1:] else None)
    Gtk.main()
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
