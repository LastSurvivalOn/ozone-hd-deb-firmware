const state = document.getElementById('state');
function post(path, body) {
  return fetch(path, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)})
    .then(r => { state.textContent = r.ok ? '' : 'The box refused it'; })
    .catch(() => { state.textContent = 'No connection to the box'; });
}
document.querySelectorAll('.tabs button').forEach(b => b.onclick = () => {
  document.querySelectorAll('.tabs button').forEach(x => x.classList.toggle('on', x === b));
  ['keys','mouse','type'].forEach(t => document.getElementById(t).classList.toggle('hidden', t !== b.dataset.tab));
});
document.querySelectorAll('[data-k]').forEach(b => {
  const k = b.dataset.k;
  const down = e => { e.preventDefault(); b.classList.add('held'); if (navigator.vibrate) navigator.vibrate(12); post('/key', {key:k, down:1}); };
  const up = e => { e.preventDefault(); if (!b.classList.contains('held')) return; b.classList.remove('held'); post('/key', {key:k, down:0}); };
  b.addEventListener('pointerdown', down); b.addEventListener('pointerup', up);
  b.addEventListener('pointercancel', up); b.addEventListener('pointerleave', up);
});
const pad = document.getElementById('touch');
let last = null, moved = 0, fingers = 0, acc = {x:0, y:0}, t0 = 0, timer = null;
function flush() { timer = null; if (acc.x || acc.y) { post('/move', {dx:Math.round(acc.x), dy:Math.round(acc.y), scroll:fingers > 1}); acc = {x:0, y:0}; } }
pad.addEventListener('touchstart', e => { e.preventDefault(); fingers = e.touches.length; const t = e.touches[0]; last = {x:t.clientX, y:t.clientY}; moved = 0; t0 = Date.now(); });
pad.addEventListener('touchmove', e => { e.preventDefault(); const t = e.touches[0]; const dx = t.clientX - last.x, dy = t.clientY - last.y;
  last = {x:t.clientX, y:t.clientY}; moved += Math.abs(dx) + Math.abs(dy); const f = fingers > 1 ? 0.15 : 2.2;
  acc.x += dx * f; acc.y += dy * f; if (!timer) timer = setTimeout(flush, 40); });
pad.addEventListener('touchend', e => { e.preventDefault(); if (e.touches.length) return; if (moved < 8 && Date.now() - t0 < 300) post('/click', {button: fingers > 1 ? 'right' : 'left'}); fingers = 0; });
document.getElementById('lclick').onclick = () => post('/click', {button:'left'});
document.getElementById('rclick').onclick = () => post('/click', {button:'right'});
document.getElementById('send').onclick = () => { const t = document.getElementById('text'); if (t.value) post('/type', {text:t.value}).then(() => t.value = ''); };
</script></body></html>
