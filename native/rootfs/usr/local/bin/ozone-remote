class PhoneServer:
    """The page and its requests, in a thread; what they do happens in GTK's (the Remote)"""

    def __init__(self, remote):
        import http.server
        self.remote = remote
        self.held = {}   # key -> repeat timer
        server = self

        class Handler(http.server.BaseHTTPRequestHandler):
            def log_message(self, *args):
                pass

            def allowed(self):
                try:
                    ip = ipaddress.ip_address(self.client_address[0])
                except ValueError:
                    return False
                if getattr(ip, 'ipv4_mapped', None):
                    ip = ip.ipv4_mapped
                return ip.is_private or ip.is_loopback   # the home network only

            def reply(self, code, body=b'', ctype='text/plain'):
                self.send_response(code)
                self.send_header('Content-Type', ctype)
                self.send_header('Content-Length', str(len(body)))
                self.send_header('Cache-Control', 'no-store')
                self.end_headers()
                self.wfile.write(body)

            def do_GET(self):
                if not self.allowed():
                    return self.reply(403)
                if self.path in ('/', '/index.html'):
                    return self.reply(200, PHONE_PAGE.encode(), 'text/html; charset=utf-8')
                self.reply(404)

            def do_POST(self):
                if not self.allowed():
                    return self.reply(403)
                try:
                    n = int(self.headers.get('Content-Length') or 0)
                    data = json.loads(self.rfile.read(min(n, 65536)) or b'{}')
                except ValueError:
                    return self.reply(400)
                ok = server.handle(self.path, data)
                self.reply(200 if ok else 400)

        class Server(http.server.ThreadingHTTPServer):
            daemon_threads = True
            allow_reuse_address = True
        try:
            self.httpd = Server(('0.0.0.0', PHONE_PORT), Handler)
        except OSError as e:
            log('phone remote: port %d: %s' % (PHONE_PORT, e))
            return
        threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
        log('phone remote on port %d' % PHONE_PORT)

    def handle(self, path, data):
        r = self.remote
        if path == '/key':
            name = PHONE_KEYS.get(str(data.get('key')))
            if not name:
                return False
            code = getattr(E, name)
            down = bool(data.get('down'))
            GLib.idle_add(self.key, name, code, down)
            return True
        if path == '/move':
            dx, dy = int(data.get('dx', 0)), int(data.get('dy', 0))
            if data.get('scroll'):
                if dy:
                    GLib.idle_add(lambda: r.mouse.emit((E.EV_REL, E.REL_WHEEL, -1 if dy > 0 else 1)) and False)
            else:
                GLib.idle_add(lambda: r.mouse.emit((E.EV_REL, E.REL_X, dx), (E.EV_REL, E.REL_Y, dy)) and False)
            return True
        if path == '/click':
            button = E.BTN_RIGHT if data.get('button') == 'right' else E.BTN_LEFT
            GLib.idle_add(lambda: (r.mouse.key(button, 1), r.mouse.key(button, 0)) and False)
            return True
        if path == '/type':
            text = str(data.get('text', ''))[:2000]
            if text:
                Keyboard.xdotool('type', '--clearmodifiers', '--', text)
            return True
        return False

    def key(self, name, code, down):
        """A press and its release from the page, as the IR remote's (held: repeats as it does)"""
        timer = self.held.pop(name, None)
        if timer:
            GLib.source_remove(timer)
        if down:
            self.remote.key(code, 1)
            if name in REPEATS:
                self.held[name] = GLib.timeout_add(400, self.repeat, name, code, True)
            else:   # a release that never comes (the phone's page closed) can't leave it down
                self.held[name] = GLib.timeout_add(8000, self.key, name, code, False)
        else:
            self.remote.key(code, 0)
        return False

    def repeat(self, name, code, first):
        if name not in self.held:
            return False
        self.remote.key(code, 2)
        if first:   # every 110 ms from now on, for 30 s at most
            self.held[name] = GLib.timeout_add(110, self.repeat, name, code, False)
            GLib.timeout_add(30000, self.key, name, code, False)
            return False
        return True


class Gamepads:
    """Gamepads as remotes: their buttons go through Remote.key as the remote's would. They are
    read alongside whoever else reads them (not grabbed), and ignored while RetroArch runs. No udev
    here: the devices are looked for every few seconds (a Bluetooth pad comes and goes)."""
    LOOK = 3            # s between looks for new gamepads
    STICK = 0.6         # of the way to the edge: a stick pushed that far is an arrow

    def __init__(self, remote):
        self.remote = remote
        self.pads = {}            # path: (device, watch)
        self.held = {}            # (path, axis): the arrow it holds down
        self.games_at = 0
        self.games = False
        self.look()
        GLib.timeout_add_seconds(self.LOOK, self.look)

    def look(self):
        for path in list_devices():
            if path in self.pads:
                continue
            try:
                dev = InputDevice(path)
            except OSError:
                continue
            caps = dev.capabilities()
            if E.BTN_SOUTH not in caps.get(E.EV_KEY, []) or dev.name.startswith(('ozone-', 'aml_')):
                dev.close()
                continue
            log('gamepad %s (%s)' % (path, dev.name))
            watch = GLib.io_add_watch(dev.fd, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_ERR | GLib.IO_HUP,
                                      self.on_input, path)
            self.pads[path] = (dev, watch)
        return True

    def drop(self, path):
        dev, _watch = self.pads.pop(path)
        for key in [k for k in self.held if k[0] == path]:
            self.remote.key(self.held.pop(key), 0)
        try:
            dev.close()
        except OSError:   # 3.10: an unplugged device fails even that (see kbd-merge)
            pass
        log('gamepad %s gone' % path)

    def playing(self):
        """RetroArch runs: the pad is the game's (asked at most once a second)"""
        now = time.monotonic()
        if now - self.games_at > 1:
            self.games_at = now
            self.games = Remote.running('retroarch')
        return self.games

    def on_input(self, fd, cond, path):
        dev = self.pads[path][0]
        if cond & (GLib.IO_ERR | GLib.IO_HUP):
            self.drop(path)
            return False
        try:
            events = list(dev.read())
        except BlockingIOError:
            return True
        except OSError:
            self.drop(path)
            return False
        if self.playing():
            return True
        for ev in events:
            try:
                if ev.type == E.EV_KEY and ev.code in PAD_KEYS and ev.value in (0, 1):
                    self.remote.key(PAD_KEYS[ev.code], ev.value)
                elif ev.type == E.EV_ABS:
                    self.axis(dev, path, ev.code, ev.value)
            except Exception as e:   # never stop
                log('gamepad event %d %d: %r' % (ev.type, ev.code, e))
        return True

    def axis(self, dev, path, code, value):
        if code in (E.ABS_HAT0X, E.ABS_HAT0Y):
            where = (value > 0) - (value < 0)
        elif code in (E.ABS_X, E.ABS_Y):
            info = dev.absinfo(code)
            mid = (info.max + info.min) / 2
            half = (info.max - info.min) / 2 or 1
            pos = (value - mid) / half
            where = 1 if pos > self.STICK else -1 if pos < -self.STICK else 0
        else:
            return
        horizontal = code in (E.ABS_HAT0X, E.ABS_X)
        arrow = {(True, -1): E.KEY_LEFT, (True, 1): E.KEY_RIGHT, (False, -1): E.KEY_UP,
                 (False, 1): E.KEY_DOWN}.get((horizontal, where))
        key = (path, code)
        if self.held.get(key) == arrow:
            return
        if key in self.held:
            self.remote.key(self.held.pop(key), 0)
        if arrow:
            self.held[key] = arrow
            self.remote.key(arrow, 1)


def main():
    if daemon_pid():
        sys.exit('%s is already running' % NAME)
    try:
        Gtk.CssProvider().load_from_data(b'* { padding: 0px; }')   # see yt: the first stylesheet's
    except GLib.Error:                                             # first number fails to parse
        pass
    css = Gtk.CssProvider()
    css.load_from_data(OSK_CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    remote = Remote()
    PhoneServer(remote)
    Gamepads(remote)
    try:
        Gtk.main()
    finally:
        remote.release_all()
        remote.mouse_mode = False
        remote.osk.win.hide()
        remote.changed()
        log('stopped')


if __name__ == '__main__':
    main()
