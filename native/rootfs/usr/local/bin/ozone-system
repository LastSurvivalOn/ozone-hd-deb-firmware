#!/usr/bin/python3
"""ozone-system: updates, backups, restoring them and the factory reset, from the box itself.

  ozone-system [updates|backup|restore|reset]   the window, at that section ("Updates" and
                                                "Backup and reset" in the apps menu)
  ozone-system check                            (bspwmrc) looks for updates 10 minutes after the
                                                start, then once a day, and says on the panel when
                                                there are some
  ozone-system root COMMAND ...                 the work, as root (sudo -n): its progress on stdout

Updates: the Debian packages (apt-get upgrade, with sysvinit kept), yt-dlp (YouTube) and the box's
own scripts from GitHub (REPO's main branch: native/update.py of the new tree brings the box up to
it, keeping the user's own changes to their files). Before installing, a backup of the whole system
can be made on the box, to go back to.

Backups go to a USB drive or SD card (its folder ozone-backups) or to the box's own storage
(/mnt/nand/linux/backups), each with a .json beside it saying what it is:
- the settings (a .tar.gz of a few MB): the hidden files of the home folder (the programs'
  settings, TV channels, the browser's data, the calendar...) and the system's settings below
  (WiFi networks, the network, Bluetooth pairings, network folders, VPN, display and sound);
- the whole system (a .tar.zst of the root filesystem, ~0.7 GB): restoring it makes a new
  debian.img next to the one in use, and renames it over that one: the running system keeps its
  own (the loop device holds it) until the restart, which starts the restored one.
Restoring settings and the factory reset happen at the next start, before anything uses the files
(/etc/init.d/ozone-system runs "ozone-system root pending"); both first back up the settings as
they are onto the box, so they can be undone. The reset keeps the user's files (or erases them too)
and ~/.ssh, and puts back the files install-desktop.sh installed (/usr/local/share/ozone/dotfiles).
"""
import calendar
import json
import os
import pwd
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import threading
import time
import urllib.error
import urllib.request

REPO = 'LastSurvivalOn/ozone-hd-deb-firmware'
BRANCH = 'main'
SELF = '/usr/local/bin/ozone-system'
NAND = '/mnt/nand/linux'
IMAGE = NAND + '/debian.img'
NAND_BACKUPS = NAND + '/backups'
FOLDER = 'ozone-backups'
STATE = '/var/lib/ozone'
PENDING = STATE + '/pending.json'
PENDING_SETTINGS = STATE + '/pending-settings.tar.gz'
UPDATE_CACHE = '/var/cache/ozone-update'
PRISTINE = '/usr/local/share/ozone/dotfiles'
HOME = os.path.expanduser('~')
CACHE = os.path.join(os.environ.get('XDG_CACHE_HOME') or os.path.join(HOME, '.cache'), 'ozone-system')
CHECKED = os.path.join(CACHE, 'updates.json')
LOG = '/var/log/ozone-system.log'

# the system's settings, kept in a settings backup and put back by the reset (deleted: the tools
# fall back to their defaults)
SYSTEM_SETTINGS = ['/etc/ozone/display', '/etc/ozone/screen', '/etc/ozone/network.json', '/etc/ozone/proxy',
                   '/etc/ozone/hotspot.json', '/etc/ozone/shares.json', '/etc/ozone/alsaequal.bin',
                   '/etc/ozone/vpn', '/etc/wpa_supplicant/ozone.conf', '/var/lib/bluetooth', '/etc/ozone/share.json']
SYSTEM_KEPT = ['/etc/timezone', '/etc/localtime', '/etc/environment', '/etc/apt/apt.conf.d/80ozone-proxy',
               '/etc/ppp/pap-secrets', '/etc/ppp/chap-secrets']
# the home's hidden entries a settings backup leaves out, and the reset leaves alone
HOME_SKIP = {'.cache', '.dbus', '.Xauthority', '.xsession-errors', '.local/share/Trash', '.thumbnails'}
HOME_KEEP = {'.ssh'}
HOME_FOLDERS = ['Videos', 'Music', 'Pictures', 'Downloads']
BIG = 100 << 20    # a settings backup skips files bigger than this
# the whole system leaves out what isn't on the root filesystem or is made anew
SYSTEM_EXCLUDE = ['./proc/*', './sys/*', './dev/*', './run/*', './tmp/*', './mnt/*', './media/*', './system/*',
                  './var/tmp/*', './var/cache/apt/archives/*.deb', './var/cache/apt/*.bin', './home/*/.cache/*',
                  './root/.cache/*', './var/cache/ozone-update/*', './var/lib/ozone/pending*']
MOUNTPOINTS = {'proc': 0o555, 'sys': 0o555, 'dev': 0o755, 'run': 0o755, 'tmp': 0o1777, 'mnt': 0o755,
               'media': 0o755, 'system': 0o755}


def human(n):
    n = float(n)
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if n < 1024 or unit == 'TB':
            return ('%.0f %s' if unit in ('B', 'KB') or n >= 100 else '%.1f %s') % (n, unit)
        n /= 1024


def read(path, default=''):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def native():
    return subprocess.call(['/etc/ozone/is-native'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0 \
        and os.path.exists(IMAGE)


def box_backups():
    """Where "on the box" is: the NAND beside debian.img, or (under Android) inside Debian"""
    return NAND_BACKUPS if os.path.isdir(NAND) else STATE + '/backups'


def free(path):
    while not os.path.exists(path):
        path = os.path.dirname(path)
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize


def drives():
    """The writable mounts in /media: [(path, name)]"""
    out = []
    try:
        with open('/proc/mounts') as f:
            for line in f:
                dev, mnt, fs, opts = line.split()[:4]
                mnt = mnt.replace('\\040', ' ')
                if mnt.startswith('/media/') and 'rw' in opts.split(','):
                    out.append((mnt, os.path.basename(mnt)))
    except OSError:
        pass
    return sorted(out)


def places():
    """Where backups can go: [(folder, name)]"""
    out = [(box_backups(), 'On the box')]
    out += [(os.path.join(m, FOLDER), 'Drive ' + name) for m, name in drives()]
    return out


def place_name(path):
    if path.startswith(box_backups()):
        return 'on the box'
    m = re.match(r'/media/([^/]+)/', path)
    return 'drive ' + m.group(1) if m else os.path.dirname(path)


def backups():
    """Every backup found: [info] newest first; info has path, kind, made, bytes, note, auto"""
    out = []
    for folder, _name in places():
        try:
            names = os.listdir(folder)
        except OSError:
            continue
        for n in names:
            m = re.match(r'ozone-(settings|system)-(\d{8}-\d{6})\.tar\.(gz|zst)$', n)
            if not m:
                continue
            path = os.path.join(folder, n)
            info = {}
            try:
                with open(path + '.json') as f:
                    info = json.load(f)
            except (OSError, ValueError):
                pass
            info.setdefault('kind', m.group(1))
            if 'made' not in info:
                info['made'] = calendar.timegm(time.strptime(m.group(2), '%Y%m%d-%H%M%S')) + time.timezone
            try:
                info['bytes'] = os.path.getsize(path)
            except OSError:
                continue
            info['path'] = path
            out.append(info)
    return sorted(out, key=lambda i: -i['made'])


def installed_commit():
    c = read('/etc/ozone/commit')
    if c:
        return c
    m = re.match(r'([0-9a-f]{7,40})\b', read('/etc/ozone/version'))
    return m.group(1) if m else ''


# ---- the work, as root ----------------------------------------------------------------------------

CLEANUP = []    # half-made files a stopped worker deletes


def on_term(signum, frame):
    for p in CLEANUP:
        try:
            os.unlink(p)
        except OSError:
            pass
    os._exit(1)


def out(*words):
    print(' '.join(str(w) for w in words), flush=True)


def progress(frac, text=''):
    out('progress', '%.3f' % frac, text)


def fail(text):
    out('error', text)
    sys.exit(1)


def user_home(user):
    pw = pwd.getpwnam(user)
    return pw.pw_dir, pw.pw_uid, pw.pw_gid


def stamp():
    return time.strftime('%Y%m%d-%H%M%S')


def sidecar(path, info):
    with open(path + '.json.tmp', 'w') as f:
        json.dump(info, f, indent=1)
    os.replace(path + '.json.tmp', path + '.json')


def finish(tmp, path):
    with open(tmp, 'rb+') as f:
        os.fsync(f.fileno())
    os.replace(tmp, path)
    subprocess.call(['sync'])


def home_filter(home):
    def f(ti):
        rel = ti.name.split('/', 1)[1] if '/' in ti.name else ''
        if any(rel == s or rel.startswith(s + '/') for s in HOME_SKIP):
            return None
        if not (ti.isfile() or ti.isdir() or ti.issym()):
            return None
        if ti.isfile() and ti.size > BIG:
            out('log', 'left out (too big for a settings backup): ~/%s, %s' % (rel, human(ti.size)))
            return None
        return ti
    return f


def backup_settings(folder, user, note='', auto=False):
    home, _uid, _gid = user_home(user)
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, 'ozone-settings-%s.tar.gz' % stamp())
    tmp = path + '.part'
    CLEANUP.append(tmp)
    progress(-1, 'the settings')
    info = {'kind': 'settings', 'made': time.time(), 'version': read('/etc/ozone/version'), 'note': note,
            'auto': auto, 'user': user}
    try:
        with tarfile.open(tmp, 'w:gz', compresslevel=6, format=tarfile.PAX_FORMAT) as tar:
            data = json.dumps(info, indent=1).encode()
            ti = tarfile.TarInfo('ozone-backup.json')
            ti.size, ti.mtime = len(data), time.time()
            import io
            tar.addfile(ti, io.BytesIO(data))
            filt = home_filter(home)
            for entry in sorted(os.listdir(home)):
                if entry.startswith('.') and entry not in HOME_SKIP:
                    tar.add(os.path.join(home, entry), 'home/' + entry, filter=filt)
            for p in SYSTEM_SETTINGS + SYSTEM_KEPT:
                if os.path.lexists(p):
                    tar.add(p, 'root' + p)
        finish(tmp, path)
    except Exception as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        fail('The backup failed: %s' % e)
    info['bytes'] = os.path.getsize(path)
    sidecar(path, info)
    out('log', 'settings: %s, %s' % (path, human(info['bytes'])))
    return path


def prune(folder, kind, keep):
    """Deletes the oldest automatic backups of a kind beyond keep"""
    old = [b for b in backups() if b['path'].startswith(folder + '/') and b['kind'] == kind and b.get('auto')]
    for b in old[keep:]:
        delete(b['path'])


def pump(src, dst, total, text, start=0.0, span=1.0):
    """Copies a pipe into another, saying how far it got"""
    n = 0
    last = 0
    while True:
        chunk = src.read(1 << 20)
        if not chunk:
            break
        dst.write(chunk)
        n += len(chunk)
        if n - last > 8 << 20:
            last = n
            progress(start + span * min(0.99, n / total) if total else -1, '%s: %s' % (text, human(n)))
    return n


def backup_system(folder, note='', auto=False):
    if not native():
        fail('The whole system can be backed up only in native Linux (not under Android).')
    st = os.statvfs('/')
    used = (st.f_blocks - st.f_bfree) * st.f_frsize
    need = int(used * 0.5)
    if auto:
        prune(folder, 'system', 0)
    if free(folder) < need + (300 << 20):
        fail('Not enough space %s: it needs about %s, %s is free.' % (place_name(folder + '/x'), human(need),
                                                                       human(free(folder))))
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, 'ozone-system-%s.tar.zst' % stamp())
    tmp = path + '.part'
    CLEANUP.append(tmp)
    progress(0, 'the whole system')
    subprocess.call(['sync'])
    cmd = ['tar', '--create', '--one-file-system', '--numeric-owner', '--xattrs', '--xattrs-include=*',
           '--warning=no-file-changed', '--warning=no-file-ignored', '--warning=no-file-removed', '-C', '/']
    cmd += ['--exclude=' + e for e in SYSTEM_EXCLUDE] + ['.']
    with open(tmp, 'wb') as f:
        tar = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        zst = subprocess.Popen(['zstd', '-1', '-T4', '-q', '-c'], stdin=subprocess.PIPE, stdout=f)
        err = []
        t = threading.Thread(target=lambda: err.append(tar.stderr.read()), daemon=True)
        t.start()
        try:
            n = pump(tar.stdout, zst.stdin, used, 'the whole system')
        except BrokenPipeError:
            n = 0
        zst.stdin.close()
        tar.wait()
        zst.wait()
        t.join(5)
    # tar's 1 is "some files changed while read": logs, which is fine
    if tar.returncode not in (0, 1) or zst.returncode != 0:
        os.unlink(tmp)
        msg = (err[0].decode(errors='replace').strip().splitlines() or [''])[-1] if err else ''
        fail('The backup failed (tar %s, zstd %s): %s' % (tar.returncode, zst.returncode, msg))
    finish(tmp, path)
    info = {'kind': 'system', 'made': time.time(), 'version': read('/etc/ozone/version'), 'note': note,
            'auto': auto, 'size': n, 'bytes': os.path.getsize(path)}
    sidecar(path, info)
    out('log', 'the whole system: %s, %s' % (path, human(info['bytes'])))
    return path


def delete(path):
    path = os.path.realpath(path)
    if os.path.basename(os.path.dirname(path)) not in (FOLDER, 'backups') or \
            not re.match(r'ozone-(settings|system)-[\d-]+\.tar\.(gz|zst)$', os.path.basename(path)):
        fail('Not a backup: %s' % path)
    for p in (path, path + '.json'):
        try:
            os.unlink(p)
        except FileNotFoundError:
            pass
    subprocess.call(['sync'])


def write_pending(info):
    os.makedirs(STATE, exist_ok=True)
    with open(PENDING + '.tmp', 'w') as f:
        json.dump(info, f)
    os.replace(PENDING + '.tmp', PENDING)
    subprocess.call(['sync'])


def restore(path, user):
    kind = 'system' if path.endswith('.tar.zst') else 'settings'
    if kind == 'settings':
        progress(-1, 'first the settings as they are now, onto the box')
        prune(box_backups(), 'settings', 4)
        backup_settings(box_backups(), user, 'before restoring the settings of %s' % time.strftime('%d.%m.%Y'), True)
        shutil.copyfile(path, PENDING_SETTINGS + '.tmp')
        os.replace(PENDING_SETTINGS + '.tmp', PENDING_SETTINGS)
        write_pending({'action': 'restore-settings', 'user': user, 'from': path})
        out('restart', 'reboot')
        return
    restore_system(path)
    out('restart', 'reboot')


def fs_layout(dev):
    """The running root's ext4 features, for an image the stock kernel mounts as it does this one"""
    r = subprocess.run(['dumpe2fs', '-h', dev], capture_output=True, text=True)
    info = {}
    for line in r.stdout.splitlines():
        if ':' in line:
            k, v = line.split(':', 1)
            info[k.strip()] = v.strip()
    features = [f for f in info.get('Filesystem features', '').split() if f not in ('needs_recovery',)]
    if 'has_journal' not in features or 'extent' not in features:
        fail('Could not read how the system disk is made (dumpe2fs %s).' % dev)
    return features, info.get('Inode size', '256'), info.get('Inode count'), info.get('Block size', '4096')


def root_device():
    """The loop device debian.img is on (/proc/mounts starts with the initramfs' rootfs on /)"""
    r = subprocess.run(['losetup', '-j', IMAGE], capture_output=True, text=True)
    return r.stdout.split(':')[0] if r.stdout.startswith('/dev/') else '/dev/loop0'


def restore_system(path, test=False):
    if not native():
        fail('The whole system can be restored only in native Linux (not under Android).')
    try:
        with open(path + '.json') as f:
            size = json.load(f).get('size') or 0
    except (OSError, ValueError):
        size = 0
    size = size or os.path.getsize(path) * 3
    # the files, their last blocks, and ext4's journal and inode tables; less than that would end in
    # "no space" halfway, which changes nothing either
    need = size * 1.08 + (100 << 20)
    if free(NAND) < need:
        fail('Not enough space on the box to restore it: it needs about %s, %s is free. Delete a backup kept '
             'on the box (blue on it), or restore from a drive.' % (human(need), human(free(NAND))))
    new = IMAGE + '.new'
    mnt = '/run/ozone-restore'
    features, isize, icount, bsize = fs_layout(root_device())
    progress(0, 'a new system disk')
    for p in (new,):
        if os.path.exists(p):
            os.unlink(p)
    with open(new, 'wb') as f:
        f.truncate(os.path.getsize(IMAGE))
    cmd = ['mke2fs', '-q', '-F', '-t', 'ext4', '-O', 'none,' + ','.join(features), '-b', bsize, '-I', isize, '-m', '0']
    if icount:
        cmd += ['-N', icount]
    if subprocess.call(cmd + [new]) != 0:
        os.unlink(new)
        fail('Could not make the new system disk (mke2fs).')
    loop = subprocess.run(['losetup', '-f', '--show', new], capture_output=True, text=True).stdout.strip()
    if not loop:
        os.unlink(new)
        fail('No free loop device for the new system disk.')
    os.makedirs(mnt, exist_ok=True)
    ok = False
    try:
        if subprocess.call(['mount', '-t', 'ext4', loop, mnt]) != 0:
            fail('Could not mount the new system disk.')
        try:
            zst = subprocess.Popen(['zstd', '-d', '-q', '-c', path], stdout=subprocess.PIPE)
            tar = subprocess.Popen(['tar', '--extract', '--numeric-owner', '--xattrs', '--xattrs-include=*', '-p',
                                    '-C', mnt], stdin=subprocess.PIPE, stderr=subprocess.PIPE)
            err = []
            t = threading.Thread(target=lambda: err.append(tar.stderr.read()), daemon=True)
            t.start()
            try:
                pump(zst.stdout, tar.stdin, size, 'restoring', 0.02, 0.9)
            except BrokenPipeError:
                pass
            tar.stdin.close()
            zst.wait()
            tar.wait()
            t.join(5)
            if zst.returncode != 0 or tar.returncode != 0:
                msg = (err[0].decode(errors='replace').strip().splitlines() or [''])[-1] if err else ''
                fail('Restoring failed (zstd %s, tar %s): %s' % (zst.returncode, tar.returncode, msg))
            for name, mode in MOUNTPOINTS.items():
                p = os.path.join(mnt, name)
                if not os.path.isdir(p):
                    os.mkdir(p, mode)
            os.makedirs(os.path.join(mnt, 'mnt/nand'), exist_ok=True)
            for need in ('sbin/init', 'etc/fstab', 'etc/inittab', 'lib/modules/3.10.33', 'usr/local/lib/ozone'):
                if not os.path.exists(os.path.join(mnt, need)):
                    fail('The backup has no %s: not a whole system of this box. Nothing was changed.' % need)
            ok = True
        finally:
            subprocess.call(['umount', mnt])
    finally:
        subprocess.call(['losetup', '-d', loop])
        if not ok and os.path.exists(new):
            os.unlink(new)
    progress(0.95, 'checking the new system disk')
    r = subprocess.run(['e2fsck', '-f', '-n', new], capture_output=True, text=True)
    if r.returncode != 0:
        os.unlink(new)
        fail('The new system disk did not check out (e2fsck %d). Nothing was changed.' % r.returncode)
    if test:   # root restore-test: all but the last step
        os.unlink(new)
        out('log', 'the test went through; nothing was changed')
        return
    subprocess.call(['sync'])
    # the system running now keeps its own disk through the loop device until the restart
    os.replace(new, IMAGE)
    subprocess.call(['sync'])
    out('log', 'the restored system starts at the next start')


def reset(mode, user):
    progress(-1, 'first the settings as they are now, onto the box')
    prune(box_backups(), 'settings', 4)
    backup_settings(box_backups(), user, 'before the reset of %s' % time.strftime('%d.%m.%Y'), True)
    write_pending({'action': 'reset', 'mode': mode, 'user': user})
    out('restart', 'reboot')


def remove(path):
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path, ignore_errors=True)
    elif os.path.lexists(path):
        os.unlink(path)


def safe_dest(base, rel):
    """base/rel when nothing on the way there is a symbolic link (a crafted backup can't write
    elsewhere)"""
    parts = [p for p in rel.split('/') if p not in ('', '.')]
    if not parts or '..' in parts:
        return None
    d = base
    for p in parts[:-1]:
        d = os.path.join(d, p)
        if os.path.islink(d):
            return None
    return os.path.join(base, *parts)


def allowed_system(path):
    return any(path == p or path.startswith(p + '/') for p in SYSTEM_SETTINGS + SYSTEM_KEPT)


def unpack_settings(archive, user):
    home, uid, gid = user_home(user)
    with tarfile.open(archive, 'r:gz') as tar:
        for m in tar:
            if m.name.startswith('home/'):
                dest, owner = safe_dest(home, m.name[5:]), (uid, gid)
            elif m.name.startswith('root/') and allowed_system('/' + m.name[5:]):
                dest, owner = safe_dest('/', m.name[5:]), (m.uid, m.gid)
            else:
                continue
            if not dest:
                out('log', 'skipped %s' % m.name)
                continue
            try:
                if m.isdir():
                    if os.path.lexists(dest) and not os.path.isdir(dest):
                        remove(dest)
                    os.makedirs(dest, exist_ok=True)
                elif m.isfile():
                    if os.path.isdir(dest) and not os.path.islink(dest):
                        remove(dest)
                    os.makedirs(os.path.dirname(dest), exist_ok=True)
                    tmp = dest + '.ozone-restore'
                    with tar.extractfile(m) as src, open(tmp, 'wb') as f:
                        shutil.copyfileobj(src, f)
                    os.replace(tmp, dest)
                elif m.issym():
                    remove(dest)
                    os.makedirs(os.path.dirname(dest), exist_ok=True)
                    os.symlink(m.linkname, dest)
                else:
                    continue
                os.lchown(dest, *owner)
                if not m.issym():
                    os.chmod(dest, m.mode & 0o7777)
                    os.utime(dest, (m.mtime, m.mtime))
            except OSError as e:
                out('log', 'could not restore %s: %s' % (m.name, e))


def do_reset(mode, user):
    home, uid, gid = user_home(user)
    for entry in os.listdir(home):
        if entry in HOME_KEEP:
            continue
        if entry.startswith('.') or mode == 'all':
            remove(os.path.join(home, entry))
    if mode == 'all' and os.path.isdir(NAND + '/Recordings'):
        for n in os.listdir(NAND + '/Recordings'):
            remove(os.path.join(NAND, 'Recordings', n))
    # Debian's own (.bashrc, .profile), then the files install-desktop.sh installed
    subprocess.call(['cp', '-a', '--no-preserve=ownership', '/etc/skel/.', home + '/'])
    if os.path.isdir(PRISTINE):
        subprocess.call(['cp', '-a', '--no-preserve=ownership', PRISTINE + '/.', home + '/'])
    for d in HOME_FOLDERS:
        os.makedirs(os.path.join(home, d), exist_ok=True)
    subprocess.call(['chown', '-R', '%d:%d' % (uid, gid), home])
    for p in SYSTEM_SETTINGS:
        if p in ('/etc/ozone/vpn', '/var/lib/bluetooth') and os.path.isdir(p):
            for n in os.listdir(p):
                remove(os.path.join(p, n))
        else:
            remove(p)
    with open('/etc/timezone', 'w') as f:
        f.write('Europe/Kyiv\n')
    remove('/etc/localtime')
    os.symlink('/usr/share/zoneinfo/Europe/Kyiv', '/etc/localtime')
    # the proxy's files from no proxy, the sound's from no settings
    for tool in (['/usr/local/lib/ozone/net-apply', 'proxy'], ['/usr/local/lib/ozone/sound-config']):
        if os.path.exists(tool[0]):
            subprocess.call(tool, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def pending():
    """At the start (/etc/init.d/ozone-system), before the programs that use the files"""
    try:
        with open(PENDING) as f:
            job = json.load(f)
    except (OSError, ValueError):
        return
    # once only, even if it fails halfway
    os.replace(PENDING, PENDING + '.done')
    subprocess.call(['sync'])
    out('log', '%s: %s' % (time.strftime('%F %T'), json.dumps(job)))
    if job.get('action') == 'restore-settings' and os.path.exists(PENDING_SETTINGS):
        unpack_settings(PENDING_SETTINGS, job['user'])
        os.unlink(PENDING_SETTINGS)
    elif job.get('action') == 'reset':
        do_reset(job.get('mode', 'settings'), job['user'])
    subprocess.call(['sync'])
    out('log', 'done')


def apt_env():
    return dict(os.environ, DEBIAN_FRONTEND='noninteractive', LC_ALL='C')


def check_init():
    r = subprocess.run(['dpkg', '-S', '/sbin/init'], capture_output=True, text=True)
    if 'sysvinit-core' not in r.stdout:
        fail('/sbin/init is not sysvinit any more: do NOT restart the box. Reinstall sysvinit-core '
             '(sudo apt-get install sysvinit-core) first.')


def apt_check():
    progress(-1, 'asking Debian what is new')
    r = subprocess.run(['apt-get', 'update', '-q'], env=apt_env(), stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, text=True)
    if r.returncode != 0:
        fail('apt-get update failed: %s' % (r.stdout.strip().splitlines() or [''])[-1])
    r = subprocess.run(['apt-get', '-s', '-q', '--no-install-recommends', 'upgrade'], env=apt_env(),
                       capture_output=True, text=True)
    n = 0
    for line in r.stdout.splitlines():
        m = re.match(r'Inst (\S+) \[([^\]]+)\] \((\S+)', line)
        if m:
            out('pkg', m.group(1), m.group(2), m.group(3))
            n += 1
    out('count', n)


def apt_upgrade():
    check_init()
    cmd = ['apt-get', '-y', '-q', '--no-install-recommends', '-o', 'APT::Status-Fd=1',
           '-o', 'Dpkg::Options::=--force-confdef', '-o', 'Dpkg::Options::=--force-confold', 'upgrade']
    p = subprocess.Popen(cmd, env=apt_env(), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    upgraded = []
    for line in p.stdout:
        line = line.rstrip()
        m = re.match(r'(dlstatus|pmstatus):([^:]*):([\d.]+):(.*)', line)
        if m:
            pct = float(m.group(3)) / 100
            frac = pct * 0.3 if m.group(1) == 'dlstatus' else 0.3 + pct * 0.7
            progress(frac, m.group(4))
            continue
        m = re.match(r'Unpacking (\S+?)(:\S+)? ', line)
        if m:
            upgraded.append(m.group(1))
        if line.startswith(('E:', 'W:')):
            out('log', line)
    p.wait()
    if p.returncode != 0:
        fail('apt-get upgrade failed (%d): see /var/log/apt/term.log' % p.returncode)
    check_init()
    subprocess.call(['apt-get', 'clean'])
    out('log', 'Debian: %d packages updated' % len(upgraded))
    if any(u.startswith(('libwebkit2gtk', 'libjavascriptcoregtk')) for u in upgraded) and \
            os.path.isdir('/usr/local/lib/ozone-webkit'):
        out('warn', "WebKit was updated: the browser's own WebKit should be rebuilt on a computer "
                    '(native/install-webkit.sh) for the same fixes')
    if upgraded:
        out('restart', 'reboot')


def ytdlp():
    progress(-1, 'yt-dlp')
    r = subprocess.run(['/usr/local/bin/yt-dlp', '-U'], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in r.stdout.strip().splitlines()[-2:]:
        out('log', 'yt-dlp: ' + line)


def ozone_update(sha, date, user):
    if not re.match(r'^[0-9a-f]{40}$', sha):
        fail('Not a commit: %s' % sha)
    shutil.rmtree(UPDATE_CACHE, ignore_errors=True)
    os.makedirs(UPDATE_CACHE)
    url = 'https://codeload.github.com/%s/tar.gz/%s' % (REPO, sha)
    progress(-1, 'downloading the box software')
    archive = os.path.join(UPDATE_CACHE, 'src.tar.gz')
    try:
        with urllib.request.urlopen(url, timeout=60) as r, open(archive, 'wb') as f:
            n = 0
            while True:
                chunk = r.read(1 << 16)
                if not chunk:
                    break
                f.write(chunk)
                n += len(chunk)
                if n % (1 << 20) < (1 << 16):
                    progress(-1, 'downloading the box software: %s' % human(n))
    except (OSError, urllib.error.URLError) as e:
        fail('Could not download %s: %s' % (url, e))
    tree = os.path.join(UPDATE_CACHE, 'tree')
    with tarfile.open(archive, 'r:gz') as tar:
        for m in tar:
            parts = m.name.split('/')
            if m.name.startswith('/') or '..' in parts or not (m.isfile() or m.isdir() or m.issym()):
                continue
            if m.issym() and (m.linkname.startswith('/') or '..' in m.linkname.split('/')):
                continue
            tar.extract(m, tree, set_attrs=m.isfile() or m.isdir())
    tops = os.listdir(tree)
    native_dir = os.path.join(tree, tops[0], 'native') if len(tops) == 1 else ''
    script = os.path.join(native_dir, 'update.py')
    if not os.path.isfile(script):
        fail('The download has no native/update.py.')
    progress(-1, 'installing')
    p = subprocess.Popen(['python3', '-I', script, '--native', native_dir, '--user', user, '--commit', sha,
                          '--date', date], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in p.stdout:
        line = line.rstrip()
        if line.startswith('@@ '):
            progress(-1, line[3:])
            out('log', line[3:])
        elif line.startswith('!! '):
            out('warn', line[3:])
        elif line.startswith('== '):
            if line[3:] in ('reboot', 'desktop'):
                out('restart', line[3:])
        elif line.strip():
            out('log', line.strip())
    p.wait()
    shutil.rmtree(UPDATE_CACHE, ignore_errors=True)
    if p.returncode != 0:
        fail('The update stopped (update.py %d).' % p.returncode)


def root_main(args):
    if os.geteuid() != 0:
        fail('ozone-system root needs root (sudo)')
    os.umask(0o022)
    signal.signal(signal.SIGTERM, on_term)
    cmd, rest = args[0], args[1:]
    if cmd == 'backup-settings':
        backup_settings(rest[0], rest[1], *(rest[2:3] or ['']))
    elif cmd == 'backup-system':
        backup_system(rest[0], *(rest[1:2] or ['']), auto=len(rest) > 1)
    elif cmd == 'restore':
        restore(rest[0], rest[1])
    elif cmd == 'reset':
        if rest[0] not in ('settings', 'all'):
            fail('reset settings|all USER')
        reset(rest[0], rest[1])
    elif cmd == 'restore-test':
        restore_system(rest[0], test=True)
    elif cmd == 'delete':
        delete(rest[0])
    elif cmd == 'pending':
        pending()
    elif cmd == 'apt-check':
        apt_check()
    elif cmd == 'apt-upgrade':
        apt_upgrade()
    elif cmd == 'ytdlp':
        ytdlp()
    elif cmd == 'update':
        ozone_update(rest[0], rest[1], rest[2])
    else:
        fail('unknown: %s' % cmd)
    out('done', '')


# ---- looking for updates (as the user) ------------------------------------------------------------

def github(path):
    req = urllib.request.Request('https://api.github.com/repos/%s' % path,
                                 headers={'Accept': 'application/vnd.github+json', 'User-Agent': 'ozone-system'})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def check_box_software():
    """{'state': 'new' | 'same' | 'newer' | 'apart' | 'unknown' | 'error', 'commits': [...], ...}"""
    have = installed_commit()
    if not have:
        return {'state': 'unknown', 'text': 'The box does not know its version'}
    try:
        c = github('%s/compare/%s...%s' % (REPO, have, BRANCH))
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return {'state': 'unknown', 'text': 'This version (%s) is not on GitHub: it was installed from a '
                                                'computer. Updates come from there.' % have[:7]}
        return {'state': 'error', 'text': 'GitHub: %s' % e}
    except (OSError, ValueError) as e:
        return {'state': 'error', 'text': 'GitHub could not be reached: %s' % getattr(e, 'reason', e)}
    status = c.get('status')
    commits = [{'sha': x['sha'], 'title': x['commit']['message'].split('\n')[0],
                'date': x['commit']['committer']['date']} for x in c.get('commits', [])]
    if status == 'ahead' and commits:
        head = commits[-1]
        d = time.strptime(head['date'][:10], '%Y-%m-%d')
        return {'state': 'new', 'commits': commits[::-1], 'sha': head['sha'], 'date': time.strftime('%d.%m.%Y', d),
                'text': '%d changes' % len(commits)}
    if status in ('identical', 'behind'):
        return {'state': 'same', 'text': 'Up to date'}
    return {'state': 'apart', 'text': 'The box has changes GitHub hasn\'t: update it from the computer'}


def check_ytdlp():
    try:
        have = subprocess.run(['/usr/local/bin/yt-dlp', '--version'], capture_output=True, text=True,
                              timeout=30).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        have = ''
    try:
        latest = github('yt-dlp/yt-dlp/releases/latest').get('tag_name', '')
    except (OSError, ValueError):
        latest = ''
    return {'have': have, 'latest': latest, 'new': bool(have and latest and latest > have)}


def check_debian():
    p = subprocess.run(['sudo', '-n', SELF, 'root', 'apt-check'], capture_output=True, text=True)
    pkgs = []
    error = ''
    for line in p.stdout.splitlines():
        w = line.split()
        if w[:1] == ['pkg'] and len(w) >= 4:
            pkgs.append({'name': w[1], 'old': w[2], 'new': w[3]})
        elif w[:1] == ['error']:
            error = line[6:]
    if p.returncode != 0 and not error:
        error = (p.stderr.strip().splitlines() or ['sudo failed'])[-1]
    return {'packages': pkgs, 'error': error}


def check_all():
    result = {'time': time.time(), 'box': check_box_software(), 'ytdlp': check_ytdlp(), 'debian': check_debian()}
    os.makedirs(CACHE, exist_ok=True)
    with open(CHECKED + '.tmp', 'w') as f:
        json.dump(result, f)
    os.replace(CHECKED + '.tmp', CHECKED)
    return result


def load_checked():
    try:
        with open(CHECKED) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def updates_count(r):
    if not r:
        return 0
    return len(r['debian'].get('packages', [])) + (1 if r['ytdlp'].get('new') else 0) + \
        (len(r['box'].get('commits', [])) and 1 if r['box'].get('state') == 'new' else 0)


def check_service():
    time.sleep(600)
    while True:
        try:
            r = check_all()
            if updates_count(r):
                subprocess.call(['ozone-notify', ' Updates are ready'],
                                stderr=subprocess.DEVNULL)
        except Exception as e:   # the network may be down: try again tomorrow
            print('check failed: %r' % e, file=sys.stderr, flush=True)
        time.sleep(86400)


# ---- the window -----------------------------------------------------------------------------------

