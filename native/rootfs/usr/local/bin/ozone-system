SECTIONS = [('updates', '', 'Updates'), ('backup', '', 'Back up'), ('restore', '', 'Restore'),
            ('reset', '', 'Reset')]
BLUE = ('Launch4', 'Delete')


def setup_gtk():
    global Gdk, GLib, Gtk, Pango
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gdk, GLib, Gtk, Pango
    # GTK's CSS parser loses the first number of the first stylesheet to a stale errno (see yt)
    try:
        Gtk.CssProvider().load_from_data(b'* { padding: 0px; }')
    except GLib.Error:
        pass
    style = Gtk.CssProvider()
    style.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), style,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def label(text='', cls=None, **kw):
    kw.setdefault('xalign', 0)
    w = Gtk.Label(label=text, **kw)
    for c in (cls or '').split():
        w.get_style_context().add_class(c)
    return w


def classes(widget, *names, on=True):
    ctx = widget.get_style_context()
    for n in names:
        (ctx.add_class if on else ctx.remove_class)(n)


def hint_markup(pairs):
    colours = {'red': '#f38ba8', 'green': '#a6e3a1', 'yellow': '#f9e2af', 'blue': '#89b4fa'}
    parts = []
    for keys, what in pairs:
        k = GLib.markup_escape_text(keys)
        for name, c in colours.items():
            k = k.replace(name, '<span foreground="%s">●</span> %s' % (c, name))
        parts.append('<b>%s</b>  %s' % (k, GLib.markup_escape_text(what)))
    return '      '.join(parts)


class Row:
    def __init__(self, key, title, sub='', icon='', options=None, value=None, enabled=True):
        self.key, self.title, self.sub, self.icon = key, title, sub, icon
        self.options, self.value, self.enabled = options, value, enabled


class Window:
    def __init__(self, section):
        self.user = pwd.getpwuid(os.getuid()).pw_name
        self.section = [s[0] for s in SECTIONS].index(section) if section in [s[0] for s in SECTIONS] else 0
        self.focus = 'rows'
        self.chosen = 0
        self.armed = None
        self.job = None           # the running work: {'title', 'proc', 'stoppable'}
        self.checking = False
        self.checked = load_checked()
        self.backup_first = True
        self.place = 0
        self.message = ('', '')   # (class, text) under the rows
        self.restart = None
        self.lines = []

        self.win = Gtk.Window(title='Updates and backups')
        self.win.set_default_size(1280, 720)
        self.win.connect('delete-event', self.on_delete)
        self.win.connect('destroy', Gtk.main_quit)
        self.win.connect('key-press-event', self.on_key)
        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        header = Gtk.Box(spacing=12)
        classes(header, 'header')
        header.pack_start(label('', 'logo'), False, False, 0)
        header.pack_start(label('Updates and backups', 'heading'), False, False, 0)
        self.status = label('', 'status', ellipsize=Pango.EllipsizeMode.END)
        header.pack_start(self.status, True, True, 0)
        close = Gtk.Button(label='', tooltip_text='Close (exit)', can_focus=False)
        classes(close, 'close')
        close.connect('clicked', lambda w: self.close())
        header.pack_start(close, False, False, 0)
        top.pack_start(header, False, False, 0)
        body = Gtk.Box()
        self.side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, width_request=220)
        classes(self.side, 'sections')
        self.section_rows = []
        for i, (_key, icon, name) in enumerate(SECTIONS):
            ev = Gtk.EventBox(visible_window=False)
            box = Gtk.Box(spacing=10)
            classes(box, 'section')
            box.pack_start(label(icon, 'icon', xalign=0.5), False, False, 0)
            box.pack_start(label(name, 'name'), False, False, 0)
            ev.add(box)
            ev.connect('button-press-event', lambda w, e, i=i: self.click_section(i))
            self.side.pack_start(ev, False, False, 0)
            self.section_rows.append(box)
        body.pack_start(self.side, False, False, 0)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, can_focus=False)
        self.scroll = scroll
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        classes(self.content, 'content')
        scroll.add(self.content)
        body.pack_start(scroll, True, True, 0)
        top.pack_start(body, True, True, 0)
        self.hints = label('', 'hints', use_markup=True)
        top.pack_start(self.hints, False, False, 0)
        self.win.add(top)
        self.win.show_all()
        self.render()
        if SECTIONS[self.section][0] == 'updates' and (not self.checked or time.time() - self.checked['time'] > 3600):
            self.check()
        GLib.timeout_add_seconds(5, self.tick)

    # -- the sections' rows

    def rows(self):
        key = SECTIONS[self.section][0]
        if self.job:
            return []
        if self.restart:
            if self.restart == 'reboot':
                return [Row('reboot', 'Restart the box now', 'needed for everything to take effect', ''),
                        Row('later', 'Later', 'the next time the box starts', '')]
            return [Row('desktop', 'Restart the desktop now', 'the programs start again with the new version; '
                                   'open windows close', ''),
                    Row('later', 'Later', '', '')]
        if key == 'updates':
            n = updates_count(self.checked)
            rows = [Row('check', 'Look for updates', 'Debian, YouTube (yt-dlp) and the box software', '')]
            if n:
                rows.append(Row('install', 'Install the updates', self.updates_summary(), ''))
                if native():
                    rows.append(Row('first', 'First back up the whole system on the box',
                                    'about 2 minutes and 0.7 GB: Restore takes the box back to it if '
                                    'something goes wrong', '', ['Yes', 'No'], 0 if self.backup_first else 1))
            return rows
        if key == 'backup':
            ps = places()
            self.place = min(self.place, len(ps) - 1)
            folder = ps[self.place][0]
            opts = ['%s (%s free)' % (name, human(free(f))) for f, name in ps]
            rows = [Row('place', 'Where', 'a USB drive or SD card plugged in, or the box itself', '',
                        opts, self.place),
                    Row('settings', 'Back up the settings',
                        'WiFi and network, Bluetooth devices, TV channels and timers, the browser, the '
                        'calendar, every program\'s settings: a few MB, seconds', '')]
            if native():
                rows.append(Row('system', 'Back up the whole system',
                                'everything installed and set up, to start again from: about 0.7 GB, 2 minutes',
                                ''))
            n = len([b for b in backups() if b['path'].startswith(folder + '/')])
            if n:
                self.message = ('text', '%d backup%s there already (Restore lists them).' % (n, '' if n == 1 else 's'))
            return rows
        if key == 'restore':
            rows = []
            for b in backups():
                what = 'The settings' if b['kind'] == 'settings' else 'The whole system'
                sub = '%s, %s' % (place_name(b['path']), human(b['bytes']))
                if b.get('note'):
                    sub += ', ' + b['note']
                if b.get('version'):
                    sub += ' · version ' + b['version'].split(',')[0]
                rows.append(Row(b['path'], '%s of %s' % (what, time.strftime('%d.%m.%Y %H:%M',
                                                                           time.localtime(b['made']))),
                                sub, '' if b['kind'] == 'settings' else ''))
            return rows
        if key == 'reset':
            return [Row('reset-settings', 'Reset the settings',
                        'as after installing: WiFi networks, Bluetooth devices, TV channels, the browser\'s '
                        'data and every setting go. Videos, music, photos, downloads, code, games and TV '
                        'recordings stay.', ''),
                    Row('reset-all', 'Erase everything',
                        'the settings and your files too: the home folder and the TV recordings. Backups stay.',
                        '')]
        return []

    def updates_summary(self):
        r = self.checked
        parts = []
        if r['debian'].get('packages'):
            parts.append('%d Debian packages' % len(r['debian']['packages']))
        if r['ytdlp'].get('new'):
            parts.append('yt-dlp %s' % r['ytdlp']['latest'])
        if r['box'].get('state') == 'new':
            parts.append('the box software: %s' % r['box']['text'])
        return ', '.join(parts)

    def info(self):
        """The text above the rows: [(class, text)]"""
        key = SECTIONS[self.section][0]
        if self.job:
            return []
        if self.restart:
            return [('title', 'Done'), ('text', 'Restart the %s for it to take effect.' %
                                        ('box' if self.restart == 'reboot' else 'desktop'))]
        if key == 'updates':
            out = [('title', 'Updates'), ('text', 'This box: version %s' % (read('/etc/ozone/version') or 'unknown'))]
            r = self.checked
            if self.checking:
                out.append(('warn', 'Looking for updates…'))
            elif not r:
                out.append(('text', 'Not looked for yet.'))
            else:
                out.append(('text', 'Looked %s.' % time.strftime('%d.%m %H:%M', time.localtime(r['time']))))
                b = r['box']
                out.append(('good' if b['state'] == 'same' else 'warn' if b['state'] == 'new' else 'text',
                            'Box software: ' + b.get('text', '')))
                d = r['debian']
                if d.get('error'):
                    out.append(('bad', 'Debian: ' + d['error']))
                else:
                    n = len(d.get('packages', []))
                    out.append(('warn' if n else 'good', 'Debian: %s' % ('%d packages to update' % n if n else 'up to date')))
                y = r['ytdlp']
                if y.get('have'):
                    out.append(('warn' if y.get('new') else 'good', 'YouTube (yt-dlp): %s%s' % (
                        y['have'], ', %s is out' % y['latest'] if y.get('new') else ', up to date')))
            return out
        if key == 'backup':
            return [('title', 'Back up'), ('text', 'A copy to take the box back to later (Restore), or to another '
                                                   'box like this one.')]
        if key == 'restore':
            if not backups():
                return [('title', 'Restore'), ('text', 'No backups found. Plug in the drive they are on: '
                                                       'they are in its folder ozone-backups.')]
            return [('title', 'Restore'), ('text', 'Backups found on the box and the drives, newest first. The box '
                                                   'restarts to finish; the settings as they are now are kept on the '
                                                   'box first.')]
        if key == 'reset':
            return [('title', 'Reset'), ('text', 'Back to how it was after installing. The settings as they are '
                                                 'now are first backed up onto the box (Restore can bring them '
                                                 'back). The box restarts to do it. The programs and their updates '
                                                 'stay.')]
        return []

    def after(self):
        """What comes below the rows"""
        key = SECTIONS[self.section][0]
        out = []
        if self.job:
            return out
        if key == 'updates' and self.checked and not self.restart:
            b = self.checked['box']
            if b.get('state') == 'new':
                out.append(('title', 'New in the box software'))
                for c in b['commits'][:15]:
                    out.append(('text', '•  ' + c['title']))
                if len(b['commits']) > 15:
                    out.append(('text', '…and %d more' % (len(b['commits']) - 15)))
            pkgs = self.checked['debian'].get('packages', [])
            if pkgs:
                out.append(('title', 'Debian packages'))
                names = ', '.join(p['name'] for p in pkgs[:40])
                out.append(('mono', names + (' and %d more' % (len(pkgs) - 40) if len(pkgs) > 40 else '')))
        return out

    # -- drawing

    def render(self):
        for i, box in enumerate(self.section_rows):
            classes(box, 'current', on=i == self.section)
            classes(box, 'chosen', on=i == self.section and self.focus == 'sections')
        for w in self.content.get_children():
            self.content.remove(w)
        for cls, text in self.info():
            self.content.pack_start(label(text, cls, wrap=True, max_width_chars=90), False, False, 0)
        self.current_rows = self.rows()
        if self.current_rows:   # none while working: the choice stays for afterwards
            self.chosen = min(self.chosen, len(self.current_rows) - 1)
        if self.current_rows:
            self.content.pack_start(Gtk.Box(height_request=6), False, False, 0)
        for i, r in enumerate(self.current_rows):
            ev = Gtk.EventBox(visible_window=False)
            box = Gtk.Box(spacing=10)
            classes(box, 'row')
            classes(box, 'chosen', on=self.focus == 'rows' and i == self.chosen)
            classes(box, 'armed', on=self.armed == (r.key, 'do') and i == self.chosen)
            box.pack_start(label(r.icon, 'ricon', yalign=0), False, False, 0)
            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            title = r.title
            if self.armed and self.armed[0] == r.key and i == self.chosen:
                title = {'do': 'Press OK again to %s' % self.confirm_text(r.key),
                         'delete': 'Press blue again to delete this backup'}[self.armed[1]]
            texts.pack_start(label(title, 'rtitle', wrap=True), False, False, 0)
            if r.sub:
                texts.pack_start(label(r.sub, 'sub', wrap=True, max_width_chars=95), False, False, 0)
            box.pack_start(texts, True, True, 0)
            if r.options:
                box.pack_start(label('', 'arrows'), False, False, 0)
                box.pack_start(label(r.options[r.value], 'rtitle'), False, False, 0)
                box.pack_start(label('', 'arrows'), False, False, 0)
            ev.add(box)
            ev.connect('button-press-event', lambda w, e, i=i: self.click_row(i, e))
            self.content.pack_start(ev, False, False, 0)
        if self.message[1]:
            self.content.pack_start(label(self.message[1], self.message[0], wrap=True, max_width_chars=90,
                                          margin_top=8), False, False, 0)
        if self.job:
            self.content.pack_start(label(self.job['title'], 'title'), False, False, 0)
            self.bar = Gtk.ProgressBar(margin_top=6, margin_bottom=6)
            self.content.pack_start(self.bar, False, False, 0)
            self.job_text = label(self.job.get('text', ''), 'text', ellipsize=Pango.EllipsizeMode.MIDDLE)
            self.content.pack_start(self.job_text, False, False, 0)
            self.set_progress(self.job.get('frac', -1), self.job.get('text', ''))
        if self.lines:
            self.content.pack_start(Gtk.Box(height_request=8), False, False, 0)
            for cls, text in self.lines[-14:]:
                self.content.pack_start(label(text, cls, wrap=True, max_width_chars=100, selectable=False),
                                        False, False, 0)
        for cls, text in self.after():
            self.content.pack_start(label(text, cls, wrap=True, max_width_chars=95,
                                          margin_top=10 if cls == 'title' else 0), False, False, 0)
        self.content.show_all()
        self.render_hints()

    def confirm_text(self, key):
        return {'reset-settings': 'reset the settings: the box restarts',
                'reset-all': 'ERASE EVERYTHING: the box restarts',
                'install': 'install the updates'}.get(key, 'restore it: the box restarts')

    def render_hints(self):
        if self.job:
            pairs = [('exit', 'stop it')] if self.job.get('stoppable') else [('', 'Working: please wait, it can\'t be '
                                                                               'stopped halfway')]
        elif self.focus == 'sections':
            pairs = [('↑ ↓', 'section'), ('→ OK', 'into it'), ('exit', 'close')]
        else:
            r = self.current_rows[self.chosen] if self.current_rows else None
            pairs = [('↑ ↓', 'choose'), ('← →', 'change') if r and r.options else ('OK', 'do it')]
            if SECTIONS[self.section][0] == 'restore' and self.current_rows:
                pairs.append(('blue', 'delete the backup'))
            if not (r and r.options) and not self.restart:
                pairs.append(('←', 'the sections'))
            pairs.append(('exit', 'close' if self.restart else 'back'))
        self.hints.set_markup(hint_markup(pairs))

    def set_progress(self, frac, text):
        if not self.job:
            return
        self.job['frac'], self.job['text'] = frac, text
        if frac < 0:
            self.bar.pulse()
        else:
            self.bar.set_fraction(frac)
        self.job_text.set_text(text)

    def tick(self):
        if self.job and self.job.get('frac', 0) < 0:
            self.bar.pulse()
        elif not self.job and SECTIONS[self.section][0] in ('backup', 'restore') and self.focus == 'sections':
            self.render()   # drives come and go
        return True

    # -- doing things

    def say(self, cls, text):
        self.lines.append((cls, text))

    def run_jobs(self, jobs, done=None):
        """jobs: [(title, argv, stoppable)] run one after another as root; the window shows their
        progress"""
        self.lines = []
        self.message = ('', '')
        self.armed = None

        def worker():
            restart = None
            ok = True
            for title, argv, stoppable in jobs:
                GLib.idle_add(self.start_job, title, stoppable)
                p = subprocess.Popen(['sudo', '-n', SELF, 'root'] + argv, stdout=subprocess.PIPE,
                                     stderr=subprocess.PIPE, text=True, start_new_session=True)
                self.job['proc'] = p
                error = ''
                for line in p.stdout:
                    w = line.rstrip('\n').split(' ', 2)
                    if w[0] == 'progress' and len(w) >= 2:
                        GLib.idle_add(self.set_progress, float(w[1]), w[2] if len(w) > 2 else '')
                    elif w[0] in ('log', 'warn'):
                        text = line.rstrip('\n').split(' ', 1)[1] if ' ' in line.strip() else ''
                        GLib.idle_add(self.say, 'warn' if w[0] == 'warn' else 'mono', text)
                    elif w[0] == 'restart' and len(w) > 1:
                        restart = 'reboot' if 'reboot' in (restart, w[1]) else w[1]
                    elif w[0] == 'error':
                        error = line.rstrip('\n')[6:]
                p.wait()
                err = p.stderr.read().strip()
                if p.returncode != 0:
                    if self.job and self.job.get('stopped'):
                        GLib.idle_add(self.say, 'warn', 'Stopped.')
                    else:
                        GLib.idle_add(self.say, 'bad', error or (err.splitlines() or ['failed'])[-1])
                    ok = False
                    break
                GLib.idle_add(self.say, 'good', '  ' + title)
            GLib.idle_add(self.jobs_done, ok, restart, done)
        self.job = {'title': '', 'stoppable': False}
        threading.Thread(target=worker, daemon=True).start()

    def start_job(self, title, stoppable):
        proc = self.job.get('proc') if self.job else None
        self.job = {'title': title, 'stoppable': stoppable, 'frac': -1, 'text': '', 'proc': proc}
        self.render()

    def jobs_done(self, ok, restart, done):
        self.job = None
        if done:
            done(ok)
        if ok and restart:
            self.restart = restart
            self.chosen = 0
        self.focus = 'rows'
        self.render()

    def stop_job(self):
        p = self.job.get('proc') if self.job else None
        if p and p.poll() is None:
            self.job['stopped'] = True
            # sudo passes the signal on to the worker, which leaves no half-made file behind it
            subprocess.call(['sudo', '-n', 'pkill', '-TERM', '-s', str(os.getpgid(p.pid))])

    def check(self):
        if self.checking:
            return
        self.checking = True
        self.render()

        def work():
            try:
                r = check_all()
            except Exception as e:
                r = None
                GLib.idle_add(self.say, 'bad', 'Could not look for updates: %s' % e)
            GLib.idle_add(self.checked_done, r)
        threading.Thread(target=work, daemon=True).start()

    def checked_done(self, r):
        self.checking = False
        if r:
            self.checked = r
        self.render()

    def install(self):
        r = self.checked
        jobs = []
        if self.backup_first and native():
            jobs.append(('Backing up the whole system onto the box', ['backup-system', box_backups(),
                                                                      'before the updates'], True))
        if r['debian'].get('packages'):
            jobs.append(('Updating Debian (%d packages)' % len(r['debian']['packages']), ['apt-upgrade'], False))
        if r['ytdlp'].get('new'):
            jobs.append(('Updating yt-dlp', ['ytdlp'], False))
        if r['box'].get('state') == 'new':
            jobs.append(('Updating the box software', ['update', r['box']['sha'], r['box']['date'], self.user], False))

        def done(ok):
            if ok:
                self.checked = None
                try:
                    os.unlink(CHECKED)
                except OSError:
                    pass
                GLib.timeout_add_seconds(1, lambda: self.check() and False)
        self.run_jobs(jobs, done)

    def activate(self):
        if not self.current_rows:
            return
        r = self.current_rows[self.chosen]
        key = r.key
        if r.options:
            self.change(1)
            return
        if key == 'reboot':
            self.status.set_text('restarting…')
            subprocess.Popen(['sudo', '-n', '/sbin/reboot'])
            return
        if key == 'desktop':
            subprocess.Popen(['bspc', 'quit'])
            return
        if key == 'later':
            self.restart = None
            self.lines = []
            self.render()
            return
        if key == 'check':
            self.lines = []
            self.check()
            return
        needs_confirm = key in ('install', 'reset-settings', 'reset-all') or SECTIONS[self.section][0] == 'restore'
        if needs_confirm and self.armed != (key, 'do'):
            self.armed = (key, 'do')
            self.render()
            return
        self.armed = None
        if key == 'install':
            self.install()
        elif key == 'settings':
            self.run_jobs([('Backing up the settings', ['backup-settings', places()[self.place][0], self.user], True)])
        elif key == 'system':
            self.run_jobs([('Backing up the whole system', ['backup-system', places()[self.place][0]], True)])
        elif key in ('reset-settings', 'reset-all'):
            self.run_jobs([('Getting ready to reset', ['reset', key[6:], self.user], False)], self.reboot_after)
        elif SECTIONS[self.section][0] == 'restore':
            what = 'the whole system' if key.endswith('.zst') else 'the settings'
            self.run_jobs([('Restoring %s' % what, ['restore', key, self.user], False)], self.reboot_after)

    def reboot_after(self, ok):
        if ok:
            self.say('warn', 'The box restarts in 5 seconds…')
            GLib.timeout_add_seconds(5, lambda: subprocess.Popen(['sudo', '-n', '/sbin/reboot']) and False)

    def change(self, n):
        r = self.current_rows[self.chosen] if self.current_rows else None
        if not r or not r.options:
            return
        if r.key == 'first':
            self.backup_first = not self.backup_first
        elif r.key == 'place':
            self.place = (self.place + n) % len(r.options)
            self.message = ('', '')
        self.render()

    def delete_backup(self):
        r = self.current_rows[self.chosen] if self.current_rows else None
        if not r or SECTIONS[self.section][0] != 'restore':
            return
        if self.armed != (r.key, 'delete'):
            self.armed = (r.key, 'delete')
            self.render()
            return
        self.armed = None
        self.run_jobs([('Deleting the backup', ['delete', r.key], False)])

    # -- input

    def click_section(self, i):
        if self.job:
            return
        self.section, self.focus, self.chosen, self.armed = i, 'rows', 0, None
        self.lines, self.message = [], ('', '')
        self.render()

    def click_row(self, i, ev):
        if self.job or ev.type != Gdk.EventType.BUTTON_PRESS:
            return
        self.focus = 'rows'
        if self.chosen != i:
            self.armed = None
        self.chosen = i
        if self.current_rows and self.current_rows[i].options:
            self.change(1 if ev.button == 1 else -1)
        else:
            self.activate()

    def on_delete(self, w, ev):
        if self.job and not self.job.get('stoppable'):
            return True   # it can't be stopped halfway
        if self.job:
            self.stop_job()
        return False

    def close(self):
        if self.job:
            if self.job.get('stoppable'):
                self.stop_job()
            return
        self.win.destroy()

    def on_key(self, w, ev):
        k = Gdk.keyval_name(ev.keyval)
        if self.job:
            if k == 'Escape' and self.job.get('stoppable'):
                if self.job.get('confirm_stop'):
                    self.stop_job()
                else:
                    self.job['confirm_stop'] = True
                    self.set_progress(self.job.get('frac', -1), 'press exit again to stop it')
            return True
        if k == 'Escape':
            if self.armed:
                self.armed = None
            elif self.focus == 'rows' and not self.restart:
                self.focus = 'sections'
            else:
                self.win.destroy()
                return True
            self.render()
            return True
        if self.focus == 'sections':
            if k in ('Up', 'Down'):
                self.section = (self.section + (1 if k == 'Down' else -1)) % len(SECTIONS)
                self.chosen, self.armed, self.lines, self.message = 0, None, [], ('', '')
                if SECTIONS[self.section][0] == 'updates' and not self.checked:
                    self.check()
                self.render()
            elif k in ('Right', 'Return', 'KP_Enter', 'Tab'):
                self.focus = 'rows'
                self.render()
            return True
        r = self.current_rows[self.chosen] if self.current_rows else None
        if k in ('Up', 'Down'):
            if self.current_rows:
                self.chosen = (self.chosen + (1 if k == 'Down' else -1)) % len(self.current_rows)
            self.armed = None
            self.render()
        elif k in ('Left', 'Right') and r and r.options:
            self.change(1 if k == 'Right' else -1)
        elif k in ('Left', 'ISO_Left_Tab', 'BackSpace') and not self.restart:
            self.focus = 'sections'
            self.armed = None
            self.render()
        elif k in ('Return', 'KP_Enter', 'space'):
            self.activate()
        elif k in BLUE:
            self.delete_backup()
        return True


def main():
    args = sys.argv[1:]
    if args[:1] == ['root']:
        root_main(args[1:])
        return
    if args[:1] == ['check']:
        check_service()
        return
    section = args[0] if args else 'updates'
    setup_gtk()
    GLib.set_prgname('ozone-system')
    Window(section)
    Gtk.main()


if __name__ == '__main__':
    main()
