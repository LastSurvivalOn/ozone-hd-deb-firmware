class TvApp:
    """The process that drives the tuner: the window (when shown), the player, recordings, timers"""

    def __init__(self, test):
        self.test = test
        self.settings = load_settings()
        self.channels = load_channels()
        self.guide = Guide()
        self.fe = None
        self.fe_lock = threading.Lock()
        self._tuner = None
        self.watching = None      # the Watch while the player is up
        self.watched = None       # the key of the channel last watched
        self.job = None           # a scan or guide update running
        self.window = None
        self.menu_unlocked = False
        self.starting = 0         # timer recordings being started
        self.lock = threading.RLock()

    # the frontend and tuner, shared by everything in this process

    def frontend(self):
        with self.fe_lock:
            if not self.fe:
                self.fe = open_frontend(self.test)
            return self.fe

    def tuner(self):
        with self.lock:
            if not self._tuner:
                self._tuner = Tuner(self)
            return self._tuner

    def release_tuner(self):
        """The tuner closed once nothing uses it (the frontend stays open while the process runs)"""
        with self.lock:
            if self._tuner and self._tuner.idle() and not self.watching:
                self._tuner.close()
                self._tuner = None

    def tuner_busy(self):
        with self.lock:
            return self.watching is not None or (self._tuner is not None and not self._tuner.idle()) or self.job

    def note_signal(self, khz, strength, quality):
        self.settings['signals'][str(khz)] = [strength, quality, time.time()]

    def set_setting(self, name, value):
        self.settings[name] = value
        save_settings(self.settings)

    def reload(self):
        self.channels = load_channels()
        if not self._tuner:   # else its EIT reader fills this one
            self.guide = Guide()

    def save_signals(self):
        s = load_settings()
        s['signals'] = self.settings['signals']
        save_settings(s)

    # watching

    def watch(self, group, index):
        """The player on channel index of group; if it's up already, switch it"""
        lst = group_list(self.channels, self.settings, group)
        if not lst:
            return
        with self.lock:
            if self.watching:
                ch = lst[index % len(lst)]
                self.watching.events.put(('play', key(ch), ch['radio']))
                return
            if self.job:
                notify('TV is busy: %s' % self.job)
                return
            LOG.write('tv', 'watch %s channel %d' % (group, index + 1))
            self.watching = Watch(self, group, index)
        threading.Thread(target=self.watching.run, daemon=True).start()

    def watch_key(self, k):
        for group in (self.settings.get('group', ALL), ALL, RADIO):
            lst = group_list(self.channels, self.settings, group)
            i = next((i for i, c in enumerate(lst) if key(c) == k), None)
            if i is not None:
                return self.watch(group, i)
        LOG.write('tv', 'no channel %s' % k)

    def player_started(self):
        from gi.repository import GLib
        GLib.idle_add(lambda: self.window and self.window.win.hide())

    def watch_ended(self, w):
        from gi.repository import GLib
        with self.lock:
            if self.watching is w:
                self.watching = None
        self.save_signals()
        self.release_tuner()
        GLib.idle_add(self.after_watch, w)

    def after_watch(self, w):
        if self.window:
            self.window.reload(select_key=self.watched)
            self.window.win.show()
            self.window.win.present()
        self.maybe_quit()

    # recordings

    def record(self, ch, until, title, desc, timer=None):
        """Starts recording ch until until (None: until stopped); (Recording, None) or (None, why)"""
        drive = recording_drive(self.settings)
        if not drive:
            return None, 'No drive to record to'
        if free_bytes(drive) < 200 << 20:
            return None, 'The drive is full (%s)' % drive
        tuner = self.tuner()
        mux = tuner.mux()
        if mux and mux != ch['freq_khz']:
            other = tuner.recordings[0]
            return None, 'Already recording %s on %d MHz' % (other.ch['name'], mux // 1000)
        w = self.watching
        if w and w.ch and w.ch['freq_khz'] != ch['freq_khz']:
            if not timer:
                return None, 'Another multiplex than the one watched'
            w.events.put(('play', key(ch), ch['radio']))   # a timer wins: the viewer follows it
            time.sleep(2.5)
        deadline = time.monotonic() + 60
        if not tuner.tune(ch, cancel=lambda t: time.sleep(t) or time.monotonic() > deadline):
            return None, 'No signal on %d MHz' % (ch['freq_khz'] // 1000)
        try:
            rec = Recording(ch, until, title, desc, drive, timer)
        except OSError as e:
            return None, 'Can\'t record to %s: %s' % (drive, e.strerror)
        tuner.add_recording(rec)
        if w:
            w.events.put(('recordings',))
        self.refresh_window()
        return rec, None

    def record_now(self, ch):
        """The record key: until the programme ends (and the margin), or for so many minutes"""
        now, _n = self.guide.now_next(ch['sid'])
        instant = self.settings.get('instant', 'programme')
        if instant == 'programme' and now:
            until = now[0] + now[1] + self.settings['margin_after'] * 60
        elif instant == 'programme':
            until = time.time() + 2 * 3600
        else:
            until = time.time() + int(instant) * 60 if int(instant) else None
        return self.record(ch, until, now[2] if now else '', now[3] if now else '')

    def stop_recording(self, rec):
        tuner = self._tuner
        if tuner:
            tuner.remove_recording(rec)
        if rec.timer:
            timers = load_timers()
            for t in timers:
                if t['id'] == rec.timer:
                    t['state'] = 'done'
                    self.repeat(timers, t)
            save_timers(timers)
        w = self.watching
        if w:
            w.events.put(('recordings',))
        self.release_tuner()
        self.refresh_window()
        from gi.repository import GLib
        GLib.idle_add(self.maybe_quit)

    def repeat(self, timers, t):
        step = {'daily': 86400, 'weekly': 7 * 86400}.get(t.get('repeat'))
        if step:
            n = dict(t, id='%x' % int(time.time() * 1000), start=t['start'] + step, end=t['end'] + step, state='')
            timers.append(n)

    def recordings(self):
        return list(self._tuner.recordings) if self._tuner else []

    # timers

    def check_timers(self):
        """Every 15 s: timers due start, recordings whose time is over stop"""
        now = time.time()
        for rec in self.recordings():
            if rec.until and now >= rec.until:
                LOG.write('timer', 'recording of %s over' % rec.ch['name'])
                threading.Thread(target=self.stop_recording, args=(rec,), daemon=True).start()
        timers = load_timers()
        changed = False
        for t in timers:
            if t.get('state', '') != '':
                continue
            if now >= t['end']:
                t['state'] = 'missed'
                changed = True
                self.repeat(timers, t)
                continue
            if t['start'] > now:
                continue
            ch = next((c for c in self.channels if key(c) == t['key']), None)
            if not ch:
                t['state'] = 'failed'
                changed = True
                continue
            t['state'] = 'running' if t['action'] == 'record' else 'done'
            changed = True
            LOG.write('timer', 'due: %s' % json.dumps(t, ensure_ascii=False))
            if t['action'] == 'record':
                self.starting += 1
                threading.Thread(target=self.timer_record, args=(t, ch), daemon=True).start()
            else:
                if os.path.exists('/run/ozone-standby.lock'):   # asleep: the screen on first
                    subprocess.call(['sudo', '-n', 'ozone-standby', 'wake'])
                notify('%s: %s' % (ch['name'], t['title']))
                self.watch_key(t['key'])
                self.repeat(timers, t)
        cut = now - 7 * 86400
        kept = [t for t in timers if t.get('state', '') in ('', 'running') or t['end'] > cut]
        if changed or len(kept) != len(timers):
            save_timers(kept)
            self.refresh_window()
        self.maybe_quit()
        return True

    def timer_record(self, t, ch):
        try:
            rec, why = self.record(ch, t['end'], t['title'], '', timer=t['id'])
        except Exception as e:
            LOG.write('tv', traceback.format_exc())
            rec, why = None, str(e)
        finally:
            self.starting -= 1
        if not rec:
            LOG.write('timer', 'recording %s failed: %s' % (t['title'], why))
            notify('Recording %s failed: %s' % (t['title'], why))
            timers = load_timers()
            for x in timers:
                if x['id'] == t['id']:
                    x['state'] = 'failed'
            save_timers(timers)
            from gi.repository import GLib
            GLib.idle_add(self.maybe_quit)
        else:
            notify('Recording %s: %s' % (ch['name'], t['title']))

    # the window, the control socket, the end

    def refresh_window(self):
        from gi.repository import GLib
        GLib.idle_add(lambda: self.window and self.window.refresh())

    def show_window(self):
        if self.window:
            if not self.watching:
                self.window.win.show()
                self.window.win.present()
            return
        self.window = TvWindow(self)
        if self.watching:
            self.window.win.hide()

    def window_closed(self):
        self.window = None
        self.maybe_quit()

    def maybe_quit(self):
        """The process ends with nothing to do: no window, player, recording, scan, or timer due
        within two minutes"""
        from gi.repository import Gtk
        now = time.time()
        soon = any(t.get('state', '') == '' and t['start'] - 120 <= now < t['end'] for t in load_timers())
        if not self.window and not self.watching and not self.recordings() and not self.job and not self.starting \
                and not soon:
            Gtk.main_quit()
        return False

    def on_control(self, sock, _cond):
        conn, _a = sock.accept()
        try:
            conn.settimeout(2)
            line = conn.makefile().readline().split()
            LOG.write('tv', 'request: %s' % ' '.join(line))
            reply = 'ok'
            if not line or line[0] == 'show':
                self.show_window()
            elif line[0] == 'play' and len(line) > 1:
                lst = group_list(self.channels, self.settings, ALL)
                n = int(line[1]) - 1
                if 0 <= n < len(lst):
                    self.watch(ALL, n)
                else:
                    reply = 'no channel %s' % line[1]
            elif line[0] in ('timers', 'timer'):
                self.check_timers()
            else:
                reply = 'unknown request'
            conn.sendall(reply.encode() + b'\n')
        except (OSError, ValueError) as e:
            LOG.write('tv', 'request: %s' % e)
        finally:
            conn.close()
        return True

    def run(self, action):
        import gi
        gi.require_version('Gtk', '3.0')
        gi.require_version('Gdk', '3.0')
        from gi.repository import Gdk, GLib, Gtk
        GLib.set_prgname('ozone-tv')
        # GTK's CSS parser loses the first number of the first stylesheet to a stale errno (see yt)
        try:
            Gtk.CssProvider().load_from_data(b'* { padding: 0px; }')
        except GLib.Error:
            pass
        style = Gtk.CssProvider()
        style.load_from_data(TV_CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), style,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        try:
            os.unlink(CONTROL)
        except OSError:
            pass
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.bind(CONTROL)
        sock.listen(4)
        GLib.io_add_watch(sock.fileno(), GLib.IO_IN, lambda fd, cond: self.on_control(sock, cond))
        GLib.timeout_add_seconds(15, self.check_timers)
        if action[0] == 'menu':
            self.show_window()
        elif action[0] == 'play':
            lst = group_list(self.channels, self.settings, ALL)
            if not lst:
                notify('No channels yet: scan first')
                return 1
            self.watch(ALL, (action[1] - 1) % len(lst))
        GLib.idle_add(lambda: self.check_timers() and False)
        GLib.idle_add(self.maybe_quit)
        Gtk.main()
        sock.close()
        try:
            os.unlink(CONTROL)
        except OSError:
            pass
        for rec in self.recordings():
            self.stop_recording(rec)
        if self._tuner:
            self._tuner.close()
        if self.fe:
            self.fe.close()
        self.save_signals()
        return 0


# ---- the window -------------------------------------------------------------------------------------

def later(action):
    """action() once the event that asked for it is over: a dialog run from a button's or menu
    item's handler would find the pointer still grabbed by that button, and get no clicks"""
    from gi.repository import GLib
    GLib.idle_add(lambda: action() and False)


def day_name(t):
    today = time.localtime(time.time())
    d = time.localtime(t)
    delta = (time.mktime(d[:3] + (0, 0, 0, 0, 0, -1)) - time.mktime(today[:3] + (0, 0, 0, 0, 0, -1))) / 86400
    name = {0: 'Today', 1: 'Tomorrow', -1: 'Yesterday'}.get(round(delta), time.strftime('%A', d))
    return '%s, %s' % (name, time.strftime('%d.%m', d))


class TvWindow:
    """The TV window: a list on the left (channels of a group, recordings or timers), the selected
    channel's schedule on the right, and the settings"""

    def __init__(self, app):
        from gi.repository import Gtk, Pango
        self.Gtk, self.Pango = Gtk, Pango
        self.app = app
        self.typed, self.typed_at = '', 0   # a channel number from the remote's digits
        self.group = app.settings.get('group', ALL)
        self.win = Gtk.Window(title='TV')
        self.win.set_default_size(1280, 720)
        self.win.connect('destroy', lambda w: app.window_closed())
        self.win.connect('key-press-event', self.on_key)

        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        header = Gtk.Box(spacing=12)
        header.get_style_context().add_class('header')
        header.pack_start(self.label('', 'logo'), False, False, 0)
        header.pack_start(self.label('TV', 'heading'), False, False, 0)
        self.status = self.label('', 'status', ellipsize=Pango.EllipsizeMode.END)
        header.pack_start(self.status, True, True, 0)
        for text, action in (('Update guide', self.update_guide), ('Scan channels', self.scan_dialog),
                             ('Settings', self.settings_dialog)):
            b = Gtk.Button(label=text)
            b.connect('clicked', lambda w, a=action: later(a))
            header.pack_start(b, False, False, 0)
        # bspwm draws no title bars, so the window closes here (or with Esc, the panel's ✕)
        close = Gtk.Button(label='', tooltip_text='Close')
        close.get_style_context().add_class('close')
        close.connect('clicked', lambda w: self.win.destroy())
        header.pack_start(close, False, False, 0)
        top.pack_start(header, False, False, 0)

        body = Gtk.Box()
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        left.set_size_request(470, -1)
        left.get_style_context().add_class('channels')
        gbox = Gtk.Box(spacing=8)
        gbox.get_style_context().add_class('groups')
        self.groups = Gtk.ComboBoxText()
        self.groups.connect('changed', self.on_group)
        gbox.pack_start(self.groups, True, True, 0)
        left.pack_start(gbox, False, False, 0)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        # a click shows the channel's schedule, a double click (or Enter) watches it
        self.list = Gtk.ListBox(activate_on_single_click=False)
        self.list.connect('row-selected', self.on_row)
        self.list.connect('row-activated', lambda lb, row: self.activate(row))
        self.list.connect('button-press-event', self.on_list_click)
        scroll.add(self.list)
        left.pack_start(scroll, True, True, 0)
        body.pack_start(left, False, False, 0)
        self.right = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.sched = Gtk.ListBox(activate_on_single_click=False)
        self.sched.connect('row-selected', self.on_event)
        self.sched.connect('row-activated', lambda lb, row: self.event_menu(row))
        self.right.add(self.sched)
        body.pack_start(self.right, True, True, 0)
        top.pack_start(body, True, True, 0)
        hint = self.label('Enter: watch   →: the guide   Menu or F2: the channel\'s menu   Tab: next list   '
                          'Esc: close', 'hint')
        hint.set_margin_start(16)
        hint.set_margin_bottom(6)
        top.pack_start(hint, False, False, 0)
        self.win.add(top)

        self.rows = []
        self.fill_groups()
        self.win.show_all()
        self.reload(select_key=app.watched)
        from gi.repository import GLib
        GLib.timeout_add_seconds(30, self.tick)

    def label(self, text='', cls=None, **kw):
        kw.setdefault('xalign', 0)
        w = self.Gtk.Label(label=text, **kw)
        if cls:
            w.get_style_context().add_class(cls)
        return w

    # the lists

    def fill_groups(self):
        self.filling = True
        self.groups.remove_all()
        names = groups(self.app.settings, self.app.channels) + [RECORDED, TIMERS_VIEW]
        if self.group not in names:
            self.group = ALL
        for n in names:
            self.groups.append(n, {ALL: 'All channels'}.get(n, n))
        self.groups.set_active_id(self.group)
        self.filling = False

    def on_group(self, combo):
        if self.filling or not combo.get_active_id():
            return
        self.group = combo.get_active_id()
        if self.group in groups(self.app.settings, self.app.channels):
            self.app.set_setting('group', self.group)
        self.reload()

    def next_group(self):
        names = [self.groups.get_model()[i][1] for i in range(len(self.groups.get_model()))]
        self.groups.set_active_id(names[(names.index(self.group) + 1) % len(names)])

    def reload(self, select_key=None):
        """The list again from disk (after watching, a scan, an edit)"""
        self.app.reload()
        self.fill_groups()
        for row in self.list.get_children():
            row.destroy()
        self.rows = []
        if self.group == RECORDED:
            self.fill_recordings()
        elif self.group == TIMERS_VIEW:
            self.fill_timers()
        else:
            self.fill_channels()
        self.list.show_all()
        self.update_now()
        index = next((i for i, r in enumerate(self.rows) if getattr(r, 'key', None) == select_key), 0)
        self.select(index)
        if not self.rows:
            self.fill_schedule(None)

    def refresh(self):
        row = self.list.get_selected_row()
        self.reload(select_key=getattr(row, 'key', None))
        return False

    def empty(self, text):
        row = self.Gtk.ListBoxRow(selectable=False, activatable=False)
        row.add(self.label(text, 'empty', wrap=True))
        self.list.add(row)

    def fill_channels(self):
        Gtk, Pango = self.Gtk, self.Pango
        self.chans = group_list(self.app.channels, self.app.settings, self.group)
        recording = {r.key for r in self.app.recordings()}
        signals = self.app.settings['signals']
        for i, c in enumerate(self.chans):
            row = Gtk.ListBoxRow()
            row.index, row.key, row.ch = i, key(c), c
            if c.get('skip'):
                row.get_style_context().add_class('skipped')
            box = Gtk.Box(spacing=12)
            box.pack_start(self.label(str(channel_number(c, i)), 'num', width_chars=3, xalign=1), False, False, 0)
            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            line = Gtk.Box(spacing=8)
            flags = (' \U0001f512' if c.get('locked') else '') + (' ⏭' if c.get('skip') else '')
            line.pack_start(self.label(c['name'] + lock_icon(c) + flags, 'name', ellipsize=Pango.EllipsizeMode.END),
                            True, True, 0)
            if row.key in recording:
                line.pack_start(self.label('● REC', 'rec'), False, False, 0)
            sig = signals.get(str(c['freq_khz']))
            line.pack_start(self.label('%d%%' % sig[0] if sig else '', 'signal',
                                       tooltip_text='Signal level when last tuned'), False, False, 0)
            info.pack_start(line, False, False, 0)
            row.now = self.label('', 'now', ellipsize=Pango.EllipsizeMode.END)
            info.pack_start(row.now, False, False, 0)
            row.prog = Gtk.ProgressBar(no_show_all=True)   # shown only with a programme on
            info.pack_start(row.prog, False, False, 2)
            box.pack_start(info, True, True, 0)
            row.add(box)
            self.list.add(row)
            self.rows.append(row)
        if not self.chans:
            self.empty('No channels yet: Scan channels' if not self.app.channels else
                       'No channels in this list. A channel\'s menu (Menu or F2) adds it to a list.')

    def fill_recordings(self):
        Gtk, Pango = self.Gtk, self.Pango
        self.recs = list_recordings(self.app.settings)
        running = {r.path for r in self.app.recordings()}
        for m in self.recs:
            row = Gtk.ListBoxRow()
            row.rec, row.key = m, m['path']
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            title = m.get('title') or os.path.basename(m['path'])[:-3]
            box.pack_start(self.label(('● ' if m['path'] in running else '') + title, 'name',
                                      ellipsize=Pango.EllipsizeMode.END), False, False, 0)
            box.pack_start(self.label('%s · %s · %d min · %.0f MB' % (
                m.get('channel', ''), time.strftime('%d.%m %H:%M', time.localtime(m.get('start', 0))),
                (m.get('duration') or 0) // 60, m['size'] / 1e6), 'now'), False, False, 0)
            row.add(box)
            self.list.add(row)
            self.rows.append(row)
        if not self.recs:
            self.empty('No recordings. The record key in the player records what\'s on; Enter on a '
                       'programme in the guide sets a timer.')

    def fill_timers(self):
        Gtk, Pango = self.Gtk, self.Pango
        timers = sorted(load_timers(), key=lambda t: t['start'])
        for t in timers:
            row = Gtk.ListBoxRow()
            row.timer, row.key = t, t['id']
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            what = {'record': 'Record', 'watch': 'Switch to'}[t['action']]
            box.pack_start(self.label('%s: %s' % (what, t['title']), 'name', ellipsize=Pango.EllipsizeMode.END),
                           False, False, 0)
            box.pack_start(self.label('%s · %s %s–%s%s%s' % (
                t['channel'], time.strftime('%a %d.%m', time.localtime(t['start'])), hhmm(t['start']),
                hhmm(t['end']), ' · ' + t['repeat'] if t.get('repeat') else '',
                ' · ' + t['state'] if t.get('state') else ''), 'now'), False, False, 0)
            row.add(box)
            self.list.add(row)
            self.rows.append(row)
        if not timers:
            self.empty('No timers. Enter on a programme in the guide records it or switches to it.')

    def update_now(self):
        t = self.app.guide.now()
        for row in self.rows:
            if not hasattr(row, 'ch'):
                continue
            now, nxt = self.app.guide.now_next(row.ch['sid'])
            if now:
                row.now.set_text('%s–%s  %s' % (hhmm(now[0]), hhmm(now[0] + now[1]), now[2]))
                row.prog.set_fraction(min(1, max(0, (t - now[0]) / max(1, now[1]))))
                row.prog.show()
            else:
                row.now.set_text('next: %s %s' % (hhmm(nxt[0]), nxt[2]) if nxt else 'no programme information')
                row.prog.hide()

    def select(self, index):
        if 0 <= index < len(self.rows):
            self.list.select_row(self.rows[index])
            self.rows[index].grab_focus()

    def on_row(self, lb, row):
        if row is None:
            return
        self.fill_schedule(getattr(row, 'ch', None))

    def fill_schedule(self, ch):
        Gtk, Pango = self.Gtk, self.Pango
        for row in self.sched.get_children():
            row.destroy()
        self.sched_ch = ch
        if not ch:
            self.sched.show_all()
            return
        t = self.app.guide.now()
        timers = load_timers()
        events = [e for e in self.app.guide.schedule(ch['sid']) if e[0] + e[1] > t]
        day = None
        for e in events:
            if day_name(e[0]) != day:
                day = day_name(e[0])
                head = Gtk.ListBoxRow(selectable=False, activatable=False)
                head.add(self.label(day, 'day'))
                self.sched.add(head)
            row = Gtk.ListBoxRow()
            row.event = e
            box = Gtk.Box(spacing=14)
            box.pack_start(self.label(hhmm(e[0]), 'time', valign=Gtk.Align.START), False, False, 0)
            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            line = Gtk.Box(spacing=8)
            line.pack_start(self.label(e[2], 'title', wrap=True), False, False, 0)
            if e[4]:
                line.pack_start(self.label('%d+' % e[4], 'hint', valign=Gtk.Align.CENTER), False, False, 0)
            if e[0] <= t:
                line.pack_start(self.label('NOW', 'badge', valign=Gtk.Align.CENTER), False, False, 0)
                row.get_style_context().add_class('current')
            timer = timer_for(timers, ch, e)
            if timer:
                badge = self.label('REC' if timer['action'] == 'record' else 'ALARM', 'badge', valign=Gtk.Align.CENTER)
                badge.get_style_context().add_class('timer')
                line.pack_start(badge, False, False, 0)
            info.pack_start(line, False, False, 0)
            row.desc = None
            if e[3] and e[3].strip() != e[2].strip():   # Zeonbud often repeats the title as the text
                row.desc = self.label(e[3], 'desc', wrap=True, lines=2, ellipsize=Pango.EllipsizeMode.END,
                                      max_width_chars=1)
                info.pack_start(row.desc, False, False, 0)
            box.pack_start(info, True, True, 0)
            row.add(box)
            self.sched.add(row)
        if not events:
            row = Gtk.ListBoxRow(selectable=False, activatable=False)
            row.add(self.label('No programme information yet. Watching a channel fills it in, or Update guide.',
                               'empty', wrap=True))
            self.sched.add(row)
        self.sched.show_all()
        self.right.get_vadjustment().set_value(0)

    def on_event(self, lb, row):
        # the selected programme's whole description
        for r in lb.get_children():
            if getattr(r, 'desc', None):
                full = r is row
                r.desc.set_lines(-1 if full else 2)
                r.desc.set_ellipsize(self.Pango.EllipsizeMode.NONE if full else self.Pango.EllipsizeMode.END)

    def tick(self):
        self.update_now()
        return True

    # actions

    def set_status(self, text):
        self.status.set_text(text)

    def activate(self, row):
        if hasattr(row, 'ch'):
            self.app.watch(self.group, row.index)
        elif hasattr(row, 'rec'):
            self.play_recording(row.rec)
        elif hasattr(row, 'timer'):
            self.timer_menu(row)

    def play_recording(self, m):
        """In amplay, as a file (the decoder is the one thing it shares with live TV)"""
        if self.app.watching:
            self.set_status('Stop watching TV first')
            return
        from gi.repository import GLib
        self.win.hide()
        cmd = ['amplay', '-v', '--title', m.get('title') or os.path.basename(m['path']), m['path']]
        if m.get('sid'):
            cmd[1:1] = ['--program', str(m['sid'])]
        LOG.write('tv', 'playing %s' % ' '.join(cmd))

        def thread():
            p = subprocess.Popen(cmd, stderr=subprocess.PIPE, text=True, errors='replace')
            pipe_to_log(p.stderr, 'amplay')
            status = p.wait()
            LOG.write('tv', 'amplay exit status %d' % status)
            subprocess.call(['amplay', '--reset'])
            GLib.idle_add(lambda: (self.win.show(), self.win.present()) and False)
        threading.Thread(target=thread, daemon=True).start()

    def run_job(self, what, job):
        """job(progress) in a thread with the frontend to itself, then everything reloaded"""
        app = self.app
        if app.tuner_busy():
            self.set_status('Busy: %s' % (app.job or 'watching or recording'))
            return
        app.job = what
        from gi.repository import GLib
        progress = lambda text: GLib.idle_add(self.set_status, text)

        def done():
            app.job = None
            app.save_signals()
            self.reload()
            app.maybe_quit()

        def thread():
            try:
                job(app.frontend(), progress)
            except Exception as e:
                LOG.write('tv', traceback.format_exc())
                GLib.idle_add(self.set_status, 'Error: %s' % e)
            finally:
                GLib.idle_add(done)
        threading.Thread(target=thread, daemon=True).start()

    def update_guide(self):
        LOG.write('tv', 'window: update the guide')
        self.run_job('updating the guide', lambda fe, progress: update_guide(fe, progress))

    def menu_allowed(self):
        """The PIN, once, if the menu is locked"""
        s = self.app.settings
        if not s.get('lock_menu') or self.app.menu_unlocked:
            return True
        pin = self.ask('Locked', 'Enter the PIN', password=True)
        if pin is not None and pin_ok(s, pin):
            self.app.menu_unlocked = True
            return True
        if pin is not None:
            self.set_status('Wrong PIN')
        return False

    def ask(self, title, prompt, text='', password=False):
        """A line of text from the viewer, or None"""
        Gtk = self.Gtk
        d = Gtk.Dialog(title=title, transient_for=self.win, modal=True)
        d.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'OK', Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        box = d.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        box.add(self.label(prompt))
        e = Gtk.Entry(text=text, activates_default=True, visibility=not password)
        box.add(e)
        d.show_all()
        r = d.run()
        value = e.get_text()
        d.destroy()
        return value if r == Gtk.ResponseType.OK else None

    def confirm(self, text):
        Gtk = self.Gtk
        d = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.OK_CANCEL, text=text)
        r = d.run()
        d.destroy()
        return r == Gtk.ResponseType.OK

    def popup(self, items, widget=None):
        """A menu of (label, action) pairs (None: a separator; a list as the action: a submenu)"""
        Gtk = self.Gtk
        def build(items):
            m = Gtk.Menu()
            for item in items:
                if item is None:
                    m.append(Gtk.SeparatorMenuItem())
                    continue
                text, action = item
                mi = Gtk.MenuItem(label=text)
                if isinstance(action, list):
                    mi.set_submenu(build(action))
                elif action:
                    mi.connect('activate', lambda w, a=action: later(a))
                else:
                    mi.set_sensitive(False)
                m.append(mi)
            m.show_all()
            return m
        from gi.repository import Gdk
        self.menu = build(items)   # kept, or it goes before it shows
        self.menu.attach_to_widget(self.win)
        if widget:
            self.menu.popup_at_widget(widget, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)
        else:
            self.menu.popup_at_pointer(None)
        self.menu.select_first(False)

    # the channel's menu: editing, lists, info

    def channel_menu(self, row):
        if not hasattr(row, 'ch'):
            return self.activate(row) if hasattr(row, 'rec') or hasattr(row, 'timer') else None
        ch = row.ch
        s = self.app.settings
        in_groups = [(('✓ ' if key(ch) in keys else '   ') + name, lambda n=name: self.toggle_group(ch, n))
                     for name, keys in s['groups'].items()]
        in_groups += [None, ('New list…', lambda: self.new_group(ch))]
        if self.group in s['groups']:
            in_groups += [('Delete the list "%s"' % self.group, lambda: self.delete_group(self.group))]
        items = [
            ('Watch', lambda: self.activate(row)),
            ('Channel info and PIDs…', lambda: self.info_dialog(ch)),
            None,
            ('Lists', in_groups),
            ('Rename…', lambda: self.edit(lambda: self.rename(ch))),
            ('Move up', lambda: self.edit(lambda: self.move(ch, -1))),
            ('Move down', lambda: self.edit(lambda: self.move(ch, 1))),
            ('Skip when switching: %s' % ('on' if ch.get('skip') else 'off'),
             lambda: self.edit(lambda: self.flag(ch, 'skip'))),
            ('Locked (PIN): %s' % ('on' if ch.get('locked') else 'off'),
             lambda: self.edit(lambda: self.flag(ch, 'locked'))),
            ('Delete', lambda: self.edit(lambda: self.delete(ch))),
            None,
            ('Sort the list', [('By number (LCN)', lambda: self.edit(lambda: self.sort('lcn'))),
                               ('A–Z', lambda: self.edit(lambda: self.sort('name')))]),
        ]
        self.popup(items, row)

    def edit(self, change):
        if self.menu_allowed():
            change()
            self.refresh()

    def rename(self, ch):
        name = self.ask('Rename', 'The name of %s:' % ch['name'], ch['name'])
        if name and name.strip():
            update_channel(ch, name=name.strip(), renamed=True)

    def move(self, ch, step):
        """In the favourites list shown, or in the whole list (a step over the channels of the list
        shown, which may leave out radio)"""
        s = self.app.settings
        if self.group in s['groups']:
            keys = s['groups'][self.group]
            i = keys.index(key(ch))
            j = i + step
            if 0 <= j < len(keys):
                keys[i], keys[j] = keys[j], keys[i]
                save_settings(s)
            return
        channels = load_channels()
        shown = [i for i, c in enumerate(channels) if c['radio'] == ch['radio']]
        pos = next(n for n, i in enumerate(shown) if key(channels[i]) == key(ch))
        if 0 <= pos + step < len(shown):
            a, b = shown[pos], shown[pos + step]
            channels[a], channels[b] = channels[b], channels[a]
            save_channels(channels)

    def flag(self, ch, name):
        if name == 'locked' and not ch.get('locked') and not self.app.settings.get('pin'):
            self.set_status('The PIN is 0000 until you set one in Settings')
        update_channel(ch, **{name: not ch.get(name)})

    def delete(self, ch):
        if not self.confirm('Delete %s from the list? A scan finds it again.' % ch['name']):
            return
        save_channels([c for c in load_channels() if key(c) != key(ch)])
        s = self.app.settings
        for keys in s['groups'].values():
            if key(ch) in keys:
                keys.remove(key(ch))
        save_settings(s)

    def sort(self, by):
        channels = load_channels()
        save_channels(sort_channels([c for c in channels if not c['radio']], by) +
                      sort_channels([c for c in channels if c['radio']], by))

    def toggle_group(self, ch, name):
        s = self.app.settings
        keys = s['groups'][name]
        if key(ch) in keys:
            keys.remove(key(ch))
        else:
            keys.append(key(ch))
        save_settings(s)
        self.set_status('%s %s %s' % (ch['name'], 'is in' if key(ch) in keys else 'is no longer in', name))
        self.refresh()

    def new_group(self, ch):
        name = self.ask('New list', 'The name of the new list of channels:')
        s = self.app.settings
        if not name or not name.strip() or name.strip() in s['groups'] or name.strip() in (ALL, RADIO, RECORDED, TIMERS_VIEW):
            return
        s['groups'][name.strip()] = [key(ch)]
        save_settings(s)
        self.refresh()

    def delete_group(self, name):
        if self.confirm('Delete the list "%s"? The channels stay in All channels.' % name):
            s = self.app.settings
            del s['groups'][name]
            s['group'] = ALL
            save_settings(s)
            self.group = ALL
            self.refresh()

    def info_dialog(self, ch):
        """What the channel is, and its PIDs, which can be edited by hand"""
        Gtk = self.Gtk
        d = Gtk.Dialog(title='Channel info', transient_for=self.win, modal=True)
        d.add_buttons('Close', Gtk.ResponseType.CANCEL, 'Save the PIDs', Gtk.ResponseType.OK)
        d.set_default_size(620, -1)
        box = d.get_content_area()
        box.set_spacing(6)
        box.set_border_width(16)
        sig = self.app.settings['signals'].get(str(ch['freq_khz']))
        uhf_ch = uhf_channel(ch['freq_khz'])
        kinds = {0x01: 'TV (MPEG-2 SD)', 0x02: 'radio', 0x11: 'TV (MPEG-2 HD)', 0x16: 'TV (H.264 SD)',
                 0x19: 'TV (H.264 HD)', 0x1f: 'TV (HEVC)', 0x0a: 'radio (advanced codec)'}
        for text in (
                ch['name'] + ('  (renamed)' if ch.get('renamed') else ''),
                'Provider: %s' % (ch.get('provider') or '-'),
                'Service: %d, type %s, LCN %s' % (ch['sid'], kinds.get(ch.get('type'), ch.get('type') or '?'),
                                                 ch.get('lcn') or '-'),
                'Multiplex: %d MHz%s, %d MHz wide, PLP %d' % (ch['freq_khz'] // 1000, ' (UHF %d)' % uhf_ch if uhf_ch else '',
                                                            ch['bandwidth'], ch['plp']),
                'Signal when last tuned: %s' % ('level %d%%, quality %d%%, %s' % (sig[0], sig[1], time.strftime(
                    '%d.%m %H:%M', time.localtime(sig[2]))) if sig else 'not known'),
                'Encrypted: %s' % {True: 'yes', False: 'no', None: 'not checked yet'}[ch.get('encrypted')],
                'Subtitles: %s' % (', '.join('%s (%s PID %d%s)' % (t['lang'] or '-', 'teletext' if t['type'] == 't' else 'DVB',
                                                                   t['pid'], ', page %x' % t['page'] if t['type'] == 't' else '')
                                             for t in ch.get('subtitles', [])) or 'none'),
                'Teletext: %s' % ('PID %d' % ch['teletext'] if ch.get('teletext') else 'none')):
            box.add(self.label(text, wrap=True))
        box.add(self.label('PIDs', 'section'))
        grid = Gtk.Grid(column_spacing=12, row_spacing=6)
        v = ch.get('video') or {}
        entries = {}
        rows = [('Video PID', 'vpid', str(v.get('pid', ''))), ('Video codec', 'vcodec', v.get('codec', 'h264')),
                ('Audio PIDs (pid:codec:lang, …)', 'audio',
                 ', '.join('%d:%s:%s' % (a['pid'], a['codec'], a['lang']) for a in ch['audio'])),
                ('PCR PID', 'pcr', str(ch['pcr_pid'])), ('PMT PID', 'pmt', str(ch['pmt_pid']))]
        for n, (text, name, value) in enumerate(rows):
            grid.attach(self.label(text), 0, n, 1, 1)
            e = Gtk.Entry(text=value, hexpand=True)
            grid.attach(e, 1, n, 1, 1)
            entries[name] = e
        box.add(grid)
        box.add(self.label('Changed PIDs stay through scans. Empty video PID: radio.', 'hint'))
        d.show_all()
        if d.run() == Gtk.ResponseType.OK and self.menu_allowed():
            try:
                vpid = entries['vpid'].get_text().strip()
                audio = []
                for part in entries['audio'].get_text().split(','):
                    f = part.strip().split(':')
                    if f[0]:
                        audio.append({'pid': int(f[0]), 'codec': f[1] if len(f) > 1 else 'mp2',
                                      'lang': f[2] if len(f) > 2 else ''})
                fields = {'video': {'pid': int(vpid), 'codec': entries['vcodec'].get_text().strip() or 'h264'}
                          if vpid else None,
                          'audio': audio, 'pcr_pid': int(entries['pcr'].get_text()),
                          'pmt_pid': int(entries['pmt'].get_text()), 'pids_edited': True}
                fields['radio'] = fields['video'] is None
                update_channel(ch, **fields)
                self.set_status('PIDs of %s saved' % ch['name'])
            except ValueError:
                self.set_status('The PIDs must be numbers')
        d.destroy()
        self.refresh()

    # the guide's programmes: timers

    def event_menu(self, row):
        ch, e = self.sched_ch, getattr(row, 'event', None)
        if not ch or not e:
            return
        t = self.app.guide.now()
        timer = timer_for(load_timers(), ch, e)
        index = next((r.index for r in self.rows if getattr(r, 'key', None) == key(ch)), 0)
        items = [('Watch %s' % ch['name'], lambda: self.app.watch(self.group, index))]
        if timer:
            items.append(('Cancel the timer', lambda: self.cancel_timer(timer['id'])))
        else:
            s = self.app.settings
            start = max(e[0] - s['margin_before'] * 60, t) if e[0] <= t else e[0] - s['margin_before'] * 60
            end = e[0] + e[1] + s['margin_after'] * 60
            items += [('Record', lambda: self.set_timer(ch, start, end, 'record', e[2], '')),
                      ('Record every day', lambda: self.set_timer(ch, start, end, 'record', e[2], 'daily')),
                      ('Record every week', lambda: self.set_timer(ch, start, end, 'record', e[2], 'weekly'))]
            if e[0] > t:
                items.append(('Switch to it when it starts', lambda: self.set_timer(ch, e[0], e[0] + e[1], 'watch',
                                                                                    e[2], '')))
        self.popup(items, row)

    def set_timer(self, ch, start, end, action, title, repeat):
        timer, other = add_timer(ch, start, end, action, title, repeat)
        if other:
            self.set_status('Conflicts with "%s" on %s, %s–%s: one tuner, one multiplex at a time' % (
                other['title'], other['channel'], hhmm(other['start']), hhmm(other['end'])))
        else:
            self.set_status('Timer set: %s %s, %s' % (hhmm(start), title, ch['name']))
            self.app.check_timers()
        self.fill_schedule(self.sched_ch)

    def cancel_timer(self, tid):
        timers = load_timers()
        t = next((t for t in timers if t['id'] == tid), None)
        if t and t.get('state') == 'running':
            rec = next((r for r in self.app.recordings() if r.timer == tid), None)
            if rec:
                self.app.stop_recording(rec)
            timers = load_timers()
        save_timers([t for t in timers if t['id'] != tid])
        self.set_status('Timer cancelled')
        self.refresh()
        if self.sched_ch:
            self.fill_schedule(self.sched_ch)

    def timer_menu(self, row):
        t = row.timer
        self.popup([('Cancel the timer' if t.get('state', '') in ('', 'running') else 'Remove',
                     lambda: self.cancel_timer(t['id']))], row)

    def recording_menu(self, row):
        m = row.rec
        running = next((r for r in self.app.recordings() if r.path == m['path']), None)
        items = [('Play', lambda: self.play_recording(m))]
        if running:
            items.append(('Stop recording', lambda: (self.app.stop_recording(running), self.refresh())))
        items.append(('Delete', lambda: self.delete_recording(m)))
        self.popup(items, row)

    def delete_recording(self, m):
        if any(r.path == m['path'] for r in self.app.recordings()):
            self.set_status('It is being recorded: stop it first')
            return
        if not self.confirm('Delete the recording "%s"?' % (m.get('title') or os.path.basename(m['path']))):
            return
        for p in (m['path'], m['path'][:-3] + '.json'):
            try:
                os.unlink(p)
            except OSError:
                pass
        self.refresh()

    # scans

    def scan_dialog(self):
        if not self.menu_allowed():
            return
        Gtk = self.Gtk
        d = Gtk.Dialog(title='Scan channels', transient_for=self.win, modal=True)
        d.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Scan', Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        box = d.get_content_area()
        box.set_spacing(8)
        box.set_border_width(16)
        full = Gtk.RadioButton(label='The whole band: UHF 21–60 (474–786 MHz), about 3 min')
        one = Gtk.RadioButton(label='One frequency', group=full)
        nit = Gtk.RadioButton(label='Network search (the frequencies the network lists, from this one)', group=full)
        for w in (full, one, nit):
            box.add(w)
        grid = Gtk.Grid(column_spacing=12, row_spacing=6, margin_start=24)
        freq = Gtk.Entry(text='', placeholder_text='UHF channel (21–69) or MHz, e.g. 27 or 522')
        bw = Gtk.ComboBoxText()
        for b in ('8', '7', '6'):
            bw.append(b, b + ' MHz')
        bw.set_active_id('8')
        plp = Gtk.SpinButton.new_with_range(0, 255, 1)
        for n, (text, w) in enumerate((('Frequency', freq), ('Bandwidth', bw), ('PLP (DVB-T2)', plp))):
            grid.attach(self.label(text), 0, n, 1, 1)
            grid.attach(w, 1, n, 1, 1)
        box.add(grid)
        box.add(self.label('A scan keeps the order, names and lists of the channels it finds again.', 'hint'))
        d.show_all()
        r = d.run()
        mode = 'full' if full.get_active() else 'one' if one.get_active() else 'nit'
        text, width, plp_id = freq.get_text().strip(), int(bw.get_active_id()), plp.get_value_as_int()
        d.destroy()
        if r != Gtk.ResponseType.OK:
            return
        test = self.app.test
        sigs = self.app.settings['signals']
        if mode == 'full':
            LOG.write('tv', 'window: scan')
            self.run_job('a channel scan is running', lambda fe, p: scan(fe, uhf(21, 60) if not test else [(0, 8, 0)],
                                                                         test, p, sigs))
            return
        try:
            n = float(text.replace(',', '.'))
        except ValueError:
            self.set_status('The frequency: a UHF channel number or MHz')
            return
        khz = 306000 + 8000 * int(n) if n < 100 else int(n * 1000)
        if test:
            khz = 0
        LOG.write('tv', 'window: scan %s %d kHz' % (mode, khz))
        if mode == 'one':
            self.run_job('a channel scan is running', lambda fe, p: scan(fe, [(khz, width, plp_id)], test, p, sigs))
        else:
            self.run_job('a network search is running', lambda fe, p: nit_search(fe, khz, width, test, p, sigs))

    # settings

    def settings_dialog(self):
        if not self.menu_allowed():
            return
        Gtk = self.Gtk
        s = self.app.settings
        d = Gtk.Dialog(title='TV settings', transient_for=self.win, modal=True)
        d.add_buttons('Close', Gtk.ResponseType.CLOSE)
        d.set_default_size(720, 520)
        book = Gtk.Notebook()
        d.get_content_area().pack_start(book, True, True, 0)

        def page(name):
            g = Gtk.Grid(column_spacing=16, row_spacing=10, border_width=16)
            g.row = 0
            book.append_page(g, Gtk.Label(label=name))
            return g

        def add(g, text, w, hint=None):
            g.attach(self.label(text), 0, g.row, 1, 1)
            g.attach(w, 1, g.row, 1, 1)
            g.row += 1
            if hint:
                g.attach(self.label(hint, 'hint', wrap=True, max_width_chars=60), 0, g.row, 2, 1)
                g.row += 1

        def combo(options, value, on):
            c = Gtk.ComboBoxText()
            for v, text in options:
                c.append(str(v), text)
            c.set_active_id(str(value))
            c.connect('changed', lambda w: on(w.get_active_id()))
            return c

        def switch(name, on=None):
            w = Gtk.Switch(active=bool(s.get(name)), halign=Gtk.Align.START)
            def changed(w, _p):
                s[name] = w.get_active()
                save_settings(s)
                if on:
                    on(w.get_active())
            w.connect('notify::active', changed)
            return w

        def spin(name, lo, hi, step=1):
            w = Gtk.SpinButton.new_with_range(lo, hi, step)
            w.set_value(s[name])
            def changed(w):
                s[name] = w.get_value_as_int()
                save_settings(s)
            w.connect('value-changed', changed)
            return w

        def setter(name, conv=int):
            def on(v):
                s[name] = conv(v)
                save_settings(s)
            return on

        def langs(name):
            e = Gtk.Entry(text=', '.join(s[name]), placeholder_text='ukr, eng')
            def changed(w):
                s[name] = [x.strip().lower() for x in w.get_text().split(',') if x.strip()]
                save_settings(s)
            e.connect('changed', changed)
            return e

        g = page('Picture and sound')
        add(g, 'Player bars stay up for (s)', spin('banner', 1, 30), 'After the last key; then only the picture.')
        add(g, 'Picture shape', combo([(0, 'As broadcast'), (1, 'Full screen (stretched)'), (2, '4:3'), (3, '16:9')],
                                      s['aspect'], setter('aspect')), 'The blue key changes it while watching.')
        add(g, 'Audio languages, in order', langs('audio_langs'), 'ISO 639 codes. The yellow key changes the track '
            'and stereo / left / right while watching; the choice is kept per channel.')
        add(g, 'Audio', combo([(0, 'Stereo'), (1, 'Left channel on both'), (2, 'Right channel on both')],
                              s['audio_mode'], setter('audio_mode')))
        add(g, 'Subtitles on by default', switch('subtitles'))
        add(g, 'Subtitle languages, in order', langs('subtitle_langs'), 'The green key turns them on and off.')
        add(g, 'Teletext characters', combo([(0, 'Latin (Western Europe)'), (32, 'Cyrillic (Ukrainian, Russian)')],
                                            s['teletext_region'], setter('teletext_region')),
            'For pages that don\'t name their character set. The text key opens teletext.')

        g = page('Antenna')

        def antenna(on):
            fe = self.app.fe
            try:
                if fe:
                    fe.antenna(on)
                self.set_status('Antenna power %s' % ('on: 5 V' if on else 'off'))
            except RuntimeError as e:
                self.set_status('Antenna power: %s' % e)
        add(g, '5 V antenna power', switch('antenna_power', antenna),
            'For an active antenna (with an amplifier) powered through its cable. Leave it off for a passive '
            'antenna, or one with its own power supply.')
        sigs = s['signals']
        if sigs:
            g.attach(self.label('Signal when last tuned', 'section'), 0, g.row, 2, 1)
            g.row += 1
            for khz in sorted(sigs, key=int):
                lv, q, at = sigs[khz]
                g.attach(self.label('%d MHz: level %d%%, quality %d%%  (%s)' % (int(khz) // 1000, lv, q, time.strftime(
                    '%d.%m %H:%M', time.localtime(at)))), 0, g.row, 2, 1)
                g.row += 1

        g = page('Recording')
        options = [('auto', 'The first USB drive (else the internal memory)')] + [(p, l) for p, l in drives()] + \
                  [(NAND, 'Internal memory')]
        add(g, 'Record to', combo(options, s['drive'] or 'auto', setter('drive', lambda v: '' if v == 'auto' else v)),
            'In a "%s" folder there. Now: %s' % (RECORDINGS, recording_drive(s) or 'nowhere'))
        add(g, 'The record key records', combo([('programme', 'Until the programme ends'), ('30', '30 min'),
                                                ('60', '1 hour'), ('120', '2 hours'), ('240', '4 hours'),
                                                ('0', 'Until stopped')],
                                               s['instant'], setter('instant', lambda v: v if v == 'programme' else int(v))))
        add(g, 'Timers start early by (min)', spin('margin_before', 0, 30))
        add(g, 'and end late by (min)', spin('margin_after', 0, 60))
        add(g, 'Pause live TV: buffer in memory (MB)', spin('timeshift_mb', 16, 128, 8),
            'About 2 minutes per 64 MB of an SD channel.')
        add(g, 'Or on the recording drive', switch('timeshift_drive'))
        add(g, 'Buffer on the drive (MB)', spin('timeshift_drive_mb', 256, 16384, 256),
            'From the next time you watch.')

        g = page('Parental control')

        def change_pin():
            old = self.ask('PIN', 'The PIN now (0000 if never set):', password=True)
            if old is None:
                return
            if not pin_ok(s, old):
                self.set_status('Wrong PIN')
                return
            new = self.ask('PIN', 'The new PIN, four digits:', password=True)
            if new and re.fullmatch(r'\d{4}', new) and self.ask('PIN', 'Once more:', password=True) == new:
                s['pin'] = pin_hash(new)
                save_settings(s)
                self.set_status('PIN changed')
            else:
                self.set_status('PIN not changed: four digits, the same twice')
        b = Gtk.Button(label='Change the PIN…', halign=Gtk.Align.START)
        b.connect('clicked', lambda w: later(change_pin))
        add(g, 'PIN', b, 'It is 0000 until changed. Locked channels (the channel\'s menu) need it each time the '
            'player starts.')
        add(g, 'Programmes rated', combo([(0, 'Any age'), (6, '6+ and over need the PIN'), (12, '12+ and over…'),
                                          (16, '16+ and over…'), (18, '18+ only…')], s['age'], setter('age')),
            'From the age rating the broadcast gives (Zeonbud gives none for most programmes).')
        add(g, 'Lock the TV menu', switch('lock_menu'), 'Settings, scans and editing the list need the PIN.')

        g = page('Channels')

        def backup():
            usb = drives()
            if not usb:
                self.set_status('No USB drive')
                return
            dest = os.path.join(usb[0][0], 'ozone-tv-backup-%s' % time.strftime('%Y%m%d-%H%M'))
            os.makedirs(dest, exist_ok=True)
            for f, name in ((CHANNELS, 'channels.json'), (SETTINGS, 'settings.json'), (TIMERS, 'timers.json'),
                            (EPG, 'epg.json')):
                if os.path.exists(f):
                    shutil.copy(f, os.path.join(dest, name))
            self.set_status('Saved to %s' % dest)

        def restore():
            found = sorted((os.path.join(p, n) for p, _l in drives() for n in os.listdir(p)
                            if n.startswith('ozone-tv-backup-') and os.path.isdir(os.path.join(p, n))), reverse=True)
            if not found:
                self.set_status('No ozone-tv-backup-* folder on the USB drives')
                return
            if not self.confirm('Replace the channel list, settings and timers with the backup %s?' % found[0]):
                return
            for n, f in (('channels.json', CHANNELS), ('settings.json', SETTINGS), ('timers.json', TIMERS),
                         ('epg.json', EPG)):
                if os.path.exists(os.path.join(found[0], n)):
                    shutil.copy(os.path.join(found[0], n), f)
            self.app.settings.clear()
            self.app.settings.update(load_settings())
            self.set_status('Restored from %s' % found[0])
            d.response(Gtk.ResponseType.CLOSE)

        def reset():
            if not self.confirm('Delete the channel list, the guide, the timers and the settings? Recordings stay.'):
                return
            for f in (CHANNELS, SETTINGS, TIMERS, EPG):
                try:
                    os.unlink(f)
                except OSError:
                    pass
            self.app.settings.clear()
            self.app.settings.update(load_settings())
            self.set_status('TV data reset: scan for channels')
            d.response(Gtk.ResponseType.CLOSE)

        for text, action, hint in (
                ('Scan channels…', lambda: (d.response(Gtk.ResponseType.CLOSE), self.scan_dialog()),
                 'The whole band, one frequency, or a network search.'),
                ('Sort by number (LCN)', lambda: self.sort('lcn') or self.set_status('Sorted by number'), None),
                ('Sort A–Z', lambda: self.sort('name') or self.set_status('Sorted by name'), None),
                ('Back up to USB', backup, 'The channel list, lists, settings, timers and guide, into an '
                 'ozone-tv-backup-<date> folder on the first USB drive.'),
                ('Restore from USB…', restore, 'From the newest backup folder on the USB drives.'),
                ('Reset TV data…', reset, 'Everything but the recordings: then scan again.')):
            b = Gtk.Button(label=text, halign=Gtk.Align.START)
            b.connect('clicked', lambda w, a=action: later(a))
            g.attach(b, 0, g.row, 1, 1)
            if hint:
                g.attach(self.label(hint, 'hint', wrap=True, max_width_chars=50), 1, g.row, 1, 1)
            g.row += 1

        d.show_all()
        d.run()
        d.destroy()
        self.app.settings.update(load_settings())
        self.refresh()

    # keys

    def on_list_click(self, w, ev):
        if ev.button == 3:
            row = self.list.get_row_at_y(int(ev.y))
            if row:
                self.list.select_row(row)
                self.row_menu(row)
            return True
        return False

    def row_menu(self, row):
        if hasattr(row, 'rec'):
            self.recording_menu(row)
        elif hasattr(row, 'timer'):
            self.timer_menu(row)
        else:
            self.channel_menu(row)

    def on_key(self, w, ev):
        from gi.repository import Gdk
        k = Gdk.keyval_name(ev.keyval)
        name = (k or '').replace('KP_', '')
        digit = name if len(name) == 1 and name.isdigit() else None
        focus = self.win.get_focus()
        in_list = focus and focus.get_parent() is self.list
        if digit and self.group not in (RECORDED, TIMERS_VIEW) and not isinstance(focus, self.Gtk.Entry):
            # digits typed within 1.5 s make one number: that channel is selected (OK watches)
            now = time.monotonic()
            self.typed = (self.typed if now - self.typed_at < 1.5 else '')[-2:] + digit
            self.typed_at = now
            if 1 <= int(self.typed) <= len(self.rows):
                self.select(int(self.typed) - 1)
            return True
        if k == 'Escape':
            self.win.destroy()
            return True
        if k in ('Menu', 'F2', 'Launch4'):   # the remote's blue key
            row = self.list.get_selected_row()
            if focus and focus.get_parent() is self.sched:
                self.event_menu(focus)
            elif row:
                self.row_menu(row)
            return True
        if k in ('Tab', 'Launch2') and not isinstance(focus, self.Gtk.Entry):   # green: the next list
            self.next_group()
            return True
        if k == 'Right' and in_list:
            rows = [r for r in self.sched.get_children() if r.get_selectable()]
            cur = [r for r in rows if r.get_style_context().has_class('current')]
            if rows:
                (cur or rows)[0].grab_focus()
                self.sched.select_row((cur or rows)[0])
            return True
        if k == 'Left' and focus and focus.get_parent() is self.sched:
            row = self.list.get_selected_row()
            if row:
                row.grab_focus()
            return True
        return False


# ---- logs and the command line --------------------------------------------------------------------

def logger_entry(buf):
    """One Android logger v1 entry: (sec, pid, priority, tag, message), or None"""
    if len(buf) < 20:
        return None
    n, _pad, pid, _tid, sec, _nsec = struct.unpack_from('<HHiiii', buf)
    payload = buf[20:20 + n]
    tag, _, msg = payload[1:].partition(b'\0')
    return (sec, pid, payload[0] if payload else 0, tag.decode(errors='replace'),
            msg.rstrip(b'\0\n').decode(errors='replace'))


def show_log():
    """Android logger v1 entries from /dev/log/main"""
    fd = os.open('/dev/log/main', os.O_RDONLY | os.O_NONBLOCK)
    while True:
        try:
            entry = logger_entry(os.read(fd, 5 * 1024))
        except BlockingIOError:
            break
        if not entry:
            break
        sec, pid, _prio, tag, msg = entry
        print('%s %s(%d): %s' % (time.strftime('%H:%M:%S', time.localtime(sec)), tag, pid, msg))


def show_logs():
    runs = sorted(n for n in os.listdir(LOGS) if n.startswith('tv-')) if os.path.isdir(LOGS) else []
    print(LOGS)
    for n in runs:
        print('  ' + n)
    if runs:
        print(os.path.join(LOGS, runs[-1], 'tv.log'))


def main(argv):
    global BUSY, CHANNELS
    args = argv[1:]
    test = None
    if '--test' in args:
        i = args.index('--test')
        test = args[i + 1]
        del args[i:i + 2]
        CHANNELS = os.path.join(DATA, 'channels-test.json')   # the real list stays as it is
    cmd = args[0] if args else 'menu'
    if cmd in ('log', 'logs'):
        return show_log() if cmd == 'log' else show_logs()
    if cmd == 'timers':
        return timer_service()
    if cmd == 'now':
        guide = Guide()
        for i, c in enumerate(group_list(load_channels(), load_settings(), ALL)):
            print('%4d  %-24s %s' % (channel_number(c, i), c['name'], on_now(guide, c)))
        return 0
    if cmd == 'antenna' and len(args) > 1:
        s = load_settings()
        s['antenna_power'] = args[1] == 'on'
        save_settings(s)
    # the window, a channel and timers go to the process that runs, if one does
    if cmd in ('menu', 'play', 'timer') and not test:
        reply = control({'menu': 'show', 'timer': 'timers'}.get(cmd, ' '.join(args)))
        if reply is not None:
            if reply != 'ok':
                print(reply)
            return 0
    # one at a time: a second run would start a second dtvfe on the same tuner
    os.makedirs(DATA, exist_ok=True)
    lock = open(LOCK, 'a+')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.seek(0)
        notify('TV is busy: %s' % (lock.read().strip() or 'another ozone-tv is running'))
        return 1
    BUSY = lock
    busy({'menu': 'the TV window is open', 'play': 'watching TV', 'timer': 'a timer'}.get(cmd, 'ozone-tv ' + cmd))
    LOG.start(cmd + ('-test' if test else ''))
    try:
        return run(cmd, args, test)
    except SystemExit as e:
        LOG.write('tv', 'exit %s' % e.code)
        raise
    except KeyboardInterrupt:
        return 130
    except BaseException as e:
        LOG.write('tv', traceback.format_exc())
        notify('TV error: %s' % e)
        raise
    finally:
        LOG.write('tv', 'done')
        LOG.close()


def run(cmd, args, test):
    if cmd in ('menu', 'play', 'timer'):
        app = TvApp(test)
        if cmd == 'play' and len(args) > 1:
            return app.run(('play', int(args[1])))
        return app.run(('menu',) if cmd == 'menu' else ('timer',))
    if cmd in ('guide', 'scan', 'status', 'antenna'):
        fe = open_frontend(test)
        try:
            if cmd == 'guide':
                update_guide(fe)
            elif cmd == 'antenna':
                print('antenna power', 'on' if fe.antenna(len(args) > 1 and args[1] == 'on') else 'off')
            elif cmd == 'status' and len(args) > 1:
                print(fe.tune(int(args[1]), int(args[2]) if len(args) > 2 else 8))
                while True:
                    time.sleep(1)
                    locked, strength, quality = fe.status()
                    print('locked' if locked else 'no lock', 'level %d%%' % strength, 'quality %d%%' % quality, flush=True)
            elif cmd == 'scan':
                if test:
                    channels = scan(fe, [(0, 8, 0)], test)[0]
                elif len(args) > 2 and args[1] == '--nit':
                    channels = nit_search(fe, int(args[2]), int(args[3]) if len(args) > 3 else 8) or []
                elif len(args) > 2 and args[1] == '--freq':
                    channels = scan(fe, [(int(args[2]), int(args[3]) if len(args) > 3 else 8,
                                          int(args[4]) if len(args) > 4 else 0)])[0]
                else:
                    first, last = (int(args[1]), int(args[2])) if len(args) > 2 else (21, 60)
                    channels = scan(fe, uhf(first, last))[0]
                for c in channels:
                    print('%4s  %-28s %4d MHz  sid %-5d %s %s%s' % (
                        c['lcn'] or '', c['name'], c['freq_khz'] // 1000, c['sid'],
                        'radio' if c['radio'] else c['video']['codec'],
                        ' '.join('%s/%s' % (a['codec'], a['lang'] or '-') for a in c['audio']),
                        ' subs ' + ','.join(t['lang'] for t in c.get('subtitles', [])) if c.get('subtitles') else ''))
            else:
                sys.exit(__doc__)
        except KeyboardInterrupt:
            pass
        finally:
            fe.close()
        return 0
    sys.exit(__doc__)


if __name__ == '__main__':
    sys.exit(main(sys.argv))
