#!/usr/bin/python3
"""ozone-tv: DVB-T/T2 television in native Linux.

The frontend (AVL6762 demodulator + MxL608 tuner) is driven by dtvfe, which runs the TV app's own
Android libraries (see ozone-dtv). Everything after the demodulator is the kernel's regular DVB
demux: section filters for the tables (PAT, PMT, SDT, NIT, EIT), and PES filters with TS output on
the services in use, read from dvr0. The watched service goes into the live buffer, a run of
segment files that amplay --tv plays from with the hardware decoder, and that is also the
timeshift buffer; a recording is the same data written to a drive.

  ozone-tv                        the TV window: channels, what's on, the guide; Enter to watch
  ozone-tv play N                 watch channel N of the list
  ozone-tv timers                 the timer service (bspwmrc starts it): recordings and reminders
  ozone-tv scan [FROM TO]         scan UHF channels FROM..TO (default 21..60, 8 MHz)
  ozone-tv scan --freq KHZ [BW [PLP]]   scan one multiplex
  ozone-tv scan --nit KHZ [BW]    the multiplexes the network lists (NIT), from the one at KHZ
  ozone-tv guide                  update the programme guide (tunes each multiplex for a while)
  ozone-tv now                    what's on every channel, from the guide
  ozone-tv status KHZ [BW]        tune and print the signal once a second (aiming the antenna)
  ozone-tv antenna on|off         the 5 V power for an active antenna (kept in the settings)
  ozone-tv log                    the frontend libraries' messages (Android log)
  ozone-tv logs                   where the session logs are, and the latest one

  --test FILE: instead of the tuner, FILE (a TS) is fed into the demux from memory, as a single
  multiplex at 0 kHz; tests the scanner and player without an antenna.

One ozone-tv process drives the tuner at a time. The TV window, the player and recordings are all
that one process, which keeps the frontend open between them (starting it takes 1-4 s); running
`ozone-tv`, `ozone-tv play N` or a timer again hands the request to it through a socket in the data
directory. It ends when the window is closed and nothing is being watched or recorded.

Data, in ~/.local/share/ozone-tv: channels.json (the list, with what the viewer changed: order,
names, skips, locks, tracks, PIDs), settings.json, timers.json, epg.json (the programme guide, from
the broadcast EIT: Zeonbud's multiplexes carry now/next and a week of schedule for all of them, so
whatever is tuned fills in most of it; 'ozone-tv guide' visits every multiplex for the rest). With
--test, channels-test.json. Recordings go to Recordings/ on the chosen drive, a .ts and a .json
each.

The player (amplay --tv) stays up while channels change: a switch is the tune (only for another
multiplex, ~1.2 s) and the next keyframe (Zeonbud: one a second), not a new player. Its keys: see
MANUAL.md, and osd.c.

Every run is logged, without needing a network: /mnt/nand/linux/logs/tv-<time>-<command>/tv.log
(the data partition, where Android's own logs go too, see hybrid/box/android-log.sh) has what
ozone-tv did, the frontend's replies, the libraries' Android log, the kernel log, amplay's
messages and the signal every 3 s while watching; a scan adds the raw tables and 3 s of every
multiplex found (mux-<MHz>.ts), to replay later with --test. The last 30 runs are kept.
"""
import fcntl
import hashlib
import json
import os
import queue
import re
import select
import shutil
import socket
import struct
import subprocess
import sys
import threading
import time
import traceback

DTVFE = '/usr/local/lib/ozone/dtvfe'
DEMUX = '/dev/dvb/adapter0/demux0'
DVR = '/dev/dvb/adapter0/dvr0'
DEMUX_SOURCE = '/sys/class/stb/demux0_source'
ASYNCFIFO_SOURCE = '/sys/class/stb/asyncfifo0_source'
ASYNCFIFO_FLUSH = '/sys/class/stb/asyncfifo0_flush_size'
FLUSH_SIZE = 16384
NO_DATA_TIMEOUT = 10   # s without a byte from dvr0 before saying so
RELOCK_AFTER = 2       # signal checks (3 s apart) without lock while watching before tuning again
DATA = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'), 'ozone-tv')
CHANNELS = os.path.join(DATA, 'channels.json')
SETTINGS = os.path.join(DATA, 'settings.json')
TIMERS = os.path.join(DATA, 'timers.json')
LOCK = os.path.join(DATA, 'busy')   # held by the process that drives the tuner
CONTROL = os.path.join(DATA, 'control')   # its socket
EPG = os.path.join(DATA, 'epg.json')
OSD_CHANNELS = os.path.join(DATA, 'osd-channels.txt')   # the player's channel list
EPG_KEEP = 3 * 3600        # s of programmes already over kept in the guide
GUIDE_SECONDS = 25         # per multiplex, for 'ozone-tv guide'
EIT_PID, TDT_PID = 0x12, 0x14
NAND = '/mnt/nand/linux'   # the data partition: logs, and recordings without a USB drive
LOGS = NAND + '/logs' if os.access(NAND, os.W_OK) else os.path.join(DATA, 'logs')
SAMPLE_SECONDS = 3
SEG_BYTES = 8 << 20        # the live buffer's segment files (as amplay's SEG_BYTES)
LIVE_MEMORY = '/dev/shm'
RECORDINGS = 'Recordings'  # the folder on the drive
MEDIA = '/media'

# linux/dvb/dmx.h
DMX_START = 0x6f29
DMX_STOP = 0x6f2a
DMX_SET_FILTER = 0x403c6f2b       # struct dmx_sct_filter_params, 60 bytes
DMX_SET_PES_FILTER = 0x40146f2c   # struct dmx_pes_filter_params, 20 bytes
DMX_SET_BUFFER_SIZE = 0x6f2d
DMX_CHECK_CRC, DMX_IMMEDIATE_START = 1, 4
DMX_IN_FRONTEND, DMX_OUT_TS_TAP, DMX_PES_OTHER = 0, 2, 20

VIDEO_TYPES = {0x01: 'mpeg1', 0x02: 'mpeg2', 0x1b: 'h264', 0x24: 'hevc'}
AUDIO_TYPES = {0x03: 'mp2', 0x04: 'mp2', 0x0f: 'aac', 0x11: 'aac-latm', 0x81: 'ac3', 0x87: 'eac3'}
RADIO_SERVICE_TYPES = {0x02, 0x07, 0x0a}

DEFAULTS = {
    'antenna_power': False,        # 5 V on the antenna input
    'banner': 4,                   # s the player's bars stay up after a key
    'aspect': 0,                   # the video layer's screen mode (see amplay's ASPECTS)
    'audio_langs': ['ukr', 'eng'], # preferred audio, first and second
    'audio_mode': 0,               # 0 stereo, 1 left, 2 right
    'subtitles': False,            # on by default where there are some in subtitle_langs
    'subtitle_langs': ['ukr', 'eng'],
    'teletext_region': 0,          # characters of pages that don't say: 0 Latin, 32 Cyrillic
    'timeshift_mb': 64,            # the live buffer in memory: ~2 min of an SD channel
    'timeshift_drive': False,      # or on the recording drive, this much
    'timeshift_drive_mb': 2048,
    'drive': '',                   # recordings: a mount point, '' for the first USB drive
    'instant': 'programme',        # an instant recording stops at the programme's end, or after N min
    'margin_before': 1,            # min, for recordings from the guide
    'margin_after': 5,
    'pin': '',                     # sha256 of the PIN; '' is 0000
    'age': 0,                      # programmes rated this age or more need the PIN; 0 off
    'lock_menu': False,            # settings, scans and editing need the PIN
    'groups': {'Favourites': []},  # favourites: name -> channel keys
    'group': 'All',
    'signals': {},                 # kHz -> [level, quality, time] last seen
}
ALL, RADIO, RECORDED, TIMERS_VIEW = 'All', 'Radio', 'Recordings', 'Timers'


class Log:
    """One file per run with everything that happened, from every source, in time order. Lines
    are written as they come and the file is synced at least every second, so a kernel oops (it
    reboots the box) or a pulled plug loses at most that second."""

    KERNEL_NOISE = re.compile(r'audio data unligned|CTS_CPU_CLK')   # several lines a second
    STATE = ['/sys/class/stb/' + n for n in ('source', 'demux0_source', 'demux1_source', 'tso_source',
                                              'asyncfifo0_source', 'dsc_source', 'hw_setting',
                                              'demux0_filter_users', 'demux0_free_filters', 'dvr0_mode')]

    def __init__(self):
        self.f, self.dir, self.synced = None, None, 0
        self.lock = threading.Lock()

    def start(self, what):
        try:
            os.makedirs(LOGS, exist_ok=True)
            runs = sorted(n for n in os.listdir(LOGS) if n.startswith('tv-'))
            for old in runs[:-29]:
                subprocess.call(['rm', '-rf', os.path.join(LOGS, old)])
            self.dir = os.path.join(LOGS, 'tv-%s-%s' % (time.strftime('%Y%m%d-%H%M%S'), what))
            os.makedirs(self.dir, exist_ok=True)
            self.f = open(os.path.join(self.dir, 'tv.log'), 'a', buffering=1)
        except OSError as e:
            print('no log: %s' % e, file=sys.stderr)
            return
        self.started = time.time()
        self.write('tv', 'ozone-tv %s (pid %d)' % (' '.join(sys.argv[1:]), os.getpid()))
        self.environment()
        threading.Thread(target=self._kernel, daemon=True).start()
        threading.Thread(target=self._android, daemon=True).start()

    def write(self, src, text):
        if not self.f:
            return
        t = time.time()
        stamp = time.strftime('%H:%M:%S', time.localtime(t)) + '.%03d' % (t % 1 * 1000)
        with self.lock:
            try:
                for line in str(text).splitlines() or ['']:
                    self.f.write('%s [%s] %s\n' % (stamp, src, line))
                if t - self.synced >= 1:
                    self.f.flush()
                    os.fsync(self.f.fileno())
                    self.synced = t
            except (OSError, ValueError):
                pass

    def path(self, name):
        return os.path.join(self.dir, name) if self.dir else None

    def close(self):
        if getattr(self, 'dmesg', None):
            self.dmesg.terminate()
        with self.lock:
            if self.f:
                self.f.flush()
                os.fsync(self.f.fileno())
                self.f.close()
                self.f = None

    def environment(self):
        def read(path):
            try:
                with open(path) as f:
                    return f.read().strip()
            except OSError as e:
                return '(%s)' % e.strerror
        self.write('env', 'kernel %s, uptime %s s' % (os.uname().release, read('/proc/uptime').split()[0]))
        self.write('env', '/system mounted: %s, /dev/__properties__: %s, dtvfe: %s, i2c-2: %s' % (
            os.path.ismount('/system'), os.path.exists('/dev/__properties__'), os.access(DTVFE, os.X_OK),
            os.path.exists('/dev/i2c-2')))
        self.write('env', 'dvb nodes: %s' % ' '.join(sorted(os.listdir('/dev/dvb/adapter0')))
                   if os.path.isdir('/dev/dvb/adapter0') else 'no /dev/dvb/adapter0')
        for f in self.STATE:
            self.write('env', '%s: %s' % (f, read(f)))
        self.write('env', 'channels in the list: %d' % len(load_channels()))

    def _kernel(self):
        try:
            self.dmesg = subprocess.Popen(['dmesg', '-w'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                          text=True, errors='replace')
        except OSError as e:
            self.write('kernel', 'dmesg: %s' % e)
            return
        # dmesg -w starts with the whole buffer: only what came after this run started
        since = float(open('/proc/uptime').read().split()[0]) - 2
        try:
            for line in self.dmesg.stdout:
                m = re.match(r'\[\s*(\d+\.\d+)\]', line)
                if m and float(m.group(1)) < since or self.KERNEL_NOISE.search(line):
                    continue
                self.write('kernel', line.rstrip())
        except BaseException:   # the interpreter shutting down under this daemon thread
            pass

    def _android(self):
        """The libraries log through Android's logger (/dev/log/main, see ozone-dtv)"""
        try:
            fd = os.open('/dev/log/main', os.O_RDONLY)
        except OSError as e:
            self.write('lib', '/dev/log/main: %s' % e.strerror)
            return
        while True:
            try:
                entry = logger_entry(os.read(fd, 5 * 1024))
            except OSError:
                return
            # the logger keeps older entries: only this run's
            if entry and entry[0] >= self.started - 2:
                _sec, pid, prio, tag, msg = entry
                self.write('lib', '%s%s(%d): %s' % ('VDIWEF'[prio - 2] + ' ' if 2 <= prio <= 7 else '', tag, pid, msg))


LOG = Log()


def notify(text):
    print(text, flush=True)
    LOG.write('tv', text)
    if os.environ.get('DISPLAY'):
        subprocess.call(['ozone-notify', text], stderr=subprocess.DEVNULL)


BUSY = None


def busy(text):
    """What this run is doing, for a second one that finds the lock taken"""
    if BUSY:
        BUSY.seek(0)
        BUSY.truncate()
        BUSY.write(text)
        BUSY.flush()


def say(text):
    """To the terminal and the log, not the panel"""
    print(text, flush=True)
    LOG.write('tv', text)


def pipe_to_log(stream, src):
    def run():
        for line in stream:
            LOG.write(src, line.rstrip())
    threading.Thread(target=run, daemon=True).start()


# ---- settings -----------------------------------------------------------------------------------

def load_settings():
    s = json.loads(json.dumps(DEFAULTS))   # a deep copy
    try:
        with open(SETTINGS) as f:
            s.update(json.load(f))
    except (OSError, ValueError):
        pass
    return s


def save_settings(s):
    os.makedirs(DATA, exist_ok=True)
    with open(SETTINGS + '.tmp', 'w') as f:
        json.dump(s, f, ensure_ascii=False, indent=1)
    os.replace(SETTINGS + '.tmp', SETTINGS)


def pin_hash(pin):
    return hashlib.sha256(('ozone-tv:' + pin).encode()).hexdigest()


def pin_ok(settings, pin):
    return (settings.get('pin') or pin_hash('0000')) == pin_hash(pin)


# ---- frontend -------------------------------------------------------------------------------------

class Frontend:
    """dtvfe, as root: the I2C bus, GPIOs and DVB nodes it opens are root's"""

    def __init__(self):
        # (Android's linker finds the libraries in /system/lib by itself)
        cmd = [DTVFE] if os.geteuid() == 0 else ['sudo', '-n', DTVFE]
        t = time.monotonic()
        self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=subprocess.PIPE, text=True, bufsize=1)
        pipe_to_log(self.p.stderr, 'dtvfe')
        reply = self.p.stdout.readline().split()
        LOG.write('fe', 'start: %s (%.1f s)' % (' '.join(reply) or 'no reply, exit %s' % self.p.poll(),
                                                time.monotonic() - t))
        if not reply or reply[0] != 'ready':
            raise RuntimeError('frontend: ' + (' '.join(reply) or 'dtvfe did not start'))
        self.khz = None
        self.lock = threading.Lock()   # the signal monitor asks while the player runs
        route_dvr()

    def _ask(self, line, fields=4):
        with self.lock:
            t = time.monotonic()
            self.p.stdin.write(line + '\n')
            reply = self.p.stdout.readline().split()
            LOG.write('fe', '%s -> %s (%.2f s)' % (line, ' '.join(reply) or 'no reply, exit %s' % self.p.poll(),
                                                   time.monotonic() - t))
        if len(reply) != fields:
            raise RuntimeError('frontend: ' + (' '.join(reply) or 'dtvfe died'))
        return tuple(int(x) for x in reply[1:])

    def tune(self, khz, bw=8, plp=0):
        """(locked, strength %, quality %). The driver waits up to ~2.5 s for a lock itself;
        DVB-T2 sometimes needs a little longer"""
        self.khz = khz
        st = self._ask('tune %d %d %d' % (khz, bw, plp))
        for _ in range(3):
            if st[0]:
                break
            time.sleep(0.5)
            st = self._ask('status')
        return st

    def status(self):
        return self._ask('status')

    def antenna(self, on):
        return self._ask('antenna %d' % bool(on), 2)[0]

    def close(self):
        try:
            self.p.stdin.write('quit\n')
            self.p.stdin.close()
            self.p.wait(5)
        except (OSError, subprocess.TimeoutExpired):
            self.p.kill()


def route_dvr():
    """From the tuner input, TS-tap filters reach dvr0 through an asyncfifo (DMA) fed by the demux,
    and nothing selects one after boot: without this, sections arrive but dvr0 stays empty. The
    DMA passes data on in blocks of flush_size, 256 KB after boot: at the 2-5 Mbit/s of a service
    that was 0.5-1.3 s before a new channel's first packet; 16 KB is ~40 ms."""
    for path, want in ((ASYNCFIFO_SOURCE, 'dmx0'), (ASYNCFIFO_FLUSH, str(FLUSH_SIZE))):
        try:
            with open(path) as f:
                cur = f.read().strip()
            if cur != want:
                with open(path, 'w') as f:
                    f.write(want)
            LOG.write('dmx', '%s: %r -> %s' % (os.path.basename(path), cur, want))
        except OSError as e:
            LOG.write('dmx', '%s: %s' % (os.path.basename(path), e))


class TestFrontend:
    """--test: a TS file fed into demux0 from memory, looping, paced at OZONE_TV_TEST_RATE bit/s
    (default 7 M, the rate of the generated test multiplex)"""

    def __init__(self, path):
        self.path = path
        self.khz = None
        LOG.write('fe', 'test input: %s' % path)
        with open(DEMUX_SOURCE, 'w') as f:
            f.write('hiu')
        self.stop = threading.Event()
        threading.Thread(target=self._feed, daemon=True).start()

    def _feed(self):
        dvr = os.open(DVR, os.O_WRONLY)
        rate = float(os.environ.get('OZONE_TV_TEST_RATE', 7e6))
        start, sent = time.monotonic(), 0
        while not self.stop.is_set():
            with open(self.path, 'rb') as f:
                while not self.stop.is_set():
                    data = f.read(188 * 348)
                    if not data:
                        break
                    os.write(dvr, data)
                    sent += len(data)
                    time.sleep(max(0, start + sent * 8 / rate - time.monotonic()))
        os.close(dvr)

    def tune(self, khz, bw=8, plp=0):
        self.khz = khz
        return (1, 100, 100) if khz == 0 else (0, 0, 0)

    def status(self):
        return (1, 100, 100)

    def antenna(self, on):
        return int(bool(on))

    def close(self):
        self.stop.set()
        with open(DEMUX_SOURCE, 'w') as f:
            f.write('ts0')   # back to the tuner's TS input


def open_frontend(test):
    fe = TestFrontend(test) if test else Frontend()
    try:
        fe.antenna(load_settings().get('antenna_power'))
    except RuntimeError as e:
        LOG.write('fe', 'antenna power: %s' % e)
    return fe


# ---- tables -------------------------------------------------------------------------------------

def read_sections(pid, table_id, ext=None, timeout=3.0):
    """All sections of one table (current version), as a list of bytes, or [] on timeout"""
    fd = os.open(DEMUX, os.O_RDWR | os.O_NONBLOCK)
    try:
        filt, mask = bytearray(16), bytearray(16)
        filt[0], mask[0] = table_id, 0xff
        if ext is not None:   # table_id_extension: the program number of a PMT
            filt[1], filt[2], mask[1], mask[2] = ext >> 8, ext & 0xff, 0xff, 0xff
        fcntl.ioctl(fd, DMX_SET_FILTER, struct.pack('<H16s16s16s2xII', pid, bytes(filt), bytes(mask), bytes(16),
                                                    int(timeout * 1000), DMX_CHECK_CRC | DMX_IMMEDIATE_START))
        got, last, end = {}, None, time.monotonic() + timeout
        while time.monotonic() < end:
            if not select.select([fd], [], [], end - time.monotonic())[0]:
                break
            try:
                sec = os.read(fd, 4096)
            except OSError as e:   # timeout or overflow reported by the driver
                LOG.write('si', 'pid 0x%x table 0x%x: %s' % (pid, table_id, e.strerror))
                break
            if len(sec) < 12 or not sec[5] & 1:   # not current_next
                continue
            got[sec[6]] = sec
            last = sec[7]
            if last is not None and len(got) > last:
                break
        secs = [got[k] for k in sorted(got)]
        LOG.write('si', 'pid 0x%x table 0x%x%s: %s' % (pid, table_id, '' if ext is None else ' ext %d' % ext,
                                                       '%d section(s)' % len(secs) if secs else 'nothing in %.0f s' % timeout))
        for sec in secs:   # raw, for parsing again later
            LOG.write('si', '  ' + sec.hex())
        return secs
    finally:
        os.close(fd)


def dvb_text(b):
    """DVB SI text (EN 300 468 annex A) to str; Cyrillic usually comes as ISO 8859-5 (0x01)"""
    if not b:
        return ''
    enc, first = 'iso6937', b[0]
    if 0x01 <= first <= 0x0b:
        enc, b = 'iso8859-%d' % (first + 4), b[1:]
    elif first == 0x10 and len(b) >= 3:
        enc, b = 'iso8859-%d' % b[2], b[3:]
    elif first == 0x11:
        enc, b = 'utf-16-be', b[1:]
    elif first == 0x15:
        enc, b = 'utf-8', b[1:]
    elif first < 0x20:
        b = b[1:]
    try:
        text = b.decode(enc if enc != 'iso6937' else 'latin-1', errors='replace')
    except LookupError:
        text = b.decode('latin-1', errors='replace')
    # 0x8a is a line break; emphasis and other control codes (0x80-0x9f) out, and the NULs some
    # broadcasters pad with
    text = text.replace('\x8a', '\n')
    return ''.join(c for c in text if not 0x80 <= ord(c) <= 0x9f and c != '\0').strip()


def descriptors(b):
    i = 0
    while i + 2 <= len(b):
        tag, n = b[i], b[i + 1]
        yield tag, b[i + 2:i + 2 + n]
        i += 2 + n


def parse_pat(secs):
    progs = {}
    for s in secs:
        end = 3 + (((s[1] & 0x0f) << 8) | s[2]) - 4
        for i in range(8, end, 4):
            num, pid = (s[i] << 8) | s[i + 1], ((s[i + 2] & 0x1f) << 8) | s[i + 3]
            if num:
                progs[num] = pid
    return progs


def lang_of(d):
    return d[:3].decode('latin-1', errors='replace').strip('\0 ')


def parse_pmt(s):
    """A service's streams from its PMT section: the PCR PID, the video, the audio tracks, the
    subtitles (DVB, and teletext subtitle pages), the teletext PID"""
    end = 3 + (((s[1] & 0x0f) << 8) | s[2]) - 4
    pcr = ((s[8] & 0x1f) << 8) | s[9]
    i = 12 + (((s[10] & 0x0f) << 8) | s[11])
    video, audio, subs, ttx = None, [], [], None
    while i + 5 <= end:
        stype, pid = s[i], ((s[i + 1] & 0x1f) << 8) | s[i + 2]
        n = ((s[i + 3] & 0x0f) << 8) | s[i + 4]
        desc = dict(descriptors(s[i + 5:i + 5 + n]))
        lang = lang_of(desc[0x0a]) if 0x0a in desc else ''
        if stype in VIDEO_TYPES and video is None:
            video = {'pid': pid, 'codec': VIDEO_TYPES[stype]}
        elif stype in AUDIO_TYPES:
            audio.append({'pid': pid, 'codec': AUDIO_TYPES[stype], 'lang': lang})
        elif stype == 0x06 and (0x6a in desc or 0x7a in desc or 0x7c in desc):   # in private data
            audio.append({'pid': pid, 'codec': 'ac3' if 0x6a in desc else 'eac3' if 0x7a in desc else 'aac',
                          'lang': lang})
        elif stype == 0x06 and 0x59 in desc:   # DVB subtitles, a language each 8 bytes
            d = desc[0x59]
            for j in range(0, len(d) - 7, 8):
                subs.append({'pid': pid, 'type': 'd', 'lang': lang_of(d[j:j + 3]), 'page': 0})
        elif stype == 0x06 and (0x56 in desc or 0x46 in desc):   # teletext: its pages, 5 bytes each
            ttx = pid
            d = desc.get(0x56) or desc[0x46]
            for j in range(0, len(d) - 4, 5):
                kind, mag = d[j + 3] >> 3, d[j + 3] & 7 or 8
                if kind in (2, 5):   # subtitles, and for the hard of hearing
                    subs.append({'pid': pid, 'type': 't', 'lang': lang_of(d[j:j + 3]) + ('·HoH' if kind == 5 else ''),
                                 'page': mag << 8 | d[j + 4]})
        i += 5 + n
    return pcr, video, audio, subs, ttx


def parse_sdt(secs):
    services = {}
    for s in secs:
        end = 3 + (((s[1] & 0x0f) << 8) | s[2]) - 4
        i = 11
        while i + 5 <= end:
            sid = (s[i] << 8) | s[i + 1]
            free_ca = bool(s[i + 3] & 0x10)
            n = ((s[i + 3] & 0x0f) << 8) | s[i + 4]
            info = {'scrambled': free_ca}
            for tag, d in descriptors(s[i + 5:i + 5 + n]):
                if tag == 0x48 and len(d) >= 3:   # service_descriptor
                    plen = d[1]
                    info['type'] = d[0]
                    info['provider'] = dvb_text(d[2:2 + plen])
                    info['name'] = dvb_text(d[3 + plen:3 + plen + d[2 + plen]])
            services[sid] = info
            i += 5 + n
    return services


def parse_nit(secs):
    """The logical channel numbers (EACEM descriptor 0x83), service_id -> number, and the
    multiplexes the network lists: [(kHz, bandwidth MHz, PLP)] from terrestrial (0x5a) and T2
    (0x7f/0x04) delivery descriptors"""
    lcn, muxes = {}, []
    for s in secs:
        end = 3 + (((s[1] & 0x0f) << 8) | s[2]) - 4
        i = 10 + (((s[8] & 0x0f) << 8) | s[9])
        i += 2   # transport_stream_loop_length
        while i + 6 <= end:
            n = ((s[i + 4] & 0x0f) << 8) | s[i + 5]
            for tag, d in descriptors(s[i + 6:i + 6 + n]):
                if tag == 0x83:
                    for j in range(0, len(d) - 3, 4):
                        lcn[(d[j] << 8) | d[j + 1]] = ((d[j + 2] & 0x03) << 8) | d[j + 3]
                elif tag == 0x5a and len(d) >= 5:   # centre frequency in 10 Hz
                    bw = {0: 8, 1: 7, 2: 6, 3: 5}.get(d[4] >> 5, 8)
                    muxes.append((struct.unpack('>I', d[:4])[0] // 100, bw, 0))
                elif tag == 0x7f and len(d) >= 4 and d[0] == 0x04:   # T2: PLP, system, cells
                    plp = d[1]
                    if len(d) < 6:
                        continue
                    bw = {0: 8, 1: 7, 2: 6, 3: 5, 4: 10}.get((d[4] >> 2) & 0x0f, 8)
                    tfs = d[5] & 1
                    j = 6
                    while j + 2 < len(d):
                        j += 2   # cell_id
                        if tfs:
                            k = d[j]
                            freqs = [struct.unpack('>I', d[j + 1 + m:j + 5 + m])[0] for m in range(0, k, 4)]
                            j += 1 + k
                        else:
                            freqs = [struct.unpack('>I', d[j:j + 4])[0]]
                            j += 4
                        j += 1 + (d[j] if j < len(d) else 0)   # subcells
                        muxes += [(f // 100, bw, plp) for f in freqs]
            i += 6 + n
    return lcn, muxes


def bcd(b):
    return (b >> 4) * 10 + (b & 0x0f)


def mjd_utc(b):
    """5 bytes, MJD and BCD hh mm ss (EN 300 468 annex C), to Unix time; None if undefined"""
    if b == b'\xff' * 5:
        return None
    return (((b[0] << 8) | b[1]) - 40587) * 86400 + bcd(b[2]) * 3600 + bcd(b[3]) * 60 + bcd(b[4])


def parse_eit(s):
    """service_id and its events, (start, duration, title, description, age rating or 0), from one
    EIT section"""
    end = 3 + (((s[1] & 0x0f) << 8) | s[2]) - 4
    events = []
    i = 14
    while i + 12 <= end:
        start = mjd_utc(s[i + 2:i + 7])
        dur = bcd(s[i + 7]) * 3600 + bcd(s[i + 8]) * 60 + bcd(s[i + 9])
        n = ((s[i + 10] & 0x0f) << 8) | s[i + 11]
        title, text, ext, age = '', '', {}, 0
        for tag, d in descriptors(s[i + 12:i + 12 + n]):
            if tag == 0x4d and len(d) >= 5:   # short_event: language, name, text
                nl = d[3]
                title = dvb_text(d[4:4 + nl])
                if len(d) > 4 + nl:
                    text = dvb_text(d[5 + nl:5 + nl + d[4 + nl]])
            elif tag == 0x4e and len(d) >= 6:   # extended_event, in numbered parts: items, then text
                at = 5 + d[4]
                if at < len(d):
                    ext[d[0] >> 4] = dvb_text(d[at + 1:at + 1 + d[at]])
            elif tag == 0x55:   # parental_rating: country, minimum age - 3
                for j in range(0, len(d) - 3, 4):
                    if 0x01 <= d[j + 3] <= 0x0f:
                        age = max(age, d[j + 3] + 3)
        if ext:
            text = ''.join(ext[k] for k in sorted(ext)) or text
        if start is not None and title:
            events.append((start, dur, title, text, age))
        i += 12 + n
    return (s[3] << 8) | s[4], events


# ---- PSI for amplay and recordings ----------------------------------------------------------------

CRC_TABLE = []
for _i in range(256):
    _c = _i << 24
    for _ in range(8):
        _c = (_c << 1) ^ 0x04c11db7 if _c & 0x80000000 else _c << 1
    CRC_TABLE.append(_c & 0xffffffff)


def crc32_mpeg(b):
    crc = 0xffffffff
    for x in b:
        crc = ((crc << 8) & 0xffffffff) ^ CRC_TABLE[((crc >> 24) ^ x) & 0xff]
    return crc


def section(table_id, ext, body):
    sec = bytes([table_id]) + struct.pack('>HHBBB', 0xb000 | (5 + len(body) + 4), ext, 0xc1, 0, 0) + body
    return sec + struct.pack('>I', crc32_mpeg(sec))


def make_pat(ch):
    return section(0x00, 1, struct.pack('>HH', ch['sid'], 0xe000 | ch['pmt_pid']))


def make_pmt(ch):
    """The PMT as broadcast (kept from the scan), or one made from the channel's fields: lists
    scanned before it was kept, and PIDs edited by hand"""
    if ch.get('pmt_raw') and not ch.get('pids_edited'):
        return bytes.fromhex(ch['pmt_raw'])
    types = {'mpeg1': 0x01, 'mpeg2': 0x02, 'h264': 0x1b, 'hevc': 0x24, 'mp1': 0x03, 'mp2': 0x03, 'aac': 0x0f,
             'aac-latm': 0x11}
    def es(stype, pid, desc=b''):
        return struct.pack('>BHH', stype, 0xe000 | pid, 0xf000 | len(desc)) + desc
    body = b''
    if ch.get('video'):
        body += es(types.get(ch['video']['codec'], 0x1b), ch['video']['pid'])
    for a in ch['audio']:
        lang = b'\x0a\x04' + a['lang'].encode('latin-1', 'replace')[:3].ljust(3, b' ') + b'\0'
        if a['codec'] in ('ac3', 'eac3'):
            body += es(0x06, a['pid'], (b'\x6a\x01\0' if a['codec'] == 'ac3' else b'\x7a\x01\0') + lang)
        else:
            body += es(types.get(a['codec'], 0x03), a['pid'], lang)
    return section(0x02, ch['sid'], struct.pack('>HH', 0xe000 | (ch.get('pcr_pid') or 0x1fff), 0xf000) + body)


def ts_packets(pid, sec):
    out, first, cc = b'', True, 0
    while sec or first:
        head = bytes([0x47, (0x40 if first else 0) | pid >> 8, pid & 0xff, 0x10 | cc]) + (b'\0' if first else b'')
        chunk, sec = sec[:188 - len(head)], sec[188 - len(head):]
        out += (head + chunk).ljust(188, b'\xff')
        first, cc = False, (cc + 1) & 15
    return out


def channel_pids(ch):
    pids = {0x00, ch['pmt_pid']}
    if ch.get('pcr_pid') and ch['pcr_pid'] != 0x1fff:
        pids.add(ch['pcr_pid'])
    if ch.get('video'):
        pids.add(ch['video']['pid'])
    pids |= {a['pid'] for a in ch['audio']}
    pids |= {s['pid'] for s in ch.get('subtitles', [])}
    if ch.get('teletext'):
        pids.add(ch['teletext'])
    return pids


# ---- the guide ------------------------------------------------------------------------------------

class Guide:
    """The programme guide: for each service_id (unique across Zeonbud's multiplexes), its events.
    Kept in epg.json; the broadcast time (TDT) is kept too, for a box whose clock is off (no network,
    no RTC battery)."""

    def __init__(self):
        self.lock = threading.Lock()
        try:
            with open(EPG) as f:
                d = json.load(f)
        except (OSError, ValueError):
            d = {}
        self.events = {sid: [tuple(e) + (0,) * (5 - len(e)) for e in ev] for sid, ev in d.get('events', {}).items()}
        self.offset = d.get('clock_offset', 0)
        self.changed = False

    def now(self):
        """The broadcast's idea of the time if the box's is more than two minutes off"""
        return time.time() + (self.offset if abs(self.offset) > 120 else 0)

    def add(self, sid, events):
        with self.lock:
            have = {e[0]: e for e in self.events.get(str(sid), [])}
            for e in events:
                # a changed schedule: what the new event overlaps goes
                for start in [k for k, o in have.items() if k != e[0] and k < e[0] + e[1] and k + o[1] > e[0]]:
                    del have[start]
                if have.get(e[0]) != e:
                    have[e[0]] = e
                    self.changed = True
            self.events[str(sid)] = sorted(have.values())

    def set_time(self, utc):
        self.offset = utc - time.time()

    def save(self):
        with self.lock:
            if not self.changed:
                return
            cut = self.now() - EPG_KEEP
            events = {sid: [list(e) for e in ev if e[0] + e[1] > cut] for sid, ev in self.events.items()}
            self.changed = False
        try:
            with open(EPG + '.tmp', 'w') as f:
                json.dump({'events': events, 'clock_offset': self.offset, 'saved': time.time()}, f,
                          ensure_ascii=False)
            os.replace(EPG + '.tmp', EPG)
        except OSError as e:
            LOG.write('epg', 'save: %s' % e)

    def schedule(self, sid):
        with self.lock:
            return list(self.events.get(str(sid), []))

    def now_next(self, sid, t=None):
        """(the programme on at t (now), the one after), either None"""
        t = self.now() if t is None else t
        ev = self.schedule(sid)
        for i, e in enumerate(ev):
            if e[0] <= t < e[0] + e[1]:
                return e, ev[i + 1] if i + 1 < len(ev) else None
            if e[0] > t:
                return None, e
        return None, None


def hhmm(t):
    return time.strftime('%H:%M', time.localtime(t))


def on_now(guide, ch):
    """'21:00 News' for the channel lists, '' when the guide has nothing"""
    now, _next = guide.now_next(ch['sid'])
    return '%s %s' % (hhmm(now[0]), now[2]) if now else ''


class EitReader:
    """The EIT (and the TDT, for the time) of whatever multiplex is tuned, into the guide, in a
    thread until stop(). One section filter for all EIT tables (0x4e-0x6f: value 0x40, mask 0xc0)."""

    def __init__(self, guide):
        self.guide = guide
        self.fds = []
        for pid, value, mask in ((EIT_PID, 0x40, 0xc0), (TDT_PID, 0x70, 0xff)):
            fd = os.open(DEMUX, os.O_RDWR | os.O_NONBLOCK)
            filt, msk = bytearray(16), bytearray(16)
            filt[0], msk[0] = value, mask
            try:
                fcntl.ioctl(fd, DMX_SET_FILTER, struct.pack('<H16s16s16s2xII', pid, bytes(filt), bytes(msk),
                                                            bytes(16), 0, DMX_CHECK_CRC | DMX_IMMEDIATE_START))
            except OSError as e:
                LOG.write('epg', 'filter on 0x%x: %s' % (pid, e.strerror))
                os.close(fd)
                continue
            self.fds.append(fd)
        self.sections = self.events = 0
        self.stopped = threading.Event()
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def _run(self):
        saved = time.monotonic()
        while not self.stopped.is_set() and self.fds:
            for fd in select.select(self.fds, [], [], 0.5)[0]:
                try:
                    sec = os.read(fd, 4096)
                except OSError:   # overflow: the next one comes
                    continue
                if not sec:
                    continue
                if sec[0] == 0x70 and len(sec) >= 8:
                    t = mjd_utc(sec[3:8])
                    if t:
                        self.guide.set_time(t)
                    continue
                try:
                    sid, events = parse_eit(sec)
                except IndexError:
                    continue
                self.sections += 1
                self.events += len(events)
                if events:
                    self.guide.add(sid, events)
            if time.monotonic() - saved > 20:
                self.guide.save()
                saved = time.monotonic()

    def stop(self):
        self.stopped.set()
        self.thread.join(2)
        for fd in self.fds:
            os.close(fd)
        self.guide.save()
        LOG.write('epg', '%d EIT sections, %d events' % (self.sections, self.events))


def update_guide(fe, progress=say):
    """Every multiplex of the channel list in turn, GUIDE_SECONDS each, for the guide"""
    muxes = sorted({(c['freq_khz'], c['bandwidth'], c['plp']) for c in load_channels()})
    if not muxes:
        progress('No channels yet: scan first')
        return
    guide = Guide()
    for n, (khz, bw, plp) in enumerate(muxes, 1):
        progress('Guide %d/%d: %d MHz…' % (n, len(muxes), khz // 1000))
        busy('updating the guide (%d/%d)' % (n, len(muxes)))
        locked, _s, _q = fe.tune(khz, bw, plp)
        if not locked:
            continue
        reader = EitReader(guide)
        time.sleep(GUIDE_SECONDS)
        reader.stop()
    progress('Guide updated: %d channels with programmes' % sum(1 for c in load_channels() if guide.schedule(c['sid'])))


# ---- scanning -------------------------------------------------------------------------------------

def read_mux(khz, bw, plp):
    """The services of the multiplex the frontend is locked to, and the multiplexes its NIT lists"""
    progs = parse_pat(read_sections(0x00, 0x00))
    LOG.write('tv', 'PAT: %s' % ', '.join('service %d -> PMT 0x%x' % kv for kv in sorted(progs.items())))
    if not progs:
        return [], []
    sdt = parse_sdt(read_sections(0x11, 0x42, timeout=4))
    lcn, muxes = parse_nit(read_sections(0x10, 0x40, timeout=4))
    found = []
    for sid, pmt_pid in sorted(progs.items()):
        secs = read_sections(pmt_pid, 0x02, ext=sid, timeout=2)
        if not secs:
            continue
        pcr, video, audio, subs, ttx = parse_pmt(secs[0])
        info = sdt.get(sid, {})
        found.append({
            'name': info.get('name') or 'Service %d' % sid,
            'provider': info.get('provider', ''),
            'scrambled': info.get('scrambled', False),
            'type': info.get('type'),
            'radio': video is None or info.get('type') in RADIO_SERVICE_TYPES,
            'freq_khz': khz, 'bandwidth': bw, 'plp': plp,
            'sid': sid, 'pmt_pid': pmt_pid, 'pcr_pid': pcr,
            'video': video, 'audio': audio, 'subtitles': subs, 'teletext': ttx,
            'pmt_raw': secs[0].hex(),
            'lcn': lcn.get(sid),
        })
    for c in found:
        LOG.write('tv', 'service: %s' % json.dumps(c, ensure_ascii=False))
    return found, muxes


def record_sample(services, path, seconds=SAMPLE_SECONDS):
    """A few seconds of the multiplex (tables and every service's streams) for replaying with --test"""
    # the demux has 32 filters (31 free): tables first, then whole services while they fit
    pids = [0x00, 0x10, 0x11, 0x12, 0x14] + [c['pmt_pid'] for c in services]   # PAT NIT SDT EIT TDT, PMTs
    for c in services:
        more = [p for p in channel_pids(c) if p not in pids and p != 0x1fff]
        if len(pids) + len(more) > 28:
            break
        pids += more
    filters = Filters()
    filters.set(set(pids))
    dvr = os.open(DVR, os.O_RDONLY | os.O_NONBLOCK)
    size = 0
    try:
        with open(path, 'wb') as out:
            end = time.monotonic() + seconds
            while time.monotonic() < end:
                if not select.select([dvr], [], [], 0.5)[0]:
                    continue
                try:
                    data = os.read(dvr, 188 * 1024)
                except (BlockingIOError, OSError):
                    continue
                out.write(data)
                size += len(data)
    finally:
        os.close(dvr)
        filters.set(set())
    LOG.write('tv', 'sample: %s, %.1f MB, %.1f Mbit/s over %d PIDs' % (os.path.basename(path), size / 1e6,
                                                                     size * 8 / seconds / 1e6, len(pids)))


def scan(fe, freqs, test=None, progress=None, signals=None):
    """freqs: [(kHz, bandwidth MHz, PLP)]; progress(text), if given, gets the panel's messages
    too; signals, the levels found (else into the settings). Returns the new list, and the
    multiplexes the networks list (NIT)"""
    def tell(text):
        notify(text)
        if progress:
            progress(text)
    tell('Scanning %d frequenc%s, about %d min…' % (len(freqs), 'y' if len(freqs) == 1 else 'ies',
                                                   max(1, round(len(freqs) * 4.5 / 60))))
    found, listed = [], []
    settings = None
    if signals is None:
        settings = load_settings()
        signals = settings['signals']
    reader = EitReader(Guide())   # the guide fills in from every multiplex that locks
    try:
        for n, (khz, bw, plp) in enumerate(freqs, 1):
            # on the panel too: a scan of the whole band takes minutes, mostly without any signal
            tell('Scan %d/%d: %d MHz… (found %d)' % (n, len(freqs), khz // 1000, sum(1 for c in found if not c['radio'])))
            busy('a channel scan is running (%d/%d)' % (n, len(freqs)))
            locked, strength, quality = fe.tune(khz, bw, plp)
            label = '%d MHz (%d/%d)' % (khz // 1000, n, len(freqs))
            if not locked:
                say('%s: no signal, level %d%%' % (label, strength))
                continue
            signals[str(khz)] = [strength, quality, time.time()]
            say('%s: locked, level %d%%, quality %d%%' % (label, strength, quality))
            services, muxes = read_mux(khz, bw, plp)
            found += services
            listed += muxes
            if services and not test and LOG.dir:
                try:
                    record_sample(services, LOG.path('mux-%d.ts' % (khz // 1000)))
                except OSError as e:
                    LOG.write('tv', 'sample: %s' % e)
            tv = sum(1 for s in services if not s['radio'])
            tell('%s: signal %d%%, quality %d%%: %d TV, %d radio' %
                 (label, strength, quality, tv, len(services) - tv))
    finally:
        reader.stop()
    channels = merge_scan(load_channels(), found)
    save_channels(channels)
    if settings:
        save_settings(settings)
    tv = sum(1 for c in channels if not c['radio'])
    radio = len(channels) - tv
    tell('Scan finished: %d channels%s' % (tv, ', %d radio' % radio if radio else '') if channels
         else 'Scan finished: nothing found, check the antenna')
    return channels, listed


def nit_search(fe, khz, bw=8, test=None, progress=None, signals=None):
    """The multiplexes the network information table lists, scanned; khz is one of its own"""
    def tell(text):
        notify(text)
        if progress:
            progress(text)
    tell('Network search: reading the network table at %d MHz…' % (khz // 1000))
    locked, strength, _q = fe.tune(khz, bw)
    if not locked:
        tell('Network search: no signal at %d MHz (level %d%%)' % (khz // 1000, strength))
        return None
    secs = read_sections(0x10, 0x40, timeout=6) + read_sections(0x10, 0x41, timeout=6)
    _lcn, muxes = parse_nit(secs)
    muxes = sorted(set(muxes) | {(khz, bw, 0)})
    LOG.write('tv', 'NIT lists: %s' % muxes)
    if len(muxes) == 1:
        tell('The network lists no other frequencies (Zeonbud\'s doesn\'t): use the full scan')
    return scan(fe, muxes, test, progress, signals)[0]


def uhf(first, last):
    """UHF channel numbers to (centre kHz, 8 MHz, PLP 0): channel 21 is 474 MHz"""
    return [(306000 + 8000 * ch, 8, 0) for ch in range(first, last + 1)]


def uhf_channel(khz):
    ch = (khz - 306000) / 8000
    return int(ch) if ch == int(ch) and 21 <= ch <= 69 else None


# ---- the channel list -----------------------------------------------------------------------------

USER_FIELDS = ('renamed', 'skip', 'locked', 'audio_pid', 'amode', 'subs_pid', 'encrypted')


def key(c):
    """A channel's identity, kept by favourites and timers: the service on its multiplex"""
    return '%d:%d' % (c['freq_khz'], c['sid'])


def load_channels():
    try:
        with open(CHANNELS) as f:
            channels = json.load(f)
    except (OSError, ValueError):
        return []
    for c in channels:   # lists scanned before NULs were dropped
        c['name'] = c['name'].replace('\0', '').strip()
        c['provider'] = c.get('provider', '').replace('\0', '').strip()
        c.setdefault('subtitles', [])
        c.setdefault('teletext', None)
    return channels


def save_channels(channels):
    os.makedirs(DATA, exist_ok=True)
    with open(CHANNELS + '.tmp', 'w') as f:
        json.dump(channels, f, ensure_ascii=False, indent=1)
    os.replace(CHANNELS + '.tmp', CHANNELS)


def update_channel(ch, **fields):
    """Fields of one channel changed and saved, in the list on disk too"""
    ch.update(fields)
    channels = load_channels()
    for c in channels:
        if key(c) == key(ch):
            c.update(fields)
    save_channels(channels)


def sort_channels(channels, by='lcn'):
    if by == 'name':
        return sorted(channels, key=lambda c: c['name'].casefold())
    # broadcaster's numbering first, then by multiplex and service
    return sorted(channels, key=lambda c: (c['lcn'] is None, c['lcn'] or 0, c['freq_khz'], c['sid']))


def merge_scan(old, found):
    """A rescan: the multiplexes it found replace what the list had of them, keeping the viewer's
    order, names, skips, locks and tracks; new services go at the end, by number"""
    done = {c['freq_khz'] for c in found}
    new = {key(c): c for c in found}
    out = []
    for c in old:
        if c['freq_khz'] not in done:
            out.append(c)
            continue
        n = new.pop(key(c), None)
        if n is None:
            continue   # gone from its multiplex
        for f in USER_FIELDS:
            if f in c:
                n[f] = c[f]
        if c.get('renamed'):
            n['name'] = c['name']
        if c.get('pids_edited'):
            for f in ('video', 'audio', 'pcr_pid', 'pids_edited'):
                n[f] = c[f]
        out.append(n)
    return out + sort_channels(list(new.values()))


def lock_icon(c):
    """Only for channels found encrypted when watched: the SDT's free_CA_mode ('scrambled') is set
    on Zeonbud's services that Android shows without any card"""
    return '  \U0001f512' if c.get('encrypted') else ''


def groups(settings, channels):
    """The lists the viewer can switch between: all TV channels, the favourites, radio"""
    names = [ALL] + list(settings['groups'])
    if any(c['radio'] for c in channels):
        names.append(RADIO)
    return names


def group_list(channels, settings, group):
    if group == RADIO:
        return [c for c in channels if c['radio']]
    if group in settings['groups']:
        by_key = {key(c): c for c in channels}
        return [by_key[k] for k in settings['groups'][group] if k in by_key]
    return [c for c in channels if not c['radio']]


def channel_number(ch, index):
    """The place in the list, as the stock TV app numbers them: Zeonbud gives the same logical
    channel numbers (NIT) to services of different multiplexes"""
    return index + 1


def remember_encrypted(ch, encrypted):
    if ch.get('encrypted') != encrypted:
        update_channel(ch, encrypted=encrypted)


# ---- recordings -------------------------------------------------------------------------------------

def drives():
    """Mounted USB drives, SD cards and network folders (ozone-media), writable: [(path, label)]"""
    out = []
    try:
        with open('/proc/mounts') as f:
            for line in f:
                dev, mnt, fs, opts = line.split()[:4]
                mnt = mnt.replace('\\040', ' ')
                if mnt.startswith(MEDIA + '/') and 'ro' not in opts.split(',') and os.access(mnt, os.W_OK):
                    out.append((mnt, os.path.basename(mnt)))
    except OSError:
        pass
    return out


def recording_drive(settings):
    """Where recordings go: the drive chosen, else the first USB drive, else the data partition"""
    d = settings.get('drive')
    if d and os.path.isdir(d) and os.access(d, os.W_OK):
        return d
    usb = drives()
    if usb:
        return usb[0][0]
    return NAND if os.access(NAND, os.W_OK) else None


def free_bytes(path):
    try:
        st = os.statvfs(path)
        return st.f_bavail * st.f_frsize
    except OSError:
        return 0


def safe_name(text):
    return re.sub(r'[<>:"/\\|?*\x00-\x1f]', '_', text).strip(' .')[:120] or 'recording'


class Recording:
    """One service's packets written to a .ts on a drive, with a .json next to it: the channel,
    the programme, when and how long"""

    def __init__(self, ch, until, title, desc, drive, timer=None):
        folder = os.path.join(drive, RECORDINGS)
        os.makedirs(folder, exist_ok=True)
        name = safe_name('%s %s%s' % (time.strftime('%Y-%m-%d %H.%M'), ch['name'], ' - ' + title if title else ''))
        self.path = os.path.join(folder, name + '.ts')
        self.f = open(self.path, 'wb')
        self.f.write(ts_packets(0, make_pat(ch)) + ts_packets(ch['pmt_pid'], make_pmt(ch)))
        self.ch, self.until, self.timer = ch, until, timer
        self.key, self.pids = key(ch), channel_pids(ch)
        self.start, self.size, self.error = time.time(), 0, None
        self.meta = {'channel': ch['name'], 'sid': ch['sid'], 'radio': ch['radio'], 'title': title,
                     'description': desc, 'start': self.start, 'duration': 0, 'file': os.path.basename(self.path)}
        self.save_meta()
        LOG.write('rec', 'recording %s until %s into %s' % (ch['name'], hhmm(until) if until else '-', self.path))

    def write(self, data):
        if self.error:
            return
        try:
            self.f.write(data)
            self.size += len(data)
        except OSError as e:
            self.error = e.strerror
            LOG.write('rec', '%s: %s' % (self.path, e))

    def save_meta(self):
        try:
            with open(self.path[:-3] + '.json', 'w') as f:
                json.dump(self.meta, f, ensure_ascii=False, indent=1)
        except OSError as e:
            LOG.write('rec', 'meta: %s' % e)

    def close(self):
        try:
            self.f.close()
        except OSError:
            pass
        self.meta['duration'] = time.time() - self.start
        self.meta['size'] = self.size
        self.save_meta()
        LOG.write('rec', 'recorded %s: %.0f min, %.0f MB%s' % (self.ch['name'], self.meta['duration'] / 60,
                                                              self.size / 1e6, ', ' + self.error if self.error else ''))


def list_recordings(settings):
    """The recordings on every drive and the data partition, newest first"""
    out, seen = [], set()
    for d in [settings.get('drive')] + [p for p, _l in drives()] + [NAND]:
        folder = os.path.join(d, RECORDINGS) if d else None
        if not folder or folder in seen or not os.path.isdir(folder):
            continue
        seen.add(folder)
        for n in os.listdir(folder):
            if not n.endswith('.ts'):
                continue
            path = os.path.join(folder, n)
            try:
                with open(path[:-3] + '.json') as f:
                    meta = json.load(f)
            except (OSError, ValueError):
                meta = {'title': n[:-3], 'channel': '', 'start': os.path.getmtime(path), 'duration': 0}
            meta['path'] = path
            meta['size'] = os.path.getsize(path)
            out.append(meta)
    return sorted(out, key=lambda m: -m.get('start', 0))


# ---- timers ---------------------------------------------------------------------------------------

def load_timers():
    try:
        with open(TIMERS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return []


def save_timers(timers):
    os.makedirs(DATA, exist_ok=True)
    with open(TIMERS + '.tmp', 'w') as f:
        json.dump(timers, f, ensure_ascii=False, indent=1)
    os.replace(TIMERS + '.tmp', TIMERS)


def timer_conflict(timers, new):
    """A recording timer that overlaps new on another multiplex (there is one tuner), or None"""
    if new['action'] != 'record':
        return None
    mux = new['key'].split(':')[0]
    for t in timers:
        if (t['action'] == 'record' and t.get('state', '') in ('', 'running') and t['id'] != new['id'] and
                t['start'] < new['end'] and new['start'] < t['end'] and t['key'].split(':')[0] != mux):
            return t
    return None


def add_timer(ch, start, end, action, title, repeat=''):
    """A timer (record, or switch to the channel at the start); returns (timer, conflicting timer)"""
    timers = load_timers()
    t = {'id': '%x' % int(time.time() * 1000), 'key': key(ch), 'channel': ch['name'], 'title': title,
         'start': int(start), 'end': int(end), 'action': action, 'repeat': repeat, 'state': ''}
    other = timer_conflict(timers, t)
    if other:
        return None, other
    timers.append(t)
    save_timers(timers)
    LOG.write('timer', 'added: %s' % json.dumps(t, ensure_ascii=False))
    return t, None


def timer_for(timers, ch, event):
    """The timer set on a programme of the guide, if any"""
    k = key(ch)
    for t in timers:
        if t['key'] == k and t.get('state', '') in ('', 'running') and t['start'] <= event[0] + 60 and \
                t['end'] >= event[0] + event[1] - 60:
            return t
    return None


def timer_service():
    """ozone-tv timers: wakes the TV process for timers due when it isn't running (it does the
    rest itself). From standby too, which only turns the screen off; not from power off, which
    nothing but the remote can end (the RTC has no wake alarm)."""
    env = dict(os.environ)
    env.setdefault('DISPLAY', ':0')   # the TV process is a window's, even when it starts hidden
    started = []
    while True:
        now = time.time()
        due = [t for t in load_timers() if t.get('state', '') == '' and t['start'] - 90 <= now < t['end']]
        if due and not control('timers'):
            print('%s: starting the TV for %s' % (time.strftime('%F %T'), due[0]['title']), flush=True)
            started.append(subprocess.Popen(['ozone-tv', 'timer', due[0]['id']], stdin=subprocess.DEVNULL,
                                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env,
                                            start_new_session=True))
        started = [p for p in started if p.poll() is None]
        time.sleep(30)


# ---- the control socket ---------------------------------------------------------------------------

def control(line):
    """Hands a request to the running TV process; its reply, or None if none is running"""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(5)
        s.connect(CONTROL)
        s.sendall(line.encode() + b'\n')
        reply = s.makefile().readline().strip()
        s.close()
        return reply or 'ok'
    except OSError:
        return None


# ---- the tuner in use: filters, dvr0, the live buffer -----------------------------------------------

class Filters:
    """PES filters with TS output on a set of PIDs; while a PID's filter exists, its packets reach
    dvr0. Changed a PID at a time, so services that stay keep flowing."""

    def __init__(self):
        self.fds = {}

    def set(self, pids):
        for pid in [p for p in self.fds if p not in pids]:
            os.close(self.fds.pop(pid))
        for pid in sorted(p for p in pids if p not in self.fds):
            fd = os.open(DEMUX, os.O_RDWR)
            try:
                fcntl.ioctl(fd, DMX_SET_PES_FILTER, struct.pack('<H2xiiiI', pid, DMX_IN_FRONTEND, DMX_OUT_TS_TAP,
                                                                 DMX_PES_OTHER, DMX_IMMEDIATE_START))
            except OSError as e:   # out of filters, most likely
                LOG.write('dmx', 'PES filter on 0x%x: %s' % (pid, e.strerror))
                os.close(fd)
                continue
            self.fds[pid] = fd
        LOG.write('dmx', 'PES filters on %s' % (' '.join('0x%x' % p for p in sorted(self.fds)) or 'nothing'))


def only(data, pids):
    """The TS packets of data on pids"""
    out = bytearray()
    for i in range(0, len(data) - 187, 188):
        if ((data[i + 1] & 0x1f) << 8 | data[i + 2]) in pids:
            out += data[i:i + 188]
    return bytes(out)


class LiveBuffer:
    """The watched service's packets in segment files that amplay --tv reads behind the writer:
    SEG_BYTES each, the oldest deleted once there are more than the size given. In memory by
    default (a couple of minutes of timeshift), or on the recording drive."""

    def __init__(self, directory, max_bytes, on_low):
        self.dir = directory
        self.prefix = os.path.join(directory, 'ozone-tv-live-%d-' % os.getpid())
        for n in os.listdir(directory):   # from a run that crashed
            m = re.match(r'ozone-tv-live-(\d+)-\d+\.ts$', n)
            if m and not os.path.exists('/proc/' + m.group(1)):
                try:
                    os.unlink(os.path.join(directory, n))
                except OSError:
                    pass
        self.keep = max(3, max_bytes // SEG_BYTES)
        self.offset = self.low = 0
        self.f, self.seg, self.on_low = None, -1, on_low
        self.lock = threading.Lock()
        self.full = False
        LOG.write('live', 'buffer %s*, %d MB' % (self.prefix, self.keep * SEG_BYTES >> 20))

    def path(self, seg):
        return '%s%06d.ts' % (self.prefix, seg)

    def write(self, data):
        with self.lock:
            while data:
                seg, pos = divmod(self.offset, SEG_BYTES)
                try:
                    if seg != self.seg:
                        if self.f:
                            self.f.close()
                        self.f = open(self.path(seg), 'wb', buffering=0)
                        self.seg = seg
                        if seg >= self.keep:
                            try:
                                os.unlink(self.path(seg - self.keep))
                            except OSError:
                                pass
                            self.low = (seg - self.keep + 1) * SEG_BYTES
                            self.on_low(self.low)
                    n = min(len(data), SEG_BYTES - pos)
                    self.f.write(data[:n])
                except OSError as e:   # the memory or drive full: dropped
                    if not self.full:
                        LOG.write('live', 'buffer: %s' % e)
                    self.full = True
                    return
                self.full = False
                self.offset += n
                data = data[n:]

    def close(self):
        with self.lock:
            if self.f:
                self.f.close()
            for seg in range(max(0, self.seg - self.keep), self.seg + 1):
                try:
                    os.unlink(self.path(seg))
                except OSError:
                    pass


def tune_until_locked(fe, ch, waiting=None, cancel=None):
    """Tunes to ch's multiplex and, without a lock, tunes again and again, as the stock TV app does:
    a weak or disturbed multiplex (506 MHz here at night) locks after a few tries, or later.
    waiting(text) gets what's going on; cancel(seconds) waits that long and says whether to stop.
    True once locked"""
    tries = 0
    while True:
        locked, strength, _q = fe.tune(ch['freq_khz'], ch['bandwidth'], ch['plp'])
        tries += 1
        if locked:
            if tries > 1:
                LOG.write('tv', '%d MHz locked after %d tries' % (ch['freq_khz'] // 1000, tries))
            return True
        text = '%s: no signal (level %d%%), trying again…' % (ch['name'], strength)
        if waiting:
            waiting(text)
        elif tries == 1:
            notify(text)
        if tries == 1 or tries % 10 == 0:
            LOG.write('tv', '%d MHz: no lock after %d tries' % (ch['freq_khz'] // 1000, tries))
        if cancel:
            if cancel(0.5):
                return False
        else:
            time.sleep(0.5)


class Tuner:
    """The frontend tuned to one multiplex, and dvr0 read in a thread: the watched service's packets
    go to the live buffer, each recording's to its file. Also the signal every 3 s (relocking when
    it is lost) and the guide from the multiplex's EIT."""

    def __init__(self, app):
        self.app = app
        self.fe = app.frontend()
        self.lock = threading.RLock()
        self.watched, self.buf, self.events = None, None, None
        self.recordings = []
        self.filters = Filters()
        self.split = False
        self.eit = None
        self.dvr = os.open(DVR, os.O_RDONLY | os.O_NONBLOCK)
        try:
            fcntl.ioctl(self.dvr, DMX_SET_BUFFER_SIZE, 4 << 20)
        except OSError as e:
            LOG.write('dmx', 'dvr buffer size: %s' % e.strerror)
        self.stopped = threading.Event()
        self._checks(None)
        self.threads = [threading.Thread(target=f, daemon=True) for f in (self._read, self._monitor)]
        for t in self.threads:
            t.start()

    def mux(self):
        """The multiplex recordings hold the tuner on, or None"""
        with self.lock:
            return self.recordings[0].ch['freq_khz'] if self.recordings else None

    def tune(self, ch, waiting=None, cancel=None):
        if self.fe.khz == ch['freq_khz'] and self.fe.status()[0]:
            return True
        if not tune_until_locked(self.fe, ch, waiting, cancel):
            return False
        if not self.eit:
            self.eit = EitReader(self.app.guide)
        return True

    def _refilter(self):
        sets = ([channel_pids(self.watched)] if self.watched else []) + [r.pids for r in self.recordings]
        self.filters.set(set().union(*sets) if sets else set())
        self.split = len({frozenset(s) for s in sets}) > 1

    def _checks(self, ch):
        self.since, self.total, self.checked, self.scrambled, self.nodata_told = time.monotonic(), 0, 0, 0, False
        self.vpid = ch['video']['pid'] if ch and ch.get('video') else None

    def watch(self, ch):
        """ch's packets to the live buffer from now on (None: nobody's); where in it they start"""
        with self.lock:
            self.watched = ch
            self._refilter()
            self._checks(ch)
            return self.buf.offset if self.buf else 0

    def add_recording(self, rec):
        with self.lock:
            self.recordings.append(rec)
            self._refilter()

    def remove_recording(self, rec):
        with self.lock:
            if rec in self.recordings:
                self.recordings.remove(rec)
            self._refilter()
        rec.close()

    def recording(self, ch):
        with self.lock:
            return next((r for r in self.recordings if r.key == key(ch)), None)

    def idle(self):
        with self.lock:
            return not self.watched and not self.recordings

    def _read(self):
        got, since = 0, time.monotonic()
        while not self.stopped.is_set():
            if time.monotonic() - since >= 10 and got:
                LOG.write('dvr', '%.2f Mbit/s' % (got * 8 / (time.monotonic() - since) / 1e6))
                got, since = 0, time.monotonic()
            if not select.select([self.dvr], [], [], 0.5)[0]:
                continue
            try:
                data = os.read(self.dvr, 188 * 1024)
            except BlockingIOError:
                continue
            except OSError as e:   # EOVERFLOW: we fell behind, the driver dropped data
                LOG.write('dvr', 'read: %s' % e.strerror)
                continue
            got += len(data)
            with self.lock:
                if self.watched and self.buf:
                    self.buf.write(only(data, channel_pids(self.watched)) if self.split else data)
                    self._check(data)
                for r in self.recordings:
                    r.write(only(data, r.pids) if self.split else data)

    def _check(self, data):
        """Whether the watched channel's video is scrambled: then it needs the provider's card"""
        self.total += len(data)
        if self.vpid is None or self.checked >= 2000:
            return
        for i in range(0, len(data) - 187, 188):
            if data[i] == 0x47 and ((data[i + 1] & 0x1f) << 8 | data[i + 2]) == self.vpid:
                self.checked += 1
                self.scrambled += bool(data[i + 3] & 0xc0)   # transport_scrambling_control
        if self.checked >= 2000:
            encrypted = self.scrambled > self.checked // 2
            LOG.write('tv', 'video packets: %d of %d scrambled' % (self.scrambled, self.checked))
            remember_encrypted(self.watched, encrypted)
            if encrypted and self.events:
                self.events.put(('encrypted',))

    def _monitor(self):
        """The signal every 3 s, into the log. When the lock is gone for a while the demodulator
        does not get it back by itself, so tune again until it does (the picture stands still
        meanwhile and goes on when the data is back)"""
        unlocked = 0
        while not self.stopped.wait(3):
            if self.fe.khz is None or self.idle():
                continue
            try:
                locked, strength, quality = self.fe.status()
            except (RuntimeError, OSError) as e:
                LOG.write('signal', str(e))
                return
            LOG.write('signal', '%s, level %d%%, quality %d%%' % ('locked' if locked else 'NO LOCK', strength, quality))
            self.app.note_signal(self.fe.khz, strength, quality)
            if self.events:
                self.events.put(('signal', locked, strength, quality))
            with self.lock:
                w = self.watched
                if w and not self.nodata_told and time.monotonic() - self.since > NO_DATA_TIMEOUT and \
                        (not self.total or (self.vpid is not None and not self.checked)):
                    self.nodata_told = True
                    LOG.write('tv', 'nothing from the tuner in %d s: %d bytes, %d video packets' %
                              (NO_DATA_TIMEOUT, self.total, self.checked))
                    if self.events:
                        self.events.put(('nodata', 'video' if self.total else 'data'))
            unlocked = 0 if locked else unlocked + 1
            if unlocked >= RELOCK_AFTER:
                khz = self.fe.khz
                ch = w or (self.recordings[0].ch if self.recordings else None)
                if ch and ch['freq_khz'] == khz:
                    locked, strength, _q = self.fe.tune(khz, ch['bandwidth'], ch['plp'])
                    LOG.write('signal', 'tuned again: %s, level %d%%' % ('locked' if locked else 'no lock', strength))
                    if locked:
                        unlocked = 0

    def close(self):
        self.stopped.set()
        for t in self.threads:
            t.join(4)
        with self.lock:
            for r in list(self.recordings):
                self.remove_recording(r)
            self.watched = None
            self.filters.set(set())
        if self.eit:
            self.eit.stop()
        os.close(self.dvr)


# ---- the player -----------------------------------------------------------------------------------

class Player:
    """amplay --tv: commands to its stdin, what the viewer does from its stdout into events"""

    def __init__(self, events, banner):
        self.events = events
        self.lock = threading.Lock()
        self.p = subprocess.Popen(['amplay', '-v', '--tv', '--banner', str(banner)], stdin=subprocess.PIPE,
                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1,
                                  errors='replace')
        pipe_to_log(self.p.stderr, 'amplay')
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        for line in self.p.stdout:
            words = line.split()
            if words:
                LOG.write('player', line.strip())
                self.events.put(tuple(words))
        self.events.put(('quit', 'exit'))

    def send(self, *fields):
        line = '\t'.join(str(f).replace('\t', ' ').replace('\n', '\\n') for f in fields)
        with self.lock:
            try:
                self.p.stdin.write(line + '\n')
                self.p.stdin.flush()
            except (BrokenPipeError, OSError, ValueError):
                pass

    def close(self):
        self.send('quit')
        try:
            self.p.stdin.close()
        except OSError:
            pass
        try:
            self.p.wait(5)
        except subprocess.TimeoutExpired:
            self.p.kill()
            self.p.wait()
        LOG.write('tv', 'player exit status %s' % self.p.returncode)
        subprocess.call(['amplay', '--reset'])


def clean(text):
    return ' '.join(str(text).split())


class Watch:
    """Watching: one amplay --tv for the whole time, on the tuner's live buffer. Runs in a thread,
    taking events from the player, the tuner and the app in turn."""

    def __init__(self, app, group, index):
        self.app, self.group, self.index = app, group, index
        self.events = queue.Queue()
        s = app.settings
        if s.get('timeshift_drive') and recording_drive(s) and recording_drive(s) != NAND:
            where, size = recording_drive(s), s['timeshift_drive_mb'] << 20
        else:
            where, size = LIVE_MEMORY, s['timeshift_mb'] << 20
        self.buf = LiveBuffer(where, size, lambda low: self.player.send('buffer', low))
        self.player = Player(self.events, s['banner'])
        self.tuner = None
        self.unlocked = set()
        self.pending = None      # a locked channel waiting for the PIN
        self.ch = None
        self.started = False

    @property
    def list(self):
        return group_list(self.app.channels, self.app.settings, self.group)

    def run(self):
        try:
            self.tuner = self.app.tuner()
            with self.tuner.lock:
                self.tuner.buf = self.buf
                self.tuner.events = self.events
            self.player.send('aspect', self.app.settings['aspect'])
            self.send_list()
            self.switch(self.index)
            self.loop()
        except Exception:
            LOG.write('tv', traceback.format_exc())
        finally:
            if self.tuner:
                with self.tuner.lock:
                    self.tuner.watch(None)
                    self.tuner.buf = self.tuner.events = None
            self.player.close()
            self.buf.close()
            self.app.watch_ended(self)

    def loop(self):
        tick = time.monotonic()
        while True:
            try:
                ev = self.events.get(timeout=5)
            except queue.Empty:
                ev = None
            if time.monotonic() - tick >= 30:
                tick = time.monotonic()
                self.refresh()
            if not ev:
                continue
            what = ev[0]
            if what == 'quit':
                return
            if what == 'channel':
                # the viewer pressed on: only the last one counts
                target = int(ev[1])
                while True:
                    with self.events.mutex:
                        nxt = next((e for e in self.events.queue if e[0] in ('channel', 'quit', 'play')), None)
                    if not nxt or nxt[0] != 'channel':
                        break
                    target = int(self.events.get()[1])
                self.switch(target)
            elif what == 'play':   # from the app: a channel by its key (the window, a timer)
                lst = self.list
                i = next((i for i, c in enumerate(lst) if key(c) == ev[1]), None)
                if i is None:
                    self.group = ALL if not ev[2] else RADIO
                    self.send_list()
                    i = next((i for i, c in enumerate(self.list) if key(c) == ev[1]), 0)
                self.switch(i)
            elif what == 'pin':
                self.on_pin(ev[1])
            elif what == 'audio' and self.ch:
                update_channel(self.ch, audio_pid=int(ev[1]), amode=int(ev[2]))
            elif what == 'subs' and self.ch:
                update_channel(self.ch, subs_pid=int(ev[1]), subs_page=int(ev[2], 16))
            elif what == 'aspect':
                self.app.set_setting('aspect', int(ev[1]))
            elif what == 'record':
                self.toggle_recording()
            elif what in ('group', 'tvradio'):
                self.next_group(what == 'tvradio')
            elif what == 'signal':
                self.player.send('signal', '%d %d %d' % ev[1:4])
            elif what == 'encrypted':
                self.player.send('message', 0, '%s is encrypted: it needs the provider\'s card' % self.ch['name'])
            elif what == 'nodata':
                self.player.send('message', 0, '%s: no %s from the tuner' % (self.ch['name'], ev[1]))
            elif what == 'recordings':   # started or stopped elsewhere (a timer)
                self.player.send('rec', 1 if self.ch and self.tuner.recording(self.ch) else 0)
            elif what == 'error':
                LOG.write('tv', 'player: %s' % ' '.join(ev))

    def _interrupt(self, timeout):
        """For the tuning loop: wait, and stop if the viewer moved on"""
        end = time.monotonic() + timeout
        while True:
            with self.events.mutex:
                if any(e[0] in ('channel', 'quit', 'play') for e in self.events.queue):
                    return True
            if time.monotonic() >= end:
                return False
            time.sleep(0.05)

    def title(self, ch, index):
        title = '%d  %s%s' % (channel_number(ch, index), ch['name'], lock_icon(ch))
        now, nxt = self.app.guide.now_next(ch['sid'])
        if now:
            title += '   %s–%s %s' % (hhmm(now[0]), hhmm(now[0] + now[1]), now[2])
        if nxt:
            title += '   ·   %s %s' % (hhmm(nxt[0]), nxt[2])
        return clean(title)

    def send_list(self):
        lst = self.list
        try:
            with open(OSD_CHANNELS, 'w') as f:
                for i, c in enumerate(lst):
                    f.write('%d\t%s%s\t%s\t%s\n' % (channel_number(c, i), clean(c['name']), lock_icon(c),
                                                     clean(on_now(self.app.guide, c)), 's' if c.get('skip') else ''))
        except OSError as e:
            LOG.write('tv', 'channel list for the player: %s' % e)
            return
        cur = next((i for i, c in enumerate(lst) if self.ch and key(c) == key(self.ch)), -1)
        self.player.send('channels', OSD_CHANNELS, cur)

    def next_group(self, radio):
        names = groups(self.app.settings, self.app.channels)
        if radio:
            self.group = RADIO if self.group != RADIO and RADIO in names else ALL
        else:
            tv = [n for n in names if n != RADIO]
            self.group = tv[(tv.index(self.group) + 1) % len(tv)] if self.group in tv else ALL
        lst = self.list
        self.send_list()
        self.player.send('message', 2, '%s: %d channel%s' % (self.group_label(), len(lst), '' if len(lst) == 1 else 's'))
        if radio and lst:   # TV/radio switches to it, the color key only shows the list
            self.switch(0)

    def group_label(self):
        return {ALL: 'All channels', RADIO: 'Radio'}.get(self.group, self.group)

    def locked(self, ch):
        """The PIN first: a locked channel, or a programme rated above the age limit"""
        if key(ch) in self.unlocked:
            return None
        if ch.get('locked'):
            return 'Locked channel: enter the PIN'
        age = self.app.settings.get('age') or 0
        now, _n = self.app.guide.now_next(ch['sid'])
        if age and now and now[4] >= age:
            return 'Rated %d+: enter the PIN' % now[4]
        return None

    def switch(self, i):
        lst = self.list
        if not lst:
            self.player.send('message', 0, 'No channels in %s' % self.group_label())
            return
        i %= len(lst)
        ch = lst[i]
        LOG.write('tv', 'channel %d: %s' % (i + 1, json.dumps(ch, ensure_ascii=False)))
        busy('watching %s' % ch['name'])
        mux = self.tuner.mux()
        if mux and mux != ch['freq_khz']:
            rec = self.tuner.recordings[0]
            self.player.send('message', 4, 'Recording %s: only channels of %d MHz until %s' % (
                rec.ch['name'], mux // 1000, hhmm(rec.until) if rec.until else 'it is stopped'))
            if self.ch:   # stays where it was
                self.player.send('current', next((k for k, c in enumerate(lst) if key(c) == key(self.ch)), -1))
                self.player.send('title', self.title(self.ch, self.index))
                self.play(self.ch, self.tuner.watch(self.ch))
            return
        self.index, self.ch, self.pending = i, ch, None
        self.app.watched = key(ch)
        self.player.send('current', i)
        self.player.send('stop', self.title(ch, i))
        self.player.send('message', 0, '')
        self.player.send('pin', '')
        self.tuner.watch(None)
        if not self.tuner.tune(ch, lambda t: self.player.send('message', 0, t), self._interrupt):
            LOG.write('tv', 'stopped waiting for a signal')
            return
        self.player.send('message', 0, '')
        off = self.tuner.watch(ch)
        prompt = self.locked(ch)
        if prompt:
            self.pending = ch
            self.player.send('pin', prompt)
            return
        self.play(ch, off)

    def tracks(self, ch):
        """The audio track (index) and subtitles (index or -1) to start with: as last chosen on
        this channel, else the preferred languages"""
        s = self.app.settings
        audio = ch['audio']
        asel = next((i for i, a in enumerate(audio) if a['pid'] == ch.get('audio_pid')), None)
        for lang in s['audio_langs']:
            if asel is None:
                asel = next((i for i, a in enumerate(audio) if lang and a['lang'] == lang), None)
        subs = ch.get('subtitles', [])
        if 'subs_pid' in ch:
            ssel = next((i for i, t in enumerate(subs) if t['pid'] == ch['subs_pid'] and
                         t['page'] == ch.get('subs_page', 0)), -1)
        else:
            ssel = -1
            for lang in s['subtitle_langs'] if s['subtitles'] else []:
                if ssel < 0:
                    ssel = next((i for i, t in enumerate(subs) if lang and t['lang'].startswith(lang)), -1)
        return asel or 0, ch.get('amode', s['audio_mode']), ssel

    def play(self, ch, off):
        asel, amode, ssel = self.tracks(ch)
        now, _n = self.app.guide.now_next(ch['sid'])
        fields = {
            'src': self.buf.prefix, 'off': off, 'pmt': ch['pmt_pid'],
            'psi': '%s,%s' % (make_pat(ch).hex(), make_pmt(ch).hex()),
            'v': ch['video']['pid'] if ch.get('video') and not ch['radio'] else 0,
            'a': ','.join('%d:%s' % (a['pid'], clean(a['lang']) or '-') for a in ch['audio']),
            'asel': asel, 'amode': amode,
            's': ','.join('%d:%s:%s:%x' % (t['pid'], t['type'], clean(t['lang']) or '-', t['page'])
                          for t in ch.get('subtitles', [])),
            'ssel': ssel, 'ttx': ch.get('teletext') or 0, 'ttxregion': self.app.settings['teletext_region'],
            'title': self.title(ch, self.index) if not ch['radio'] else ch['name'],
            'now': '%s–%s %s' % (hhmm(now[0]), hhmm(now[0] + now[1]), now[2]) if now else '',
        }
        self.player.send('play', *('%s=%s' % (k, clean(v) if k in ('title', 'now') else v) for k, v in fields.items()))
        self.player.send('info', self.info(ch))
        self.player.send('rec', 1 if self.tuner.recording(ch) else 0)
        if not self.started:
            self.started = True
            self.app.player_started()

    def info(self, ch):
        """The info panel's text (the first line is its heading)"""
        lines = ['%d  %s' % (channel_number(ch, self.index), ch['name'])]
        uhf_ch = uhf_channel(ch['freq_khz'])
        lines.append('%s · %d MHz%s%s · service %d%s' % (
            ch.get('provider') or '-', ch['freq_khz'] // 1000, ' (UHF %d)' % uhf_ch if uhf_ch else '',
            ', PLP %d' % ch['plp'] if ch['plp'] else '', ch['sid'], ', LCN %d' % ch['lcn'] if ch.get('lcn') else ''))
        now, nxt = self.app.guide.now_next(ch['sid'])
        if now:
            lines.append('')
            lines.append('Now %s–%s  %s%s' % (hhmm(now[0]), hhmm(now[0] + now[1]), now[2],
                                              '  (%d+)' % now[4] if now[4] else ''))
            if now[3] and now[3].strip() != now[2].strip():
                lines.append(now[3][:400])
        if nxt:
            lines.append('Next %s  %s' % (hhmm(nxt[0]), nxt[2]))
        lines.append('')
        v = ch.get('video')
        lines.append('Video: %s' % ('%s, PID %d' % (v['codec'], v['pid']) if v else 'none (radio)'))
        lines.append('Audio: %s' % (', '.join('%s %s PID %d' % (a['codec'], a['lang'] or '-', a['pid'])
                                              for a in ch['audio']) or 'none'))
        subs = ch.get('subtitles', [])
        if subs:
            lines.append('Subtitles: %s' % ', '.join('%s%s' % (t['lang'] or '-', ' (teletext %x)' % t['page']
                                                               if t['type'] == 't' else '') for t in subs))
        if ch.get('teletext'):
            lines.append('Teletext: PID %d' % ch['teletext'])
        lines.append('PMT %d · PCR %d%s' % (ch['pmt_pid'], ch['pcr_pid'], ' · PIDs edited' if ch.get('pids_edited') else ''))
        return '\n'.join(lines)

    def on_pin(self, pin):
        if not self.pending:
            return
        if not pin_ok(self.app.settings, pin):
            LOG.write('tv', 'wrong PIN')
            self.player.send('pin', 'Wrong PIN, again')
            return
        ch, self.pending = self.pending, None
        self.unlocked.add(key(ch))
        self.player.send('pin', '')
        self.play(ch, self.buf.offset)

    def toggle_recording(self):
        ch = self.ch
        if not ch:
            return
        rec = self.tuner.recording(ch)
        if rec:
            self.app.stop_recording(rec)
            self.player.send('message', 3, 'Recording stopped: %s, %d min' % (os.path.basename(rec.path)[:-3],
                                                                            rec.meta['duration'] // 60))
        else:
            rec, why = self.app.record_now(ch)
            self.player.send('message', 4, why if not rec else 'Recording %s until %s' % (
                ch['name'], hhmm(rec.until) if rec.until else 'stopped'))
        self.player.send('rec', 1 if self.tuner.recording(ch) else 0)

    def refresh(self):
        """Every 30 s: the title, the list's "now on", and the PIN for a programme rated over the
        limit that has begun"""
        if not self.ch:
            return
        self.player.send('title', self.title(self.ch, self.index), self.info_now())
        self.player.send('info', self.info(self.ch))
        self.send_list()
        if not self.pending and self.locked(self.ch):
            self.player.send('stop', self.title(self.ch, self.index))
            self.pending = self.ch
            self.player.send('pin', self.locked(self.ch))

    def info_now(self):
        now, _n = self.app.guide.now_next(self.ch['sid'])
        return clean('%s–%s %s' % (hhmm(now[0]), hhmm(now[0] + now[1]), now[2])) if now else ''


# ---- the TV process -------------------------------------------------------------------------------

