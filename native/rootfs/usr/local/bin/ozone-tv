         font-weight: bold; }
.empty { color: #7f849c; font-size: 15px; padding: 40px; }
"""


def window(test=None):
    """The TV window: the channels with what's on (left), the selected one's schedule (right)"""
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gdk, GLib, Gtk, Pango

    def label(text='', cls=None, **kw):
        kw.setdefault('xalign', 0)
        w = Gtk.Label(label=text, **kw)
        if cls:
            w.get_style_context().add_class(cls)
        return w

    def day_name(t):
        today = time.localtime(time.time())
        d = time.localtime(t)
        delta = (time.mktime(d[:3] + (0, 0, 0, 0, 0, -1)) - time.mktime(today[:3] + (0, 0, 0, 0, 0, -1))) / 86400
        name = {0: 'Today', 1: 'Tomorrow', -1: 'Yesterday'}.get(round(delta), time.strftime('%A', d))
        return '%s, %s' % (name, time.strftime('%d.%m', d))

    class TvWindow:
        def __init__(self):
            # GTK's CSS parser loses the first number of the first stylesheet to a stale errno (see yt)
            try:
                Gtk.CssProvider().load_from_data(b'* { padding: 0px; }')
            except GLib.Error:
                pass
            style = Gtk.CssProvider()
            style.load_from_data(TV_CSS)
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), style,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.guide = Guide()
            self.busy = False
            self.cancel, self.waiting, self.after = None, False, None   # see watch()
            self.typed, self.typed_at = '', 0   # a channel number from the remote's digits
            self.win = Gtk.Window(title='TV')
            self.win.set_default_size(1280, 720)
            self.win.connect('destroy', Gtk.main_quit)
            self.win.connect('key-press-event', self.on_key)

            top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            header = Gtk.Box(spacing=12)
            header.get_style_context().add_class('header')
            header.pack_start(label('', 'logo'), False, False, 0)
            header.pack_start(label('TV', 'heading'), False, False, 0)
            self.status = label('', 'status', ellipsize=Pango.EllipsizeMode.END)
            header.pack_start(self.status, True, True, 0)
            for text, action in (('Update guide', self.update_guide), ('Scan channels', self.scan)):
                b = Gtk.Button(label=text)
                b.connect('clicked', lambda w, a=action: a())
                header.pack_start(b, False, False, 0)
            # bspwm draws no title bars, so the window closes here (or with Esc, the panel's ✕)
            close = Gtk.Button(label='\uf00d', tooltip_text='Close')
            close.get_style_context().add_class('close')
            close.connect('clicked', lambda w: self.win.destroy())
            header.pack_start(close, False, False, 0)
            top.pack_start(header, False, False, 0)

            body = Gtk.Box()
            left = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            left.set_size_request(470, -1)
            left.get_style_context().add_class('channels')
            # a click shows the channel's schedule, a double click (or Enter) watches it
            self.channels = Gtk.ListBox(activate_on_single_click=False)
            self.channels.connect('row-selected', self.on_channel)
            self.channels.connect('row-activated', lambda lb, row: self.watch(row.index))
            left.add(self.channels)
            body.pack_start(left, False, False, 0)
            self.right = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            self.sched = Gtk.ListBox(activate_on_single_click=False)
            self.sched.connect('row-selected', self.on_event)
            self.sched.connect('row-activated', lambda lb, row: self.watch(self.index))
            self.right.add(self.sched)
            body.pack_start(self.right, True, True, 0)
            top.pack_start(body, True, True, 0)
            self.win.add(top)

            self.index = 0
            self.fill_channels()
            self.win.show_all()
            self.update_now()
            self.select(WATCHED)
            GLib.timeout_add_seconds(30, self.tick)

        # the lists

        def fill_channels(self):
            for row in self.channels.get_children():
                row.destroy()
            self.list = [c for c in load_channels() if not c['radio']]
            for i, c in enumerate(self.list):
                row = Gtk.ListBoxRow()
                row.index = i
                box = Gtk.Box(spacing=12)
                num = label(str(channel_number(c, i)), 'num', width_chars=3, xalign=1)
                box.pack_start(num, False, False, 0)
                info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
                info.pack_start(label(c['name'] + lock_icon(c), 'name', ellipsize=Pango.EllipsizeMode.END), False, False, 0)
                row.now = label('', 'now', ellipsize=Pango.EllipsizeMode.END)
                info.pack_start(row.now, False, False, 0)
                row.prog = Gtk.ProgressBar(no_show_all=True)   # shown only with a programme on
                info.pack_start(row.prog, False, False, 2)
                box.pack_start(info, True, True, 0)
                row.add(box)
                self.channels.add(row)
            if not self.list:
                row = Gtk.ListBoxRow(selectable=False, activatable=False)
                row.add(label('No channels yet: Scan channels', 'empty', wrap=True))
                self.channels.add(row)
            self.channels.show_all()
            self.update_now()

        def update_now(self):
            t = self.guide.now()
            for row in self.channels.get_children():
                if not hasattr(row, 'index'):
                    continue
                now, nxt = self.guide.now_next(self.list[row.index]['sid'])
                if now:
                    row.now.set_text('%s–%s  %s' % (hhmm(now[0]), hhmm(now[0] + now[1]), now[2]))
                    row.prog.set_fraction(min(1, max(0, (t - now[0]) / max(1, now[1]))))
                    row.prog.show()
                else:
                    row.now.set_text('next: %s %s' % (hhmm(nxt[0]), nxt[2]) if nxt else 'no programme information')
                    row.prog.hide()

        def select(self, index):
            row = self.channels.get_row_at_index(index) if self.list else None
            if row:
                self.channels.select_row(row)
                row.grab_focus()

        def on_channel(self, lb, row):
            if row is None or not hasattr(row, 'index'):
                return
            self.index = row.index
            self.fill_schedule(self.list[row.index])

        def fill_schedule(self, ch):
            for row in self.sched.get_children():
                row.destroy()
            t = self.guide.now()
            events = [e for e in self.guide.schedule(ch['sid']) if e[0] + e[1] > t]
            current = None
            day = None
            for e in events:
                if day_name(e[0]) != day:
                    day = day_name(e[0])
                    head = Gtk.ListBoxRow(selectable=False, activatable=False)
                    head.add(label(day, 'day'))
                    self.sched.add(head)
                row = Gtk.ListBoxRow()
                box = Gtk.Box(spacing=14)
                box.pack_start(label(hhmm(e[0]), 'time', valign=Gtk.Align.START), False, False, 0)
                info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
                line = Gtk.Box(spacing=8)
                line.pack_start(label(e[2], 'title', wrap=True), False, False, 0)
                if e[0] <= t:
                    line.pack_start(label('NOW', 'badge', valign=Gtk.Align.CENTER), False, False, 0)
                    row.get_style_context().add_class('current')
                    current = row
                info.pack_start(line, False, False, 0)
                row.desc = None
                if e[3] and e[3].strip() != e[2].strip():   # Zeonbud often repeats the title as the text
                    row.desc = label(e[3], 'desc', wrap=True, lines=2, ellipsize=Pango.EllipsizeMode.END,
                                     max_width_chars=1)
                    info.pack_start(row.desc, False, False, 0)
                box.pack_start(info, True, True, 0)
                row.add(box)
                self.sched.add(row)
            if not events:
                row = Gtk.ListBoxRow(selectable=False, activatable=False)
                row.add(label('No programme information yet. Watching a channel fills it in, or Update guide.',
                              'empty', wrap=True))
                self.sched.add(row)
            self.sched.show_all()
            self.right.get_vadjustment().set_value(0)

        def on_event(self, lb, row):
            # the selected programme's whole description
            for r in lb.get_children():
                if getattr(r, 'desc', None):
                    full = r is row
                    r.desc.set_lines(-1 if full else 2)
                    r.desc.set_ellipsize(Pango.EllipsizeMode.NONE if full else Pango.EllipsizeMode.END)

        def tick(self):
            self.update_now()
            return True

        # actions

        def run(self, what, job):
            """job() in a thread, then everything reloaded"""
            if self.busy:
                return
            self.busy = True
            def done():
                self.busy = False
                self.guide = Guide()
                self.fill_channels()
                self.select(WATCHED if what == 'watch' else self.index)
                self.win.show()
                self.win.present()
                if what == 'watch':
                    self.status.set_text('')
                    self.waiting = False
                    if self.after is not None:   # chosen while waiting for a signal
                        index, self.after = self.after, None
                        self.watch(index)
            def thread():
                try:
                    job()
                except Exception as e:
                    LOG.write('tv', traceback.format_exc())
                    GLib.idle_add(self.status.set_text, 'Error: %s' % e)
                finally:
                    GLib.idle_add(done)
            threading.Thread(target=thread, daemon=True).start()

        def watch(self, index):
            """The window stays while the tuner looks for the signal (on_waiting says so) and goes
            when the player starts; another channel chosen meanwhile replaces this one"""
            if not self.list:
                return
            if self.busy:
                if self.waiting:
                    self.after = index
                    self.cancel.set()
                    self.status.set_text('Switching…')
                return
            LOG.write('tv', 'window: watch channel %d' % (index + 1))
            self.cancel, self.waiting = threading.Event(), False
            self.status.set_text('Tuning…')
            waiting = lambda text: GLib.idle_add(self.on_waiting, text)
            self.run('watch', lambda: watch(index, test, waiting, self.cancel))

        def on_waiting(self, text):
            """watch() has no signal yet (text), or the player starts (None)"""
            self.waiting = text is not None
            if text:
                self.status.set_text(text + '   Esc: stop')
                self.win.show()
                self.win.present()
            else:
                self.win.hide()

        def scan(self):
            LOG.write('tv', 'window: scan')
            progress = lambda text: GLib.idle_add(self.status.set_text, text)
            self.run('scan', lambda: scan(uhf(21, 60) if not test else [(0, 8)], test, progress))

        def update_guide(self):
            LOG.write('tv', 'window: update the guide')
            progress = lambda text: GLib.idle_add(self.status.set_text, text)
            self.run('guide', lambda: update_guide(test, progress))

        def on_key(self, w, ev):
            k = Gdk.keyval_name(ev.keyval)
            name = (k or '').replace('KP_', '')
            digit = name if len(name) == 1 and name.isdigit() else None
            if digit and not self.busy:
                # digits typed within 1.5 s make one number: that channel is selected (OK watches)
                now = time.monotonic()
                self.typed = (self.typed if now - self.typed_at < 1.5 else '')[-2:] + digit
                self.typed_at = now
                if 1 <= int(self.typed) <= len(self.list):
                    self.select(int(self.typed) - 1)
                return True
            if k == 'Escape' and self.busy and self.waiting:
                self.cancel.set()
                self.status.set_text('Stopping…')
                return True
            if k == 'Escape' and not self.busy:
                Gtk.main_quit()
                return True
            focus = self.win.get_focus()
            if k == 'Right' and focus and focus.get_parent() is self.channels:
                rows = [r for r in self.sched.get_children() if r.get_selectable()]
                cur = [r for r in rows if r.get_style_context().has_class('current')]
                if rows:
                    (cur or rows)[0].grab_focus()
                    self.sched.select_row((cur or rows)[0])
                return True
            if k == 'Left' and focus and focus.get_parent() is self.sched:
                self.select(self.index)
                return True
            return False

    GLib.set_prgname('ozone-tv')
    TvWindow()
    Gtk.main()
    return 0


def uhf(first, last):
    """UHF channel numbers to (centre kHz, 8 MHz): channel 21 is 474 MHz"""
    return [(306000 + 8000 * ch, 8) for ch in range(first, last + 1)]


def logger_entry(buf):
    """One Android logger v1 entry: (sec, pid, priority, tag, message), or None"""
    if len(buf) < 20:
        return None
    n, _pad, pid, _tid, sec, _nsec = struct.unpack_from('<HHiiii', buf)
    payload = buf[20:20 + n]
    tag, _, msg = payload[1:].partition(b'\0')
    return (sec, pid, payload[0] if payload else 0, tag.decode(errors='replace'),
            msg.rstrip(b'\0\n').decode(errors='replace'))


def show_log():
    """Android logger v1 entries from /dev/log/main"""
    fd = os.open('/dev/log/main', os.O_RDONLY | os.O_NONBLOCK)
    while True:
        try:
            entry = logger_entry(os.read(fd, 5 * 1024))
        except BlockingIOError:
            break
        if not entry:
            break
        sec, pid, _prio, tag, msg = entry
        print('%s %s(%d): %s' % (time.strftime('%H:%M:%S', time.localtime(sec)), tag, pid, msg))


def show_logs():
    runs = sorted(n for n in os.listdir(LOGS) if n.startswith('tv-')) if os.path.isdir(LOGS) else []
    print(LOGS)
    for n in runs:
        print('  ' + n)
    if runs:
        print(os.path.join(LOGS, runs[-1], 'tv.log'))


def main(argv):
    args = argv[1:]
    if '--test' in args:
        i = args.index('--test')
        del args[i:i + 2]
    cmd = args[0] if args else 'menu'
    if cmd in ('log', 'logs'):
        return show_log() if cmd == 'log' else show_logs()
    # one at a time: a second run would start a second dtvfe on the same tuner
    os.makedirs(DATA, exist_ok=True)
    global BUSY
    lock = open(LOCK, 'a+')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.seek(0)
        notify('TV is busy: %s' % (lock.read().strip() or 'another ozone-tv is running'))
        return 1
    BUSY = lock
    busy('the TV window is open' if cmd == 'menu' else 'ozone-tv ' + cmd)
    LOG.start(cmd + ('-test' if '--test' in argv else ''))
    try:
        return run(argv)
    except SystemExit as e:
        LOG.write('tv', 'exit %s' % e.code)
        raise
    except KeyboardInterrupt:
        return 130
    except BaseException as e:
        LOG.write('tv', traceback.format_exc())
        notify('TV error: %s' % e)
        raise
    finally:
        LOG.write('tv', 'done')
        LOG.close()


def run(argv):
    global CHANNELS
    test = None
    if '--test' in argv:
        i = argv.index('--test')
        test = argv[i + 1]
        del argv[i:i + 2]
        CHANNELS = os.path.join(DATA, 'channels-test.json')   # the real list stays as it is
    cmd = argv[1] if len(argv) > 1 else 'menu'
    if cmd == 'menu':
        return window(test)
    if cmd == 'guide':
        return update_guide(test) or 0
    if cmd == 'now':
        guide = Guide()
        for i, c in enumerate(c for c in load_channels() if not c['radio']):
            print('%4d  %-24s %s' % (channel_number(c, i), c['name'], on_now(guide, c)))
        return 0
    if cmd == 'scan':
        if test:
            freqs = [(0, 8)]
        elif len(argv) > 2 and argv[2] == '--freq':
            freqs = [(int(argv[3]), int(argv[4]) if len(argv) > 4 else 8)]
        else:
            first, last = (int(argv[2]), int(argv[3])) if len(argv) > 3 else (21, 60)
            freqs = uhf(first, last)
        for c in scan(freqs, test):
            print('%4s  %-28s %4d MHz  sid %-5d %s %s' % (c['lcn'] or '', c['name'], c['freq_khz'] // 1000, c['sid'],
                  'radio' if c['radio'] else c['video']['codec'],
                  ' '.join('%s/%s' % (a['codec'], a['lang'] or '-') for a in c['audio'])))
        return 0
    if cmd == 'play' and len(argv) > 2:
        return watch(int(argv[2]) - 1, test)
    if cmd == 'status' and len(argv) > 2:
        fe = open_frontend(test)
        try:
            print(fe.tune(int(argv[2]), int(argv[3]) if len(argv) > 3 else 8))
            while True:
                time.sleep(1)
                locked, strength, quality = fe.status()
                print('locked' if locked else 'no lock', 'level %d%%' % strength, 'quality %d%%' % quality, flush=True)
        except KeyboardInterrupt:
            return 0
        finally:
            fe.close()
    sys.exit(__doc__)


if __name__ == '__main__':
    sys.exit(main(sys.argv))
