button { background: #1e1e2e; border: 1px solid #313244; border-radius: 16px; padding: 4px 14px;
         box-shadow: none; }
button:hover, button:focus { border-color: #cba6f7; }
button.close { font-family: "FontAwesome"; font-size: 16px; background: transparent; border: none;
               padding: 4px 10px; color: #a6adc8; }
button.close:hover { background: #f38ba8; color: #11111b; }
.channels { border-right: 1px solid #313244; }
row { padding: 6px 12px; outline: none; }
row:selected { background: #313244; }
.num { font-family: "JetBrains Mono"; font-size: 15px; font-weight: bold; color: #cba6f7; }
.name { font-size: 15px; font-weight: bold; }
.now { color: #a6adc8; font-size: 12px; }
progressbar trough { min-height: 3px; background: #313244; border: none; border-radius: 2px; }
progressbar progress { min-height: 3px; background: #cba6f7; border: none; border-radius: 2px; }
.day { font-weight: bold; color: #f9e2af; padding: 12px 12px 4px 12px; }
.time { font-family: "JetBrains Mono"; font-size: 14px; color: #a6adc8; }
