#!/usr/bin/python3
"""ozone-sysinfo: everything about the box in one window.

Sections on the left: an overview, the software (firmware, kernel, Debian, programs), what starts
at boot and with the desktop (and whether it runs now), how it all works, the hardware, storage
and memory. The live ones refresh every 3 s. "Copy all" puts the whole report on the clipboard.

Keys: ↑ / ↓ choose a section, → (or Tab) goes into it, where ↑ / ↓ / PgUp / PgDn scroll and ←
goes back; Esc closes. The panel's CPU, memory and temperature open it too.
"""
import os
import re
import subprocess
import threading
import time

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

REFRESH = 3000   # ms
SYSTEM_PROP = '/system/build.prop'

