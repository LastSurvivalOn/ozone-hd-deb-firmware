notebook header tab button.flat { padding: 0 4px; min-height: 18px; }
'''

# Reader view: the element holding most paragraph text, cleaned of everything but content.
# Runs in its own script world; on a fast-mode page JavaScript is switched on just for this call
# (the page's own scripts were skipped at load and don't come back).
READER_JS = r'''(() => {
  const score = new Map();
  for (const p of document.querySelectorAll('p, pre, li')) {
    const n = p.textContent.trim().length;
    if (n < 40) continue;
    for (let el = p.parentElement, w = 1; el && w > 0.2; el = el.parentElement, w /= 2)
      score.set(el, (score.get(el) || 0) + n * w);
  }
  let best = null, top = 0;
  for (const [el, s] of score) if (s > top) { top = s; best = el; }
  if (!best || top < 600) return '';
  const c = best.cloneNode(true);
  c.querySelectorAll('script, style, noscript, iframe, form, button, input, select, nav, aside, footer, ' +
                     '[role=navigation], [aria-hidden=true], .mw-editsection, .navbox, .reference').forEach(e => e.remove());
  for (const img of c.querySelectorAll('img')) {
    const src = img.dataset.src || img.getAttribute('src');
    if (src) img.src = new URL(src, location.href).href;
    img.removeAttribute('srcset'); img.removeAttribute('loading');
  }
  for (const a of c.querySelectorAll('a[href]')) a.href = new URL(a.getAttribute('href'), location.href).href;
  for (const e of c.querySelectorAll('*')) { e.removeAttribute('style'); e.removeAttribute('class'); e.removeAttribute('width'); e.removeAttribute('height'); }
  const h1 = document.querySelector('h1');
  return JSON.stringify({ title: (h1 && h1.textContent.trim()) || document.title, html: c.innerHTML });
})()'''

READER_PAGE = '''<!doctype html><meta charset="utf-8"><title>{title}</title>
<style>
body {{ background: #1e1e2e; color: #cdd6f4; font: 21px/1.6 "DejaVu Serif", serif; margin: 0; }}
main {{ max-width: 44em; margin: 0 auto; padding: 32px 24px 80px; }}
h1, h2, h3 {{ font-family: "JetBrains Mono", monospace; line-height: 1.25; color: #f5f5f5; }}
a {{ color: #cba6f7; }} img {{ max-width: 100%; height: auto; }}
pre, code {{ font: 17px "JetBrains Mono", monospace; background: #181825; }} pre {{ padding: 12px; overflow-x: auto; }}
table {{ border-collapse: collapse; }} td, th {{ border: 1px solid #313244; padding: 4px 8px; }}
.src {{ font: 15px "JetBrains Mono", monospace; color: #7f849c; }}
</style><main><p class="src">{host}</p><h1>{title}</h1>{html}</main>'''


def update_filters():
    """Turns the ad server list into a WebKit content blocker (Safari's JSON rule format)."""
    with urllib.request.urlopen(BLOCKLIST_URL, timeout=30) as r:
        hosts = [h.strip() for h in r.read().decode().splitlines()]
    rules = [{'trigger': {'url-filter': r'^[^:]+://+([^:/]+\.)?' + re.escape(h) + r'[:/]'},
              'action': {'type': 'block'}}
             for h in hosts if h and not h.startswith('#')]
    os.makedirs(DATA, exist_ok=True)
    with open(FILTERS_JSON + '.tmp', 'w') as f:
        json.dump(rules, f)
    os.replace(FILTERS_JSON + '.tmp', FILTERS_JSON)
    return len(rules)


def host_of(uri):
    return (urllib.parse.urlsplit(uri or '').hostname or '').lower()


def flat_button(icon, tooltip, handler, *args):
    b = Gtk.Button(label=ICON[icon], relief=Gtk.ReliefStyle.NONE, tooltip_text=tooltip, can_focus=False)
    b.get_style_context().add_class('flat')
    b.get_style_context().add_class('icon')
    b.connect('clicked', lambda _b: handler(*args))
    return b


def set_active(button, on):
    ctx = button.get_style_context()
    ctx.add_class('active') if on else ctx.remove_class('active')


class Tab(Gtk.Box):
    def __init__(self, browser, view):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.browser, self.view = browser, view
        self.reader_of = None    # the page's URI while it is shown as a reader view
        self.started = 0
        self.pack_start(view, True, True, 0)
        self.label = Gtk.Label(label='New tab', ellipsize=Pango.EllipsizeMode.END, width_chars=18,
                               max_width_chars=18, xalign=0)
        close = flat_button('close', 'Close tab (Ctrl+W)', browser.close_tab, self)
        self.header = Gtk.Box(spacing=4)
        self.header.pack_start(self.label, True, True, 0)
        self.header.pack_start(close, False, False, 0)
        self.header.show_all()
        view.connect('notify::title', self.on_title)
        view.connect('notify::uri', self.on_uri)
        view.connect('notify::estimated-load-progress', lambda *_: browser.sync(self))
        view.connect('notify::is-loading', lambda *_: browser.sync(self))
        view.connect('load-changed', self.on_load)
        view.connect('create', browser.on_create)
        view.connect('decide-policy', browser.on_decide_policy)
        view.connect('web-process-terminated', self.on_crash)
        view.connect('close', lambda *_: browser.close_tab(self))
        self.show_all()

    def on_load(self, view, event):
        if event in (WebKit2.LoadEvent.STARTED, WebKit2.LoadEvent.REDIRECTED):
            # before the new document commits: JavaScript on or off for the site it comes from
            view.get_settings().set_enable_javascript(not self.browser.is_fast(view.get_uri()))
            if event == WebKit2.LoadEvent.STARTED:
                self.started = time.monotonic()
        elif event == WebKit2.LoadEvent.COMMITTED and self.reader_of and view.get_uri() != self.reader_of:
            self.reader_of = None    # navigated away from the reader view
        elif event == WebKit2.LoadEvent.FINISHED and self.started:
            print(f'loaded in {time.monotonic() - self.started:.1f} s: {view.get_uri()}', flush=True)
            self.started = 0
        self.browser.sync(self)

    def on_uri(self, view, _param):
        # YouTube's app switches videos with pushState, which is no navigation policy decision
        uri = view.get_uri() or ''
        if YOUTUBE_WATCH.match(uri):
            self.browser.play(uri)
            view.go_back() if view.can_go_back() else GLib.idle_add(self.browser.close_tab, self)
        self.browser.sync(self)

    def on_title(self, *_):
        title = self.view.get_title() or self.view.get_uri() or 'New tab'
        self.label.set_text(title)
        self.header.set_tooltip_text(title)
        self.browser.sync(self)

    def on_crash(self, view, reason):
        print(f'web process ended ({reason.value_nick}): {view.get_uri()}', flush=True)
        uri = GLib.markup_escape_text(view.get_uri() or '')
        memory = reason == WebKit2.WebProcessTerminationReason.EXCEEDED_MEMORY_LIMIT
        view.load_alternate_html(
            '<body style="background:#1e1e2e;color:#cdd6f4;font:18px JetBrains Mono;padding:40px">'
            '<h2>The page crashed</h2><p>' + ('It ran out of memory. ' if memory else '') +
            f'<a style="color:#cba6f7" href="{uri}">Reload</a></p>', uri, None)


class Browser(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title='ozone-web')
        self.set_default_size(1280, 690)

        style = Gtk.CssProvider()
        style.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), style,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        os.makedirs(DATA, exist_ok=True)
        pressure = WebKit2.MemoryPressureSettings()
        pressure.set_memory_limit(MEMORY_LIMIT_MB)
        manager = WebKit2.WebsiteDataManager(base_data_directory=DATA, base_cache_directory=CACHE)
        manager.get_cookie_manager().set_persistent_storage(os.path.join(DATA, 'cookies.sqlite'),
                                                            WebKit2.CookiePersistentStorage.SQLITE)
        self.context = WebKit2.WebContext(website_data_manager=manager, memory_pressure_settings=pressure)
        self.context.set_cache_model(WebKit2.CacheModel.WEB_BROWSER)
        self.context.set_spell_checking_enabled(False)
        self.context.connect('download-started', self.on_download)

        self.settings = WebKit2.Settings(
            hardware_acceleration_policy=WebKit2.HardwareAccelerationPolicy.ALWAYS if GPU
            else WebKit2.HardwareAccelerationPolicy.NEVER,
            enable_smooth_scrolling=False,
            enable_webgl=False,
            enable_webaudio=False,
            enable_media=False,
            enable_media_stream=False,
            enable_encrypted_media=False,
            enable_page_cache=True,
            enable_developer_extras=False,
            enable_back_forward_navigation_gestures=False,
        )
        self.content = WebKit2.UserContentManager()
        self.policies = WebKit2.WebsitePolicies(autoplay=WebKit2.AutoplayPolicy.DENY)
        self.blocking = False
        self.sites = self.load_json(SITES_JSON, {})   # host: {"fast": bool, "scripts": bool}
        self.script_filter = None
        self.store = WebKit2.UserContentFilterStore.new(os.path.join(CACHE, 'filters'))
        self.load_filters()
        self.update_script_filter()

        # toolbar
        self.back = flat_button('back', 'Back (Alt+Left)', lambda: self.tab.view.go_back())
        self.forward = flat_button('forward', 'Forward (Alt+Right)', lambda: self.tab.view.go_forward())
        self.reload = flat_button('reload', 'Reload (F5)', self.reload_or_stop)
        home = flat_button('home', 'Home', lambda: self.tab.view.load_uri(HOME_PAGE))
        self.entry = Gtk.Entry(placeholder_text='Search or address')
        self.entry.connect('activate', self.on_entry)
        self.entry.connect('focus-in-event', lambda *_: GLib.idle_add(self.entry.select_region, 0, -1))
        self.find = Gtk.Entry(placeholder_text='Find', width_chars=18, no_show_all=True)
        self.find.connect('changed', self.on_find)
        self.find.connect('activate', lambda *_: self.tab.view.get_find_controller().search_next())
        self.fast = flat_button('fast', 'Fast mode for this site: JavaScript off (F8)', self.toggle_fast)
        self.reader = flat_button('reader', 'Reader view (F9)', self.toggle_reader)
        self.video = flat_button('video', 'Play the video on this page (F7, or pause on the remote)',
                                 self.play_page_video)
        self.shield = flat_button('shield', 'Third-party scripts blocked on this site', self.toggle_scripts)
        bar = Gtk.Box(spacing=2)
        bar.get_style_context().add_class('toolbar')
        for w in (self.back, self.forward, self.reload, home):
            bar.pack_start(w, False, False, 0)
        bar.pack_start(self.entry, True, True, 6)
        for w in (self.find, self.video, self.fast, self.reader, self.shield):
            bar.pack_start(w, False, False, 0)
        # bspwm draws no title bars: the window closes here too (as with Super+Q, it stays ready)
        bar.pack_start(flat_button('close', 'Close the browser (Super+Q)', self.close), False, False, 8)

        self.notebook = Gtk.Notebook(scrollable=True, show_border=False)
        new = flat_button('new', 'New tab (Ctrl+T)', self.new_tab, HOME_PAGE)
        self.notebook.set_action_widget(new, Gtk.PackType.END)
        new.show()
        self.notebook.connect('switch-page', lambda _n, page, _i: self.sync(page))

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.pack_start(bar, False, False, 0)
        box.pack_start(self.notebook, True, True, 0)
        self.add(box)
        self.connect('key-press-event', self.on_key)
        self.connect('delete-event', self.on_quit)
        box.show_all()   # the window itself is shown by App (or stays hidden in the background)

    # -- tabs -------------------------------------------------------------------------------------

    @property
    def tab(self):
        return self.notebook.get_nth_page(self.notebook.get_current_page())

    def make_view(self, related=None):
        # every tab gets its own copy of the settings: JavaScript is switched per site
        s = WebKit2.Settings()
        for p in self.settings.list_properties():
            if p.flags & GObject.ParamFlags.WRITABLE and not p.flags & GObject.ParamFlags.DEPRECATED:
                s.set_property(p.name, self.settings.get_property(p.name))
        kwargs = dict(related_view=related) if related else dict(web_context=self.context)
        view = WebKit2.WebView(settings=s, user_content_manager=self.content, website_policies=self.policies,
                               **kwargs)
        view.set_background_color(Gdk.RGBA(0.118, 0.118, 0.18, 1))   # Catppuccin base while loading
        return view

    def add_tab(self, view):
        tab = Tab(self, view)
        n = self.notebook.insert_page(tab, tab.header, self.notebook.get_current_page() + 1)
        self.notebook.set_tab_reorderable(tab, True)
        self.notebook.set_current_page(n)
        return tab

    def warm_up(self):
        """An empty tab whose web process is already running, for the next page to open"""
        self.warm = self.add_tab(self.make_view())
        self.warm.view.load_uri('about:blank')

    def new_tab(self, uri=None):
        tab, self.warm = (self.warm, None) if getattr(self, 'warm', None) else (self.add_tab(self.make_view()), None)
        if uri:
            tab.view.load_uri(uri)
        if not uri or uri == HOME_PAGE:
            self.entry.grab_focus()
        else:
            tab.view.grab_focus()
        return tab

    def close_tab(self, tab):
        if tab is getattr(self, 'warm', None):
            self.warm = None
        self.notebook.remove_page(self.notebook.page_num(tab))
        tab.view.destroy()
        if self.notebook.get_n_pages() == 0:
            self.on_quit()

    def on_create(self, view, _action):
        # target=_blank and window.open: a new tab sharing the opener's process
        return self.add_tab(self.make_view(related=view)).view

    # -- navigation -------------------------------------------------------------------------------

    def on_entry(self, entry):
        self.tab.view.load_uri(to_uri(entry.get_text()))
        self.tab.view.grab_focus()

    def reload_or_stop(self):
        v = self.tab.view
        v.stop_loading() if v.is_loading() else v.reload()

    def on_decide_policy(self, view, decision, kind):
        if kind == WebKit2.PolicyDecisionType.RESPONSE:
            if not decision.is_mime_type_supported():
                decision.download()
                return True
            return False
        uri = decision.get_navigation_action().get_request().get_uri() or ''
        if YOUTUBE_WATCH.match(uri):
            self.play(uri)
        elif YOUTUBE_OTHER.match(uri):
            # the YouTube app is far too heavy for this CPU; yt searches it in a second
            q = urllib.parse.parse_qs(urllib.parse.urlsplit(uri).query).get('search_query', [''])[0]
            subprocess.Popen(['yt'] + ([q] if q else []), start_new_session=True)
        else:
            return False
        decision.ignore()
        if not view.get_uri():   # an empty tab opened just for the link
            GLib.idle_add(self.close_tab, view.get_parent())
        return True

    def play(self, uri):
        """Video belongs to the hardware decoder, not to WebKit"""
        now = time.monotonic()
        if uri == getattr(self, 'playing', (None, 0))[0] and now - self.playing[1] < 5:
            return   # both the policy decision and the URI change report the same click
        self.playing = (uri, now)
        subprocess.Popen(['yt', uri], start_new_session=True)

    def play_page_video(self):
        """The page's video on the hardware decoder, through yt (yt-dlp knows a thousand sites and plain
        <video> pages): a source of its <video>, else an embedded player, else the page itself"""
        tab = self.tab
        page = tab.reader_of or tab.view.get_uri() or ''
        if tab.reader_of:
            self.play(page)
            return
        js_was = tab.view.get_settings().get_enable_javascript()

        def found(view, result):
            view.get_settings().set_enable_javascript(js_was)
            try:
                media = json.loads(view.evaluate_javascript_finish(result).to_string())
            except (GLib.Error, ValueError):
                media = {}
            urls = [u for u in media.get('sources', []) + media.get('frames', []) if u.startswith('http')]
            if urls or page.startswith('http'):
                subprocess.Popen(['ozone-notify', 'Opening the video' if urls else 'Looking for a video on this page'])
                self.play(urls[0] if urls else page)
            else:
                subprocess.Popen(['ozone-notify', 'No video on this page'])

        # as for the reader view: on for this one call, even in fast mode
        tab.view.get_settings().set_enable_javascript(True)
        tab.view.evaluate_javascript(VIDEO_JS, -1, 'ozone-video', None, None, found)

    def on_download(self, _context, download):
        def destination(dl, name):
            folder = (GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) or
                      os.path.expanduser('~/Downloads'))
            os.makedirs(folder, exist_ok=True)
            dl.set_destination(os.path.join(folder, name))
            subprocess.Popen(['ozone-notify', 'Downloading ' + name])
            return True
        download.connect('decide-destination', destination)
        download.connect('finished', lambda dl: subprocess.Popen(
            ['ozone-notify', 'Downloaded ' + os.path.basename(dl.get_destination() or '')]))

    def on_find(self, entry):
        fc = self.tab.view.get_find_controller()
        text = entry.get_text()
        if text:
            fc.search(text, WebKit2.FindOptions.CASE_INSENSITIVE | WebKit2.FindOptions.WRAP_AROUND, 1000)
        else:
            fc.search_finish()

    # -- fast mode and reader view ------------------------------------------------------------------

    def site(self, uri):
        s = self.sites.get(host_of(uri))
        return s if isinstance(s, dict) else {}

    def is_fast(self, uri):
        host = host_of(uri)
        return self.site(uri).get('fast', any(host == d or host.endswith('.' + d) for d in FAST_SITES))

    def scripts_allowed(self, uri):
        return self.site(uri).get('scripts', False)

    def set_site(self, key, value):
        tab = self.tab
        uri = tab.reader_of or tab.view.get_uri()
        host = host_of(uri)
        if not host:
            return
        self.sites[host] = dict(self.site(uri), **{key: value})
        self.save_json(SITES_JSON, self.sites)
        tab.reader_of = None
        if key == 'scripts':
            self.update_script_filter(lambda: tab.view.load_uri(uri))
        else:
            tab.view.load_uri(uri)   # a reload keeps the old document's settings

    def toggle_fast(self):
        uri = self.tab.reader_of or self.tab.view.get_uri()
        self.set_site('fast', not self.is_fast(uri))

    def toggle_scripts(self):
        uri = self.tab.reader_of or self.tab.view.get_uri()
        self.set_site('scripts', not self.scripts_allowed(uri))

    def update_script_filter(self, then=None):
        """A small rule list, recompiled when a site is let through: third-party scripts blocked,
        except from the CDNs and on allowed sites (ignore-previous-rules acts within its own list,
        so the ad blocklist still applies there)"""
        rules = [{'trigger': {'url-filter': '.*', 'resource-type': ['script'], 'load-type': ['third-party']},
                  'action': {'type': 'block'}}]
        rules += [{'trigger': {'url-filter': r'^[^:]+://+([^:/]+\.)?' + re.escape(d) + r'[:/]',
                               'resource-type': ['script']},
                   'action': {'type': 'ignore-previous-rules'}} for d in SCRIPT_CDNS]
        allowed = [h for h, s in self.sites.items() if isinstance(s, dict) and s.get('scripts')]
        if allowed:
            rules.append({'trigger': {'url-filter': '.*', 'if-domain': ['*' + h for h in allowed]},
                          'action': {'type': 'ignore-previous-rules'}})

        def compiled(store, result):
            try:
                flt = store.save_finish(result)
            except GLib.Error as e:
                print('ozone-web: script filter:', e.message, flush=True)
                return
            if self.script_filter:
                self.content.remove_filter(self.script_filter)
            self.content.add_filter(flt)
            self.script_filter = flt
            if then:
                then()

        self.store.save('scripts', GLib.Bytes.new(json.dumps(rules).encode()), None, compiled)

    def toggle_reader(self):
        tab = self.tab
        if tab.reader_of:
            uri, tab.reader_of = tab.reader_of, None
            tab.view.load_uri(uri)
            return

        js_was = tab.view.get_settings().get_enable_javascript()

        def extracted(view, result):
            view.get_settings().set_enable_javascript(js_was)
            try:
                text = view.evaluate_javascript_finish(result).to_string()
            except GLib.Error as e:
                print('ozone-web: reader:', e.message, flush=True)
                text = ''
            if not text:
                subprocess.Popen(['ozone-notify', 'No article found on this page'])
                return
            page = json.loads(text)
            uri = view.get_uri()
            html = READER_PAGE.format(title=GLib.markup_escape_text(page['title']),
                                      host=GLib.markup_escape_text(host_of(uri)), html=page['html'])
            tab.reader_of = uri
            view.get_settings().set_enable_javascript(False)
            view.load_alternate_html(html, uri, uri)

        tab.view.get_settings().set_enable_javascript(True)
        tab.view.evaluate_javascript(READER_JS, -1, 'ozone-reader', None, None, extracted)

    # -- state ------------------------------------------------------------------------------------

    def sync(self, tab):
        if tab is not self.tab:
            return
        v = tab.view
        uri = tab.reader_of or v.get_uri() or ''
        if not self.entry.has_focus():
            self.entry.set_text('' if uri == HOME_PAGE else uri)
        loading = v.is_loading()
        self.entry.set_progress_fraction(v.get_estimated_load_progress() if loading else 0)
        self.back.set_sensitive(v.can_go_back())
        self.forward.set_sensitive(v.can_go_forward())
        self.reload.set_label(ICON['stop'] if loading else ICON['reload'])
        set_active(self.fast, self.is_fast(uri))
        allowed = self.scripts_allowed(uri)
        set_active(self.shield, not allowed)
        self.shield.set_tooltip_text(('Third-party scripts allowed here' if allowed else
                                      'Third-party scripts blocked here') + (', ads blocked' if self.blocking else ''))
        set_active(self.reader, bool(tab.reader_of))
        self.set_title((v.get_title() or 'ozone-web') + ' — ozone-web')

    def load_filters(self):
        store = self.store

        def use(flt):
            self.content.add_filter(flt)
            self.blocking = True

        def compiled(store, result):
            try:
                use(store.save_finish(result))
            except GLib.Error as e:
                print('ozone-web: blocklist:', e.message, flush=True)

        def compile_json():
            with open(FILTERS_JSON, 'rb') as f:
                store.save('blocklist', GLib.Bytes.new(f.read()), None, compiled)

        def fetch():
            try:
                update_filters()
                GLib.idle_add(compile_json)
            except OSError as e:
                print('ozone-web: blocklist download:', e, flush=True)

        def loaded(store, result):
            try:
                use(store.load_finish(result))
            except GLib.Error:   # not compiled yet
                if os.path.exists(FILTERS_JSON):
                    compile_json()
                else:
                    threading.Thread(target=fetch, daemon=True).start()

        store.load('blocklist', None, loaded)

    @staticmethod
    def load_json(path, default):
        try:
            with open(path) as f:
                return json.load(f)
        except (OSError, ValueError):
            return default

    @staticmethod
    def save_json(path, value):
        try:
            with open(path + '.tmp', 'w') as f:
                json.dump(value, f)
            os.replace(path + '.tmp', path)
        except OSError:
            pass

    def on_quit(self, *_):
        tabs = [self.notebook.get_nth_page(i) for i in range(self.notebook.get_n_pages())]
        uris = [t.reader_of or t.view.get_uri() for t in tabs if t is not getattr(self, 'warm', None)]
        self.save_json(SESSION, [u for u in uris if u and u not in (HOME_PAGE, 'about:blank')])
        if not self.get_application().background:
            self.get_application().quit()
            return False
        # stay resident: drop the pages (and their web processes), keep one warm tab
        self.hide()
        self.warm = None
        for t in tabs:
            self.notebook.remove_page(self.notebook.page_num(t))
            t.view.destroy()
        self.warm_up()
        return True

    # -- keys -------------------------------------------------------------------------------------

    def on_key(self, _w, ev):
        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        alt = bool(ev.state & Gdk.ModifierType.MOD1_MASK)
        k = Gdk.keyval_name(ev.keyval)
        if not self.notebook.get_n_pages():
            return False
        v = self.tab.view
        n = self.notebook.get_n_pages()
        cur = self.notebook.get_current_page()
        zoom = lambda d: v.set_zoom_level(min(max(v.get_zoom_level() + d, 0.3), 3))  # noqa: E731
        actions = {
            (1, 0, 'l'): self.entry.grab_focus,
            (0, 0, 'F6'): self.entry.grab_focus,
            (1, 0, 't'): lambda: self.new_tab(HOME_PAGE),
            (1, 0, 'w'): lambda: self.close_tab(self.tab),
            (1, 0, 'Tab'): lambda: self.notebook.set_current_page((cur + 1) % n),
            (1, 0, 'ISO_Left_Tab'): lambda: self.notebook.set_current_page((cur - 1) % n),
            (0, 1, 'Left'): v.go_back,
            (0, 1, 'Right'): v.go_forward,
            (0, 0, 'F5'): v.reload,
            (1, 0, 'r'): v.reload,
            (1, 0, 'plus'): lambda: zoom(0.1),
            (1, 0, 'equal'): lambda: zoom(0.1),
            (1, 0, 'minus'): lambda: zoom(-0.1),
            (1, 0, '0'): lambda: v.set_zoom_level(1),
            (1, 0, 'f'): lambda: (self.find.show(), self.find.grab_focus()),
            (0, 0, 'F7'): self.play_page_video,
            # the remote's pause and unpause buttons (KEY_PLAYPAUSE, see /etc/ozone/remote.conf)
            (0, 0, 'AudioPlay'): self.play_page_video,
            (0, 0, 'F8'): self.toggle_fast,
            (0, 0, 'F9'): self.toggle_reader,
            (0, 0, 'F11'): self.toggle_fullscreen,
        }
        if (int(ctrl), int(alt), k) in actions:
            actions[(int(ctrl), int(alt), k)]()
            return True
        if k == 'Escape':
            if self.find.get_visible():
                self.find.set_text('')
                self.find.hide()
            elif v.is_loading():
                v.stop_loading()
            v.grab_focus()
            return True
        return False

    def toggle_fullscreen(self):
        st = self.get_window().get_state()
        self.unfullscreen() if st & Gdk.WindowState.FULLSCREEN else self.fullscreen()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.window = None
        self.background = False

    def do_command_line_background(self):
        self.background = True
        self.hold()
        self.window = Browser(self)
        self.window.hide()
        self.window.warm_up()

    def get_window(self, restore):
        if not self.window:
            self.window = Browser(self)
        w = self.window
        shown = w.get_visible()
        if restore and not shown:
            for uri in w.load_json(SESSION, []):
                w.new_tab(uri)
        w.show()
        w.present()
        return w, shown

    def do_activate(self):
        if self.background and self.window is None:
            return self.do_command_line_background()
        # first opening: the last session; opened again while shown: a new tab
        w, shown = self.get_window(restore=True)
        real = [t for t in (w.notebook.get_nth_page(i) for i in range(w.notebook.get_n_pages()))
                if t is not getattr(w, 'warm', None)]
        if shown or not real:
            w.new_tab(HOME_PAGE)
        elif getattr(w, 'warm', None):
            w.close_tab(w.warm)   # the restored session needs no empty tab

    def do_open(self, files, _n, _hint):
        w, _shown = self.get_window(restore=False)
        for f in files:
            w.new_tab(f.get_uri())


def main():
    if sys.argv[1:] == ['--update-filters']:
        print(f'{update_filters()} hosts blocked; recompiled on the next start')
        path = os.path.join(CACHE, 'filters')
        for f in os.listdir(path) if os.path.isdir(path) else []:
            os.remove(os.path.join(path, f))
        return
    GLib.set_prgname('ozone-web')   # the window class bspwm and rofi see
    if not sys.stderr.isatty():
        os.makedirs(CACHE, exist_ok=True)
        log = open(LOG, 'a', buffering=1)
        os.dup2(log.fileno(), 1)
        os.dup2(log.fileno(), 2)
    app = App()
    if sys.argv[1:] == ['--background']:
        app.background = True   # becomes the resident instance unless one is already running
        sys.exit(app.run([sys.argv[0]]))
    # bare words and host names become URIs before GApplication takes them for file names
    args = [sys.argv[0]] + [to_uri(a) for a in sys.argv[1:]]
    sys.exit(app.run(args))


if __name__ == '__main__':
    main()
