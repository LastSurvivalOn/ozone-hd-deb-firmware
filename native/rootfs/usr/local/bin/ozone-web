.toolbar { padding: 4px 6px; }
button.flat { color: #a6adc8; padding: 2px 8px; min-height: 26px; border: none; background: none; }
button.flat:hover { color: #cdd6f4; background: #313244; }
button.flat:disabled { color: #45475a; }
button.icon label { font-family: "FontAwesome"; font-size: 15px; }
