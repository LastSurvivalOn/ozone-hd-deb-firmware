#!/usr/bin/python3
"""ozone-web: a small browser on WebKitGTK, tuned for the S805 (Cortex-A5, Mali-450 GPU).

What was measured on the box, and what follows from it:

- Engines: Chromium doesn't start on kernel 3.10 (killed in execve). Firefox ESR works but needs
  27-33 s to start, twice WebKit's memory, and scrolls slower. WebKitGTK is the one to use.
- WebKit renders through EGL by default, which on fbdev means Mesa in software: 2.7 fps scrolling
  a plain page. WEBKIT_DISABLE_DMABUF_RENDERER + WEBKIT_DISABLE_COMPOSITING_MODE: 45 fps, 60 MB
  less. Composited mode with CPU or llvmpipe raster gained nothing on real pages.
- On the GPU (OZONE_WEB_GPU=1; the default with our own WebKit installed, OZONE_WEB_GPU=0 turns
  it off), with the GPU on the desktop (native/gpu), it runs through ozone-gl in
  composited mode on the Mali-450, its frames coming back through cached X pixmaps
  (native/gpu/egl-fix). CSS animations: 24 frames a second instead of 3; smooth scrolling
  Wikipedia 9.7 instead of 6.5. But every frame then crosses to X whole, through shared memory
  (~25 a second at most on this memory bus), where the CPU path redraws only the strip a scroll
  exposes. It takes ~45 MB more memory. With our own WebKit installed (install-webkit.sh) the
  frames go to X as pixmaps instead: CSS animations 35 against 29; wheel scrolling Wikipedia 25
  frames a second against 12 on the CPU path (in composited mode WebKit scrolls on its own thread,
  not waiting for the page's JavaScript), a static page 29 against 32.
- Real wheel scrolling on heavy sites (Wikipedia, BBC) runs at 1-3 fps, and the cause is the
  sites' JavaScript reacting to every scroll, not painting: with JS off the same pages scroll at
  12-20 fps. Hence the per-site fast mode (JS off), on by default for sites that work without
  it, and the reader view (F9), a static copy of the article.
- No HTML5 media: WebKit's GStreamer path has neither codecs nor CPU for it here, and on YouTube it
  took the web process down. Video goes to the hardware decoder: watch pages, including the
  in-page navigation of YouTube's app, open in `yt` -> amplay; YouTube search goes to `yt` too.
  Elsewhere the play button (F7) hands the page's video to `yt` (yt-dlp): a <video> source, an
  embedded player, or the page itself, which yt-dlp knows for a thousand sites.
- Ads and trackers are blocked by a compiled WebKit content filter (pgl.yoyo.org list), and so are
  all third-party scripts (analytics, tag managers, ad and social widgets) apart from the common
  library CDNs: CNN loaded in 22 s instead of 45, The Verge in 12 instead of 48. The shield button
  lets them through for a site that needs them.
- One instance: opening it again adds a tab to the running window instead of starting another
  4-second, 200 MB browser. Closing the window quits it. `--background` keeps it ready, hidden,
  with a web process already spawned (~60 MB, and more after use): it opens at once, and closing
  the window frees the tabs and hides it again. The desktop no longer starts it that way, for the
  memory. A running instance gets requests through gdbus before this script even imports GTK
  (66 ms instead of 1.5 s).

  ozone-web [URL...]
  ozone-web --background         start hidden, ready to open
  ozone-web --update-filters     fetch the blocklist again
"""
import json
import os
import re
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request

APP_ID = 'org.ozone.Web'
SEARCH = 'https://html.duckduckgo.com/html/?q='


def to_uri(text):
    text = text.strip()
    if re.match(r'^[a-z][a-z0-9+.-]*:', text):
        return text
    if ' ' not in text and ('.' in text or text.startswith('localhost')):
        return 'https://' + text
    return SEARCH + urllib.parse.quote(text, safe='')


def forward(uris):
    """Hands the request to a running instance, if there is one, without loading GTK and WebKit"""
    def gvariant(u):
        return "'" + u.replace('\\', '\\\\').replace("'", "\\'") + "'"
    method = (['org.gtk.Application.Open', '[' + ', '.join(gvariant(u) for u in uris) + ']', "''", '{}'] if uris
              else ['org.gtk.Application.Activate', '{}'])
    try:
        return subprocess.run(['gdbus', 'call', '--session', '--dest', APP_ID, '--object-path',
                               '/' + APP_ID.replace('.', '/'), '--method'] + method,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


if __name__ == '__main__' and sys.argv[1:2] not in (['--update-filters'], ['--background']):
    if forward([to_uri(a) for a in sys.argv[1:]]):
        sys.exit(0)

# The GPU, when the desktop has it, with our WebKit (install-webkit.sh), which hands frames to X as
# pixmaps: the default once that is installed. OZONE_WEB_GPU=0: the CPU path; OZONE_WEB_GPU=1 also
# with Debian's WebKit; OZONE_WEB_OWN_WEBKIT=0: Debian's WebKit on the GPU.
OWN_WEBKIT = '/usr/local/lib/ozone-webkit/lib'
HAVE_OWN = os.path.exists(OWN_WEBKIT + '/libwebkit2gtk-4.1.so.0')
GPU = (os.path.exists('/run/ozone-gpu-desktop')
       and os.environ.get('OZONE_WEB_GPU', '1' if HAVE_OWN else '0') == '1')
OWN = GPU and HAVE_OWN and os.environ.get('OZONE_WEB_OWN_WEBKIT', '1') == '1'
if GPU:
    paths = [p for p in os.environ.get('LD_LIBRARY_PATH', '').split(':') if p]
    if '/usr/local/lib/mali' not in paths or (OWN and OWN_WEBKIT not in paths):
        # the libraries go in before the dynamic linker loads EGL and WebKit, so: start again
        # through ozone-gl (which puts the Mali ones first)
        if OWN and OWN_WEBKIT not in paths:
            os.environ['LD_LIBRARY_PATH'] = ':'.join([OWN_WEBKIT] + paths)
        os.execvp('ozone-gl', ['ozone-gl', sys.executable] + sys.argv)
if OWN:
    os.environ.setdefault('WEBKIT_X11_PIXMAP_RENDERER', '1')
os.environ.setdefault('WEBKIT_DISABLE_DMABUF_RENDERER', '0' if GPU else '1')
os.environ.setdefault('WEBKIT_DISABLE_COMPOSITING_MODE', '0' if GPU else '1')

import gi  # noqa: E402

gi.require_version('Gdk', '3.0')
gi.require_version('Gtk', '3.0')
gi.require_version('WebKit2', '4.1')
from gi.repository import Gdk, Gio, GLib, GObject, Gtk, Pango, WebKit2  # noqa: E402

HOME_PAGE = 'https://html.duckduckgo.com/html/'
DATA = os.path.join(GLib.get_user_data_dir(), 'ozone-web')
CACHE = os.path.join(GLib.get_user_cache_dir(), 'ozone-web')
FILTERS_JSON = os.path.join(DATA, 'blocklist.json')
SITES_JSON = os.path.join(DATA, 'sites.json')
SESSION = os.path.join(DATA, 'session.json')
LOG = os.path.join(CACHE, 'log')
BLOCKLIST_URL = 'https://pgl.yoyo.org/adservers/serverlist.php?hostformat=nohtml&showintro=0&mimetype=plaintext'
MEMORY_LIMIT_MB = 350   # per web process; WebKit drops caches and stops runaway pages above it
# Read fine without JavaScript, and scroll several times faster for it
FAST_SITES = ('wikipedia.org', 'wikimedia.org', 'wiktionary.org', 'wikibooks.org', 'bbc.com', 'bbc.co.uk',
              'news.ycombinator.com', 'stackoverflow.com', 'stackexchange.com', 'superuser.com',
              'askubuntu.com', 'old.reddit.com', 'lwn.net', 'debian.org', 'archlinux.org')
# Third-party scripts still allowed: library CDNs, and sites' own asset domains
SCRIPT_CDNS = ('githubassets.com', 'gstatic.com', 'googleapis.com', 'cdnjs.cloudflare.com', 'jsdelivr.net',
               'unpkg.com', 'code.jquery.com', 'bootstrapcdn.com', 'cloudfront.net', 'akamaized.net',
               'redditstatic.com', 'twimg.com', 'sstatic.net', 'wikimedia.org', 'gitlab-static.net')
YOUTUBE_WATCH = re.compile(r'^https?://((www|m)\.)?(youtube\.com/(watch|shorts/)|youtu\.be/)')
YOUTUBE_OTHER = re.compile(r'^https?://((www|m)\.)?youtube\.com/?(results|\?|$|#)')

# Font Awesome 4, like the panel
ICON = {'back': '', 'forward': '', 'reload': '', 'stop': '', 'home': '',
        'new': '', 'close': '', 'fast': '', 'reader': '', 'shield': '',
        'video': ''}

# What plays on the page (F7): the sources of its <video> and <audio> elements (not blob: ones, which
# a site's player feeds itself), and embedded players. WebKit's media is off, so these are only
# found, never loaded.
VIDEO_JS = r'''(() => {
  const abs = s => { try { return new URL(s, location.href).href } catch (e) { return '' } };
  const sources = [];
  for (const m of document.querySelectorAll('video, audio'))
    for (const s of [m.getAttribute('src'), ...Array.from(m.querySelectorAll('source'), e => e.getAttribute('src'))])
      if (s && !/^(blob|data):/.test(s)) sources.push(abs(s));
  const frames = Array.from(document.querySelectorAll('iframe[src]'), f => abs(f.getAttribute('src')))
    .filter(u => /youtube(-nocookie)?\.com\/embed|player\.vimeo\.com|dailymotion\.com\/embed|\/embed\/|player\./.test(u));
  return JSON.stringify({sources, frames});
})()'''

