#!/usr/bin/python3
"""ozone-dlna: DLNA (UPnP AV) on the home network, both ways.

  ozone-dlna renderer   the box as a TV that phones and computers send to: "Play to" / "Cast to
                        device" in BubbleUPnP, VLC, Kodi, Windows' Films & TV and Media Player...
                        Videos play in amplay (in mpv when it has no hardware decoder for them),
                        music and photos in mpv. The desktop starts it (bspwmrc), when it is on.
  ozone-dlna browse     the media servers on the network (a NAS, Jellyfin, Plex, minidlna, a
                        computer sharing its media), their folders, and play from them
  ozone-dlna menu       for the Network menu: receiving on / off, its name, browse
  ozone-dlna status     "on: NAME" or "off"

The renderer: SSDP on 239.255.255.250:1900 (announcements and answers to searches), an HTTP
server on port 49494 (the device and service descriptions, SOAP control, GENA events) for the
home network only, and AVTransport, RenderingControl (the volume: the Master control, as
ozone-volume) and ConnectionManager. Settings: ~/.config/ozone/dlna.json; log ~/.cache/ozone-dlna.log.
"""
import html
import http.client
import ipaddress
import json
import os
import random
import re
import select
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request
import uuid
import xml.etree.ElementTree as ET
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOME = os.path.expanduser('~')
CONF = os.path.join(HOME, '.config/ozone/dlna.json')
LOG = os.path.join(HOME, '.cache/ozone-dlna.log')
SOCK = os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'ozone-dlna-mpv.%d' % os.getuid())
PORT = 49494
SSDP = ('239.255.255.250', 1900)
SERVER = 'Linux/3.10 UPnP/1.0 ozone-dlna/1.0'
DEFAULTS = {'renderer': True, 'name': 'Ozone TV'}

AVT = 'urn:schemas-upnp-org:service:AVTransport:1'
RCS = 'urn:schemas-upnp-org:service:RenderingControl:1'
CMS = 'urn:schemas-upnp-org:service:ConnectionManager:1'
CDS = 'urn:schemas-upnp-org:service:ContentDirectory:1'
RENDERER = 'urn:schemas-upnp-org:device:MediaRenderer:1'
MEDIA_SERVER = 'urn:schemas-upnp-org:device:MediaServer:1'
NS = {'d': 'urn:schemas-upnp-org:device-1-0', 'didl': 'urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/',
      'dc': 'http://purl.org/dc/elements/1.1/', 'upnp': 'urn:schemas-upnp-org:metadata-1-0/upnp/'}

MIMES = ('video/mp4', 'video/x-matroska', 'video/mpeg', 'video/mp2t', 'video/vnd.dlna.mpeg-tts', 'video/avi',
         'video/x-msvideo', 'video/quicktime', 'video/webm', 'video/x-flv', 'video/3gpp', 'video/x-ms-wmv',
         'video/x-mkv', 'audio/mpeg', 'audio/mp4', 'audio/x-m4a', 'audio/aac', 'audio/flac', 'audio/x-flac',
         'audio/wav', 'audio/x-wav', 'audio/L16', 'audio/ogg', 'audio/x-ms-wma', 'image/jpeg', 'image/png',
         'image/gif', 'image/bmp', 'application/vnd.apple.mpegurl', 'application/x-mpegurl')
SINK = ','.join('http-get:*:%s:*' % m for m in MIMES)


def log(text):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, 'a') as f:
            f.write('%s %s\n' % (time.strftime('%F %T'), text))
    except OSError:
        pass


def settings():
    s = dict(DEFAULTS)
    try:
        with open(CONF) as f:
            s.update(json.load(f))
    except (OSError, ValueError):
        pass
    return s


def save_settings(s):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF + '.tmp', 'w') as f:
        json.dump(s, f, indent=1)
    os.replace(CONF + '.tmp', CONF)


def notify(text):
    subprocess.call(['ozone-notify', text], stderr=subprocess.DEVNULL)


def local_addresses():
    """The box's IPv4 addresses on the networks around it (the cable, WiFi, the hotspot), not VPNs"""
    out = []
    r = subprocess.run(['ip', '-4', '-o', 'addr'], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        f = line.split()
        if len(f) > 3 and f[2] == 'inet' and not f[1].startswith(('lo', 'tun', 'wg', 'ppp')):
            out.append(f[3].split('/')[0])
    return out


def address_towards(ip):
    """The box's address a host at ip reaches it on"""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect((ip, 9))   # nothing is sent: it only picks the route
        return s.getsockname()[0]
    except OSError:
        return None
    finally:
        s.close()


def private(ip):
    try:
        a = ipaddress.ip_address(ip)
        return a.is_private or a.is_loopback or a.is_link_local
    except ValueError:
        return False


def hms(seconds):
    seconds = max(0, int(seconds or 0))
    return '%d:%02d:%02d' % (seconds // 3600, seconds // 60 % 60, seconds % 60)


def seconds_of(text):
    """'H:MM:SS(.fff)' -> seconds"""
    try:
        parts = [float(p) for p in text.strip().split(':')]
    except ValueError:
        return None
    total = 0.0
    for p in parts:
        total = total * 60 + p
    return total


def xml_text(e, path):
    x = e.find(path, NS)
    return x.text.strip() if x is not None and x.text else ''


def didl_items(xml):
    """DIDL-Lite -> [{'id', 'container', 'title', 'class', 'url', 'mime', 'duration', 'size', 'count'}]"""
    out = []
    try:
        root = ET.fromstring(xml)
    except ET.ParseError:
        return out
    for e in root:
        tag = e.tag.split('}')[-1]
        if tag not in ('container', 'item'):
            continue
        d = {'id': e.get('id', ''), 'container': tag == 'container', 'title': xml_text(e, 'dc:title') or '?',
             'class': xml_text(e, 'upnp:class'), 'count': e.get('childCount'), 'url': None, 'mime': '',
             'duration': None, 'size': None}
        for res in e.findall('didl:res', NS):
            info = res.get('protocolInfo', '')
            if res.text and info.startswith('http-get'):
                d['url'], d['mime'] = res.text.strip(), (info.split(':') + ['', '', ''])[2]
                d['duration'] = seconds_of(res.get('duration', '')) if res.get('duration') else None
                d['size'] = res.get('size')
                break
        out.append(d)
    return out


def media_kind(cls, mime, url):
    """'video', 'audio' or 'image', from the upnp:class, the MIME type or the file name"""
    for word in (cls or '', mime or ''):
        for k, keys in (('video', ('videoItem', 'video/')), ('audio', ('audioItem', 'audio/', 'musicTrack')),
                        ('image', ('imageItem', 'image/', 'photo'))):
            if any(key in word for key in keys):
                return k
    ext = os.path.splitext(urllib.parse.urlparse(url or '').path)[1].lower()
    if ext in ('.mp3', '.flac', '.m4a', '.aac', '.ogg', '.opus', '.wav', '.wma'):
        return 'audio'
    if ext in ('.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp'):
        return 'image'
    return 'video'


# ---- the players ----------------------------------------------------------------------------------

def stop_other_players():
    """The hardware decoder takes one player: any other amplay (Files, YouTube, TV) is asked to go"""
    r = subprocess.run(['pgrep', '-x', 'amplay'], capture_output=True, text=True)
    pids = [int(p) for p in r.stdout.split()]
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    for _ in range(30):
        if not any(os.path.exists('/proc/%d' % p) for p in pids):
            break
        time.sleep(0.1)


class Player:
    """What plays the current URI: amplay --control, or mpv through its JSON IPC. state is the
    AVTransport one. The players are started from the request threads, so no PR_SET_PDEATHSIG
    (it goes with the thread, not the process): the renderer stops them when it ends"""

    def __init__(self, on_change):
        self.on_change = on_change
        self.lock = threading.RLock()
        self.p = None
        self.backend = None
        self.state = 'NO_MEDIA_PRESENT'
        self.pos = 0.0
        self.dur = 0.0
        self.uri = ''
        self.meta = ''
        self.next = ('', '')
        self.title = ''
        self.kind = 'video'
        self.generation = 0
        self.log = open(LOG, 'a')

    def set_uri(self, uri, meta):
        with self.lock:
            playing = self.state in ('PLAYING', 'TRANSITIONING')
            self.stop(quiet=True)
            self.uri, self.meta = uri, meta or ''
            self.pos, self.dur = 0.0, 0.0
            self.title, cls, mime = self.describe(self.meta)
            self.kind = media_kind(cls, mime, uri)
            self.state = 'STOPPED'
            log('uri %s (%s): %s' % (self.title, self.kind, uri))
        if playing:   # a new one while playing: some senders don't say Play again
            self.play()
        self.on_change()

    def describe(self, meta):
        items = didl_items(meta) if meta else []
        if items:
            i = items[0]
            if i['duration']:
                self.dur = i['duration']
            return i['title'], i['class'], i['mime']
        name = urllib.parse.unquote(os.path.basename(urllib.parse.urlparse(self.uri).path))
        return os.path.splitext(name)[0] or 'From the network', '', ''

    def play(self):
        with self.lock:
            if not self.uri:
                return False
            if self.p and self.p.poll() is None:
                self.command('play')
                self.state = 'PLAYING'
            else:
                self.start(self.kind == 'video')
        self.on_change()
        return True

    def start(self, hardware):
        self.generation += 1
        gen = self.generation
        self.state = 'TRANSITIONING'
        if hardware:
            stop_other_players()
            self.backend = 'amplay'
            self.p = subprocess.Popen(['amplay', '--control', '--title', self.title, self.uri], stdin=subprocess.PIPE,
                                      stdout=subprocess.PIPE, stderr=self.log, text=True, bufsize=1)
            threading.Thread(target=self.watch_amplay, args=(self.p, gen), daemon=True).start()
        else:
            if self.kind == 'video':
                subprocess.call(['amplay', '--reset'])
            self.backend = 'mpv'
            try:
                os.unlink(SOCK)
            except OSError:
                pass
            args = ['mpv', '--fs', '--no-terminal', '--force-window=immediate', '--input-ipc-server=' + SOCK, '--title=' + self.title,
                    '--keep-open=no', '--image-display-duration=inf', '--osd-playing-msg=${media-title}']
            self.p = subprocess.Popen(args + ['--', self.uri], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                      stderr=self.log)
            threading.Thread(target=self.watch_mpv, args=(self.p, gen), daemon=True).start()
        notify('From the network: %s' % self.title)

    def watch_amplay(self, p, gen):
        for line in p.stdout:
            f = line.split()
            if len(f) == 4 and f[0] == 'pos':
                with self.lock:
                    if gen != self.generation:
                        break
                    self.pos, self.dur = float(f[1]), float(f[2]) or self.dur
                    state = {'playing': 'PLAYING', 'paused': 'PAUSED_PLAYBACK'}.get(f[3], 'TRANSITIONING')
                    changed = state != self.state
                    self.state = state
                if changed:
                    self.on_change()
        code = p.wait()
        with self.lock:
            if gen != self.generation:
                return
            if code == 3:   # no hardware decoder for it (or no video at all): mpv
                log('amplay: no hardware decoder, mpv')
                self.start(False)
                return
        self.ended(gen)

    def mpv(self, *cmd):
        try:
            s = socket.socket(socket.AF_UNIX)
            s.settimeout(1)
            s.connect(SOCK)
            s.sendall((json.dumps({'command': list(cmd)}) + '\n').encode())
            data = b''
            while b'\n' not in data:
                chunk = s.recv(4096)
                if not chunk:
                    break
                data += chunk
            s.close()
            for line in data.decode(errors='replace').splitlines():
                m = json.loads(line)
                if 'error' in m:
                    return m.get('data')
        except (OSError, ValueError):
            pass
        return None

    def watch_mpv(self, p, gen):
        while p.poll() is None:
            time.sleep(1)
            pos, dur, paused = self.mpv('get_property', 'time-pos'), self.mpv('get_property', 'duration'), \
                self.mpv('get_property', 'pause')
            with self.lock:
                if gen != self.generation:
                    return
                if pos is not None:
                    self.pos = pos
                if dur:
                    self.dur = dur
                state = 'PAUSED_PLAYBACK' if paused else 'PLAYING' if pos is not None or self.kind == 'image' \
                    else 'TRANSITIONING'
                changed = state != self.state
                self.state = state
            if changed:
                self.on_change()
        self.ended(gen)

    def ended(self, gen):
        """The player is gone: at the end, or the viewer closed it. The next one, if one was given"""
        with self.lock:
            if gen != self.generation:
                return
            self.p = None
            nxt = self.next
            self.next = ('', '')
            self.state = 'STOPPED'
            self.pos = 0.0
        self.on_change()
        if nxt[0]:
            self.set_uri(*nxt)
            self.play()

    def command(self, what, value=None, p=None):
        """pause, play, seek SECONDS, quit"""
        if self.backend == 'amplay':
            try:
                (p or self.p).stdin.write(what + ('' if value is None else ' %.1f' % value) + '\n')
                (p or self.p).stdin.flush()
            except (OSError, AttributeError, ValueError):
                pass
        elif what in ('pause', 'play'):
            self.mpv('set_property', 'pause', what == 'pause')
        elif what == 'seek':
            self.mpv('seek', value, 'absolute')
        elif what == 'quit':
            self.mpv('quit')

    def pause(self):
        with self.lock:
            if self.p and self.p.poll() is None:
                self.command('pause')
                self.state = 'PAUSED_PLAYBACK'
        self.on_change()

    def seek(self, seconds):
        with self.lock:
            if self.p and self.p.poll() is None:
                self.command('seek', seconds)
                self.pos = seconds

    def stop(self, quiet=False):
        with self.lock:
            self.generation += 1
            p, self.p = self.p, None
            if p and p.poll() is None:
                self.command('quit', p=p)
                try:
                    p.wait(3)
                except subprocess.TimeoutExpired:
                    p.kill()
                    p.wait()
            self.state = 'STOPPED' if self.uri else 'NO_MEDIA_PRESENT'
            self.pos = 0.0
        if not quiet:
            self.on_change()


# ---- the renderer: UPnP descriptions, SOAP, events ---------------------------------------------------

def scpd(actions, variables):
    """actions: {name: [(argument, 'in'|'out', variable)]}; variables: [(name, type, events, allowed)]"""
    a = ''.join('<action><name>%s</name><argumentList>%s</argumentList></action>' % (
        n, ''.join('<argument><name>%s</name><direction>%s</direction><relatedStateVariable>%s'
                   '</relatedStateVariable></argument>' % arg for arg in args)) for n, args in actions.items())
    v = ''.join('<stateVariable sendEvents="%s"><name>%s</name><dataType>%s</dataType>%s</stateVariable>' % (
        'yes' if ev else 'no', n, t,
        '<allowedValueList>%s</allowedValueList>' % ''.join('<allowedValue>%s</allowedValue>' % x for x in allowed)
        if isinstance(allowed, tuple) else
        '<allowedValueRange><minimum>0</minimum><maximum>100</maximum><step>1</step></allowedValueRange>'
        if allowed == 'volume' else '') for n, t, ev, allowed in variables)
    return ('<?xml version="1.0" encoding="utf-8"?><scpd xmlns="urn:schemas-upnp-org:service-1-0"><specVersion>'
            '<major>1</major><minor>0</minor></specVersion><actionList>%s</actionList><serviceStateTable>%s'
            '</serviceStateTable></scpd>' % (a, v))


