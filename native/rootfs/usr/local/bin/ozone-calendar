#!/usr/bin/python3
"""ozone-calendar: a month calendar for the remote, with events, reminders and Ukraine's holidays.

  ozone-calendar               the window
  ozone-calendar reminders     the reminder service (bspwmrc starts it): shows a reminder when one
                               is due, waking the screen from sleep
  ozone-calendar popup ID DAY  one reminder's window (the service starts it)

The month: the arrows choose a day, page+ / page- the month, 0 today; OK opens the day (its events,
or a new one if it has none), green (or N) a new event on it, exit closes. The day: up / down
choose an event, OK edits it, blue (or Delete) removes it (pressed twice), exit back to the month.
An event: up / down choose a line, left / right change it (the date, the time, how it repeats, the
reminder), the digits type a time, OK on Save saves it, exit cancels. The bar at the bottom always
says which keys do what.

Events are kept in ~/.local/share/ozone-calendar/events.json: {"id", "date": "YYYY-MM-DD",
"time": "HH:MM" or "" (all day), "title", "repeat": "" / "weekly" / "monthly" / "yearly",
"remind": minutes before or null}. An all-day event reminds at 9:00.
"""
import calendar
import datetime
import json
import os
import subprocess
import sys
import time
import uuid

HOME = os.path.expanduser('~')
DATA = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.join(HOME, '.local/share'), 'ozone-calendar')
EVENTS = os.path.join(DATA, 'events.json')
REMINDED = os.path.join(DATA, 'reminded.json')
ALL_DAY_AT = 9 * 60          # minutes after midnight: when an all-day event reminds
CHECK = 20                   # s between the service's looks at the clock
LATE = 6 * 3600              # s: a reminder missed by more than this (the box was off) is dropped

REPEATS = [('', 'Once'), ('weekly', 'Every week'), ('monthly', 'Every month'), ('yearly', 'Every year')]
REMINDS = [(None, 'No reminder'), (0, 'At the time'), (10, '10 minutes before'), (30, '30 minutes before'),
           (60, '1 hour before'), (180, '3 hours before'), (1440, 'The day before'), (10080, 'A week before')]
WEEKDAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
MONTHS = [None, 'January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September',
          'October', 'November', 'December']


# ---- the events -----------------------------------------------------------------------------------

def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def load_events():
    return [e for e in load(EVENTS, []) if isinstance(e, dict) and e.get('date')]


def occurs(ev, day):
    """The event happens on this day (a datetime.date)"""
    try:
        first = datetime.date.fromisoformat(ev['date'])
    except ValueError:
        return False
    if day < first:
        return False
    rep = ev.get('repeat', '')
    if rep == 'weekly':
        return (day - first).days % 7 == 0
    if rep == 'monthly':
        # the 31st of a month: the last day of shorter ones
        return day.day == min(first.day, calendar.monthrange(day.year, day.month)[1])
    if rep == 'yearly':
        if (first.month, first.day) == (2, 29) and not calendar.isleap(day.year):
            return (day.month, day.day) == (2, 28)
        return (day.month, day.day) == (first.month, first.day)
    return day == first


def minutes(ev):
    """When in the day the event is, in minutes; None all day"""
    t = ev.get('time') or ''
    try:
        h, m = t.split(':')
        return int(h) * 60 + int(m)
    except ValueError:
        return None


def on_day(events, day):
    out = [e for e in events if occurs(e, day)]
    return sorted(out, key=lambda e: (minutes(e) is not None, minutes(e) or 0, e.get('title', '').casefold()))


def when_text(ev):
    m = minutes(ev)
    return 'all day' if m is None else '%02d:%02d' % divmod(m, 60)


def orthodox_easter(year):
    """Easter by the Julian reckoning (Meeus), as a Gregorian date"""
    a, b, c = year % 4, year % 7, year % 19
    d = (19 * c + 15) % 30
    e = (2 * a + 4 * b - d + 34) % 7
    month, day = divmod(d + e + 114, 31)
    return datetime.date(year, month, day + 1) + datetime.timedelta(days=13)


def holidays(year):
    """Ukraine's public holidays: {date: name}. Since 2024 they follow the new church calendar
    (Christmas on 25 December) and the new days of 2023's laws. Under martial law they are
    working days, but still the holidays."""
    easter = orthodox_easter(year)
    d = datetime.date
    out = {d(year, 1, 1): "New Year's Day", d(year, 3, 8): "International Women's Day",
           easter: 'Easter', easter + datetime.timedelta(days=49): 'Trinity',
           d(year, 5, 1): "International Workers' Day", d(year, 6, 28): 'Constitution Day',
           d(year, 8, 24): 'Independence Day', d(year, 12, 25): 'Christmas'}
    if year >= 2024:
        out.update({d(year, 5, 8): 'Day of Remembrance and Victory over Nazism',
                    d(year, 7, 15): 'Statehood Day', d(year, 10, 1): 'Defenders Day'})
    else:
        out.update({d(year, 1, 7): 'Christmas (old calendar)', d(year, 5, 9): 'Victory Day',
                    d(year, 10, 14): 'Defenders Day'})
        if year >= 2022:
            out[d(year, 7, 28)] = 'Statehood Day'
    return out


_HOLIDAYS = {}


def holiday(day):
    if day.year not in _HOLIDAYS:
        _HOLIDAYS[day.year] = holidays(day.year)
    return _HOLIDAYS[day.year].get(day)


def long_date(day):
    return '%s, %d %s %d' % (calendar.day_name[day.weekday()], day.day, MONTHS[day.month], day.year)


# ---- reminders ------------------------------------------------------------------------------------

def due_at(ev, day):
    """The time (epoch) the event on this day reminds at, or None"""
    before = ev.get('remind')
    if before is None:
        return None
    m = minutes(ev)
    at = datetime.datetime.combine(day, datetime.time()) + datetime.timedelta(
        minutes=(ALL_DAY_AT if m is None else m) - before)
    return at.timestamp()


def reminder_service():
    """Looks at the clock every CHECK s; a reminder due since the last look (or missed by less than
    LATE, as after a power off) opens its window. Each one once: reminded.json keeps them."""
    env = dict(os.environ)
    env.setdefault('DISPLAY', ':0')
    while True:
        now = time.time()
        done = load(REMINDED, {})
        changed = False
        today = datetime.date.today()
        events = load_events()
        # a reminder is due at most a week before the day (the longest choice)
        for offset in range(-1, 8):
            day = today + datetime.timedelta(days=offset)
            for ev in events:
                if not occurs(ev, day):
                    continue
                at = due_at(ev, day)
                key = '%s@%s' % (ev.get('id'), day.isoformat())
                if at is None or at > now or now - at > LATE or key in done:
                    continue
                done[key] = now
                changed = True
                show_reminder(ev['id'], day.isoformat(), env)
        snoozed = done.get('snoozed') if isinstance(done.get('snoozed'), dict) else {}
        for key, at in list(snoozed.items()):
            if at <= now:
                del snoozed[key]
                changed = True
                ev_id, day = key.split('@', 1)
                show_reminder(ev_id, day, env)
        # forget the old ones
        for key in [k for k, v in done.items() if k != 'snoozed' and isinstance(v, (int, float)) and v < now - 9 * 86400]:
            del done[key]
            changed = True
        if changed:
            save(REMINDED, done)
        time.sleep(CHECK)


def show_reminder(ev_id, day, env):
    print('%s: reminder %s %s' % (time.strftime('%F %T'), ev_id, day), flush=True)
    if os.path.exists('/run/ozone-standby.lock'):   # asleep: the screen on first
        subprocess.call(['sudo', '-n', '/usr/local/bin/ozone-standby', 'wake'])
    subprocess.Popen([sys.argv[0], 'popup', ev_id, day], env=env, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


# ---- the windows ----------------------------------------------------------------------------------

