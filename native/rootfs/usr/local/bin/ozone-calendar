# the remote's colour buttons and what a keyboard has for them
GREEN = ('Launch2', 'n', 'N', 'Insert')
BLUE = ('Launch4', 'Delete')


def hint_markup(pairs):
    """[(keys, what)] as the hint bar's text; a colour name becomes a dot of its colour"""
    colours = {'red': '#f38ba8', 'green': '#a6e3a1', 'yellow': '#f9e2af', 'blue': '#89b4fa'}
    out = []
    for keys, what in pairs:
        k = GLib.markup_escape_text(keys)
        for name, c in colours.items():
            k = k.replace(name, '<span foreground="%s">●</span> %s' % (c, name))
        out.append('<b>%s</b>  %s' % (k, GLib.markup_escape_text(what)))
    return '      '.join(out)


def setup_gtk():
    global Gdk, GLib, Gtk, Pango
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gdk, GLib, Gtk, Pango
    # GTK's CSS parser loses the first number of the first stylesheet to a stale errno (see yt)
    try:
        Gtk.CssProvider().load_from_data(b'* { padding: 0px; }')
    except GLib.Error:
        pass
    style = Gtk.CssProvider()
    style.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), style,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def label(text='', cls=None, **kw):
    kw.setdefault('xalign', 0)
    w = Gtk.Label(label=text, **kw)
    for c in (cls or '').split():
        w.get_style_context().add_class(c)
    return w


def classes(widget, *names, on=True):
    ctx = widget.get_style_context()
    for n in names:
        (ctx.add_class if on else ctx.remove_class)(n)


class Calendar:
    def __init__(self):
        self.events = load_events()
        self.today = datetime.date.today()
        self.day = self.today
        self.mode = 'month'      # month, day (its list of events), form (an event)
        self.chosen = 0          # the row in the day's list or the form
        self.armed = None        # a delete waiting for its second press
        self.win = Gtk.Window(title='Calendar')
        self.win.set_default_size(1280, 720)
        self.win.connect('destroy', Gtk.main_quit)
        self.win.connect('key-press-event', self.on_key)

        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        header = Gtk.Box(spacing=8)
        classes(header, 'header')
        header.pack_start(label('\uf073', 'logo'), False, False, 0)
        header.pack_start(label('Calendar', 'heading'), False, False, 0)
        prev = Gtk.Button(label='\uf053', tooltip_text='The previous month (page-)')
        classes(prev, 'nav')
        prev.connect('clicked', lambda w: self.move_month(-1))
        self.month_label = label('', 'month')
        nxt = Gtk.Button(label='\uf054', tooltip_text='The next month (page+)')
        classes(nxt, 'nav')
        nxt.connect('clicked', lambda w: self.move_month(1))
        today = Gtk.Button(label='Today', tooltip_text='Today (0)')
        today.connect('clicked', lambda w: self.go(datetime.date.today()))
        header.pack_start(Gtk.Box(), True, True, 0)
        for w in (prev, self.month_label, nxt, today):
            header.pack_start(w, False, False, 0)
        header.pack_start(Gtk.Box(), True, True, 0)
        self.clock = label('', 'clock')
        header.pack_start(self.clock, False, False, 0)
        close = Gtk.Button(label='\uf00d', tooltip_text='Close (exit)')
        classes(close, 'close')
        close.connect('clicked', lambda w: self.win.destroy())
        header.pack_start(close, False, False, 0)
        for w in header.get_children():
            w.set_can_focus(False)
        top.pack_start(header, False, False, 0)

        body = Gtk.Box(spacing=16, margin_start=16, margin_end=16, margin_bottom=12)
        grid = Gtk.Grid(row_spacing=6, column_spacing=6, row_homogeneous=False, column_homogeneous=True)
        for c, name in enumerate(WEEKDAYS):
            w = label(name, 'weekday', xalign=0.5)
            classes(w, 'weekend', on=c >= 5)
            grid.attach(w, c, 0, 1, 1)
        self.cells = []
        for r in range(6):
            for c in range(7):
                box = Gtk.EventBox(visible_window=True, hexpand=True, vexpand=True)
                classes(box, 'cell')
                inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                num = label('', 'num')
                marks = label('', 'mark', ellipsize=Pango.EllipsizeMode.END, max_width_chars=1,
                              hexpand=True, yalign=0, lines=3, wrap=True)
                inner.pack_start(num, False, False, 0)
                inner.pack_start(marks, True, True, 0)
                box.add(inner)
                box.connect('button-press-event', self.on_cell, len(self.cells))
                grid.attach(box, c, r + 1, 1, 1)
                self.cells.append((box, num, marks))
        body.pack_start(grid, True, True, 0)

        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, width_request=380)
        classes(side, 'side')
        self.side_name = label('', 'dayname')
        self.side_num = label('', 'daynum')
        self.side_hol = label('', 'dayhol', wrap=True)
        for w in (self.side_name, self.side_num, self.side_hol):
            side.pack_start(w, False, False, 0)
        side.pack_start(Gtk.Box(height_request=8), False, False, 0)
        self.rows_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True, can_focus=False)
        scroll.add(self.rows_box)
        self.scroll = scroll
        side.pack_start(scroll, True, True, 0)
        self.message = label('', 'warn', wrap=True)
        side.pack_start(self.message, False, False, 0)
        body.pack_start(side, False, False, 0)
        top.pack_start(body, True, True, 0)

        self.hints = label('', 'hints', use_markup=True)
        top.pack_start(self.hints, False, False, 0)
        self.win.add(top)

        self.entry = Gtk.Entry(placeholder_text='What is it (text on the remote types)')
        self.entry.connect('activate', lambda w: self.form_move(1))
        self.win.show_all()
        self.render()
        self.tick()
        GLib.timeout_add_seconds(20, self.tick)

    # -- drawing

    def tick(self):
        now = datetime.datetime.now()
        self.clock.set_text(now.strftime('%H:%M'))
        if now.date() != self.today:   # past midnight
            self.today = now.date()
            self.render()
        return True

    def month_days(self):
        first = self.day.replace(day=1)
        start = first - datetime.timedelta(days=first.weekday())
        return [start + datetime.timedelta(days=i) for i in range(42)]

    def render(self):
        self.month_label.set_text('%s %d' % (MONTHS[self.day.month], self.day.year))
        for (box, num, marks), d in zip(self.cells, self.month_days()):
            num.set_text(str(d.day))
            hol = holiday(d)
            evs = on_day(self.events, d)
            lines = []
            if hol:
                lines.append('<span foreground="#f38ba8">%s</span>' % GLib.markup_escape_text(hol))
            for e in evs:
                m = minutes(e)
                lines.append(GLib.markup_escape_text(('%02d:%02d ' % divmod(m, 60) if m is not None else '• ')
                                                     + e.get('title', '')))
            marks.set_markup('\n'.join(lines))
            classes(box, 'other', on=d.month != self.day.month)
            classes(box, 'today', on=d == self.today)
            classes(box, 'selected', on=d == self.day)
            classes(box, 'weekend', on=d.weekday() >= 5)
            classes(box, 'holiday', on=bool(hol))
        self.side_name.set_text(calendar.day_name[self.day.weekday()] +
                                ('  · today' if self.day == self.today else ''))
        self.side_num.set_text('%d %s %d' % (self.day.day, MONTHS[self.day.month], self.day.year))
        hol = holiday(self.day)
        self.side_hol.set_text(hol or '')
        self.side_hol.set_visible(bool(hol))
        if self.mode == 'form':
            self.render_form()
        else:
            self.render_day()
        self.render_hints()

    def clear_rows(self):
        # the entry first: a row dropped with it inside destroys it, and its text
        if self.entry.get_parent():
            self.entry.get_parent().remove(self.entry)
        for w in self.rows_box.get_children():
            self.rows_box.remove(w)

    def row(self, index, cls=''):
        box = Gtk.EventBox(visible_window=False)
        inner = Gtk.Box(spacing=10)
        classes(inner, 'row', *cls.split())
        classes(inner, 'chosen', on=self.mode != 'month' and index == self.chosen)
        box.add(inner)
        box.connect('button-press-event', self.on_row, index)
        self.rows_box.pack_start(box, False, False, 0)
        return inner

    def render_day(self):
        self.clear_rows()
        self.day_events = on_day(self.events, self.day)
        r = self.row(0)
        r.pack_start(label('\uf067  New event', 'add'), True, True, 0)
        for i, e in enumerate(self.day_events, 1):
            r = self.row(i)
            r.pack_start(label(when_text(e), 'time', yalign=0), False, False, 0)
            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            texts.pack_start(label(e.get('title', ''), wrap=True, max_width_chars=26), False, False, 0)
            extra = [t for v, t in REPEATS if v == e.get('repeat', '') and v] + \
                    ['\uf0f3 ' + t.lower() for v, t in REMINDS if v == e.get('remind') and v is not None]
            if extra:
                texts.pack_start(label(' · '.join(extra), 'rep'), False, False, 0)
            r.pack_start(texts, True, True, 0)
        if not self.day_events:
            self.rows_box.pack_start(label('Nothing on this day.', 'rep', margin_start=10, margin_top=8),
                                     False, False, 0)
        self.rows_box.show_all()

    FORM = ['title', 'date', 'time', 'repeat', 'remind', 'save', 'delete', 'cancel']

    def render_form(self):
        self.clear_rows()
        f = self.form
        for i, name in enumerate(self.FORM):
            if name == 'delete' and not f.get('id_old'):
                continue
            r = self.row(i)
            if name == 'title':
                r.pack_start(label('Event', 'key'), False, False, 0)
                r.pack_start(self.entry, True, True, 0)
                continue
            if name in ('save', 'delete', 'cancel'):
                text = {'save': '\uf00c  Save', 'cancel': '\uf05e  Cancel',
                        'delete': '\uf1f8  Press OK again to delete it' if self.armed == 'form' else '\uf1f8  Delete'}[name]
                r.pack_start(label(text, {'save': 'save', 'delete': 'danger', 'cancel': ''}[name]), True, True, 0)
                continue
            key = {'date': 'Date', 'time': 'Time', 'repeat': 'Repeats', 'remind': 'Reminder'}[name]
            r.pack_start(label(key, 'key'), False, False, 0)
            r.pack_start(label('\uf104', 'arrows'), False, False, 0)
            r.pack_start(label(self.form_value(name), 'value', ellipsize=Pango.EllipsizeMode.END), True, True, 0)
            r.pack_start(label('\uf105', 'arrows'), False, False, 0)
        self.rows_box.show_all()
        if self.FORM[self.chosen] == 'title':
            self.entry.grab_focus_without_selecting()
        else:
            self.win.set_focus(None)

    def form_value(self, name):
        f = self.form
        if name == 'date':
            d = datetime.date.fromisoformat(f['date'])
            return '%s %d %s %d' % (WEEKDAYS[d.weekday()], d.day, MONTHS[d.month][:3], d.year)
        if name == 'time':
            if f.get('typed'):
                t = f['typed'].ljust(4, '_')
                return '%s:%s' % (t[:2], t[2:])
            return when_text(f)
        if name == 'repeat':
            return dict(REPEATS)[f['repeat']]
        if name == 'remind':
            return dict(REMINDS)[f['remind']]
        return ''

    def render_hints(self):
        if self.mode == 'month':
            pairs = [('← → ↑ ↓', 'day'), ('page+ page−', 'month'), ('OK', 'the day'), ('green', 'new event'),
                     ('0', 'today'), ('exit', 'close')]
        elif self.mode == 'day':
            pairs = [('↑ ↓', 'choose'), ('OK', 'open'), ('blue', 'delete'), ('green', 'new event'),
                     ('exit', 'back to the month')]
        else:
            name = self.FORM[self.chosen]
            pairs = [('↑ ↓', 'line')]
            if name == 'title':
                pairs += [('text', 'on-screen keyboard'), ('OK', 'next line')]
            elif name == 'time':
                pairs += [('← →', '15 minutes'), ('0–9', 'type the time'), ('delete', 'all day')]
            elif name == 'date':
                pairs += [('← →', 'day'), ('page+ page−', 'month')]
            elif name in ('repeat', 'remind'):
                pairs += [('← →', 'change')]
            else:
                pairs += [('OK', name)]
            pairs += [('exit', 'cancel')]
        self.hints.set_markup(hint_markup(pairs))

    # -- moving about

    def go(self, day):
        self.day = day
        self.armed = None
        if self.mode == 'day':
            self.chosen = 0
        self.message.set_text('')
        self.render()

    def move_month(self, n):
        y, m = divmod(self.day.year * 12 + self.day.month - 1 + n, 12)
        self.go(self.day.replace(year=y, month=m + 1, day=min(self.day.day, calendar.monthrange(y, m + 1)[1])))

    def on_cell(self, box, ev, index):
        if self.mode == 'form':
            return False
        if ev.type == Gdk.EventType._2BUTTON_PRESS:
            self.open_day()
        else:
            self.go(self.month_days()[index])
        return True

    def on_row(self, box, ev, index):
        if ev.type != Gdk.EventType.BUTTON_PRESS:
            return False
        if self.mode == 'month':
            self.mode = 'day'
        if self.mode == 'form' and self.FORM[index] in ('date', 'time', 'repeat', 'remind'):
            self.chosen = index
            self.form_change(1 if ev.button == 1 else -1)
            return True
        self.chosen = index
        self.activate()
        return True

    def open_day(self):
        self.day_events = on_day(self.events, self.day)
        if not self.day_events:
            self.new_event()
            return
        self.mode = 'day'
        self.chosen = 1
        self.render()

    def new_event(self, ev=None):
        if ev is None:
            ev = {'date': self.day.isoformat(), 'time': '', 'title': '', 'repeat': '', 'remind': None}
        self.form = dict(ev)
        self.form['id_old'] = ev.get('id')
        self.form['date_shown'] = self.day.isoformat()
        self.entry.set_text(ev.get('title', ''))
        self.mode = 'form'
        self.chosen = 0
        self.armed = None
        self.message.set_text('')
        self.render()

    def activate(self):
        if self.mode == 'day':
            if self.chosen == 0:
                self.new_event()
            else:
                e = self.day_events[self.chosen - 1]
                # a repeating event is edited as a whole, from its first day
                self.new_event(e)
            return
        name = self.FORM[self.chosen]
        if name == 'save':
            self.form_save()
        elif name == 'cancel':
            self.close_form()
        elif name == 'delete':
            if self.armed == 'form':
                self.delete(self.form['id_old'])
                self.close_form()
            else:
                self.armed = 'form'
                self.render()
        else:
            self.form_move(1)

    def close_form(self):
        self.mode = 'day' if on_day(self.events, self.day) else 'month'
        self.chosen = 0
        self.armed = None
        self.win.set_focus(None)
        self.render()

    def form_move(self, n):
        rows = [i for i, name in enumerate(self.FORM) if name != 'delete' or self.form.get('id_old')]
        pos = rows.index(self.chosen) if self.chosen in rows else 0
        self.finish_typing()
        self.chosen = rows[max(0, min(len(rows) - 1, pos + n))]
        self.armed = None
        self.render()

    def finish_typing(self):
        typed = self.form.pop('typed', '')
        if typed:
            typed = typed.ljust(4, '0')
            h, m = int(typed[:2]), int(typed[2:])
            if h < 24 and m < 60:
                self.form['time'] = '%02d:%02d' % (h, m)
            else:
                self.message.set_text('No such time: %s:%s' % (typed[:2], typed[2:]))

    def form_change(self, n, big=False):
        f = self.form
        name = self.FORM[self.chosen]
        if name == 'date':
            d = datetime.date.fromisoformat(f['date'])
            if big:
                y, m = divmod(d.year * 12 + d.month - 1 + n, 12)
                d = d.replace(year=y, month=m + 1, day=min(d.day, calendar.monthrange(y, m + 1)[1]))
            else:
                d += datetime.timedelta(days=n)
            f['date'] = d.isoformat()
        elif name == 'time':
            self.finish_typing()
            m = minutes(f)
            if m is None:
                m = 9 * 60
            else:
                m = (m // 15 + n) * 15 if m % 15 == 0 or n > 0 else m // 15 * 15
                if m < 0 or m >= 24 * 60:
                    m = None
            f['time'] = '' if m is None else '%02d:%02d' % divmod(m, 60)
        elif name in ('repeat', 'remind'):
            options = [v for v, _t in (REPEATS if name == 'repeat' else REMINDS)]
            i = options.index(f[name]) if f[name] in options else 0
            f[name] = options[(i + n) % len(options)]
        else:
            return
        self.render()

    def form_save(self):
        self.finish_typing()
        f = self.form
        title = self.entry.get_text().strip()
        if not title:
            self.message.set_text('Give the event a name first (the first line).')
            self.chosen = 0
            self.render()
            return
        ev = {'id': f.get('id_old') or uuid.uuid4().hex[:12], 'date': f['date'], 'time': f.get('time', ''),
              'title': title, 'repeat': f.get('repeat', ''), 'remind': f.get('remind')}
        self.events = [e for e in load_events() if e.get('id') != ev['id']] + [ev]
        save(EVENTS, self.events)
        # its reminders come again for the new time, but not the ones already past
        done = load(REMINDED, {})
        for k in [k for k in done if k.startswith(ev['id'] + '@')]:
            del done[k]
        now = time.time()
        for offset in range(-1, 8):
            day = datetime.date.today() + datetime.timedelta(days=offset)
            at = due_at(ev, day) if occurs(ev, day) else None
            if at is not None and at <= now:
                done['%s@%s' % (ev['id'], day.isoformat())] = now
        save(REMINDED, done)
        d = datetime.date.fromisoformat(f['date'])
        if not occurs(ev, self.day):
            self.day = d
        self.close_form()
        self.message.set_text('Saved.')

    def delete(self, ev_id):
        self.events = [e for e in load_events() if e.get('id') != ev_id]
        save(EVENTS, self.events)
        self.message.set_text('Deleted.')

    # -- keys

    def on_key(self, w, ev):
        k = Gdk.keyval_name(ev.keyval)
        if self.mode == 'form':
            return self.form_key(k, ev)
        if k in GREEN:
            self.mode = 'month'
            self.new_event()
            return True
        if k == 'Escape':
            if self.mode == 'day':
                self.mode = 'month'
                self.armed = None
                self.render()
            else:
                self.win.destroy()
            return True
        if self.mode == 'day':
            n = len(self.day_events) + 1
            if k in ('Up', 'Down'):
                self.chosen = max(0, min(n - 1, self.chosen + (1 if k == 'Down' else -1)))
                self.armed = None
                self.message.set_text('')
                self.render()
            elif k in ('Return', 'KP_Enter', 'space'):
                self.activate()
            elif k in BLUE and self.chosen > 0:
                e = self.day_events[self.chosen - 1]
                if self.armed == e.get('id'):
                    self.delete(e['id'])
                    self.armed = None
                    self.chosen = min(self.chosen, len(on_day(self.events, self.day)))
                    if not on_day(self.events, self.day):
                        self.mode = 'month'
                    self.render()
                else:
                    self.armed = e.get('id')
                    what = e.get('title', '') + (' (every time it repeats)' if e.get('repeat') else '')
                    self.message.set_text('Delete %s? Press blue again.' % what)
            elif k in ('Left', 'BackSpace'):
                self.mode = 'month'
                self.render()
            elif k in ('Page_Up', 'Page_Down'):
                self.mode = 'month'
                self.move_month(-1 if k == 'Page_Down' else 1)
            return True
        step = {'Left': -1, 'Right': 1, 'Up': -7, 'Down': 7}.get(k)
        if step:
            self.go(self.day + datetime.timedelta(days=step))
        elif k in ('Page_Up', 'Page_Down'):
            self.move_month(1 if k == 'Page_Up' else -1)
        elif k in ('0', 'KP_0', 'Home', 't', 'T'):
            self.go(datetime.date.today())
        elif k in ('Return', 'KP_Enter', 'space'):
            self.open_day()
        else:
            return False
        return True

    def form_key(self, k, ev):
        name = self.FORM[self.chosen]
        if k == 'Escape':
            self.close_form()
            return True
        if k in ('Up', 'Down'):
            self.form_move(1 if k == 'Down' else -1)
            return True
        if name == 'title':
            if k == 'Tab':
                self.form_move(1)
                return True
            return False     # the entry types, and its OK moves on
        if k in ('Return', 'KP_Enter', 'space'):
            self.activate()
        elif k in ('Left', 'Right'):
            self.form_change(1 if k == 'Right' else -1)
        elif k in ('Page_Up', 'Page_Down') and name == 'date':
            self.form_change(1 if k == 'Page_Up' else -1, big=True)
        elif name == 'time' and (k.isdigit() or k.startswith('KP_') and k[3:].isdigit()):
            typed = self.form.get('typed', '') + k[-1]
            self.form['typed'] = typed
            if len(typed) == 4:
                self.finish_typing()
            self.render()
        elif name == 'time' and k in ('BackSpace', 'Delete'):
            self.form.pop('typed', None)
            self.form['time'] = ''
            self.render()
        elif k == 'Tab':
            self.form_move(1)
        elif k in GREEN:
            self.form_save()
        else:
            return k not in ('Super_L', 'Super_R')
        return True


class Popup:
    """A reminder: the event, when, OK and "In 10 minutes" """

    def __init__(self, ev_id, day):
        ev = next((e for e in load_events() if e.get('id') == ev_id), None)
        if not ev:
            raise SystemExit(0)
        self.key = '%s@%s' % (ev_id, day)
        d = datetime.date.fromisoformat(day)
        today = datetime.date.today()
        rel = {0: 'Today', 1: 'Tomorrow'}.get((d - today).days) or long_date(d)
        when = rel + ('' if minutes(ev) is None else ' at ' + when_text(ev))
        self.win = Gtk.Window(title='Reminder: ' + ev.get('title', ''))
        self.win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.win.set_keep_above(True)
        self.win.set_position(Gtk.WindowPosition.CENTER)
        self.win.set_default_size(560, -1)
        classes(self.win, 'popup')
        self.win.connect('destroy', Gtk.main_quit)
        self.win.connect('key-press-event', self.on_key)
        box = Gtk.Box(spacing=22, margin=26)
        box.pack_start(label('\uf0f3', 'bell', yalign=0), False, False, 0)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        texts.pack_start(label(ev.get('title', ''), 'ptitle', wrap=True, max_width_chars=34), False, False, 0)
        texts.pack_start(label(when, 'pwhen'), False, False, 0)
        hol = holiday(d)
        if hol:
            texts.pack_start(label(hol, 'dayhol'), False, False, 0)
        buttons = Gtk.Box(spacing=12, margin_top=14)
        self.buttons = []
        for i, text in enumerate(('OK', 'In 10 minutes')):
            b = Gtk.EventBox(visible_window=False)
            inner = label(text, 'pbtn')
            b.add(inner)
            b.connect('button-press-event', lambda w, e, i=i: self.press(i))
            buttons.pack_start(b, False, False, 0)
            self.buttons.append(inner)
        texts.pack_start(buttons, False, False, 0)
        texts.pack_start(label('← → choose, OK presses, exit closes', 'rep'), False, False, 0)
        box.pack_start(texts, True, True, 0)
        self.win.add(box)
        self.chosen = 0
        self.show_chosen()
        self.win.show_all()
        self.win.present()
        subprocess.call(['ozone-notify', '\uf0f3 ' + ev.get('title', '') + ': ' + when.lower()],
                        stderr=subprocess.DEVNULL)

    def show_chosen(self):
        for i, b in enumerate(self.buttons):
            classes(b, 'chosen', on=i == self.chosen)

    def press(self, i):
        if i == 1:
            done = load(REMINDED, {})
            if not isinstance(done.get('snoozed'), dict):
                done['snoozed'] = {}
            done['snoozed'][self.key] = time.time() + 600
            save(REMINDED, done)
        self.win.destroy()

    def on_key(self, w, ev):
        k = Gdk.keyval_name(ev.keyval)
        if k in ('Left', 'Right', 'Tab'):
            self.chosen = 1 - self.chosen
            self.show_chosen()
        elif k in ('Return', 'KP_Enter', 'space'):
            self.press(self.chosen)
        elif k == 'Escape':
            self.win.destroy()
        return True


def main():
    args = sys.argv[1:]
    if args[:1] == ['reminders']:
        reminder_service()
        return
    if args[:1] == ['popup'] and len(args) == 3:
        name = 'ozone-reminder'
    elif not args:
        name = 'ozone-calendar'
    else:
        print(__doc__.split('\n\n')[1], file=sys.stderr)
        sys.exit(2)
    setup_gtk()
    GLib.set_prgname(name)
    if args:
        Popup(args[1], args[2])
    else:
        Calendar()
    Gtk.main()


if __name__ == '__main__':
    main()
