def window(query):
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    gi.require_version('GdkPixbuf', '2.0')
    from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Pango

    pool = ThreadPoolExecutor(6)

    def scaled(data, w, h):
        loader = GdkPixbuf.PixbufLoader()
        loader.connect('size-prepared', lambda l, iw, ih: l.set_size(w, h))  # libjpeg scales while decoding
        loader.write(data)
        loader.close()
        return loader.get_pixbuf()

    # Round avatars without cairo (python3-gi-cairo isn't installed): an antialiased disc in the
    # alpha channel
    def disc(n):
        r = n / 2
        return bytes(max(0, min(255, int((r - ((x + 0.5 - r) ** 2 + (y + 0.5 - r) ** 2) ** 0.5 + 0.5) * 255)))
                     for y in range(n) for x in range(n))
    mask = disc(AVATAR)

    def round_avatar(data):
        pb = scaled(data, AVATAR, AVATAR).add_alpha(False, 0, 0, 0)
        px, stride = bytearray(pb.get_pixels()), pb.get_rowstride()
        for y in range(AVATAR):
            px[y * stride + 3:y * stride + AVATAR * 4:4] = mask[y * AVATAR:(y + 1) * AVATAR]
        return GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(px), GdkPixbuf.Colorspace.RGB, True, 8,
                                               AVATAR, AVATAR, stride)

    def load_image(widget, url, make):
        """Downloads and decodes in the pool, shows it in the main loop"""
        def job():
            try:
                pb = make(fetch(url))
            except Exception:
                return
            GLib.idle_add(widget.set_from_pixbuf, pb)
        pool.submit(job)

    class Card(Gtk.FlowBoxChild):
        def __init__(self, e, tw):
            super().__init__()
            self.entry = e
            th = tw * 9 // 16
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

            frame = Gtk.Box()
            frame.get_style_context().add_class('thumb')
            frame.set_size_request(tw, th)
            thumb = Gtk.Image()
            frame.add(thumb)
            overlay = Gtk.Overlay()
            overlay.add(frame)
            self.badge = Gtk.Label(halign=Gtk.Align.END, valign=Gtk.Align.END)
            self.badge.get_style_context().add_class('badge')
            self.set_badge()
            overlay.add_overlay(self.badge)
            box.pack_start(overlay, False, False, 0)
            # the thumbnails in the results are WebP (no loader here); this one is JPEG, 320x180
            if e['id']:
                load_image(thumb, 'https://i.ytimg.com/vi/%s/mqdefault.jpg' % e['id'], lambda d: scaled(d, tw, th))

            row = Gtk.Box(spacing=10)
            avatar = Gtk.Image(valign=Gtk.Align.START)
            avatar.set_size_request(AVATAR, AVATAR)
            if e['avatar']:
                load_image(avatar, e['avatar'], round_avatar)
            row.pack_start(avatar, False, False, 0)
            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            title = Gtk.Label(label=e['title'], xalign=0, wrap=True, lines=2, max_width_chars=1,
                              ellipsize=Pango.EllipsizeMode.END)
            title.set_size_request(tw - AVATAR - 10, -1)
            title.get_style_context().add_class('title')
            info.pack_start(title, False, False, 0)
            for line in (e['channel'], ' · '.join(x for x in (e['views'], e['published']) if x)):
                if line:
                    lbl = Gtk.Label(label=line, xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1)
                    lbl.get_style_context().add_class('meta')
                    info.pack_start(lbl, False, False, 0)
            row.pack_start(info, True, True, 0)
            box.pack_start(row, False, False, 0)
            self.add(box)

        def set_badge(self, loading=False):
            ctx = self.badge.get_style_context()
            for c in ('live', 'loading'):
                ctx.remove_class(c)
            if loading:
                ctx.add_class('loading')
                self.badge.set_text('LOADING…')
            elif self.entry['live']:
                ctx.add_class('live')
                self.badge.set_text('LIVE')
            else:
                self.badge.set_text(self.entry['duration'])
            self.badge.set_visible(bool(self.badge.get_text()))
            self.badge.set_no_show_all(not self.badge.get_text())

    class App:
        def __init__(self):
            # GTK's CSS parser takes a stale errno for a failed number, and Python leaves ENOSYS
            # there (no getrandom() on 3.10): the first number in the first stylesheet is lost
            try:
                Gtk.CssProvider().load_from_data(b'* { padding: 0px; }')
            except GLib.Error:
                pass
            style = Gtk.CssProvider()
            style.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), style,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.win = Gtk.Window(title='YouTube')
            self.win.set_default_size(1280, 720)
            self.win.connect('destroy', Gtk.main_quit)
            self.win.connect('key-press-event', self.on_key)

            top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            header = Gtk.Box(spacing=12)
            header.get_style_context().add_class('header')
            logo = Gtk.Label(label='')   # Font Awesome's YouTube play button
            logo.get_style_context().add_class('logo')
            header.pack_start(logo, False, False, 0)
            self.entry = Gtk.Entry(placeholder_text='Search YouTube or paste a link')
            self.entry.connect('activate', lambda w: self.search(w.get_text().strip()))
            # the searches made before, offered as the entry gets the focus or as one types
            self.searches = Gtk.ListStore(str)
            completion = Gtk.EntryCompletion(model=self.searches, minimum_key_length=0, popup_single_match=True)
            completion.set_text_column(0)   # as a constructor property it shows no text
            completion.set_match_func(lambda c, key, it: key.casefold() in self.searches[it][0].casefold())
            completion.connect('match-selected', self.on_past_search)
            self.entry.set_completion(completion)
            self.entry.connect('focus-in-event', lambda *_: self.offer_searches())
            header.pack_start(self.entry, False, False, 0)
            self.status = Gtk.Label(xalign=0)
            self.status.get_style_context().add_class('status')
            header.pack_start(self.status, True, True, 0)
            # the most a video plays at
            settings = load_settings()
            label = Gtk.Label(label='Quality')
            label.get_style_context().add_class('status')
            header.pack_start(label, False, False, 0)
            self.height = Gtk.ComboBoxText(tooltip_text='Highest resolution to play')
            for h in HEIGHTS:
                self.height.append(str(h), '%dp' % h)
            self.height.set_active_id(str(settings['height']))
            header.pack_start(self.height, False, False, 0)
            self.fps = Gtk.ComboBoxText(tooltip_text='Highest frame rate (60 fps needs about twice the bandwidth)')
            for f in RATES:
                self.fps.append(str(f), '%d fps' % f)
            self.fps.set_active_id(str(settings['fps']))
            header.pack_start(self.fps, False, False, 0)
            # bspwm draws no title bars, so windows close here (or with the panel's ✕, Super+Q)
            close = Gtk.Button(label='\uf00d', tooltip_text='Close')
            close.get_style_context().add_class('close')
            close.connect('clicked', lambda w: self.win.destroy())
            header.pack_start(close, False, False, 0)
            for combo in (self.height, self.fps):
                combo.connect('changed', lambda w: save_settings({'height': int(self.height.get_active_id()),
                                                                  'fps': int(self.fps.get_active_id())}))
            top.pack_start(header, False, False, 0)

            # Recommended, History, Playlists; yellow on the remote goes through them
            tabs = Gtk.Box(spacing=6)
            tabs.get_style_context().add_class('tabs')
            self.tabs = {}
            for name, label in (('home', 'Recommended'), ('history', 'History'), ('playlists', 'Playlists')):
                b = Gtk.Button(label=label, relief=Gtk.ReliefStyle.NONE)
                b.get_style_context().add_class('tab')
                b.connect('clicked', lambda w, n=name: self.show_view(n))
                tabs.pack_start(b, False, False, 0)
                self.tabs[name] = b
            self.save_list = Gtk.Button(label='Save as a playlist', relief=Gtk.ReliefStyle.NONE, no_show_all=True)
            self.save_list.get_style_context().add_class('tab')
            self.save_list.connect('clicked', lambda w: self.save_remote_list())
            tabs.pack_start(self.save_list, False, False, 0)
            hint = Gtk.Label(label='green: add to a playlist   blue / Delete: remove   yellow: next tab', xalign=1)
            hint.get_style_context().add_class('hint')
            tabs.pack_start(hint, True, True, 0)
            top.pack_start(tabs, False, False, 0)

            self.scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            self.scroll.get_vadjustment().connect('value-changed', self.on_scroll)
            self.grid = Gtk.FlowBox(min_children_per_line=COLUMNS, max_children_per_line=COLUMNS,
                                    homogeneous=True, column_spacing=12, row_spacing=12,
                                    valign=Gtk.Align.START, margin=16,
                                    selection_mode=Gtk.SelectionMode.SINGLE)
            self.grid.set_activate_on_single_click(True)
            self.grid.set_vadjustment(self.scroll.get_vadjustment())   # arrows scroll to the card
            self.grid.connect('child-activated', lambda g, c: self.open(c))
            self.empty = Gtk.Label(label='Type and press Enter', vexpand=True)
            self.empty.get_style_context().add_class('empty')
            stack = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            stack.pack_start(self.grid, False, False, 0)
            stack.pack_start(self.empty, True, True, 0)
            self.scroll.add(stack)
            top.pack_start(self.scroll, True, True, 0)
            self.win.add(top)
            self.win.show_all()

            self.query, self.token, self.busy, self.gen, self.playing, self.pending = None, None, False, 0, False, []
            self.view, self.list_name, self.remote, self.remote_from = None, None, None, None
            if query:
                self.entry.set_text(query)
                self.search(query)
            else:
                self.show_view('home')

        # views: home (recommended), history, playlists, list (one of them), remote (a YouTube
        # playlist), search

        def set_tab(self, name):
            for n, b in self.tabs.items():
                ctx = b.get_style_context()
                ctx.add_class('active') if n == name else ctx.remove_class('active')

        def clear(self):
            self.gen += 1
            self.token = None
            for c in self.grid.get_children():
                c.destroy()
            self.scroll.get_vadjustment().set_value(0)
            self.empty.hide()
            self.save_list.hide()
            self.pending = []

        def card_width(self):
            # the window in COLUMNS, less the margins, spacing, card padding and room for a scrollbar
            return (self.scroll.get_allocated_width() - 32 - (COLUMNS - 1) * 12 - 12) // COLUMNS - 12

        def show(self, entries, status, empty, select=0):
            # cards come a page at a time, the rest as the grid is scrolled to its end (on_scroll):
            # 100 cards at once took this CPU ~5 s
            self.pending = list(entries[max(PAGE, select + 1):])
            tw = self.card_width()
            for e in entries[:max(PAGE, select + 1)]:
                self.grid.add(Card(e, tw))
            self.grid.show_all()
            self.status.set_text(status)
            if entries:
                c = self.grid.get_child_at_index(min(select, len(entries) - 1))
                self.grid.select_child(c)
                c.grab_focus()
            else:
                self.empty.set_text(empty)
                self.empty.show()

        def show_view(self, name, select=0):
            self.clear()
            self.view = name
            self.set_tab('playlists' if name == 'list' else name)
            if name == 'home':
                self.status.set_text('Finding recommendations…')
                gen = self.gen

                def job():
                    entries = recommendations()
                    GLib.idle_add(lambda: gen == self.gen and self.show(
                        entries, '%d recommended' % len(entries),
                        'Recommendations come from what you watch and search: search for something'))
                threading.Thread(target=job, daemon=True).start()
            elif name == 'history':
                h = load_json(HISTORY, [])
                self.show(h, '%d watched' % len(h), 'Nothing watched yet', select)
            elif name == 'playlists':
                cards = [{'id': v[0]['id'] if v else None, 'title': n, 'playlist': n,
                          'channel': '%d video%s' % (len(v), '' if len(v) == 1 else 's'),
                          'duration': '', 'views': '', 'published': '', 'live': False, 'avatar': None}
                         for n, v in load_playlists().items()]
                self.show(cards, '%d playlists' % len(cards), '', select)
            elif name == 'list':
                v = load_playlists().get(self.list_name, [])
                self.show(v, '%s: %d videos' % (self.list_name, len(v)),
                          'Empty: green on the remote (or Insert) adds the selected video to a playlist', select)

        def show_remote(self, list_id, back_to=None):
            """A YouTube playlist, from the results (back_to: their query) or a pasted link, which
            can be saved as one of ours"""
            self.clear()
            self.view = 'remote'
            self.remote_from = back_to
            self.set_tab(None)
            self.status.set_text('Loading the playlist…')
            gen = self.gen

            def job():
                try:
                    title, entries = youtube_playlist(list_id)
                except Exception:
                    title, entries = None, []

                def done():
                    if gen != self.gen:
                        return
                    self.remote = (title, entries)
                    self.show(entries, '%s: %d videos' % (title, len(entries)) if title else
                              'The playlist failed to load: no connection?', 'An empty playlist')
                    if entries:
                        self.save_list.show()
                GLib.idle_add(done)
            threading.Thread(target=job, daemon=True).start()

        def save_remote_list(self):
            title, entries = self.remote
            lists = load_playlists()
            name, n = title, 2
            while name in lists:
                name, n = '%s (%d)' % (title, n), n + 1
            lists[name] = entries
            save_json(PLAYLISTS, lists)
            notify('Saved as the playlist "%s"' % name)
            self.save_list.hide()

        # playlists and history: adding and removing

        def selected(self):
            sel = self.grid.get_selected_children()
            return sel[0] if sel else None

        def add_to_playlist(self):
            card = self.selected()
            if not card or card.entry.get('playlist') or card.entry.get('list'):
                return
            menu = Gtk.Menu()
            for name, videos in load_playlists().items():
                mark = '✓ ' if any(v['id'] == card.entry['id'] for v in videos) else '    '
                item = Gtk.MenuItem(label=mark + name)
                item.connect('activate', lambda w, n=name: self.add_video(n, card.entry))
                menu.append(item)
            menu.append(Gtk.SeparatorMenuItem())
            new = Gtk.MenuItem(label='    New playlist…')
            new.connect('activate', lambda w: GLib.idle_add(self.new_playlist, card.entry))
            menu.append(new)
            menu.show_all()
            menu.popup_at_widget(card, Gdk.Gravity.CENTER, Gdk.Gravity.NORTH_WEST, None)
            menu.select_first(False)   # the arrows and OK work in it at once

        def add_video(self, name, entry):
            lists = load_playlists()
            lists[name] = [v for v in lists.get(name, []) if v['id'] != entry['id']] + [dict(entry, live=False)]
            save_json(PLAYLISTS, lists)
            notify('Added to "%s"' % name)
            if self.view == 'playlists':
                self.show_view('playlists')

        def new_playlist(self, entry):
            dialog = Gtk.Dialog(title='New playlist', transient_for=self.win, modal=True)
            name = Gtk.Entry(placeholder_text='Name (text on the remote types)', activates_default=True)
            dialog.get_content_area().pack_start(name, True, True, 12)
            dialog.add_button('Create', Gtk.ResponseType.OK)
            dialog.set_default_response(Gtk.ResponseType.OK)
            dialog.show_all()
            ok = dialog.run() == Gtk.ResponseType.OK
            text = name.get_text().strip()
            dialog.destroy()
            if ok and text:
                self.add_video(text, entry)

        def remove_selected(self):
            card = self.selected()
            if not card:
                return
            i, e = card.get_index(), card.entry
            if self.view == 'history':
                save_json(HISTORY, [x for x in load_json(HISTORY, []) if x['id'] != e['id']])
            elif self.view == 'list':
                lists = load_playlists()
                lists[self.list_name] = [x for x in lists[self.list_name] if x['id'] != e['id']]
                save_json(PLAYLISTS, lists)
            elif self.view == 'playlists':
                lists = load_playlists()
                if lists[e['playlist']]:
                    notify('Only an empty playlist can be removed')
                    return
                if e['playlist'] != WATCH_LATER:   # that one is always there
                    del lists[e['playlist']]
                    save_json(PLAYLISTS, lists)
            else:
                return
            self.show_view(self.view, i)

        # searches

        def offer_searches(self):
            self.searches.clear()
            for q in load_json(SEARCHES, [])[:12]:
                self.searches.append([q])
            if len(self.searches) and not self.entry.get_text():
                # GTK 3 shows the list on a change of the text only, not on complete(), and only
                # with the device of the event at hand: so here, in the focus-in handler
                self.entry.emit('changed')

        def on_past_search(self, completion, model, it):
            q = model[it][0]
            self.entry.set_text(q)
            self.search(q)
            return True

        # results

        def search(self, q):
            if not q:
                return
            if re.match(r'^https?://', q):
                if youtube_list(q):
                    return self.show_remote(youtube_list(q))
                return self.open(None, q)
            remember_search(q)
            self.clear()
            self.view = 'search'
            self.set_tab(None)
            self.query = q
            self.load(q, None, self.gen)

        def load(self, q, token, gen):
            self.busy = True
            self.status.set_text('Searching…')

            def job():
                fallback = False
                try:
                    entries, nxt = innertube(q, token)
                    if not entries and not token:
                        raise ValueError('no results in the reply')
                except Exception:
                    if token:   # the fallback has no pages, its first one was the whole list
                        entries, nxt = [], None
                    else:
                        fallback = True
                        GLib.idle_add(self.status.set_text, 'Searching (yt-dlp)…')
                        try:
                            entries, nxt = ytdlp_search(q), None
                        except Exception:
                            entries, nxt = None, None
                GLib.idle_add(self.loaded, gen, entries, nxt, fallback)
            threading.Thread(target=job, daemon=True).start()

        def loaded(self, gen, entries, nxt, fallback):
            if gen != self.gen:
                return   # a newer search took over
            self.busy, self.token = False, nxt
            if entries is None:
                self.status.set_text('Search failed: no connection?')
                return
            first = not self.grid.get_children()
            tw = self.card_width()
            seen = {c.entry['id'] for c in self.grid.get_children()}
            for e in entries:
                if e['id'] not in seen:
                    seen.add(e['id'])
                    self.grid.add(Card(e, tw))
            self.grid.show_all()
            n = len(self.grid.get_children())
            self.status.set_text(('%d videos' % n if n else 'Nothing found') +
                                 (' (yt-dlp)' if fallback else ''))
            if first and n:
                c = self.grid.get_child_at_index(0)
                self.grid.select_child(c)
                c.grab_focus()
            if not n:
                self.empty.set_text('Nothing found')
                self.empty.show()

        def on_scroll(self, adj):
            near_end = adj.get_value() + 2 * adj.get_page_size() > adj.get_upper()
            if near_end and self.pending:
                tw = self.card_width()
                for e in self.pending[:PAGE]:
                    self.grid.add(Card(e, tw))
                self.pending = self.pending[PAGE:]
                self.grid.show_all()
            elif self.token and not self.busy and near_end:
                self.load(self.query, self.token, self.gen)

        # playback

        def open(self, card, url=None):
            if card and card.entry.get('playlist'):
                self.list_name = card.entry['playlist']
                return self.show_view('list')
            if card and card.entry.get('list'):   # a YouTube playlist among the results
                return self.show_remote(card.entry['list'], back_to=self.query)
            if self.playing:
                return
            self.playing = True
            if card:
                url = 'https://www.youtube.com/watch?v=' + card.entry['id']
                title = ' · '.join(x for x in (card.entry['title'], card.entry['channel']) if x)
                card.set_badge(loading=True)
            else:
                title = ''

            def started():
                GLib.idle_add(self.win.hide)

            def job():
                try:
                    play(url, title, started, card.entry if card else None)
                finally:
                    GLib.idle_add(self.back, card)
            threading.Thread(target=job, daemon=True).start()

        def back(self, card):
            self.playing = False
            if card:
                card.set_badge()
            self.win.show()
            self.win.present()
            if self.view == 'history':   # what was watched is first now
                self.show_view('history')
            else:
                (card or self.entry).grab_focus()

        # keys

        def on_key(self, w, ev):
            key = Gdk.keyval_name(ev.keyval)
            ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
            if key == 'Escape':
                if self.entry.has_focus() and self.grid.get_children():
                    self.focus_grid()
                elif self.view == 'list':
                    self.show_view('playlists')
                elif self.view == 'remote' and self.remote_from:
                    self.entry.set_text(self.remote_from)
                    self.search(self.remote_from)
                elif self.view in ('search', 'remote'):
                    self.show_view('home')
                else:
                    Gtk.main_quit()
                return True
            # the remote's colour buttons: yellow the next tab, green add to a playlist, blue remove
            if key == 'Launch3':
                order = ('home', 'history', 'playlists')
                cur = 'playlists' if self.view == 'list' else self.view
                self.show_view(order[(order.index(cur) + 1) % len(order)] if cur in order else 'home')
                return True
            if key in ('Launch2', 'Insert') and not self.entry.has_focus():
                self.add_to_playlist()
                return True
            if key in ('Launch4', 'Delete') and not self.entry.has_focus():
                self.remove_selected()
                return True
            if (ctrl and key == 'l') or key == 'slash' and not self.entry.has_focus():
                self.entry.grab_focus()
                return True
            if self.entry.has_focus():
                if key == 'Down' and self.grid.get_children():
                    self.focus_grid()
                    return True
                return False
            # typing anywhere starts a new search: the key then goes on to the focused entry
            if Gdk.keyval_to_unicode(ev.keyval) > 32 and not ctrl:
                self.entry.set_text('')
                self.entry.grab_focus_without_selecting()
            return False

        def focus_grid(self):
            sel = self.grid.get_selected_children() or [self.grid.get_child_at_index(0)]
            sel[0].grab_focus()

    GLib.set_prgname('yt')
    App()
    Gtk.main()
    os._exit(0)   # without waiting for thumbnails still downloading


if __name__ == '__main__':
    arg = ' '.join(sys.argv[1:]).strip()
    if re.match(r'^https?://', arg) and not youtube_list(arg):   # a playlist opens in the window
        play(arg)
    else:
        window(arg)
