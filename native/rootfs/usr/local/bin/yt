#!/usr/bin/python3
"""yt: YouTube without a browser.

Search results come straight from YouTube's own web API (InnerTube, the JSON the site itself loads:
one request, ~1 s, with channel avatars and publication dates), shown as a grid of cards; yt-dlp
is the fallback when that API changes (~10 s on this CPU, no avatars). Playback goes through the
hardware decoder (amplay, H.264 up to 1080p), or mpv in software if that fails.

  yt              search window
  yt QUERY        search window with results for QUERY
  yt URL          play right away (what ozone-web hands over): YouTube, a media file, or any of
                  yt-dlp's sites, with the browser's sign-in (its cookies) outside YouTube; a
                  YouTube playlist opens in the window

It opens on Recommended (YouTube's related videos of the last ones watched, without what was
watched; before any, the results of the last searches), next to History and Playlists, all kept on
the box (~/.local/share/ozone/yt): no account. A pasted link to a YouTube playlist shows it, to be
saved as one of ours.

Window keys: type to search (the past searches drop down), arrows to move, Enter to play, Esc
back or to close; the remote's yellow next tab, green (Insert) add to a playlist, blue (Delete)
remove. Results load further when scrolled to the end. After a video the window comes back where it was. The quality and frame
rate picked next to the search (kept in ~/.config/ozone/yt.json) are the most a video plays at:
lower them when the connection can't keep up.
"""
import json
import os
import re
import sqlite3
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor

# Language and region of the results (titles stay as uploaded; this is "views", "2 days ago")
HL = os.environ.get('YT_HL', 'en')
GL = os.environ.get('YT_GL', 'UA')

API = 'https://www.youtube.com/youtubei/v1/search?prettyPrint=false'
CLIENT = {'clientName': 'WEB', 'clientVersion': '2.20260901.00.00', 'hl': HL, 'gl': GL}
UA = 'Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0'

COLUMNS = 4
PAGE = 6 * COLUMNS   # cards made at a time
AVATAR = 36

HEIGHTS = (1080, 720, 480, 360)
RATES = (60, 30)
SETTINGS = os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config'), 'ozone', 'yt.json')


def load_settings():
    try:
        with open(SETTINGS) as f:
            s = json.load(f)
        if s.get('height') in HEIGHTS and s.get('fps') in RATES:
            return s
    except (OSError, ValueError):
        pass
    return {'height': HEIGHTS[0], 'fps': RATES[0]}


def save_settings(s):
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    with open(SETTINGS, 'w') as f:
        json.dump(s, f)


# History, searches and playlists, all on the box: no Google account
DATA = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'), 'ozone', 'yt')
HISTORY = os.path.join(DATA, 'history.json')       # videos watched, newest first
SEARCHES = os.path.join(DATA, 'searches.json')     # queries, newest first
PLAYLISTS = os.path.join(DATA, 'playlists.json')   # {name: [video, ...]}, in the order made
WATCH_LATER = 'Watch later'


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + '.tmp', 'w') as f:
        json.dump(value, f)
    os.replace(path + '.tmp', path)


def remember(path, item, key, keep):
    """Puts item first in the list at path, without its older copy"""
    items = [x for x in load_json(path, []) if key(x) != key(item)]
    save_json(path, [item] + items[:keep - 1])


def remember_video(entry):
    remember(HISTORY, dict(entry, live=False, watched=int(time.time())), lambda e: e['id'], 500)


def remember_search(query):
    remember(SEARCHES, query, lambda q: q.casefold(), 50)


def load_playlists():
    lists = load_json(PLAYLISTS, {})
    lists.setdefault(WATCH_LATER, [])
    return lists


def youtube_id(url):
    """The video's ID of a YouTube watch, short or embed URL, else None"""
    u = urllib.parse.urlsplit(url)
    if not YOUTUBE_HOST.search(u.hostname or ''):
        return None
    if (u.hostname or '').endswith('youtu.be'):
        return u.path.strip('/') or None
    m = re.match(r'^/(shorts|embed|live)/([\w-]+)', u.path)
    return m.group(2) if m else urllib.parse.parse_qs(u.query).get('v', [None])[0]


def youtube_list(url):
    """The playlist's ID of a YouTube link to a playlist (not to a video in one), else None"""
    u = urllib.parse.urlsplit(url)
    if not YOUTUBE_HOST.search(u.hostname or '') or youtube_id(url):
        return None
    return urllib.parse.parse_qs(u.query).get('list', [None])[0]


def video_format(height, fps):
    """The decoder takes H.264 (YouTube serves it up to 1080p), as separate video and audio streams
    or one with both. Without a format under the frame rate limit (60 fps videos are 60 fps from 720p
    up) the best under the height limit; without H.264 at all, whatever the site has."""
    v = '[vcodec^=avc1][height<=%d]' % height
    youtube = '/'.join('bv*%s%s+ba[acodec^=mp4a]/b%s%s' % (v, f, v, f) for f in ('[fps<=%d]' % fps, ''))
    # Other sites often don't say what codec they use (plain <video> pages say nothing): the best
    # under the limits, and amplay tells whether its decoder takes it (mpv plays it otherwise)
    return youtube + '/bv*[height<=?{0}]+ba/b[height<=?{0}]/b'.format(height)


def ytdlp():
    cmd = ['yt-dlp', '--no-warnings']
    # yt-dlp needs a JavaScript runtime to solve YouTube's signature challenges
    if any(os.access(os.path.join(d, 'node'), os.X_OK) for d in os.environ['PATH'].split(':')):
        cmd += ['--js-runtimes', 'node']
    return cmd


def notify(text):
    subprocess.call(['ozone-notify', text])


# a media file itself (what ozone-web finds in a page's <video>): nothing for yt-dlp to work out
MEDIA_FILE = re.compile(r'\.(mp4|m4v|mov|webm|mkv|ts|m3u8)$', re.I)


def play_file(url, title=''):
    """A media file's URL straight to amplay (yt-dlp takes ~10 s to start here), mpv if it fails"""
    path = urllib.parse.urlsplit(url).path
    title = title or urllib.parse.unquote(os.path.basename(path)).rsplit('.', 1)[0]
    if subprocess.call(['amplay', '--title', title, url]) != 0:
        subprocess.call(['amplay', '--reset'])
        notify('Hardware playback failed, trying mpv')
        subprocess.call(['mpv', '--force-window=immediate', url])


BROWSER_COOKIES = os.path.expanduser('~/.local/share/ozone-web/cookies.sqlite')
YOUTUBE_HOST = re.compile(r'(^|\.)(youtube\.com|youtube-nocookie\.com|youtu\.be)$')


def browser_cookies(url):
    """ozone-web's cookies as a cookies.txt for yt-dlp, so that sites signed in to in the browser give
    their videos (Vimeo, social networks). Not for YouTube: it plays without, and signed in yt-dlp
    switches to another YouTube client. The file (mode 600, in the runtime directory) is the
    caller's to remove; None without cookies."""
    if YOUTUBE_HOST.search(urllib.parse.urlsplit(url).hostname or '') or not os.path.exists(BROWSER_COOKIES):
        return None
    try:
        db = sqlite3.connect('file:%s?mode=ro' % BROWSER_COOKIES, uri=True, timeout=2)
        rows = db.execute('SELECT host, path, isSecure, isHttpOnly, expiry, name, value FROM moz_cookies').fetchall()
        db.close()
    except sqlite3.Error:
        return None
    if not rows:
        return None
    fd, path = tempfile.mkstemp(prefix='yt-cookies-', suffix='.txt', dir=os.environ.get('XDG_RUNTIME_DIR'))
    with os.fdopen(fd, 'w') as f:
        f.write('# Netscape HTTP Cookie File\n')
        for host, cpath, secure, httponly, expiry, name, value in rows:
            f.write('\t'.join((('#HttpOnly_' if httponly else '') + host, 'TRUE' if host.startswith('.') else 'FALSE',
                                cpath or '/', 'TRUE' if secure else 'FALSE', str(expiry or 0), name, value)) + '\n')
    return path


def duration_text(d):
    d = int(d)
    return '%d:%02d:%02d' % (d // 3600, d // 60 % 60, d % 60) if d >= 3600 else '%d:%02d' % (d // 60, d % 60)


def play(url, title='', started=None, entry=None):
    """Blocks until the video is over; started() is called when the picture is about to appear.
    A YouTube video goes into the history, as entry (a search card's) or as yt-dlp describes it."""
    if MEDIA_FILE.search(urllib.parse.urlsplit(url).path):
        if started:
            started()
        return play_file(url, title)
    s = load_settings()
    notify('Loading video (up to %dp%s)…' % (s['height'], s['fps'] if s['fps'] > 30 else ''))
    cookies = browser_cookies(url)
    try:
        r = subprocess.run(ytdlp() + (['--cookies', cookies] if cookies else []) +
                           # one video, as the output below is read as one video's lines: a watch URL
                           # in a playlist is its video, a page with several videos its first one
                           ['--no-playlist', '--playlist-items', '1',
                            '--print', 'title', '--print', 'channel', '--print', '%(height)s %(fps)s %(duration)s', '-g',
                            '-f', video_format(s['height'], s['fps']), url],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    finally:
        if cookies:
            os.remove(cookies)
    out = r.stdout.split('\n')
    video = out[3] if len(out) > 3 else ''
    audio = out[4] if len(out) > 4 else ''
    # what it plays at, for the player's title: 1080p60, 720p
    fields = out[2].split() if len(out) > 2 else []
    try:
        h, fps = fields[:2]
        quality = '%dp%s' % (int(h), round(float(fps)) if float(fps) > 30 else '')
    except ValueError:   # "NA" when yt-dlp doesn't know
        quality = ''
    vid = youtube_id(url)
    if video and vid:
        try:
            length = duration_text(float(fields[2]))
        except (IndexError, ValueError):
            length = ''
        remember_video(entry or {'id': vid, 'title': out[0], 'channel': '' if out[1] == 'NA' else out[1],
                                 'duration': length, 'views': '', 'published': '', 'avatar': None})
    if not video and 'ERROR:' in r.stderr:
        # removed, blocked in the region, private...: mpv would only fail the same way
        err = r.stderr[r.stderr.rindex('ERROR:'):].split('\n')[0]
        notify(re.sub(r'^ERROR: (\[\w+\] [\w-]+: )?', '', err)[:80])
        return
    if started:
        started()
    if video:
        title = ' · '.join(x for x in (title or out[0], quality) if x)
        cmd = ['amplay', '--title', title] + (['--audio', audio] if audio else []) + [video]
        status = subprocess.call(cmd)
        subprocess.call(['amplay', '--reset'])   # in case it crashed with the desktop hidden
        if status == 0:
            return
        notify('Hardware playback failed, trying mpv')
    subprocess.call(['mpv', '--force-window=immediate', url])


# --- Search ----------------------------------------------------------------------------------

def text(o):
    """InnerTube's text objects: {"simpleText": ...} or {"runs": [{"text": ...}, ...]}"""
    if not o:
        return ''
    return o.get('simpleText') or ''.join(r.get('text', '') for r in o.get('runs', []))


def video_entry(v):
    badges = [b.get('metadataBadgeRenderer', {}).get('style') for b in v.get('badges', [])]
    avatars = (v.get('channelThumbnailSupportedRenderers', {}).get('channelThumbnailWithLinkRenderer', {})
               .get('thumbnail', {}).get('thumbnails', []))
    return {
        'id': v['videoId'],
        'title': text(v.get('title')),
        'channel': text(v.get('ownerText') or v.get('longBylineText')),
        'duration': text(v.get('lengthText')),
        'views': text(v.get('shortViewCountText') or v.get('viewCountText')),
        'published': text(v.get('publishedTimeText')),
        'live': 'BADGE_STYLE_TYPE_LIVE_NOW' in badges,
        'avatar': avatars[-1]['url'] if avatars else None,
    }


def innertube(query=None, token=None):
    """One page of results and the token of the next one"""
    body = {'context': {'client': CLIENT}}
    if token:
        body['continuation'] = token
    else:
        # no filter, as on YouTube: videos and now and then a playlist (shorts shelves and
        # channels come too, and are left out below)
        body.update(query=query)
    req = urllib.request.Request(API, json.dumps(body).encode(),
                                 {'Content-Type': 'application/json', 'User-Agent': UA})
    with urllib.request.urlopen(req, timeout=15) as r:
        data = json.load(r)
    entries, nxt = [], None

    def walk(o):
        nonlocal nxt
        if isinstance(o, dict):
            for k, v in o.items():
                if k == 'videoRenderer' and 'videoId' in v:
                    entries.append(video_entry(v))
                elif k == 'lockupViewModel' and v.get('contentType') == 'LOCKUP_CONTENT_TYPE_PLAYLIST':
                    # a mix (RD...) is no playlist one can open
                    if not v.get('contentId', 'RD').startswith('RD'):
                        entries.append(playlist_entry(v))
                elif k == 'continuationItemRenderer':
                    nxt = v.get('continuationEndpoint', {}).get('continuationCommand', {}).get('token')
                else:
                    walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)
    walk(data.get('contents') or data.get('onResponseReceivedCommands'))
    return entries, nxt


def innertube_call(endpoint, body):
    body = dict(body, context={'client': CLIENT})
    req = urllib.request.Request('https://www.youtube.com/youtubei/v1/%s?prettyPrint=false' % endpoint,
                                 json.dumps(body).encode(), {'Content-Type': 'application/json', 'User-Agent': UA})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.load(r)


def lockup_entry(v):
    """A video in the newer layout of related videos and playlists (lockupViewModel)"""
    md = v.get('metadata', {}).get('lockupMetadataViewModel', {})
    rows = [[p.get('text', {}).get('content', '') for p in r.get('metadataParts', [])]
            for r in md.get('metadata', {}).get('contentMetadataViewModel', {}).get('metadataRows', [])]
    badges = []

    def walk(o):
        if isinstance(o, dict):
            for k, x in o.items():
                badges.append(x.get('text', '')) if k == 'thumbnailBadgeViewModel' else walk(x)
        elif isinstance(o, list):
            for x in o:
                walk(x)
    walk(v.get('contentImage'))
    avatar = (md.get('image', {}).get('decoratedAvatarViewModel', {}).get('avatar', {})
              .get('avatarViewModel', {}).get('image', {}).get('sources', []))
    return {
        'id': v['contentId'],
        'title': md.get('title', {}).get('content', ''),
        'channel': rows[0][0] if rows and rows[0] else '',
        'duration': next((b for b in badges if re.match(r'^[\d:]+$', b)), ''),
        'views': rows[1][0] + ' views' if len(rows) > 1 and rows[1] else '',
        'published': rows[1][-1] if len(rows) > 1 and len(rows[1]) > 1 else '',
        'live': 'LIVE' in badges,
        'avatar': avatar[-1]['url'] if avatar else None,
    }


def playlist_entry(v):
    """A playlist among search results, as a card: its first video's thumbnail, its size where a
    video has its length; 'list' tells it from a video"""
    e = lockup_entry(v)
    thumb = re.search(r'i\.ytimg\.com/vi/([\w-]+)/', json.dumps(v.get('contentImage', {})))
    size = next((b for b in re.findall(r'"text": "([^"]+)"', json.dumps(v.get('contentImage', {})))
                 if re.search(r'\d+ (videos?|episodes?|lessons?)$', b)), 'Playlist')
    return dict(e, list=v['contentId'], id=thumb.group(1) if thumb else None, duration=size,
                views='Playlist', published='', live=False)


def lockups(o):
    found = []

    def walk(o):
        if isinstance(o, dict):
            for k, v in o.items():
                if k == 'lockupViewModel' and v.get('contentType') == 'LOCKUP_CONTENT_TYPE_VIDEO':
                    found.append(lockup_entry(v))
                else:
                    walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)
    walk(o)
    return found


def related(video_id):
    """What YouTube shows next to a video, without signing in"""
    data = innertube_call('next', {'videoId': video_id})
    return lockups(data.get('contents', {}).get('twoColumnWatchNextResults', {}).get('secondaryResults'))


def youtube_playlist(list_id):
    """A public playlist: its title and (the first hundred of) its videos"""
    data = innertube_call('browse', {'browseId': 'VL' + list_id})
    title = data.get('metadata', {}).get('playlistMetadataRenderer', {}).get('title') or 'Playlist'
    return title, lockups(data.get('contents'))


def recommendations():
    """Without an account: the videos YouTube shows next to the last ones watched, taken in turn,
    without what was watched; before any, the results of the last searches"""
    history = load_json(HISTORY, [])
    seen = {e['id'] for e in history}
    if history:
        sources = [lambda vid=e['id']: related(vid) for e in history[:6]]
    else:
        sources = [lambda q=q: [e for e in innertube(q)[0] if not e.get('list')] for q in load_json(SEARCHES, [])[:3]]
    with ThreadPoolExecutor(6) as pool:
        lists = [f.result() for f in [pool.submit(lambda s=s: _safe(s)) for s in sources]]
    out = []
    for i in range(max(map(len, lists), default=0)):
        for lst in lists:
            if i < len(lst) and lst[i]['id'] not in seen:
                seen.add(lst[i]['id'])
                out.append(lst[i])
    return out


def _safe(f):
    try:
        return f()
    except Exception:
        return []


def count(n):
    for div, suffix in ((1e9, 'B'), (1e6, 'M'), (1e3, 'K')):
        if n >= div:
            return ('%.1f' % (n / div)).rstrip('0').rstrip('.') + suffix
    return str(n)


def ago(ts):
    s = time.time() - ts
    for div, unit in ((365 * 86400, 'year'), (30 * 86400, 'month'), (7 * 86400, 'week'),
                      (86400, 'day'), (3600, 'hour'), (60, 'minute')):
        if s >= div:
            n = int(s // div)
            return '%d %s%s ago' % (n, unit, 's' if n > 1 else '')
    return 'just now'


def ytdlp_search(query, n=30):
    """The fallback: the same fields from yt-dlp's flat search (dates are approximate there too)"""
    out = subprocess.run(ytdlp() + ['--flat-playlist', '-J', '--extractor-args', 'youtubetab:approximate_date',
                                    'ytsearch%d:%s' % (n, query)],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=True).stdout
    entries = []
    for e in json.loads(out).get('entries', []):
        d = int(e.get('duration') or 0)
        entries.append({
            'id': e['id'], 'title': e.get('title') or '', 'channel': e.get('channel') or '',
            'duration': duration_text(d) if d else '',
            'views': count(e['view_count']) + ' views' if e.get('view_count') is not None else '',
            'published': ago(e['timestamp']) if e.get('timestamp') else '',
            'live': e.get('live_status') == 'is_live',
            'avatar': None,
        })
    return entries


def fetch(url):
    req = urllib.request.Request(url, headers={'User-Agent': UA})
    with urllib.request.urlopen(req, timeout=15) as r:
        return r.read()


