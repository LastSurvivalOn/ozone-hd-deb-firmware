#!/usr/bin/python3
"""ozone-vpn: VPN connections, for the remote: OpenVPN (.ovpn) and WireGuard (.conf) files from the
VPN provider or your own server, and L2TP/IPsec and PPTP (a server, a login), as on Android.

  ozone-vpn menu        connect, disconnect, add a file (from ~/VPN, Downloads or a USB drive) or a
                        server, remove
  ozone-vpn status      "on: NAME" or "off"
  ozone-vpn connect NAME | disconnect | import PATH [USER PASSWORD] | remove NAME   (root)
  ozone-vpn add l2tp|pptp NAME   (root) the server's JSON on stdin: server, user, password, psk

L2TP/IPsec: strongSwan's charon (IKEv1, a pre-shared key, transport mode for UDP 1701) through the
kernel's own IPsec, which needs xfrm_user.ko (vpn/build-xfrm-user.sh: the stock kernel has IPsec but
not its netlink interface), then xl2tpd and pppd. PPTP: pptp under pppd, with MPPE (the kernel has
it). Both on ppp1 (PPPoE has ppp0), the traffic through it by two half routes, its DNS servers from
pppd's usepeerdns (Debian's ip-up.d hook puts them in resolv.conf and back).

The files are kept in /etc/ozone/vpn (root only), with a login for OpenVPN files that ask for
one. All the traffic goes through the VPN while it is on (OpenVPN as its file says; WireGuard by
two half routes, 0/1 and 128/1, and a route to its server through the usual way out), and its DNS
servers replace the usual ones until it goes off. WireGuard runs in user space (wireguard-go):
kernel 3.10 has no WireGuard. Log: /var/log/vpn.log.
"""
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time

DIR = '/etc/ozone/vpn'
RUN = '/run/ozone-vpn'
LOG = '/var/log/vpn.log'
WG = 'wg0'
WG_GO = '/usr/local/bin/wireguard-go'
RESOLV = '/etc/resolv.conf'
PPP = 'ppp1'
XFRM_USER = '/lib/modules/3.10.33/extra/xfrm_user.ko'
IPSEC_CONF, IPSEC_SECRETS = '/etc/ipsec.conf', '/etc/ipsec.secrets'


def sh(*args):
    return subprocess.call(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def log(text):
    with open(LOG, 'a') as f:
        f.write('%s %s\n' % (time.strftime('%F %T'), text))


def kind(path):
    if path.endswith(('.l2tp', '.pptp')):
        return path.rsplit('.', 1)[1]
    try:
        with open(path, errors='replace') as f:
            text = f.read(65536)
    except OSError:
        return None
    if re.search(r'^\s*\[Interface\]', text, re.M | re.I) and re.search(r'^\s*\[Peer\]', text, re.M | re.I):
        return 'wireguard'
    if re.search(r'^\s*(client|remote|dev\s+tun|<ca>)', text, re.M):
        return 'openvpn'
    return None


def configs():
    """name -> (path, kind)"""
    out = {}
    try:
        for n in sorted(os.listdir(DIR)):
            p = os.path.join(DIR, n)
            k = kind(p) if n.endswith(('.ovpn', '.conf', '.l2tp', '.pptp')) else None
            if k:
                out[n.rsplit('.', 1)[0]] = (p, k)
    except OSError:
        pass
    return out


def current():
    try:
        with open(RUN + '/name') as f:
            return f.read().strip() or None
    except OSError:
        return None


def save_dns(servers):
    """The VPN's DNS servers in resolv.conf, the usual one kept to put back"""
    if not servers:
        return
    if not os.path.exists(RUN + '/resolv.conf'):
        shutil.copy(RESOLV, RUN + '/resolv.conf')
    with open(RESOLV + '.vpn', 'w') as f:
        f.write('# ozone-vpn\n' + ''.join('nameserver %s\n' % s for s in servers))
    os.replace(RESOLV + '.vpn', RESOLV)


def restore_dns():
    if os.path.exists(RUN + '/resolv.conf'):
        shutil.copy(RUN + '/resolv.conf', RESOLV)
        os.unlink(RUN + '/resolv.conf')


def way_out():
    r = subprocess.run(['ip', 'route', 'show', 'default'], capture_output=True, text=True)
    m = re.search(r'via (\S+) dev (\S+)', r.stdout)
    return m.groups() if m else (None, None)


# ---- OpenVPN --------------------------------------------------------------------------------------

UP_SCRIPT = '/usr/local/lib/ozone/vpn-updown'   # sets the DNS servers it pushes


def openvpn_up(name, path):
    script = UP_SCRIPT
    args = ['openvpn', '--config', path, '--daemon', 'ozone-vpn', '--writepid', RUN + '/openvpn.pid',
            '--log-append', LOG, '--script-security', '2', '--up', script, '--down', script, '--up-restart',
            '--connect-retry', '5', '30', '--cd', DIR]
    auth = os.path.join(DIR, name + '.auth')
    if os.path.exists(auth):
        args += ['--auth-user-pass', auth]
    if sh(*args):
        return 'OpenVPN did not start (see %s)' % LOG
    for _ in range(45):   # connected once its tunnel has an address
        time.sleep(1)
        r = subprocess.run(['ip', '-4', '-o', 'addr', 'show', 'dev', 'tun0'], capture_output=True, text=True)
        if ' inet ' in r.stdout:
            return None
        if not alive(RUN + '/openvpn.pid'):
            return 'OpenVPN stopped: %s' % last_error()
    return 'No connection in 45 s: %s' % last_error()


def last_error():
    try:
        with open(LOG, errors='replace') as f:
            lines = [l.strip() for l in f.readlines()[-40:]]
    except OSError:
        return 'no log'
    for l in reversed(lines):
        if re.search(r'AUTH_FAILED|error|Error|failed|refused|TLS|Cannot', l):
            return l[-160:]
    return 'see %s' % LOG


def alive(pidfile):
    try:
        with open(pidfile) as f:
            os.kill(int(f.read()), 0)
        return True
    except PermissionError:
        return True
    except (OSError, ValueError):
        return False


# ---- WireGuard (user space) ---------------------------------------------------------------------

def wg_parse(path):
    """The [Interface] lines wg-quick reads (Address, DNS, MTU), and the file wg setconf takes"""
    extra = {'address': [], 'dns': [], 'mtu': None}
    keep = []
    with open(path) as f:
        for line in f:
            m = re.match(r'\s*(\w+)\s*=\s*(.*?)\s*$', line)
            key = m.group(1).lower() if m else None
            if key == 'address':
                extra['address'] += [a.strip() for a in m.group(2).split(',') if a.strip()]
            elif key == 'dns':
                extra['dns'] += [a.strip() for a in m.group(2).split(',') if a.strip()]
            elif key == 'mtu':
                extra['mtu'] = m.group(2)
            elif key in ('table', 'preup', 'postup', 'predown', 'postdown', 'saveconfig'):
                continue
            else:
                keep.append(line)
    return extra, ''.join(keep)


def wg_up(path):
    if not os.path.exists(WG_GO):
        return 'WireGuard needs %s (install-network.sh builds it)' % WG_GO
    extra, conf = wg_parse(path)
    stripped = RUN + '/wg.conf'
    fd = os.open(stripped, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(conf)
    # it goes to the background by itself: a child with WG_PROCESS_FOREGROUND=1 added to the
    # environment, but one that is already set wins, and with 0 each child would start another
    env = {k: v for k, v in os.environ.items() if k != 'WG_PROCESS_FOREGROUND'}
    env['LOG_LEVEL'] = 'error'
    if subprocess.call([WG_GO, WG], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL):
        return 'wireguard-go did not start'
    for _ in range(20):
        if os.path.exists('/sys/class/net/' + WG):
            break
        time.sleep(0.25)
    if sh('wg', 'setconf', WG, stripped):
        wg_down()
        return 'The WireGuard file was not accepted'
    for a in extra['address']:
        if ':' not in a:   # IPv4 only: the box has no IPv6 way out to send it to
            sh('ip', 'addr', 'add', a, 'dev', WG)
    sh('ip', 'link', 'set', 'mtu', extra['mtu'] or '1420', 'up', 'dev', WG)
    # its server through the usual way out, everything else through the tunnel
    gw, dev = way_out()
    endpoints = re.findall(r'^\s*Endpoint\s*=\s*\[?([^\]\s]+?)\]?:\d+\s*$', conf, re.M | re.I)
    routes = []
    for host in endpoints:
        try:
            ip = socket.gethostbyname(host)
        except OSError:
            continue
        near = subprocess.run(['ip', 'route', 'get', ip], capture_output=True, text=True).stdout
        if gw and ' via ' in near:   # not when it is on the home network itself
            sh('ip', 'route', 'add', ip, 'via', gw, 'dev', dev)
            routes.append(ip)
    allowed = ' '.join(re.findall(r'^\s*AllowedIPs\s*=\s*(.*)$', conf, re.M | re.I))
    nets = [n.strip() for n in allowed.replace(',', ' ').split() if n.strip() and ':' not in n]
    for n in nets:
        if n == '0.0.0.0/0':
            sh('ip', 'route', 'add', '0.0.0.0/1', 'dev', WG)
            sh('ip', 'route', 'add', '128.0.0.0/1', 'dev', WG)
        else:
            sh('ip', 'route', 'add', n, 'dev', WG)
    with open(RUN + '/routes', 'w') as f:
        f.write(' '.join(routes))
    save_dns([d for d in extra['dns'] if re.match(r'^[\d.]+$', d)])
    return None


def wg_down():
    try:
        with open(RUN + '/routes') as f:
            for ip in f.read().split():
                sh('ip', 'route', 'del', ip)
        os.unlink(RUN + '/routes')
    except OSError:
        pass
    sh('ip', 'link', 'del', WG)   # wireguard-go goes with its interface


# ---- L2TP/IPsec and PPTP --------------------------------------------------------------------------

def load_server(path):
    with open(path) as f:
        return json.load(f)


def ppp_options(c, kind_):
    """pppd's options for the link; the password stays out of command lines"""
    lines = ['name "%s"' % c.get('user', ''), 'password "%s"' % c.get('password', ''), 'remotename ozone-vpn',
             'ipparam ozone-vpn', 'unit 1', 'linkname ozone-vpn', 'noauth', 'nodefaultroute', 'usepeerdns',
             'noipdefault', 'refuse-eap', 'lcp-echo-interval 20', 'lcp-echo-failure 4', 'logfile ' + LOG]
    if kind_ == 'pptp':
        # MPPE needs MS-CHAPv2
        lines += ['require-mppe-128', 'refuse-pap', 'refuse-chap', 'refuse-mschap', 'mtu 1400', 'mru 1400',
                  'nobsdcomp', 'nodeflate']
    else:
        lines += ['mtu 1280', 'mru 1280', 'noccp']
    path = RUN + '/ppp-options'
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write('\n'.join(lines) + '\n')
    return path


def server_ip(c):
    try:
        return socket.gethostbyname(c['server'])
    except (OSError, KeyError):
        return None


def route_server(ip):
    """The server through the usual way out, before the half routes take everything"""
    gw, dev = way_out()
    near = subprocess.run(['ip', 'route', 'get', ip], capture_output=True, text=True).stdout
    if gw and ' via ' in near:
        sh('ip', 'route', 'add', ip, 'via', gw, 'dev', dev)
        with open(RUN + '/routes', 'w') as f:
            f.write(ip)


def ppp_wait(seconds=40):
    """ppp1 with an address, then everything through it"""
    for i in range(seconds * 2):
        r = subprocess.run(['ip', '-4', '-o', 'addr', 'show', PPP], capture_output=True, text=True)
        if 'inet ' in r.stdout:
            sh('ip', 'route', 'add', '0.0.0.0/1', 'dev', PPP)
            sh('ip', 'route', 'add', '128.0.0.0/1', 'dev', PPP)
            return True
        # pppd gave up (a refused login, no server): no use waiting
        if i > 6 and sh('pgrep', '-f', 'pppd .*/run/ozone-vpn/ppp-options') != 0:
            return False
        time.sleep(0.5)
    return False


def pptp_up(path):
    c = load_server(path)
    ip = server_ip(c)
    if not ip:
        return 'The server %s is not found' % c.get('server')
    route_server(ip)
    opts = ppp_options(c, 'pptp')
    subprocess.call(['pppd', 'pty', '/usr/sbin/pptp %s --nolaunchpppd --nohostroute' % ip, 'file', opts],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not ppp_wait():
        return 'The PPTP server did not let the box in: check the server, the user name and the password'
    return None


def l2tp_up(path):
    c = load_server(path)
    ip = server_ip(c)
    if not ip:
        return 'The server %s is not found' % c.get('server')
    if not os.path.exists('/sys/module/xfrm_user') and sh('insmod', XFRM_USER):
        return 'IPsec needs %s (install-network.sh puts it there)' % XFRM_USER
    route_server(ip)
    with open(IPSEC_CONF, 'w') as f:
        f.write('# Written by ozone-vpn (L2TP/IPsec)\nconfig setup\n\nconn ozone-l2tp\n'
                '    keyexchange=ikev1\n    authby=secret\n    type=transport\n    left=%%defaultroute\n'
                '    leftprotoport=17/1701\n    right=%s\n    rightprotoport=17/1701\n'
                '    ike=aes256-sha1-modp2048,aes128-sha1-modp2048,aes256-sha1-modp1024,aes128-sha1-modp1024,'
                '3des-sha1-modp1024\n'
                '    esp=aes256-sha1,aes128-sha1,3des-sha1\n    keyingtries=1\n    auto=add\n' % ip)
    fd = os.open(IPSEC_SECRETS, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write('%%any %s : PSK "%s"\n' % (ip, c.get('psk', '').replace('"', '')))
    # a server that doesn't answer is given up after about 15 s, not charon's 3 minutes
    with open('/etc/strongswan.d/ozone-vpn.conf', 'w') as f:
        f.write('# Written by ozone-vpn\ncharon {\n    retransmit_tries = 3\n    retransmit_timeout = 2.0\n'
                '    retransmit_base = 1.5\n}\n')
    sh('ipsec', 'restart')
    for _ in range(20):
        if os.path.exists('/var/run/charon.ctl'):
            break
        time.sleep(0.5)
    time.sleep(1)
    try:
        r = subprocess.run(['ipsec', 'up', 'ozone-l2tp'], capture_output=True, text=True, timeout=45)
        out = r.stdout
    except subprocess.TimeoutExpired:
        out = 'timed out'
    log('ipsec up: %s' % (out.strip().splitlines() or [''])[-1])
    if 'established successfully' not in out:
        return 'IPsec with the server failed: check the server and the pre-shared key'
    conf = RUN + '/xl2tpd.conf'
    with open(conf, 'w') as f:
        f.write('[global]\nport = 1701\n\n[lac ozone]\nlns = %s\nppp debug = no\npppoptfile = %s\n'
                'length bit = yes\n' % (ip, ppp_options(c, 'l2tp')))
    control = RUN + '/l2tp-control'
    subprocess.call(['xl2tpd', '-c', conf, '-p', RUN + '/xl2tpd.pid', '-C', control],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(20):
        if os.path.exists(control):
            break
        time.sleep(0.25)
    with open(control, 'w') as f:
        f.write('c ozone\n')
    if not ppp_wait():
        return 'The L2TP server did not let the box in: check the user name and the password'
    return None


def ppp_down():
    if os.path.exists(RUN + '/l2tp-control'):
        try:
            with open(RUN + '/l2tp-control', 'w') as f:
                f.write('d ozone\n')
        except OSError:
            pass
    sh('pkill', '-f', 'pppd .*/run/ozone-vpn/ppp-options')
    sh('pkill', '-f', '^/usr/sbin/pptp ')
    if os.path.exists(RUN + '/xl2tpd.pid'):
        sh('start-stop-daemon', '--stop', '--quiet', '--oknodo', '--pidfile', RUN + '/xl2tpd.pid', '--remove-pidfile')
    if os.path.exists('/var/run/charon.ctl'):
        sh('ipsec', 'down', 'ozone-l2tp')
        sh('ipsec', 'stop')
    for _ in range(20):
        if not os.path.exists('/sys/class/net/' + PPP):
            break
        time.sleep(0.25)
    try:
        with open(RUN + '/routes') as f:
            for ip in f.read().split():
                sh('ip', 'route', 'del', ip)
        os.unlink(RUN + '/routes')
    except OSError:
        pass
    for n in ('ppp-options', 'xl2tpd.conf', 'l2tp-control'):
        try:
            os.unlink(os.path.join(RUN, n))
        except OSError:
            pass


def add_server(kind_, name):
    c = json.load(sys.stdin)
    if not c.get('server') or (kind_ == 'l2tp' and not c.get('psk')):
        return 'A server%s is needed' % (' and a pre-shared key' if kind_ == 'l2tp' else '')
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    base = re.sub(r'[^\w.-]+', '_', name)[:40] or kind_
    dest = os.path.join(DIR, '%s.%s' % (base, kind_))
    fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump({k: c.get(k, '') for k in ('server', 'user', 'password', 'psk')}, f)
    log('added %s (%s)' % (base, kind_))
    return None


# ---- all of them -----------------------------------------------------------------------------------

def connect(name):
    c = configs().get(name)
    if not c:
        return 'No VPN %s' % name
    disconnect()
    os.makedirs(RUN, exist_ok=True)
    path, k = c
    log('connecting %s (%s)' % (name, k))
    try:
        error = {'openvpn': lambda: openvpn_up(name, path), 'wireguard': lambda: wg_up(path),
                 'l2tp': lambda: l2tp_up(path), 'pptp': lambda: pptp_up(path)}[k]()
    except Exception as e:   # whatever happened, nothing half-made stays (routes, daemons)
        error = 'The VPN failed: %s' % e
    if error:
        log(error)
        disconnect()
        return error
    with open(RUN + '/name', 'w') as f:
        f.write(name)
    log('on: %s' % name)
    return None


def disconnect():
    name = current()
    if alive(RUN + '/openvpn.pid'):
        with open(RUN + '/openvpn.pid') as f:
            try:
                os.kill(int(f.read()), 15)
            except (OSError, ValueError):
                pass
        for _ in range(20):
            if not alive(RUN + '/openvpn.pid'):
                break
            time.sleep(0.25)
    if os.path.exists('/sys/class/net/' + WG):
        wg_down()
    ppp_down()
    restore_dns()
    for n in ('name', 'openvpn.pid', 'wg.conf'):
        try:
            os.unlink(os.path.join(RUN, n))
        except OSError:
            pass
    if name:
        log('off: %s' % name)


def import_file(path, user=None, password=None):
    k = kind(path)
    if not k:
        return 'Not an OpenVPN or WireGuard file'
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    base = re.sub(r'[^\w.-]+', '_', os.path.basename(path)).rsplit('.', 1)[0][:40] or 'vpn'
    dest = os.path.join(DIR, base + ('.ovpn' if k == 'openvpn' else '.conf'))
    shutil.copy(path, dest)
    os.chmod(dest, 0o600)
    if user:
        auth = os.path.join(DIR, base + '.auth')
        fd = os.open(auth, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write('%s\n%s\n' % (user, password or ''))
    log('added %s (%s)' % (base, k))
    return None


def needs_login(path):
    """An OpenVPN file that asks for a user name and password, and doesn't name a file with them"""
    try:
        with open(path, errors='replace') as f:
            return bool(re.search(r'^\s*auth-user-pass\s*$', f.read(), re.M))
    except OSError:
        return False


# ---- the menu (as the user) -----------------------------------------------------------------------

def rofi(prompt, items, message=None):
    cmd = ['rofi', '-dmenu', '-i', '-format', 'i', '-p', prompt,
           '-theme-str', 'listview { lines: %d; }' % max(1, min(len(items), 12))]
    if message:
        cmd += ['-mesg', message]
    r = subprocess.run(cmd, input='\n'.join(items), capture_output=True, text=True)
    try:
        return int(r.stdout.strip())
    except ValueError:
        return None


def ask(prompt, password=False):
    cmd = ['rofi', '-dmenu', '-p', prompt, '-theme-str', 'listview { lines: 0; }']
    if password:
        cmd.insert(2, '-password')
    r = subprocess.run(cmd, input='', capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def notify(text):
    subprocess.call(['ozone-notify', text], stderr=subprocess.DEVNULL)


def root(*args):
    return subprocess.run(['sudo', '-n', sys.argv[0]] + list(args), capture_output=True, text=True)


def found_files():
    """VPN files the user can add: in ~/VPN, ~/Downloads and the top of each drive"""
    out = []
    folders = [os.path.expanduser('~/VPN'), os.path.expanduser('~/Downloads')]
    try:
        folders += [os.path.join('/media', d) for d in os.listdir('/media')]
    except OSError:
        pass
    for d in folders:
        try:
            for n in sorted(os.listdir(d)):
                p = os.path.join(d, n)
                if n.lower().endswith(('.ovpn', '.conf')) and os.path.isfile(p) and kind(p):
                    out.append(p)
        except OSError:
            pass
    return out


def menu():
    while True:
        names = json.loads(root('list').stdout or '[]')
        on = current()
        items = ['%s  %s%s' % ('●' if n == on else '○', n, '   (connected)' if n == on else '') for n in names]
        extra = (['Disconnect'] if on else []) + ['Add a VPN file…', 'Add an L2TP/IPsec server…',
                                                  'Add a PPTP server (old and unsafe)…'] + \
            (['Remove one…'] if names else [])
        i = rofi('VPN', items + extra, 'On: %s' % on if on else
                 'OpenVPN (.ovpn) or WireGuard (.conf) files from the provider: put them in VPN or Downloads, '
                 'or on a USB drive, and add them here. Or a server: L2TP/IPsec, PPTP')
        if i is None:
            return 0
        if i < len(names):
            notify('VPN: connecting to %s…' % names[i])
            r = root('connect', names[i])
            notify(r.stdout.strip() or r.stderr.strip() or 'VPN on: %s' % names[i])
            continue
        action = extra[i - len(names)]
        if action == 'Disconnect':
            root('disconnect')
            notify('VPN off')
        elif action.startswith(('Add an L2TP', 'Add a PPTP')):
            k = 'l2tp' if 'L2TP' in action else 'pptp'
            c = {'server': ask('Server (address or name)')}
            if not c['server']:
                continue
            if k == 'l2tp':
                c['psk'] = ask('Pre-shared key (IPsec secret)', password=True)
                if not c['psk']:
                    continue
            c['user'] = ask('User name') or ''
            c['password'] = ask('Password', password=True) or ''
            name = ask('A name for it') or c['server']
            r = subprocess.run(['sudo', '-n', sys.argv[0], 'add', k, name], input=json.dumps(c),
                               capture_output=True, text=True)
            notify(r.stdout.strip() or r.stderr.strip() or 'VPN added: %s' % name)
        elif action.startswith('Add'):
            files = found_files()
            if not files:
                notify('No .ovpn or .conf files in VPN, Downloads or on a USB drive')
                continue
            j = rofi('Add', [os.path.basename(f) + '   ' + os.path.dirname(f) for f in files])
            if j is None:
                continue
            args = ['import', files[j]]
            if needs_login(files[j]):
                user = ask('VPN user name')
                if user is None:
                    continue
                password = ask('VPN password', password=True)
                if password is None:
                    continue
                args += [user, password]
            r = root(*args)
            notify(r.stdout.strip() or r.stderr.strip() or 'VPN added: %s' % os.path.basename(files[j]))
        else:
            j = rofi('Remove', names)
            if j is not None:
                root('remove', names[j])
                notify('VPN removed: %s' % names[j])


def main(argv):
    cmd = argv[1] if len(argv) > 1 else 'menu'
    if cmd in ('connect', 'disconnect', 'import', 'remove', 'list', 'dns', 'add'):
        if os.geteuid() != 0:
            sys.exit('as root')
        if cmd == 'list':
            print(json.dumps(list(configs())))
        elif cmd == 'connect' and len(argv) == 3:
            error = connect(argv[2])
            if error:
                print(error)
                return 1
        elif cmd == 'disconnect':
            disconnect()
        elif cmd == 'import' and len(argv) in (3, 5):
            error = import_file(argv[2], *argv[3:5])
            if error:
                print(error)
                return 1
        elif cmd == 'remove' and len(argv) == 3:
            if current() == argv[2]:
                disconnect()
            for ext in ('.ovpn', '.conf', '.auth', '.l2tp', '.pptp'):
                p = os.path.join(DIR, argv[2] + ext)
                if os.path.exists(p):
                    os.unlink(p)
        elif cmd == 'add' and len(argv) == 4 and argv[2] in ('l2tp', 'pptp'):
            error = add_server(argv[2], argv[3])
            if error:
                print(error)
                return 1
        elif cmd == 'dns':   # OpenVPN's up / down script
            if argv[2:]:
                save_dns([a for a in argv[2:] if re.match(r'^[\d.]+$', a)])
            else:
                restore_dns()
        else:
            sys.exit(__doc__)
        return 0
    if cmd == 'status':
        name = current()
        print('on: %s' % name if name else 'off')
        return 0
    if cmd == 'menu':
        return menu()
    sys.exit(__doc__)


if __name__ == '__main__':
    sys.exit(main(sys.argv))
