#!/usr/bin/python3
"""ozone-apps: Programs, a store of Debian's programs for the remote: picked ones by kind, a search
of all of Debian, installing, opening and removing.

  ozone-apps                    the window
  ozone-apps root install PKG...   (sudo -n) apt-get install, its progress on stdout
  ozone-apps root remove PKG...    (sudo -n) apt-get remove --autoremove

The picked programs (CATALOGUE) are ones that suit the box: a window of GTK, Qt or SDL without
OpenGL (the desktop has none: the GPU is GLES only, through ozone-gl), small enough for its 2 GB
system disk. The search reads apt's own package lists (/var/lib/apt/lists, lz4: apt-helper
cat-file), indexed once per update into ~/.cache/ozone-apps; their debtags tell windows from
terminal commands, and libraries are left out.

Before installing it works out (apt-get -s) what comes with it and how much space that takes, and
refuses if the disk hasn't got it. Everything goes with --no-install-recommends, and /sbin/init is
checked after (apt could trade sysvinit for systemd, which doesn't start on this kernel). Removing
takes the program and what only it needed; never anything else installed on purpose (the system's
own programs): then it says what still needs it instead. Only what was installed here can be
removed here (the root side checks it too), so the desktop's own programs can't be: they are
"part of the system". What was installed here is listed under "Installed by you"
(~/.local/share/ozone-apps/installed.json).
"""
import glob
import json
import os
import pickle
import re
import subprocess
import sys
import threading
import time

SELF = '/usr/local/bin/ozone-apps'
LISTS = '/var/lib/apt/lists'
HOME = os.path.expanduser('~')
CACHE = os.path.join(os.environ.get('XDG_CACHE_HOME') or os.path.join(HOME, '.cache'), 'ozone-apps')
INDEX = os.path.join(CACHE, 'index.pickle')
DATA = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.join(HOME, '.local/share'), 'ozone-apps')
MINE = os.path.join(DATA, 'installed.json')
MARGIN = 40 << 20        # bytes the disk keeps free after an install
SEARCH_MAX = 150

# (section key, icon, name, [(packages, name, what it is)]); the first package is the program
