def human(n):
    n = float(n)
    for unit in ('B', 'KB', 'MB', 'GB'):
        if n < 1024 or unit == 'GB':
            return ('%.0f %s' if unit in ('B', 'KB') or n >= 100 else '%.1f %s') % (n, unit)
        n /= 1024


def free_bytes(path='/'):
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize


# ---- what Debian has ------------------------------------------------------------------------------

def list_files():
    return sorted(f for f in glob.glob(os.path.join(LISTS, '*_Packages*')) if not f.endswith('.diff_Index'))


def build_index():
    """{name: (version, section, installed KB, download B, summary, homepage, tags)}, the newest
    version of each across the lists"""
    import apt_pkg
    apt_pkg.init_system()
    out = {}
    for path in list_files():
        raw = subprocess.run(['/usr/lib/apt/apt-helper', 'cat-file', path], capture_output=True).stdout
        for stanza in raw.decode('utf-8', 'replace').split('\n\n'):
            f = {}
            for line in stanza.split('\n'):
                if line[:1] in (' ', '\t') or ':' not in line:
                    continue
                k, v = line.split(':', 1)
                if k in ('Package', 'Version', 'Section', 'Installed-Size', 'Size', 'Description', 'Homepage', 'Tag'):
                    f[k] = v.strip()
            name = f.get('Package')
            if not name:
                continue
            old = out.get(name)
            if old and apt_pkg.version_compare(old[0], f.get('Version', '')) >= 0:
                continue
            section = f.get('Section', '').split('/')[-1]
            out[name] = (f.get('Version', ''), section, int(f.get('Installed-Size') or 0), int(f.get('Size') or 0),
                         f.get('Description', ''), f.get('Homepage', ''), f.get('Tag', ''))
    return out


def load_index():
    stamp = [(f, os.path.getmtime(f), os.path.getsize(f)) for f in list_files()]
    try:
        with open(INDEX, 'rb') as f:
            saved = pickle.load(f)
        if saved.get('stamp') == stamp:
            return saved['index']
    except (OSError, ValueError, EOFError, pickle.UnpicklingError, AttributeError):
        pass
    index = build_index()
    os.makedirs(CACHE, exist_ok=True)
    with open(INDEX + '.tmp', 'wb') as f:
        pickle.dump({'stamp': stamp, 'index': index}, f, protocol=pickle.HIGHEST_PROTOCOL)
    os.replace(INDEX + '.tmp', INDEX)
    return index


def installed_packages():
    """(installed, installed on purpose): from dpkg's status and apt's auto marks"""
    inst = set()
    name = None
    try:
        with open('/var/lib/dpkg/status') as f:
            for line in f:
                if line.startswith('Package: '):
                    name = line[9:].strip()
                elif line.startswith('Status: ') and line.rstrip().endswith(' installed') and name:
                    inst.add(name.split(':')[0])
    except OSError:
        pass
    auto = set()
    try:
        with open('/var/lib/apt/extended_states') as f:
            for stanza in f.read().split('\n\n'):
                m = re.search(r'^Package: (\S+)', stanza, re.M)
                if m and re.search(r'^Auto-Installed: 1', stanza, re.M):
                    auto.add(m.group(1).split(':')[0])
    except OSError:
        pass
    return inst, inst - auto


def kind(entry):
    """'window', 'terminal' or '' from the debtags"""
    tags = entry[6] if entry else ''
    if 'interface::x11' in tags or 'uitoolkit::' in tags or 'x11::application' in tags:
        return 'window'
    if 'interface::commandline' in tags or 'interface::text-mode' in tags:
        return 'terminal'
    return ''


def simulate(args):
    """apt-get -s: [(action, package)]"""
    r = subprocess.run(['apt-get', '-s', '-q', '--no-install-recommends'] + args, capture_output=True, text=True,
                       env=dict(os.environ, LC_ALL='C'))
    out = []
    for line in r.stdout.splitlines():
        m = re.match(r'(Inst|Remv) (\S+)', line)
        if m:
            out.append((m.group(1), m.group(2).split(':')[0]))
    return out, r.returncode, (r.stderr.strip().splitlines() or [''])[-1]


def launchers(pkg):
    """The program's .desktop files, and its commands"""
    r = subprocess.run(['dpkg', '-L', pkg], capture_output=True, text=True)
    files = r.stdout.splitlines()
    desktops = [f for f in files if f.startswith('/usr/share/applications/') and f.endswith('.desktop')]
    cmds = [f for f in files if re.match(r'^/usr/(bin|games)/[^/]+$', f) and os.path.isfile(f)]
    return desktops, cmds


GL_LIB = re.compile(r'\blib(GL|OpenGL|GLX|GLU|GLEW)\.so')
USER_APPS = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.join(HOME, '.local/share'), 'applications')


def uses_gl(pkg):
    """Its programs are linked with desktop OpenGL (most 3D games)"""
    _desktops, cmds = launchers(pkg)
    for c in cmds[:8]:
        r = subprocess.run(['ldd', c], capture_output=True, text=True)
        if GL_LIB.search(r.stdout):
            return True
    return False


def gl_launchers(pkg, on):
    """An OpenGL program's menu entries in the user's applications, started through
    "ozone-gl --gl" (gl4es on the GPU): written after installing, taken away after removing"""
    desktops, _cmds = launchers(pkg)
    for d in desktops:
        mine = os.path.join(USER_APPS, os.path.basename(d))
        if not on:
            try:
                with open(mine) as f:
                    ours = 'Exec=ozone-gl --gl ' in f.read()
            except OSError:
                ours = False
            if ours:
                os.unlink(mine)
            continue
        with open(d) as f:
            text = f.read()
        text = re.sub(r'^Exec=(?!ozone-gl )', 'Exec=ozone-gl --gl ', text, flags=re.M)
        os.makedirs(USER_APPS, exist_ok=True)
        with open(mine + '.tmp', 'w') as f:
            f.write(text)
        os.replace(mine + '.tmp', mine)


def load_mine():
    try:
        with open(MINE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_mine(d):
    os.makedirs(DATA, exist_ok=True)
    with open(MINE + '.tmp', 'w') as f:
        json.dump(d, f, indent=1)
    os.replace(MINE + '.tmp', MINE)


# ---- the work, as root ----------------------------------------------------------------------------

def out(*words):
    print(' '.join(str(w) for w in words), flush=True)


def check_init():
    r = subprocess.run(['dpkg', '-S', '/sbin/init'], capture_output=True, text=True)
    if 'sysvinit-core' not in r.stdout:
        out('error', '/sbin/init is not sysvinit any more: do NOT restart the box; reinstall sysvinit-core first.')
        sys.exit(1)


def apt_run(args):
    env = dict(os.environ, DEBIAN_FRONTEND='noninteractive', LC_ALL='C')
    cmd = ['apt-get', '-y', '-q', '--no-install-recommends', '-o', 'APT::Status-Fd=1',
           '-o', 'Dpkg::Options::=--force-confdef', '-o', 'Dpkg::Options::=--force-confold'] + args
    p = subprocess.Popen(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    last = ''
    for line in p.stdout:
        line = line.rstrip()
        m = re.match(r'(dlstatus|pmstatus):([^:]*):([\d.]+):(.*)', line)
        if m:
            pct = float(m.group(3)) / 100
            out('progress', '%.3f' % (pct * 0.4 if m.group(1) == 'dlstatus' else 0.4 + pct * 0.6), m.group(4))
        elif line.startswith(('E:', 'W:')):
            last = line
            out('log', line)
    p.wait()
    return p.returncode, last


def root_main(args):
    if os.geteuid() != 0:
        out('error', 'needs root (sudo)')
        sys.exit(1)
    cmd, pkgs = args[0], args[1:]
    if not pkgs or not all(re.match(r'^[a-z0-9][a-z0-9+.-]+$', p) for p in pkgs):
        out('error', 'not package names: %s' % ' '.join(pkgs))
        sys.exit(1)
    check_init()
    if cmd == 'install':
        code, last = apt_run(['install'] + pkgs)
    elif cmd == 'remove':
        # only what was installed here (the user's list), and nothing else installed on purpose goes
        # with it (the window checked; checked again)
        user = os.environ.get('SUDO_USER', '')
        try:
            import pwd
            with open(os.path.join(pwd.getpwnam(user).pw_dir, '.local/share/ozone-apps/installed.json')) as f:
                mine = json.load(f)
        except (KeyError, OSError, ValueError):
            mine = {}
        ours = {p for info in mine.values() for p in info.get('pkgs', [])} | set(mine)
        if any(p not in ours for p in pkgs):
            out('error', 'Only programs installed in Programs can be removed here.')
            sys.exit(1)
        acts, _rc, _e = simulate(['remove', '--autoremove'] + pkgs)
        _inst, manual = installed_packages()
        others = sorted(p for a, p in acts if a == 'Remv' and p in manual and p not in pkgs)
        if others:
            out('error', 'Removing it would take %s with it: not removed.' % ', '.join(others[:6]))
            sys.exit(1)
        code, last = apt_run(['remove', '--autoremove'] + pkgs)
    else:
        out('error', 'unknown: %s' % cmd)
        sys.exit(1)
    subprocess.call(['apt-get', 'clean'])
    check_init()
    if code != 0:
        out('error', 'apt-get failed (%d): %s' % (code, last or 'see /var/log/apt/term.log'))
        sys.exit(1)
    subprocess.call(['sync'])
    out('done', '')


