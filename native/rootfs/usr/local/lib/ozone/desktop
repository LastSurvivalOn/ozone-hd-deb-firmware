#!/bin/sh
# Graphical session. Started from /etc/inittab (respawn), so X comes back up if it crashes.
# The user is the first regular one (uid 1000).

USER_NAME=$(getent passwd 1000 | cut -d: -f1)
LOG=/var/log/ozone-desktop.log

/usr/local/lib/ozone/gen-xorg-input
/usr/local/lib/ozone/gen-xorg-screen
# the boot splash animation (started by ozone-hw) puts the screen back to full brightness on exit
start-stop-daemon --stop --quiet --retry 2 --pidfile /run/ozone-splash.pid --remove-pidfile
su -l "$USER_NAME" -c 'exec startx -- :0 vt7 -nolisten tcp -keeptty' > $LOG 2>&1
# X with the GPU driver crashed: the plain framebuffer from the next start on, until a reboot
if [ -e /run/ozone-gpu-desktop ] && grep -q 'Fatal server error' $LOG; then
    touch /run/ozone-gpu-failed
    cp $LOG /var/log/ozone-desktop-gpu-failed.log
fi
