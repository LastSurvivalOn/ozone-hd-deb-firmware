#!/bin/sh
# udev doesn't work on kernel 3.10, so Xorg can't find devices by itself. Generate the config before X starts:
# all mice via /dev/input/mice (the kernel merges ones plugged in later there too),
# all keyboards via the virtual "ozone-kbd" (ozone-input service, also supports hotplug).
# Without the service, each keyboard present when X starts is used separately.

OUT=/etc/X11/xorg.conf.d/10-ozone-input.conf

kbds=$(awk '/^N:/ { virt = /Name="ozone-kbd"/ }
            /^H:/ && virt { for (i = 1; i <= NF; i++) if ($i ~ /^event[0-9]+$/) print $i }' /proc/bus/input/devices)
[ -n "$kbds" ] ||
    kbds=$(awk '/^H:/ && /[= ]kbd / { for (i = 1; i <= NF; i++) if ($i ~ /^event[0-9]+$/) print $i }' /proc/bus/input/devices)

{
    echo '# Generated by /usr/local/lib/ozone/gen-xorg-input; do not edit'
    echo 'Section "ServerFlags"'
    echo '    Option "AutoAddDevices" "false"'
    echo 'EndSection'
    echo
    echo 'Section "ServerLayout"'
    echo '    Identifier "ozone"'
    echo '    Screen "screen"'
    echo '    InputDevice "mice" "CorePointer"'
    role=CoreKeyboard
    for ev in $kbds; do
        echo "    InputDevice \"$ev\" \"$role\""
        role=SendCoreEvents
    done
    echo 'EndSection'
    echo
    echo 'Section "InputDevice"'
    echo '    Identifier "mice"'
    echo '    Driver "mouse"'
    echo '    Option "Device" "/dev/input/mice"'
    echo '    Option "Protocol" "auto"'
    echo 'EndSection'
    for ev in $kbds; do
        echo
        echo 'Section "InputDevice"'
        echo "    Identifier \"$ev\""
        echo '    Driver "evdev"'
        echo "    Option \"Device\" \"/dev/input/$ev\""
        echo '    Option "XkbLayout" "us,ua"'
        echo '    Option "XkbOptions" "grp:alt_shift_toggle"'
        echo 'EndSection'
    done
} > $OUT
