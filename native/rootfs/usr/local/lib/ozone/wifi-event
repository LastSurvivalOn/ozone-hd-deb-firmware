#!/bin/sh
# wpa_cli action script (ozone-wifi): $1 the interface, $2 CONNECTED or DISCONNECTED.
# An address while associated (DHCP or the static one of the Network menu: net-apply), none when
# not. net-apply gives WiFi's default route metric 600: with the cable plugged in as well, the cable
# stays the way out. Without an address on disconnect: with the cable on the same subnet, WiFi's
# route would take the replies to what comes in over the cable (netwatch turns WiFi off for the
# cable).
case "$2" in
CONNECTED) /usr/local/lib/ozone/net-apply $1 ;;
DISCONNECTED) /usr/local/lib/ozone/net-apply $1 down ;;
esac
