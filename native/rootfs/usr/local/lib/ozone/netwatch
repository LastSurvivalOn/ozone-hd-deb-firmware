#!/bin/sh
# Follows the network cable (started by ozone-wifi). Kernel 3.10 keeps using a route whose link is
# down, so with the cable pulled out, eth0's default route would swallow what should go over WiFi:
# its address and routes go when the cable does, and DHCP runs again when it comes back. eth0 stays
# up throughout, since the carrier can't be read on an interface that is down.
carrier() {
    cat /sys/class/net/eth0/carrier 2> /dev/null || echo 0
}

last=$(carrier)
while sleep 3; do
    now=$(carrier)
    [ "$now" = "$last" ] && continue
    if [ "$now" = 1 ]; then
        echo "$(date '+%F %T') cable in" >> /var/log/netwatch.log
        { ifdown --force eth0; ifup eth0; } > /dev/null 2>&1 &
    else
        echo "$(date '+%F %T') cable out" >> /var/log/netwatch.log
        ip route flush dev eth0
        ip -4 addr flush dev eth0
    fi
    last=$now
done
