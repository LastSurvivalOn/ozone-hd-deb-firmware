#!/bin/sh
# Follows the network cable (started by ozone-wifi).
# - Kernel 3.10 keeps using a route whose link is down, so with the cable pulled out, eth0's default
#   route would swallow what should go over WiFi: its address and routes go when the cable does,
#   and DHCP runs again when it comes back. eth0 stays up throughout, since the carrier can't be
#   read on an interface that is down (and so no ifdown: taking the link down reads as the cable
#   going out, which brought it back up, in a loop).
# - WiFi steps aside while the cable works: once it has had an address for two checks in a row,
#   wpa_cli disconnect; when it goes, reconnect. Only a disconnect of netwatch's own is undone, not
#   one from the WiFi window.
LOG=/var/log/netwatch.log
PAUSED=/run/ozone-wifi-paused

carrier() {
    cat /sys/class/net/eth0/carrier 2> /dev/null || echo 0
}

# the cable is in use: plugged in, with an address (DHCP or static), or PPPoE up over it
wired() {
    [ "$(carrier)" = 1 ] && { ip -4 addr show dev eth0 | grep -q ' inet ' ||
                              ip -4 addr show dev ppp0 2> /dev/null | grep -q ' inet '; } && echo 1 || echo 0
}

log() {
    echo "$(date '+%F %T') $1" >> $LOG
}

rm -f $PAUSED
# a static address or PPPoE instead of the DHCP ifupdown started at boot
grep -qE '"eth0": *\{[^}]*"mode": *"(static|pppoe)"' /etc/ozone/network.json 2> /dev/null &&
    /usr/local/lib/ozone/net-apply eth0
last=$(carrier) wifi_off=0 seen=0
while true; do
    now=$(carrier)
    if [ "$now" != "$last" ]; then
        if [ "$now" = 1 ]; then
            log "cable in"
            # DHCP, the static address or PPPoE, as set in the Network menu
            /usr/local/lib/ozone/net-apply eth0
        else
            log "cable out"
            /usr/local/lib/ozone/net-apply eth0 down
        fi
        last=$now
    fi
    if [ "$(wired)" = 1 ]; then
        seen=$((seen + 1))
        if [ $wifi_off = 0 ] && [ $seen -ge 2 ]; then
            state=$(wpa_cli -i wlan0 status 2> /dev/null | sed -n 's/^wpa_state=//p')
            if [ "$state" = DISCONNECTED ]; then
                wifi_off=1   # already off, from the WiFi window: not ours to turn back on
            elif [ -n "$state" ] && wpa_cli -i wlan0 disconnect > /dev/null; then
                touch $PAUSED
                wifi_off=1
                log "cable works: WiFi off"
            fi
        fi
    else
        seen=0
        if [ $wifi_off = 1 ]; then
            if [ -e $PAUSED ]; then
                rm -f $PAUSED
                wpa_cli -i wlan0 reconnect > /dev/null
                log "no cable: WiFi on"
            fi
            wifi_off=0
        fi
    fi
    sleep 3
done
