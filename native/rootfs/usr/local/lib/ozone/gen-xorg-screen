#!/bin/sh
# The screen part of the X config, written before X starts. fb0 is a 1280x720 RGB565 desktop that
# the hardware scaler stretches to the output (set by /etc/init.d/ozone-hw); it must be 16 bit, as
# all 32-bit Amlogic OSD formats have alpha and X writes zeros there (a black screen).
# The driver is the Mali one (GPU: OpenGL ES for games and mpv through ozone-gl) when
# /etc/init.d/ozone-gpu loaded the GPU, and the plain framebuffer otherwise, or once X with the
# GPU has crashed (the desktop script sets /run/ozone-gpu-failed).

OUT=/etc/X11/xorg.conf.d/00-ozone-screen.conf

if [ -e /run/ozone-gpu ] && [ ! -e /run/ozone-gpu-failed ] && [ -e /usr/lib/xorg/modules/drivers/mali_drv.so ]; then
    driver=mali
    touch /run/ozone-gpu-desktop
else
    driver=fbdev
    rm -f /run/ozone-gpu-desktop
fi

{
    echo '# Generated by /usr/local/lib/ozone/gen-xorg-screen; do not edit'
    echo 'Section "Device"'
    echo '    Identifier "fb"'
    echo "    Driver \"$driver\""
    echo '    Option "fbdev" "/dev/fb0"'
    if [ $driver = mali ]; then
        # DRI2 with UMP buffers; the screen in a cached shadow, as reading the framebuffer is slow
        echo '    Option "DRI2" "true"'
        echo '    Option "DRI2_PAGE_FLIP" "false"'
        echo '    Option "UMP_CACHED" "true"'
        echo '    Option "UMP_LOCK" "false"'
        echo '    Option "ShadowFB" "true"'
        echo '    Option "SWCursor" "true"'
        echo '    Option "HWCursor" "false"'
    fi
    echo 'EndSection'
    echo
    echo 'Section "Screen"'
    echo '    Identifier "screen"'
    echo '    Device "fb"'
    echo '    DefaultDepth 16'
    echo '    DefaultFbBpp 16'
    echo 'EndSection'
} > $OUT.tmp && mv $OUT.tmp $OUT
