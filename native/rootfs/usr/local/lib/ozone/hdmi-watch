#!/bin/sh
# HDMI plugged in after power-on. u-boot picks the output when the box starts: with no TV on HDMI
# (unplugged, or a TV in standby that doesn't answer) it is analog 576cvbs, and nothing switches
# it later; in Android a system service does. This checks every 2 s and, once a TV is there while
# the output is still analog, switches to the HDMI mode chosen in ozone-display, or the one u-boot
# would have picked (hdmimode= on the kernel command line), with the desktop and sound (set-mode).
# Started by ozone-hw; changes go to /var/log/hdmi-watch.log.
HDMI=/sys/class/amhdmitx/amhdmitx0
MODE=/sys/class/display/mode

while true; do
    read hpd < $HDMI/hpd_state
    read mode < $MODE
    if [ "$hpd" = 1 ] && case $mode in *cvbs) true ;; *) false ;; esac; then
        echo "$(date '+%F %T') TV on HDMI, output $mode"
        # the mode chosen in ozone-display, or u-boot's hdmimode=; the desktop and sound follow
        /usr/local/lib/ozone/set-mode --hdmi
        read mode < $MODE
        echo "$(date '+%F %T') output now $mode"
        # analog chosen: it stays, and this doesn't ask again until the TV goes and comes back
        case $mode in *cvbs) while [ "$(cat $HDMI/hpd_state)" = 1 ]; do sleep 2; done ;; esac
    fi
    sleep 2
done
