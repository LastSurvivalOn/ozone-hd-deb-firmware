[Desktop Entry]
Type=Application
Name=Code editor
Comment=Geany: write C, Python, shell scripts, web pages; build with gcc and run them
Exec=ozone-code %F
Icon=geany
Terminal=false
Categories=Development;IDE;TextEditor;
MimeType=text/plain;text/x-chdr;text/x-csrc;text/x-c++hdr;text/x-c++src;text/x-python;text/x-python3;application/x-shellscript;text/x-makefile;text/html;text/css;application/javascript;application/json;application/xml;text/markdown;
