#!/bin/sh
### BEGIN INIT INFO
# Provides:          ozone-dtv
# Required-Start:    ozone-hw ozone-android
# Required-Stop:
# Default-Start:     S
# Default-Stop:
# Short-Description: Android environment for the DVB-T2 frontend libraries
# Description:       dtvfe runs the TV app's own frontend libraries (bionic), which
#                    ozone-android puts on /system; this gives them the rest of what
#                    Android's init would have.
### END INIT INFO

# Under Android, Android does all of this itself
/etc/ozone/is-native || exit 0

case "$1" in
start)
    # Android's kernel logger, so the libraries' messages can be read (ozone-tv log, the session
    # logs). It shows a reader other uids' entries only if the reader is in the node's group.
    mkdir -p /dev/log
    for n in main events radio system; do
        [ -e /dev/log/$n ] || mknod /dev/log/$n c $(tr : ' ' < /sys/class/misc/log_$n/dev)
        chgrp video /dev/log/$n && chmod 666 /dev/log/$n
    done

    # The Android names of the DVB nodes (ueventd's /dev/dvb0.demux0 etc.)
    for d in /dev/dvb/adapter0/*; do
        ln -sf $d /dev/dvb0.${d##*/}
    done
    # demux and dvr are used by the scanner and player as the regular user
    chgrp video /dev/dvb/adapter0/* && chmod g+rw /dev/dvb/adapter0/*
    # ozone-tv --test switches demux0 to memory input, and ozone-tv routes the TS-tap output to dvr0
    # and sets how much of it the DMA gathers before passing it on
    for a in demux0_source asyncfifo0_source asyncfifo0_flush_size; do
        chgrp video /sys/class/stb/$a && chmod g+w /sys/class/stb/$a
    done
    ;;
stop|restart|force-reload|status)
    ;;
*)
    echo "usage: $0 start" >&2
    exit 3
    ;;
esac
