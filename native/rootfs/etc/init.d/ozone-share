#!/bin/sh
### BEGIN INIT INFO
# Provides:          ozone-share
# Required-Start:    $local_fs $network $remote_fs
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Sharing the box's files with the network (Samba, MiniDLNA), as set in the Network menu
### END INIT INFO
case "$1" in
start|restart|force-reload)
    [ -e /etc/ozone/share.json ] && /usr/local/bin/ozone-share apply
    ;;
stop)
    if [ -e /etc/ozone/share.json ]; then
        /etc/init.d/smbd stop > /dev/null 2>&1
        /etc/init.d/nmbd stop > /dev/null 2>&1
        start-stop-daemon --stop --quiet --oknodo --pidfile /run/ozone-wsdd.pid --remove-pidfile
        start-stop-daemon --stop --quiet --oknodo --retry 5 --exec /usr/sbin/minidlnad
    fi
    ;;
status)
    /usr/local/bin/ozone-share status
    ;;
*)
    echo "Usage: $0 start|stop|restart|status" >&2
    exit 3
    ;;
esac
exit 0
