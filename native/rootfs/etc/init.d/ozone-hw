#!/bin/sh
### BEGIN INIT INFO
# Provides:          ozone-hw
# Required-Start:    kmod
# Required-Stop:
# Default-Start:     S
# Default-Stop:      0
# Short-Description: Box hardware: CPU, temperature, display
# Description:       Does what init.amlogic*.rc and set_display_mode.sh do in Android.
### END INIT INFO

# Under Android (chroot mode), Android manages the hardware
/etc/ozone/is-native || exit 0

CPU=/sys/devices/system/cpu/cpu0/cpufreq
FB=/sys/class/graphics
SPLASH=/usr/share/ozone/splash.rgb565

case "$1" in
start)
    # Same limits as the stock firmware. Its hotplug governor runs on one core and brings the others
    # up too late for a browser (pages load 20-35 % slower); interactive jumps to full speed under
    # load and drops back when idle, with all four cores online.
    echo 1536000 > $CPU/scaling_max_freq
    echo 96000 > $CPU/scaling_min_freq
    echo interactive > $CPU/scaling_governor
    for c in /sys/devices/system/cpu/cpu[1-3]/online; do echo 1 > $c; done

    # 1280x720 desktop, the hardware scaler stretches it to 1080p. It must be 16 bit (RGB565): all 32-bit
    # Amlogic OSD formats have alpha and X writes zeros there, so the layer turns transparent (black screen);
    # modern Xorg no longer supports 24 bit
    fbset -fb /dev/fb0 -g 1280 720 1280 1440 16 -rgba 5/11,6/5,5/0,0/0
    echo 0 0 1279 719 > $FB/fb0/free_scale_axis
    # into the whole 1080p output, or a window inside it for screens that cut off the edges
    # (ozone-screen keeps the margins in /etc/ozone/screen; amplay puts the video there too)
    h=0 v=0
    [ -r /etc/ozone/screen ] && read h v < /etc/ozone/screen
    case "$h$v" in *[!0-9]*|'') h=0 v=0 ;; esac
    echo $h $v $((1919 - h)) $((1079 - v)) > $FB/fb0/window_axis
    echo 0x10001 > $FB/fb0/free_scale
    dd if=/dev/zero of=/dev/fb0 bs=1M count=8 2>/dev/null
    # u-boot's logo sits on fb1 in memory the kernel doesn't reserve, so take it over on fb0
    [ -f $SPLASH ] && cat $SPLASH > /dev/fb0
    echo 1 > $FB/fb1/blank
    echo 0 > $FB/fb0/blank
    [ -f $SPLASH ] && start-stop-daemon --start --quiet --background --make-pidfile \
        --pidfile /run/ozone-splash.pid --exec /usr/bin/python3 -- /usr/local/lib/ozone/splash
    # a TV that only turns up after power-on gets HDMI then (u-boot chose analog output without it)
    start-stop-daemon --start --quiet --background --make-pidfile --pidfile /run/ozone-hdmi-watch.pid \
        --startas /bin/sh -- -c 'exec /usr/local/lib/ozone/hdmi-watch >> /var/log/hdmi-watch.log 2>&1'

    # Without udev the kernel creates device nodes for root only; set permissions as in regular Debian
    chgrp -R audio /dev/snd && chmod -R g+rw /dev/snd
    chgrp video /dev/fb0 /dev/fb1 && chmod g+rw /dev/fb0 /dev/fb1
    # ozone-screen, as the regular user
    [ -e /etc/ozone/screen ] || echo 0 0 > /etc/ozone/screen
    chgrp video /etc/ozone/screen $FB/fb0/window_axis $FB/fb0/free_scale &&
        chmod g+w /etc/ozone/screen $FB/fb0/window_axis $FB/fb0/free_scale
    chgrp input /dev/input/* && chmod g+rw /dev/input/*
    # ozone-remote (in the X session) passes the remote on through virtual devices of its own
    chgrp input /dev/uinput && chmod g+rw /dev/uinput

    # Hardware video decoder (amplay): the stream ports and the sysfs knobs it drives
    chgrp video /dev/amstream_* /dev/amvideo && chmod g+rw /dev/amstream_* /dev/amvideo
    for a in video/axis video/screen_mode video/disable_video tsync/enable tsync/startsync_mode \
             graphics/fb0/blank graphics/fb0/color_key graphics/fb0/enable_key; do
        chgrp video /sys/class/$a && chmod g+w /sys/class/$a
    done
    # Compressed swap in RAM (zram, LZO on this kernel): a browser tab can take 250 MB of the 830
    swapon --show=NAME --noheadings | grep -q zram0 || {
        echo $((384 << 20)) > /sys/block/zram0/disksize &&
        mkswap /dev/zram0 > /dev/null && swapon -p 10 /dev/zram0
    }

    # Frame-rate automation (switching the HDMI refresh rate to the video's) dereferences a NULL mode
    # name when a decoder closes and takes the kernel down. Android turns it off at boot too.
    echo 0 > /sys/class/tv/policy_fr_auto

    # softvol creates the "Master" control only on first open; polybar expects it right away.
    # aplay opens the device safely (see /etc/asound.conf and mpv.conf)
    timeout 3 aplay -q -D default -f S16_LE -r 48000 -c 2 -d 1 /dev/zero
    amixer -q sset Master 70%

    # Hardware video path: decoder -> post-processing -> video layer
    echo "rm default" > /sys/class/vfm/map
    echo "add default decoder ppmgr deinterlace amvideo" > /sys/class/vfm/map
    ;;
stop)
    # Halt: the box can't cut its own power (see /etc/default/halt), so switch HDMI off and let the
    # TV show "no signal". Early suspend does that; the wakelock keeps it from going deeper until
    # /etc/init.d/halt, with the filesystems read-only, lets go of it for deep suspend.
    if [ "$RUNLEVEL" = 0 ]; then
        echo ozone-halt > /sys/power/wake_lock
        echo mem > /sys/power/state
    fi
    ;;
restart|force-reload|status)
    ;;
*)
    echo "usage: $0 start" >&2
    exit 3
    ;;
esac
