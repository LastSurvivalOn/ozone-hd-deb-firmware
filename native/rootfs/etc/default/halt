# Default behaviour of shutdown -h / halt. Set to "halt" or "poweroff".
# ozone: this kernel implements power off as a reboot (meson_power_off restarts with reason
# "charging_reboot" and u-boot boots straight through), so it must halt instead. /etc/init.d/halt
# (ozone's wrapper) first tries deep suspend, the box's own "off": red LED, and Power on the remote
# turns it on. Only if that fails is the CPU stopped, with HDMI off (ozone-hw).
HALT=halt
# `poweroff` and `shutdown -P` export INIT_HALT=POWEROFF, which /etc/init.d/halt prefers over HALT;
# this file is sourced by that script, so override it too
INIT_HALT=HALT

# Bring networking down right before halting/rebooting system. You
# should only need this to handle issues with Wake-on-LAN or network
# filesystems.  Set to "yes" or "no".
NETDOWN=yes
